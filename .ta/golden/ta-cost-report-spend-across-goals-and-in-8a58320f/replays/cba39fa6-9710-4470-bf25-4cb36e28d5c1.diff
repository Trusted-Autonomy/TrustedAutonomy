+// cost_report.rs: spend across TA goals and interactive agent sessions (v0.17.12.18).
+//
+// `ta cost report` answers "where is the money going" across three sources:
+//   * TA goals            the goal records (`GoalRun`), the same data `GET /api/spend` reads;
+//   * Claude Code         `~/.claude/projects/**/*.jsonl` transcripts;
+//   * OMP                 `~/.omp/agent/sessions/**/*.jsonl` transcripts.
+//
+// Everything here is pure (text in, records out) except `collect_jsonl`, so it
+// is tested against tempdir fixtures and never touches a real home directory.
+//
+// Counting rules that matter for correctness:
+//   * Claude streams one assistant message as several transcript rows that
+//     repeat the same `message.id`. Rows are deduplicated by id across every
+//     file scanned, last row wins. Counting every row overstates a long
+//     session by about 2.5x. Rows whose model is `<synthetic>` (client-side
+//     placeholders, never billed) are skipped.
+//   * OMP records usage and cost per message; its own cost is used as is.
+//   * A cost is `exact` when the source reported it (OMP `usage.cost.total`,
+//     Claude `costUSD`, a runtime-reported goal cost), `estimated` when it came
+//     from the price table, and `unpriced` when the model has no row. No price
+//     is ever invented.
+//   * Cache writes are priced per class: the 1 hour class (2x input) when the
+//     transcript splits them (`cache_creation.ephemeral_1h_input_tokens`),
+//     otherwise the 5 minute class.
+//
+// The OMP reader accepts the field names OMP writes per assistant message
+// (`usage.input`, `output`, `cacheRead`, `cacheWrite`, `cost.total`) and the
+// snake_case spellings of the same names; a line it cannot read is counted in
+// the source's `unreadable_rows`, never silently dropped.
+
+use std::collections::{BTreeMap, HashMap};
+use std::path::{Path, PathBuf};
+
+use chrono::{DateTime, TimeZone, Utc};
+use serde::{Deserialize, Serialize};
+
+use crate::goal_run::GoalRun;
+use crate::token_cost::{CostSource, PriceTable, TokenUsage};
+
+// ── Records ─────────────────────────────────────────────────────────────────
+
+/// Where a row of spend came from.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum CostSourceKind {
+    /// A TA goal record.
+    TaGoal,
+    /// A Claude Code session transcript.
+    ClaudeCode,
+    /// An OMP session transcript.
+    Omp,
+}
+
+impl CostSourceKind {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            CostSourceKind::TaGoal => "ta_goal",
+            CostSourceKind::ClaudeCode => "claude_code",
+            CostSourceKind::Omp => "omp",
+        }
+    }
+}
+
+/// How trustworthy a row's cost is.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum CostKind {
+    /// The source reported the cost.
+    Exact,
+    /// Computed from a price-table row.
+    Estimated,
+    /// No price for the model; tokens are counted, the cost is 0.
+    Unpriced,
+}
+
+/// One billed unit: a deduplicated assistant turn of a session, or a whole goal.
+#[derive(Debug, Clone, PartialEq)]
+pub struct SpendRow {
+    pub source: CostSourceKind,
+    pub session: String,
+    pub project: String,
+    pub timestamp: Option<DateTime<Utc>>,
+    pub model: String,
+    pub input: u64,
+    pub output: u64,
+    pub cache_read: u64,
+    /// Cache writes with the 5 minute TTL (or unsplit writes).
+    pub cache_write_5m: u64,
+    /// Cache writes with the 1 hour TTL.
+    pub cache_write_1h: u64,
+    pub usd: f64,
+    pub cost: CostKind,
+    /// Goals only: why the goal started.
+    pub origin_class: Option<String>,
+    /// `true` for one assistant turn, `false` for a whole goal.
+    pub is_turn: bool,
+}
+
+impl SpendRow {
+    /// Prompt size of the turn: every input-side token the model saw.
+    pub fn context_tokens(&self) -> u64 {
+        self.input
+            .saturating_add(self.cache_read)
+            .saturating_add(self.cache_write_5m)
+            .saturating_add(self.cache_write_1h)
+    }
+
+    pub fn cache_write(&self) -> u64 {
+        self.cache_write_5m.saturating_add(self.cache_write_1h)
+    }
+
+    pub fn total_tokens(&self) -> u64 {
+        self.context_tokens().saturating_add(self.output)
+    }
+
+    /// The context-size bucket of a turn; `n/a` for a goal, which is one row
+    /// covering many turns.
+    pub fn bucket(&self) -> &'static str {
+        if self.is_turn {
+            context_bucket(self.context_tokens())
+        } else {
+            "n/a"
+        }
+    }
+}
+
+/// The context-size buckets, smallest first.
+pub const CONTEXT_BUCKETS: [&str; 5] = ["0-50k", "50-100k", "100-200k", "200-400k", ">400k"];
+
+/// The bucket for a prompt of `tokens` tokens. Lower bounds are inclusive.
+pub fn context_bucket(tokens: u64) -> &'static str {
+    match tokens {
+        0..=49_999 => CONTEXT_BUCKETS[0],
+        50_000..=99_999 => CONTEXT_BUCKETS[1],
+        100_000..=199_999 => CONTEXT_BUCKETS[2],
+        200_000..=399_999 => CONTEXT_BUCKETS[3],
+        _ => CONTEXT_BUCKETS[4],
+    }
+}
+
+fn price_row(row: &mut SpendRow, table: &PriceTable, reported_usd: Option<f64>) {
+    if let Some(usd) = reported_usd.filter(|v| v.is_finite() && *v >= 0.0) {
+        row.usd = usd;
+        row.cost = CostKind::Exact;
+        return;
+    }
+    let usage = TokenUsage {
+        input: row.input,
+        output: row.output,
+        cache_read: row.cache_read,
+        cache_creation: row.cache_write_5m,
+    };
+    match table.price_split(&row.model, &usage, row.cache_write_1h) {
+        Some(usd) => {
+            row.usd = usd;
+            row.cost = CostKind::Estimated;
+        }
+        None => {
+            row.usd = 0.0;
+            row.cost = CostKind::Unpriced;
+        }
+    }
+}
+
+// ── Source status ───────────────────────────────────────────────────────────
+
+/// What the scan of one source found, for the report header.
+#[derive(Debug, Clone, Default, Serialize, Deserialize, PartialEq)]
+pub struct SourceStatus {
+    pub source: String,
+    /// The directory (or goals directory) that was looked at.
+    pub location: String,
+    pub found: bool,
+    pub files: u64,
+    /// Candidate usage rows read (assistant rows with usage).
+    pub rows_read: u64,
+    /// Rows left after deduplication and skips.
+    pub rows_counted: u64,
+    /// Rows dropped because their message id was already counted.
+    pub deduplicated: u64,
+    /// `<synthetic>` placeholder rows skipped.
+    pub synthetic_skipped: u64,
+    /// Lines that were not valid JSON or lacked a readable usage block.
+    pub unreadable_rows: u64,
+    /// Rows left out because they have no timestamp and a time bound is set.
+    pub no_timestamp_skipped: u64,
+    /// Why the source could not be read, if it could not.
+    pub error: Option<String>,
+}
+
+// ── Claude Code ─────────────────────────────────────────────────────────────
+
+fn num(v: &serde_json::Value, key: &str) -> u64 {
+    v.get(key).and_then(|x| x.as_u64()).unwrap_or(0)
+}
+
+fn parse_timestamp(v: &serde_json::Value) -> Option<DateTime<Utc>> {
+    match v {
+        serde_json::Value::String(s) => DateTime::parse_from_rfc3339(s.trim())
+            .ok()
+            .map(|d| d.with_timezone(&Utc)),
+        serde_json::Value::Number(n) => {
+            let n = n.as_i64()?;
+            // Milliseconds since the epoch (seconds would put every row in 1970).
+            let ms = if n > 100_000_000_000 { n } else { n * 1000 };
+            Utc.timestamp_millis_opt(ms).single()
+        }
+        _ => None,
+    }
+}
+
+fn last_component(path: &str) -> String {
+    path.trim_end_matches(['/', '\\'])
+        .rsplit(['/', '\\'])
+        .next()
+        .unwrap_or(path)
+        .to_string()
+}
+
+/// Accumulates Claude Code assistant rows across files, deduplicated by
+/// `message.id` (last row wins).
+#[derive(Debug, Default)]
+pub struct ClaudeScan {
+    by_id: HashMap<String, usize>,
+    rows: Vec<SpendRow>,
+    /// Reported cost per row, parallel to `rows`.
+    reported: Vec<Option<f64>>,
+    status: SourceStatus,
+}
+
+impl ClaudeScan {
+    pub fn new(location: &Path) -> Self {
+        Self {
+            status: SourceStatus {
+                source: CostSourceKind::ClaudeCode.as_str().to_string(),
+                location: location.display().to_string(),
+                found: true,
+                ..SourceStatus::default()
+            },
+            ..Self::default()
+        }
+    }
+
+    /// Read one transcript. `project_hint` names the project when a row has no
+    /// `cwd`; `session_hint` names the session when a row has no `sessionId`.
+    pub fn ingest(&mut self, text: &str, project_hint: &str, session_hint: &str) {
+        self.status.files += 1;
+        for line in text.lines().filter(|l| !l.trim().is_empty()) {
+            let Ok(v) = serde_json::from_str::<serde_json::Value>(line) else {
+                self.status.unreadable_rows += 1;
+                continue;
+            };
+            if v.get("type").and_then(|t| t.as_str()) != Some("assistant") {
+                continue;
+            }
+            let Some(msg) = v.get("message") else {
+                continue;
+            };
+            let Some(usage) = msg.get("usage").filter(|u| u.is_object()) else {
+                continue;
+            };
+            let model = msg.get("model").and_then(|m| m.as_str()).unwrap_or("");
+            self.status.rows_read += 1;
+            if model == "<synthetic>" {
+                self.status.synthetic_skipped += 1;
+                continue;
+            }
+            let total_write = num(usage, "cache_creation_input_tokens");
+            let split = usage.get("cache_creation").filter(|c| c.is_object());
+            let (w5, w1) = match split {
+                Some(c) => {
+                    let w1 = num(c, "ephemeral_1h_input_tokens");
+                    let w5 = c
+                        .get("ephemeral_5m_input_tokens")
+                        .and_then(|x| x.as_u64())
+                        .unwrap_or_else(|| total_write.saturating_sub(w1));
+                    (w5, w1)
+                }
+                None => (total_write, 0),
+            };
+            let project = v
+                .get("cwd")
+                .and_then(|c| c.as_str())
+                .map(last_component)
+                .unwrap_or_else(|| project_hint.to_string());
+            let row = SpendRow {
+                source: CostSourceKind::ClaudeCode,
+                session: v
+                    .get("sessionId")
+                    .and_then(|s| s.as_str())
+                    .unwrap_or(session_hint)
+                    .to_string(),
+                project,
+                timestamp: v.get("timestamp").and_then(parse_timestamp),
+                model: model.to_string(),
+                input: num(usage, "input_tokens"),
+                output: num(usage, "output_tokens"),
+                cache_read: num(usage, "cache_read_input_tokens"),
+                cache_write_5m: w5,
+                cache_write_1h: w1,
+                usd: 0.0,
+                cost: CostKind::Unpriced,
+                origin_class: None,
+                is_turn: true,
+            };
+            let reported = v.get("costUSD").and_then(|c| c.as_f64());
+            match msg.get("id").and_then(|i| i.as_str()) {
+                Some(id) => match self.by_id.get(id) {
+                    Some(&at) => {
+                        self.status.deduplicated += 1;
+                        self.rows[at] = row;
+                        self.reported[at] = reported;
+                    }
+                    None => {
+                        self.by_id.insert(id.to_string(), self.rows.len());
+                        self.rows.push(row);
+                        self.reported.push(reported);
+                    }
+                },
+                // No id to deduplicate on: count it once, as written.
+                None => {
+                    self.rows.push(row);
+                    self.reported.push(reported);
+                }
+            }
+        }
+    }
+
+    /// Record a file that could not be read.
+    pub fn note_unreadable_file(&mut self, path: &Path, err: &std::io::Error) {
+        self.status.unreadable_rows += 1;
+        tracing::warn!(path = %path.display(), error = %err, "could not read a Claude Code transcript; skipping it");
+    }
+
+    /// Price the rows and return them with the scan status.
+    pub fn finish(mut self, table: &PriceTable) -> (Vec<SpendRow>, SourceStatus) {
+        for (row, reported) in self.rows.iter_mut().zip(&self.reported) {
+            price_row(row, table, *reported);
+        }
+        self.status.rows_counted = self.rows.len() as u64;
+        (self.rows, self.status)
+    }
+}
+
+// ── OMP ─────────────────────────────────────────────────────────────────────
+
+fn omp_field(v: &serde_json::Value, camel: &str, snake: &str) -> u64 {
+    v.get(camel)
+        .or_else(|| v.get(snake))
+        .and_then(|x| x.as_u64())
+        .unwrap_or(0)
+}
+
+/// Read one OMP session file. Appends turns to `out` and counts into `status`.
+pub fn ingest_omp(
+    text: &str,
+    project_hint: &str,
+    session: &str,
+    table: &PriceTable,
+    out: &mut Vec<SpendRow>,
+    status: &mut SourceStatus,
+) {
+    status.files += 1;
+    let mut project = project_hint.to_string();
+    for line in text.lines().filter(|l| !l.trim().is_empty()) {
+        let Ok(v) = serde_json::from_str::<serde_json::Value>(line) else {
+            status.unreadable_rows += 1;
+            continue;
+        };
+        // A session header carries the working directory.
+        if let Some(cwd) = v
+            .get("cwd")
+            .and_then(|c| c.as_str())
+            .filter(|_| v.get("message").is_none())
+        {
+            project = last_component(cwd);
+            continue;
+        }
+        let msg = v.get("message").unwrap_or(&v);
+        if msg.get("role").and_then(|r| r.as_str()) != Some("assistant") {
+            continue;
+        }
+        let Some(usage) = msg.get("usage").filter(|u| u.is_object()) else {
+            continue;
+        };
+        status.rows_read += 1;
+        let model = msg.get("model").and_then(|m| m.as_str()).unwrap_or("");
+        if model == "<synthetic>" {
+            status.synthetic_skipped += 1;
+            continue;
+        }
+        let ts = v
+            .get("timestamp")
+            .or_else(|| msg.get("timestamp"))
+            .and_then(parse_timestamp);
+        let mut row = SpendRow {
+            source: CostSourceKind::Omp,
+            session: session.to_string(),
+            project: project.clone(),
+            timestamp: ts,
+            model: model.to_string(),
+            input: omp_field(usage, "input", "input_tokens"),
+            output: omp_field(usage, "output", "output_tokens"),
+            cache_read: omp_field(usage, "cacheRead", "cache_read"),
+            cache_write_5m: omp_field(usage, "cacheWrite", "cache_write"),
+            cache_write_1h: 0,
+            usd: 0.0,
+            cost: CostKind::Unpriced,
+            origin_class: None,
+            is_turn: true,
+        };
+        let reported = usage
+            .get("cost")
+            .and_then(|c| c.get("total").or(Some(c)))
+            .and_then(|t| t.as_f64());
+        price_row(&mut row, table, reported);
+        out.push(row);
+        status.rows_counted += 1;
+    }
+}
+
+// ── Goals ───────────────────────────────────────────────────────────────────
+
+/// One spend row per goal record.
+pub fn goal_rows(goals: &[(String, GoalRun)]) -> Vec<SpendRow> {
+    goals
+        .iter()
+        .map(|(project, g)| {
+            let u = g.token_usage();
+            SpendRow {
+                source: CostSourceKind::TaGoal,
+                session: g.goal_run_id.to_string(),
+                project: project.clone(),
+                timestamp: Some(g.created_at),
+                model: g.agent_model.clone(),
+                input: u.input,
+                output: u.output,
+                cache_read: u.cache_read,
+                cache_write_5m: u.cache_creation,
+                cache_write_1h: 0,
+                usd: g.cost_usd,
+                cost: match g.cost_source {
+                    CostSource::Runtime => CostKind::Exact,
+                    CostSource::Table => CostKind::Estimated,
+                    CostSource::None => CostKind::Unpriced,
+                },
+                origin_class: Some(g.effective_origin_class().to_string()),
+                is_turn: false,
+            }
+        })
+        .collect()
+}
+
+// ── File discovery ──────────────────────────────────────────────────────────
+
+/// Every `*.jsonl` file under `root`, sorted, depth-first. A directory that
+/// cannot be listed is returned in the second list with its error so the
+/// caller can report it. Symlinked directories are not followed.
+pub fn collect_jsonl(root: &Path) -> (Vec<PathBuf>, Vec<(PathBuf, std::io::Error)>) {
+    let mut files = Vec::new();
+    let mut errors = Vec::new();
+    let mut stack = vec![root.to_path_buf()];
+    while let Some(dir) = stack.pop() {
+        let entries = match std::fs::read_dir(&dir) {
+            Ok(e) => e,
+            Err(e) => {
+                errors.push((dir, e));
+                continue;
+            }
+        };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            let Ok(ft) = entry.file_type() else { continue };
+            if ft.is_dir() {
+                stack.push(path);
+            } else if ft.is_file() && path.extension().is_some_and(|e| e == "jsonl") {
+                files.push(path);
+            }
+        }
+    }
+    files.sort();
+    (files, errors)
+}
+
+/// Scan a Claude Code projects directory. `None` status `found` means missing.
+pub fn scan_claude_dir(root: &Path, table: &PriceTable) -> (Vec<SpendRow>, SourceStatus) {
+    if !root.is_dir() {
+        return (
+            Vec::new(),
+            SourceStatus {
+                source: CostSourceKind::ClaudeCode.as_str().to_string(),
+                location: root.display().to_string(),
+                found: false,
+                ..SourceStatus::default()
+            },
+        );
+    }
+    let mut scan = ClaudeScan::new(root);
+    let (files, errors) = collect_jsonl(root);
+    for (dir, e) in &errors {
+        scan.note_unreadable_file(dir, e);
+    }
+    for f in files {
+        let project = f
+            .strip_prefix(root)
+            .ok()
+            .and_then(|p| p.components().next())
+            .map(|c| c.as_os_str().to_string_lossy().to_string())
+            .unwrap_or_default();
+        let session = f
+            .file_stem()
+            .map(|s| s.to_string_lossy().to_string())
+            .unwrap_or_default();
+        match std::fs::read_to_string(&f) {
+            Ok(text) => scan.ingest(&text, &project, &session),
+            Err(e) => scan.note_unreadable_file(&f, &e),
+        }
+    }
+    scan.finish(table)
+}
+
+/// Scan an OMP sessions directory.
+pub fn scan_omp_dir(root: &Path, table: &PriceTable) -> (Vec<SpendRow>, SourceStatus) {
+    let mut status = SourceStatus {
+        source: CostSourceKind::Omp.as_str().to_string(),
+        location: root.display().to_string(),
+        found: root.is_dir(),
+        ..SourceStatus::default()
+    };
+    let mut rows = Vec::new();
+    if !status.found {
+        return (rows, status);
+    }
+    let (files, errors) = collect_jsonl(root);
+    for (dir, e) in &errors {
+        status.unreadable_rows += 1;
+        tracing::warn!(path = %dir.display(), error = %e, "could not list an OMP sessions directory; skipping it");
+    }
+    for f in files {
+        let project = f
+            .strip_prefix(root)
+            .ok()
+            .and_then(|p| p.components().next())
+            .map(|c| c.as_os_str().to_string_lossy().to_string())
+            .unwrap_or_default();
+        let session = f
+            .file_stem()
+            .map(|s| s.to_string_lossy().to_string())
+            .unwrap_or_default();
+        match std::fs::read_to_string(&f) {
+            Ok(text) => ingest_omp(&text, &project, &session, table, &mut rows, &mut status),
+            Err(e) => {
+                status.unreadable_rows += 1;
+                tracing::warn!(path = %f.display(), error = %e, "could not read an OMP session file; skipping it");
+            }
+        }
+    }
+    (rows, status)
+}
+
+// ── Report ──────────────────────────────────────────────────────────────────
+
+/// A dimension to group the report by.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum CostGroup {
+    Day,
+    Source,
+    Model,
+    Project,
+    ContextBucket,
+    OriginClass,
+}
+
+impl CostGroup {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            CostGroup::Day => "day",
+            CostGroup::Source => "source",
+            CostGroup::Model => "model",
+            CostGroup::Project => "project",
+            CostGroup::ContextBucket => "context_bucket",
+            CostGroup::OriginClass => "origin_class",
+        }
+    }
+}
+
+/// Parse `--group-by`: a comma-separated list of dimension names.
+pub fn parse_cost_group_by(s: &str) -> Result<Vec<CostGroup>, String> {
+    let mut out = Vec::new();
+    for part in s.split(',').map(str::trim).filter(|p| !p.is_empty()) {
+        let g = match part {
+            "day" => CostGroup::Day,
+            "source" => CostGroup::Source,
+            "model" => CostGroup::Model,
+            "project" => CostGroup::Project,
+            "context_bucket" => CostGroup::ContextBucket,
+            "origin_class" => CostGroup::OriginClass,
+            other => {
+                return Err(format!(
+                    "unknown --group-by {other:?}: expected a comma-separated list of day, \
+                     source, model, project, context_bucket, origin_class (for example \
+                     --group-by source,model)"
+                ))
+            }
+        };
+        if out.contains(&g) {
+            return Err(format!(
+                "--group-by lists {part:?} twice; list each name once"
+            ));
+        }
+        out.push(g);
+    }
+    Ok(out)
+}
+
+/// Totals for one group.
+#[derive(Debug, Clone, Default, Serialize, Deserialize, PartialEq)]
+pub struct CostTotals {
+    /// Assistant turns (transcript rows).
+    pub turns: u64,
+    /// TA goals.
+    pub goals: u64,
+    pub input_tokens: u64,
+    pub output_tokens: u64,
+    pub cache_read_tokens: u64,
+    pub cache_write_tokens: u64,
+    pub total_tokens: u64,
+    pub usd: f64,
+    pub exact_rows: u64,
+    pub estimated_rows: u64,
+    pub unpriced_rows: u64,
+}
+
+impl CostTotals {
+    fn add(&mut self, r: &SpendRow) {
+        if r.is_turn {
+            self.turns += 1;
+        } else {
+            self.goals += 1;
+        }
+        self.input_tokens = self.input_tokens.saturating_add(r.input);
+        self.output_tokens = self.output_tokens.saturating_add(r.output);
+        self.cache_read_tokens = self.cache_read_tokens.saturating_add(r.cache_read);
+        self.cache_write_tokens = self.cache_write_tokens.saturating_add(r.cache_write());
+        self.total_tokens = self.total_tokens.saturating_add(r.total_tokens());
+        self.usd += r.usd;
+        match r.cost {
+            CostKind::Exact => self.exact_rows += 1,
+            CostKind::Estimated => self.estimated_rows += 1,
+            CostKind::Unpriced => self.unpriced_rows += 1,
+        }
+    }
+}
+
+/// One group of the report.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct CostGroupRow {
+    pub group: BTreeMap<String, String>,
+    #[serde(flatten)]
+    pub totals: CostTotals,
+}
+
+/// One cell of the context-bucket table.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct BucketRow {
+    pub source: String,
+    pub bucket: String,
+    pub turns: u64,
+    pub cache_read_tokens: u64,
+    pub usd: f64,
+}
+
+/// The whole report.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct CostReport {
+    pub group_by: Vec<String>,
+    pub since: Option<DateTime<Utc>>,
+    pub until: Option<DateTime<Utc>>,
+    pub project_filter: Option<String>,
+    pub sources: Vec<SourceStatus>,
+    pub groups: Vec<CostGroupRow>,
+    pub totals: CostTotals,
+    /// Turns per context-size bucket, per transcript source.
+    pub context_buckets: Vec<BucketRow>,
+    /// Plain statements about how the numbers were made.
+    pub notes: Vec<String>,
+}
+
+/// The filters of one report.
+#[derive(Debug, Clone, Default)]
+pub struct CostFilter {
+    pub since: Option<DateTime<Utc>>,
+    pub until: Option<DateTime<Utc>>,
+    /// Case-insensitive substring of the project name.
+    pub project: Option<String>,
+}
+
+impl CostFilter {
+    fn keeps(&self, r: &SpendRow, skipped_no_ts: &mut BTreeMap<CostSourceKind, u64>) -> bool {
+        if let Some(p) = &self.project {
+            if !r.project.to_lowercase().contains(&p.to_lowercase()) {
+                return false;
+            }
+        }
+        if self.since.is_some() || self.until.is_some() {
+            let Some(ts) = r.timestamp else {
+                *skipped_no_ts.entry(r.source).or_default() += 1;
+                return false;
+            };
+            if self.since.is_some_and(|s| ts < s) || self.until.is_some_and(|u| ts >= u) {
+                return false;
+            }
+        }
+        true
+    }
+}
+
+fn key_of(r: &SpendRow, d: CostGroup) -> String {
+    match d {
+        CostGroup::Day => r
+            .timestamp
+            .map(|t| t.format("%Y-%m-%d").to_string())
+            .unwrap_or_else(|| "unknown".to_string()),
+        CostGroup::Source => r.source.as_str().to_string(),
+        CostGroup::Model => {
+            if r.model.is_empty() {
+                "unknown".to_string()
+            } else {
+                r.model.clone()
+            }
+        }
+        CostGroup::Project => {
+            if r.project.is_empty() {
+                "unknown".to_string()
+            } else {
+                r.project.clone()
+            }
+        }
+        CostGroup::ContextBucket => r.bucket().to_string(),
+        CostGroup::OriginClass => r.origin_class.clone().unwrap_or_else(|| "n/a".to_string()),
+    }
+}
+
+/// Filter, group and total `rows`. `sources` is the scan status of each source
+/// (found or missing) and is carried into the report header.
+pub fn build_report(
+    rows: &[SpendRow],
+    mut sources: Vec<SourceStatus>,
+    group_by: &[CostGroup],
+    filter: &CostFilter,
+) -> CostReport {
+    let mut groups: BTreeMap<Vec<String>, CostTotals> = BTreeMap::new();
+    let mut totals = CostTotals::default();
+    let mut buckets: BTreeMap<(String, usize), BucketRow> = BTreeMap::new();
+    let mut skipped_no_ts: BTreeMap<CostSourceKind, u64> = BTreeMap::new();
+    for r in rows {
+        if !filter.keeps(r, &mut skipped_no_ts) {
+            continue;
+        }
+        let key: Vec<String> = group_by.iter().map(|d| key_of(r, *d)).collect();
+        groups.entry(key).or_default().add(r);
+        totals.add(r);
+        if r.is_turn {
+            let b = context_bucket(r.context_tokens());
+            let idx = CONTEXT_BUCKETS.iter().position(|x| *x == b).unwrap_or(0);
+            let e = buckets
+                .entry((r.source.as_str().to_string(), idx))
+                .or_insert_with(|| BucketRow {
+                    source: r.source.as_str().to_string(),
+                    bucket: b.to_string(),
+                    turns: 0,
+                    cache_read_tokens: 0,
+                    usd: 0.0,
+                });
+            e.turns += 1;
+            e.cache_read_tokens = e.cache_read_tokens.saturating_add(r.cache_read);
+            e.usd += r.usd;
+        }
+    }
+    for s in &mut sources {
+        let kind = [
+            CostSourceKind::TaGoal,
+            CostSourceKind::ClaudeCode,
+            CostSourceKind::Omp,
+        ]
+        .into_iter()
+        .find(|k| k.as_str() == s.source);
+        if let Some(n) = kind.and_then(|k| skipped_no_ts.get(&k)) {
+            s.no_timestamp_skipped = *n;
+        }
+    }
+    let names: Vec<String> = group_by.iter().map(|d| d.as_str().to_string()).collect();
+    let group_rows = groups
+        .into_iter()
+        .map(|(key, totals)| CostGroupRow {
+            group: names.iter().cloned().zip(key).collect(),
+            totals,
+        })
+        .collect();
+
+    let mut notes = Vec::new();
+    let dedup: u64 = sources.iter().map(|s| s.deduplicated).sum();
+    let synth: u64 = sources.iter().map(|s| s.synthetic_skipped).sum();
+    notes.push(format!(
+        "Claude Code rows are deduplicated by message id (last row wins): {dedup} repeated row(s) \
+         dropped, {synth} <synthetic> row(s) skipped."
+    ));
+    if totals.estimated_rows > 0 || totals.unpriced_rows > 0 {
+        notes.push(format!(
+            "{} row(s) are priced from the price table (estimates; override rates in \
+             .ta/pricing.toml), {} row(s) have exact costs reported by their source, {} row(s) \
+             have no price for their model (tokens counted, cost 0).",
+            totals.estimated_rows, totals.exact_rows, totals.unpriced_rows
+        ));
+    }
+    let no_ts: u64 = sources.iter().map(|s| s.no_timestamp_skipped).sum();
+    if no_ts > 0 {
+        notes.push(format!(
+            "{no_ts} row(s) without a timestamp were left out because --since/--until is set."
+        ));
+    }
+    CostReport {
+        group_by: names,
+        since: filter.since,
+        until: filter.until,
+        project_filter: filter.project.clone(),
+        sources,
+        groups: group_rows,
+        totals,
+        context_buckets: buckets.into_values().collect(),
+        notes,
+    }
+}
