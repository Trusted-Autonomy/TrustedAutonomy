+    #[test]
+    fn totals_match_an_independent_sum() {
+        let (_d, rows, sources) = fixture();
+        assert_eq!(sources[0].deduplicated, 1);
+        let report = build_report(&rows, sources, &[CostGroup::Source], &CostFilter::default());
+
+        // Independent arithmetic, written out by hand (Sonnet 5.5: 3 / 15 / 0.30 / 3.75).
+        // m1 (last row): 100 in, 9 out, 30,000 read.
+        let m1 = 100.0 / 1e6 * 3.0 + 9.0 / 1e6 * 15.0 + 30_000.0 / 1e6 * 0.30;
+        let m2 = 100.0 / 1e6 * 15.0 + 150_000.0 / 1e6 * 0.30;
+        let m3 = 100.0 / 1e6 * 15.0 + 400_000.0 / 1e6 * 0.30 + 100_000.0 / 1e6 * 3.75;
+        let claude = report
+            .groups
+            .iter()
+            .find(|g| g.group["source"] == "claude_code")
+            .unwrap();
+        assert!(
+            (claude.totals.usd - (m1 + m2 + m3)).abs() < 1e-9,
+            "{}",
+            claude.totals.usd
+        );
+        assert_eq!(claude.totals.turns, 3);
+        assert_eq!(claude.totals.output_tokens, 9 + 100 + 100);
+        assert_eq!(claude.totals.cache_read_tokens, 30_000 + 150_000 + 400_000);
+        assert_eq!(claude.totals.estimated_rows, 3);
+
+        let omp = report
+            .groups
+            .iter()
+            .find(|g| g.group["source"] == "omp")
+            .unwrap();
+        assert!((omp.totals.usd - 0.75).abs() < 1e-9);
+        assert_eq!(omp.totals.exact_rows, 2);
+
+        let sum: f64 = report.groups.iter().map(|g| g.totals.usd).sum();
+        assert!((report.totals.usd - sum).abs() < 1e-9);
+        assert!((report.totals.usd - (m1 + m2 + m3 + 0.75)).abs() < 1e-9);
+    }
