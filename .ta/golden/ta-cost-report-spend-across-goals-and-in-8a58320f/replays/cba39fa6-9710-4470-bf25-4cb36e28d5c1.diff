+//! `ta cost report`: spend across TA goals and interactive agent sessions.
+//!
+//! Reads, each source optional and auto-detected: the project's goal records,
+//! Claude Code transcripts (`~/.claude/projects`) and OMP transcripts
+//! (`~/.omp/agent/sessions`). The counting rules live in `ta_goal::cost_report`.
+
+use std::path::PathBuf;
+
+use anyhow::Context;
+use clap::Subcommand;
+use ta_goal::cost_report::{
+    build_report, goal_rows, parse_cost_group_by, scan_claude_dir, scan_omp_dir, CostFilter,
+    CostReport, SourceStatus,
+};
+use ta_goal::spend::parse_time_bound;
+use ta_goal::{GoalRunStore, PriceTable};
+use ta_mcp_gateway::GatewayConfig;
+
+#[derive(Debug, Subcommand)]
+pub enum CostCommands {
+    /// Report spend across TA goals, Claude Code sessions and OMP sessions.
+    ///
+    /// Sources found: this project's goals, `~/.claude/projects/**/*.jsonl` and
+    /// `~/.omp/agent/sessions/**/*.jsonl`. A missing source is reported, not an
+    /// error. Claude rows are deduplicated by message id. Costs are exact when
+    /// the source reported them and estimated from the price table otherwise
+    /// (`.ta/pricing.toml` overrides rates).
+    Report {
+        /// Only spend at or after this time (RFC 3339 or YYYY-MM-DD).
+        #[arg(long)]
+        since: Option<String>,
+        /// Only spend before this time (RFC 3339 or YYYY-MM-DD).
+        #[arg(long)]
+        until: Option<String>,
+        /// Group by a comma-separated list of: day, source, model, project,
+        /// context_bucket, origin_class.
+        #[arg(long, default_value = "source")]
+        group_by: String,
+        /// Only projects whose name contains this text (case-insensitive).
+        #[arg(long)]
+        project: Option<String>,
+        /// Print the report as JSON.
+        #[arg(long)]
+        json: bool,
+    },
+}
+
+pub fn execute(command: &CostCommands, config: &GatewayConfig) -> anyhow::Result<()> {
+    match command {
+        CostCommands::Report {
+            since,
+            until,
+            group_by,
+            project,
+            json,
+        } => {
+            let home = home_dir();
+            let sources = SourcePaths {
+                claude: home.as_ref().map(|h| h.join(".claude").join("projects")),
+                omp: home
+                    .as_ref()
+                    .map(|h| h.join(".omp").join("agent").join("sessions")),
+            };
+            let report = run_report(
+                config,
+                &sources,
+                since.as_deref(),
+                until.as_deref(),
+                group_by,
+                project.as_deref(),
+            )?;
+            if *json {
+                println!("{}", serde_json::to_string_pretty(&report)?);
+            } else {
+                print!("{}", render(&report));
+            }
+            Ok(())
+        }
+    }
+}
+
+fn home_dir() -> Option<PathBuf> {
+    std::env::var_os("HOME")
+        .or_else(|| std::env::var_os("USERPROFILE"))
+        .filter(|h| !h.is_empty())
+        .map(PathBuf::from)
+}
+
+/// Where the transcript sources live. `None` means the home directory is unknown.
+pub struct SourcePaths {
+    pub claude: Option<PathBuf>,
+    pub omp: Option<PathBuf>,
+}
+
+pub fn run_report(
+    config: &GatewayConfig,
+    sources: &SourcePaths,
+    since: Option<&str>,
+    until: Option<&str>,
+    group_by: &str,
+    project: Option<&str>,
+) -> anyhow::Result<CostReport> {
+    let group_by = parse_cost_group_by(group_by).map_err(anyhow::Error::msg)?;
+    let since = since
+        .map(parse_time_bound)
+        .transpose()
+        .map_err(|e| anyhow::anyhow!("--since: {e}"))?;
+    let until = until
+        .map(parse_time_bound)
+        .transpose()
+        .map_err(|e| anyhow::anyhow!("--until: {e}"))?;
+    if let (Some(s), Some(u)) = (since, until) {
+        anyhow::ensure!(
+            s < u,
+            "--since ({s}) must be before --until ({u}). Swap them or widen the range."
+        );
+    }
+    let table = PriceTable::load(&config.workspace_root);
+    let mut rows = Vec::new();
+    let mut statuses = Vec::new();
+
+    // TA goals: this project's goal records.
+    let project_name = config
+        .workspace_root
+        .file_name()
+        .map(|n| n.to_string_lossy().to_string())
+        .unwrap_or_else(|| "project".to_string());
+    let mut goal_status = SourceStatus {
+        source: "ta_goal".to_string(),
+        location: config.goals_dir.display().to_string(),
+        found: config.goals_dir.is_dir(),
+        ..SourceStatus::default()
+    };
+    if goal_status.found {
+        let goals = GoalRunStore::new(&config.goals_dir)
+            .and_then(|s| s.list())
+            .with_context(|| {
+                format!(
+                    "reading goal records from {}. Check the directory is readable, or run from \
+                     a project root that has a .ta directory",
+                    config.goals_dir.display()
+                )
+            })?;
+        let goals: Vec<_> = goals
+            .into_iter()
+            .map(|g| (project_name.clone(), g))
+            .collect();
+        goal_status.rows_read = goals.len() as u64;
+        goal_status.rows_counted = goals.len() as u64;
+        rows.extend(goal_rows(&goals));
+    }
+    statuses.push(goal_status);
+
+    for (dir, is_claude) in [(&sources.claude, true), (&sources.omp, false)] {
+        let name = if is_claude { "claude_code" } else { "omp" };
+        match dir {
+            Some(d) => {
+                let (r, st) = if is_claude {
+                    scan_claude_dir(d, &table)
+                } else {
+                    scan_omp_dir(d, &table)
+                };
+                rows.extend(r);
+                statuses.push(st);
+            }
+            None => statuses.push(SourceStatus {
+                source: name.to_string(),
+                location: "(home directory unknown: set HOME)".to_string(),
+                found: false,
+                ..SourceStatus::default()
+            }),
+        }
+    }
+    tracing::info!(
+        rows = rows.len(),
+        sources = statuses.iter().filter(|s| s.found).count(),
+        "cost report scanned"
+    );
+    let filter = CostFilter {
+        since,
+        until,
+        project: project.map(str::to_string),
+    };
+    Ok(build_report(&rows, statuses, &group_by, &filter))
+}
+
+fn thousands(n: u64) -> String {
+    let s = n.to_string();
+    let mut out = String::new();
+    for (i, c) in s.chars().enumerate() {
+        if i > 0 && (s.len() - i).is_multiple_of(3) {
+            out.push(',');
+        }
+        out.push(c);
+    }
+    out
+}
+
+/// The terminal report.
+pub fn render(r: &CostReport) -> String {
+    use std::fmt::Write;
+    let mut o = String::new();
+    let _ = writeln!(o, "Sources:");
+    for s in &r.sources {
+        if !s.found {
+            let _ = writeln!(o, "  {:<12} not found ({}); skipped", s.source, s.location);
+        } else if s.source == "ta_goal" {
+            let _ = writeln!(
+                o,
+                "  {:<12} {} goal(s) in {}",
+                s.source, s.rows_counted, s.location
+            );
+        } else {
+            let _ = writeln!(
+                o,
+                "  {:<12} {} file(s), {} row(s) read, {} counted, {} duplicate(s) dropped, {} synthetic skipped, {} unreadable ({})",
+                s.source, s.files, s.rows_read, s.rows_counted, s.deduplicated,
+                s.synthetic_skipped, s.unreadable_rows, s.location
+            );
+        }
+    }
+    if let (None, None) = (r.since, r.until) {
+    } else {
+        let f = |t: Option<chrono::DateTime<chrono::Utc>>| {
+            t.map(|t| t.format("%Y-%m-%d %H:%M").to_string())
+                .unwrap_or_else(|| "...".to_string())
+        };
+        let _ = writeln!(o, "Range: {} to {}", f(r.since), f(r.until));
+    }
+    if let Some(p) = &r.project_filter {
+        let _ = writeln!(o, "Project filter: {p}");
+    }
+    let _ = writeln!(o);
+    let label = if r.group_by.is_empty() {
+        "all".to_string()
+    } else {
+        r.group_by.join(" / ")
+    };
+    let _ = writeln!(
+        o,
+        "{:<34} {:>8} {:>6} {:>13} {:>13} {:>15} {:>13} {:>10}",
+        label, "turns", "goals", "input", "output", "cache read", "cache write", "cost USD"
+    );
+    for g in &r.groups {
+        let key = if g.group.is_empty() {
+            "all".to_string()
+        } else {
+            g.group.values().cloned().collect::<Vec<_>>().join(" / ")
+        };
+        let t = &g.totals;
+        let _ = writeln!(
+            o,
+            "{:<34} {:>8} {:>6} {:>13} {:>13} {:>15} {:>13} {:>10.2}{}",
+            key,
+            thousands(t.turns),
+            thousands(t.goals),
+            thousands(t.input_tokens),
+            thousands(t.output_tokens),
+            thousands(t.cache_read_tokens),
+            thousands(t.cache_write_tokens),
+            t.usd,
+            if t.estimated_rows > 0 { " ~" } else { "" }
+        );
+    }
+    let t = &r.totals;
+    let _ = writeln!(
+        o,
+        "{:<34} {:>8} {:>6} {:>13} {:>13} {:>15} {:>13} {:>10.2}",
+        "TOTAL",
+        thousands(t.turns),
+        thousands(t.goals),
+        thousands(t.input_tokens),
+        thousands(t.output_tokens),
+        thousands(t.cache_read_tokens),
+        thousands(t.cache_write_tokens),
+        t.usd
+    );
+    let _ = writeln!(o, "  (~ = includes costs estimated from the price table)");
+    if !r.context_buckets.is_empty() {
+        let _ = writeln!(o, "\nContext size per turn:");
+        let _ = writeln!(
+            o,
+            "{:<12} {:<10} {:>9} {:>16} {:>10}",
+            "source", "context", "turns", "cache read", "cost USD"
+        );
+        for b in &r.context_buckets {
+            let _ = writeln!(
+                o,
+                "{:<12} {:<10} {:>9} {:>16} {:>10.2}",
+                b.source,
+                b.bucket,
+                thousands(b.turns),
+                thousands(b.cache_read_tokens),
+                b.usd
+            );
+        }
+    }
+    let _ = writeln!(o);
+    for n in &r.notes {
+        let _ = writeln!(o, "Note: {n}");
+    }
+    o
+}
+
