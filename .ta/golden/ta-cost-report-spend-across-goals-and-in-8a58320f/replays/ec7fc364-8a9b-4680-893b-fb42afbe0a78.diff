+            concat!(
+                r#"{"type":"assistant","timestamp":"2026-10-01T10:00:00Z","cwd":"/w/alpha","message":{"id":"a","model":"claude-sonnet-5-5","usage":{"input_tokens":1,"output_tokens":10,"cache_read_input_tokens":450000,"cache_creation_input_tokens":0}}}"#,
+                "\n",
+                r#"{"type":"assistant","timestamp":"2026-10-01T10:00:01Z","cwd":"/w/alpha","message":{"id":"a","model":"claude-sonnet-5-5","usage":{"input_tokens":1,"output_tokens":20,"cache_read_input_tokens":450000,"cache_creation_input_tokens":0}}}"#,
