+// cost_report.rs: spend across TA goals and interactive agent sessions
+// (`ta cost report`, v0.17.12.18).
+//
+// `GET /api/spend` only sees TA goals, but the expensive workload is long
+// interactive Claude Code and OMP sessions. This module reads those transcripts
+// and puts them next to the goals in one report. Everything here is pure or
+// reads files only; printing lives in the CLI.
+//
+// Counting rules that matter for correctness:
+//   * Claude Code writes one transcript row per content block, so a streamed
+//     message repeats its `message.id`. Rows are de-duplicated by id, last row
+//     wins (the last row carries the final output count), across all files of
+//     one run. `<synthetic>` rows (client-generated, not API calls) are skipped.
+//   * OMP records usage and cost per message; its cost is used as reported.
+//   * A cost is `exact` when the runtime or OMP reported it, `estimated` when it
+//     was computed from a price table, and `unpriced` (0 USD, tokens still
+//     counted) for a model the table does not know. A price is never invented.
+//   * The context size of a turn is its whole prompt: uncached input plus cache
+//     read plus cache write.
+
+use std::collections::{BTreeMap, HashMap};
+use std::fs::File;
+use std::io::{BufRead, BufReader};
+use std::path::{Path, PathBuf};
+
+use chrono::{DateTime, Utc};
+use serde::{Deserialize, Serialize};
+
+use crate::goal_run::GoalRun;
+use crate::token_cost::{CostSource, PriceTable, TokenUsage};
+
+// ── Records ─────────────────────────────────────────────────────────────────
+
+/// Where a record was read from.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Source {
+    /// A TA goal record.
+    Goal,
+    /// A Claude Code session transcript.
+    Claude,
+    /// An OMP session transcript.
+    Omp,
+}
+
+impl Source {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Source::Goal => "ta_goal",
+            Source::Claude => "claude_code",
+            Source::Omp => "omp",
+        }
+    }
+}
+
+/// How trustworthy a record's cost is.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum CostKind {
+    /// Reported by the agent runtime or OMP.
+    Exact,
+    /// Computed from a price table.
+    Estimated,
+    /// No price for the model: 0 USD, tokens still counted.
+    Unpriced,
+}
+
+/// One priced unit of spend: an assistant turn of a transcript, or a whole goal.
+#[derive(Debug, Clone, PartialEq)]
+pub struct CostRecord {
+    pub source: Source,
+    pub project: String,
+    pub model: String,
+    pub timestamp: Option<DateTime<Utc>>,
+    pub usage: TokenUsage,
+    /// Part of `usage.cache_creation` written with the 1 hour TTL.
+    pub cache_write_1h: u64,
+    /// Prompt size of this turn. `None` for a goal (it spans many turns).
+    pub context_tokens: Option<u64>,
+    pub usd: f64,
+    pub kind: CostKind,
+    /// Origin class of a goal. `None` for transcripts.
+    pub origin_class: Option<String>,
+    /// Assistant turns this record stands for: 1 for a transcript turn, 0 for a goal.
+    pub turns: u64,
+    /// Goals this record stands for: 1 for a goal, 0 for a transcript turn.
+    pub goals: u64,
+}
+
+/// The context-size buckets, as (label, inclusive upper bound in tokens).
+pub const CONTEXT_BUCKETS: [(&str, u64); 5] = [
+    ("0-50k", 50_000),
+    ("50-100k", 100_000),
+    ("100-200k", 200_000),
+    ("200-400k", 400_000),
+    ("400k+", u64::MAX),
+];
+
+/// The bucket label for a prompt size.
+pub fn context_bucket(tokens: u64) -> &'static str {
+    CONTEXT_BUCKETS
+        .iter()
+        .find(|(_, hi)| tokens <= *hi)
+        .map(|(l, _)| *l)
+        .unwrap_or("400k+")
+}
+
+// ── Reading transcripts ─────────────────────────────────────────────────────
+
+/// What was found while reading one source directory.
+#[derive(Debug, Clone, Default, Serialize, Deserialize, PartialEq)]
+pub struct SourceStatus {
+    pub source: String,
+    /// The directory or store that was looked at.
+    pub location: String,
+    pub found: bool,
+    pub files: u64,
+    /// Records (turns or goals) read from it, before any time filter.
+    pub records: u64,
+    /// Why it is missing or partly unreadable, with what to do about it.
+    pub note: Option<String>,
+}
+
+/// Counters that explain how the numbers were made.
+#[derive(Debug, Clone, Default, Serialize, Deserialize, PartialEq)]
+pub struct ReadStats {
+    /// Assistant rows with usage seen in Claude Code transcripts.
+    pub claude_rows: u64,
+    /// Rows dropped because a later row had the same `message.id`.
+    pub duplicate_rows_collapsed: u64,
+    /// `<synthetic>` rows skipped.
+    pub synthetic_rows_skipped: u64,
+    /// Lines that were not valid JSON (a half-written last line, for example).
+    pub malformed_lines: u64,
+    /// Files that could not be opened.
+    pub unreadable_files: u64,
+}
+
+fn collect_jsonl(dir: &Path, out: &mut Vec<PathBuf>, unreadable: &mut u64) {
+    let entries = match std::fs::read_dir(dir) {
+        Ok(e) => e,
+        Err(e) => {
+            tracing::warn!(path = %dir.display(), error = %e, "could not read a transcript directory; check its permissions");
+            *unreadable += 1;
+            return;
+        }
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        // `file_type` does not follow symlinks, so a link cannot loop the walk.
+        let Ok(ft) = entry.file_type() else { continue };
+        if ft.is_dir() {
+            collect_jsonl(&path, out, unreadable);
+        } else if ft.is_file() && path.extension().is_some_and(|e| e == "jsonl") {
+            out.push(path);
+        }
+    }
+}
+
+/// Every `*.jsonl` under `dir`, sorted so reads are deterministic.
+fn jsonl_files(dir: &Path, unreadable: &mut u64) -> Vec<PathBuf> {
+    let mut files = Vec::new();
+    collect_jsonl(dir, &mut files, unreadable);
+    files.sort();
+    files
+}
+
+fn lines_of(path: &Path, stats: &mut ReadStats) -> Option<Vec<serde_json::Value>> {
+    let file = match File::open(path) {
+        Ok(f) => f,
+        Err(e) => {
+            tracing::warn!(path = %path.display(), error = %e, "could not open a transcript; check its permissions");
+            stats.unreadable_files += 1;
+            return None;
+        }
+    };
+    let mut rows = Vec::new();
+    for line in BufReader::new(file).lines() {
+        let Ok(line) = line else {
+            stats.malformed_lines += 1;
+            continue;
+        };
+        if line.trim().is_empty() {
+            continue;
+        }
+        match serde_json::from_str::<serde_json::Value>(&line) {
+            Ok(v) => rows.push(v),
+            Err(_) => stats.malformed_lines += 1,
+        }
+    }
+    Some(rows)
+}
+
+fn u64_at(v: &serde_json::Value, key: &str) -> u64 {
+    v.get(key).and_then(|x| x.as_u64()).unwrap_or(0)
+}
+
+fn project_of_cwd(cwd: &str) -> String {
+    Path::new(cwd)
+        .file_name()
+        .map(|n| n.to_string_lossy().into_owned())
+        .filter(|n| !n.is_empty())
+        .unwrap_or_else(|| cwd.to_string())
+}
+
+fn parse_ts(v: Option<&serde_json::Value>) -> Option<DateTime<Utc>> {
+    v.and_then(|t| t.as_str())
+        .and_then(|s| DateTime::parse_from_rfc3339(s).ok())
+        .map(|d| d.with_timezone(&Utc))
+}
+
+fn priced(table: &PriceTable, model: &str, usage: &TokenUsage, w1h: u64) -> (f64, CostKind) {
+    match table.price_split(model, usage, w1h) {
+        Some(usd) => (usd, CostKind::Estimated),
+        None => (0.0, CostKind::Unpriced),
+    }
+}
+
+/// Read Claude Code sessions under `dir` (`~/.claude/projects`).
+///
+/// Rows are de-duplicated by `message.id` across every file, last row wins; the
+/// surviving row keeps its own project, timestamp and usage.
+pub fn read_claude_sessions(
+    dir: &Path,
+    table: &PriceTable,
+    stats: &mut ReadStats,
+) -> (Vec<CostRecord>, SourceStatus) {
+    let mut status = SourceStatus {
+        source: Source::Claude.as_str().to_string(),
+        location: dir.display().to_string(),
+        ..Default::default()
+    };
+    if !dir.is_dir() {
+        status.note = Some(format!(
+            "{} does not exist. Claude Code sessions are not counted. Use --claude-dir to point \
+             at a different location.",
+            dir.display()
+        ));
+        return (Vec::new(), status);
+    }
+    status.found = true;
+    let files = jsonl_files(dir, &mut stats.unreadable_files);
+    let mut records: Vec<CostRecord> = Vec::new();
+    let mut by_id: HashMap<String, usize> = HashMap::new();
+    for path in &files {
+        let Some(rows) = lines_of(path, stats) else {
+            continue;
+        };
+        status.files += 1;
+        let fallback_project = path
+            .parent()
+            .and_then(|p| p.file_name())
+            .map(|n| n.to_string_lossy().into_owned())
+            .unwrap_or_default();
+        for row in rows {
+            if row.get("type").and_then(|t| t.as_str()) != Some("assistant") {
+                continue;
+            }
+            let Some(msg) = row.get("message") else {
+                continue;
+            };
+            let Some(u) = msg.get("usage").filter(|u| u.is_object()) else {
+                continue;
+            };
+            let model = msg.get("model").and_then(|m| m.as_str()).unwrap_or("");
+            if model == "<synthetic>" {
+                stats.synthetic_rows_skipped += 1;
+                continue;
+            }
+            stats.claude_rows += 1;
+            let usage = TokenUsage {
+                input: u64_at(u, "input_tokens"),
+                output: u64_at(u, "output_tokens"),
+                cache_read: u64_at(u, "cache_read_input_tokens"),
+                cache_creation: u64_at(u, "cache_creation_input_tokens"),
+            };
+            let w1h = u
+                .get("cache_creation")
+                .map(|c| u64_at(c, "ephemeral_1h_input_tokens"))
+                .unwrap_or(0)
+                .min(usage.cache_creation);
+            let (usd, kind) = priced(table, model, &usage, w1h);
+            let project = row
+                .get("cwd")
+                .and_then(|c| c.as_str())
+                .map(project_of_cwd)
+                .unwrap_or_else(|| fallback_project.clone());
+            let rec = CostRecord {
+                source: Source::Claude,
+                project,
+                model: if model.is_empty() {
+                    "unknown".to_string()
+                } else {
+                    model.to_string()
+                },
+                timestamp: parse_ts(row.get("timestamp")),
+                usage,
+                cache_write_1h: w1h,
+                context_tokens: Some(
+                    usage
+                        .input
+                        .saturating_add(usage.cache_read)
+                        .saturating_add(usage.cache_creation),
+                ),
+                usd,
+                kind,
+                origin_class: None,
+                turns: 1,
+                goals: 0,
+            };
+            match msg.get("id").and_then(|i| i.as_str()) {
+                Some(id) => match by_id.get(id) {
+                    Some(&idx) => {
+                        records[idx] = rec;
+                        stats.duplicate_rows_collapsed += 1;
+                    }
+                    None => {
+                        by_id.insert(id.to_string(), records.len());
+                        records.push(rec);
+                    }
+                },
+                // Nothing to de-duplicate on: count it once, as written.
+                None => records.push(rec),
+            }
+        }
+    }
+    status.records = records.len() as u64;
+    (records, status)
+}
+
+/// Read OMP sessions under `dir` (`~/.omp/agent/sessions`). OMP records the
+/// usage and the cost of every assistant message, and that cost is used as is.
+pub fn read_omp_sessions(
+    dir: &Path,
+    table: &PriceTable,
+    stats: &mut ReadStats,
+) -> (Vec<CostRecord>, SourceStatus) {
+    let mut status = SourceStatus {
+        source: Source::Omp.as_str().to_string(),
+        location: dir.display().to_string(),
+        ..Default::default()
+    };
+    if !dir.is_dir() {
+        status.note = Some(format!(
+            "{} does not exist. OMP sessions are not counted. Use --omp-dir to point at a \
+             different location.",
+            dir.display()
+        ));
+        return (Vec::new(), status);
+    }
+    status.found = true;
+    let mut records = Vec::new();
+    for path in jsonl_files(dir, &mut stats.unreadable_files) {
+        let Some(rows) = lines_of(&path, stats) else {
+            continue;
+        };
+        status.files += 1;
+        let mut project = path
+            .parent()
+            .and_then(|p| p.file_name())
+            .map(|n| n.to_string_lossy().into_owned())
+            .unwrap_or_default();
+        for row in rows {
+            match row.get("type").and_then(|t| t.as_str()) {
+                Some("session") => {
+                    if let Some(cwd) = row.get("cwd").and_then(|c| c.as_str()) {
+                        project = project_of_cwd(cwd);
+                    }
+                }
+                Some("message") => {
+                    let Some(msg) = row.get("message") else {
+                        continue;
+                    };
+                    if msg.get("role").and_then(|r| r.as_str()) != Some("assistant") {
+                        continue;
+                    }
+                    let Some(u) = msg.get("usage").filter(|u| u.is_object()) else {
+                        continue;
+                    };
+                    let model = msg.get("model").and_then(|m| m.as_str()).unwrap_or("");
+                    let usage = TokenUsage {
+                        input: u64_at(u, "input"),
+                        output: u64_at(u, "output"),
+                        cache_read: u64_at(u, "cacheRead"),
+                        cache_creation: u64_at(u, "cacheWrite"),
+                    };
+                    let w1h = u
+                        .get("cttl")
+                        .map(|c| u64_at(c, "ephemeral1h"))
+                        .unwrap_or(0)
+                        .min(usage.cache_creation);
+                    let reported = u
+                        .get("cost")
+                        .and_then(|c| c.get("total"))
+                        .and_then(|t| t.as_f64())
+                        .filter(|t| t.is_finite() && *t >= 0.0);
+                    let (usd, kind) = match reported {
+                        Some(t) => (t, CostKind::Exact),
+                        None => priced(table, model, &usage, w1h),
+                    };
+                    records.push(CostRecord {
+                        source: Source::Omp,
+                        project: project.clone(),
+                        model: if model.is_empty() {
+                            "unknown".to_string()
+                        } else {
+                            model.to_string()
+                        },
+                        timestamp: parse_ts(row.get("timestamp")),
+                        usage,
+                        cache_write_1h: w1h,
+                        context_tokens: Some(
+                            usage
+                                .input
+                                .saturating_add(usage.cache_read)
+                                .saturating_add(usage.cache_creation),
+                        ),
+                        usd,
+                        kind,
+                        origin_class: None,
+                        turns: 1,
+                        goals: 0,
+                    });
+                }
+                _ => {}
+            }
+        }
+    }
+    status.records = records.len() as u64;
+    (records, status)
+}
+
+/// One record per TA goal. `project` names the project the goals belong to.
+pub fn goal_records(project: &str, goals: &[GoalRun]) -> Vec<CostRecord> {
+    goals
+        .iter()
+        .map(|g| CostRecord {
+            source: Source::Goal,
+            project: project.to_string(),
+            model: if g.agent_model.is_empty() {
+                "unknown".to_string()
+            } else {
+                g.agent_model.clone()
+            },
+            timestamp: Some(g.created_at),
+            usage: g.token_usage(),
+            cache_write_1h: 0,
+            context_tokens: None,
+            usd: g.cost_usd,
+            kind: match g.cost_source {
+                CostSource::Runtime => CostKind::Exact,
+                CostSource::Table => CostKind::Estimated,
+                CostSource::None => CostKind::Unpriced,
+            },
+            origin_class: Some(g.effective_origin_class().to_string()),
+            turns: 0,
+            goals: 1,
+        })
+        .collect()
+}
+
+// ── Aggregation ─────────────────────────────────────────────────────────────
+
+/// A dimension to group the report by.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Dimension {
+    Day,
+    Source,
+    Model,
+    Project,
+    ContextBucket,
+    OriginClass,
+}
+
+impl Dimension {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Dimension::Day => "day",
+            Dimension::Source => "source",
+            Dimension::Model => "model",
+            Dimension::Project => "project",
+            Dimension::ContextBucket => "context_bucket",
+            Dimension::OriginClass => "origin_class",
+        }
+    }
+
+    fn key(self, r: &CostRecord) -> String {
+        match self {
+            Dimension::Day => r
+                .timestamp
+                .map(|t| t.format("%Y-%m-%d").to_string())
+                .unwrap_or_else(|| "undated".to_string()),
+            Dimension::Source => r.source.as_str().to_string(),
+            Dimension::Model => r.model.clone(),
+            Dimension::Project => r.project.clone(),
+            Dimension::ContextBucket => r
+                .context_tokens
+                .map(|c| context_bucket(c).to_string())
+                .unwrap_or_else(|| "n/a".to_string()),
+            Dimension::OriginClass => r.origin_class.clone().unwrap_or_else(|| "n/a".to_string()),
+        }
+    }
+}
+
+/// Parse `--group-by`: one or more of day, source, model, project,
+/// context_bucket, origin_class, comma separated. Unknown or repeated names
+/// are errors.
+pub fn parse_dimensions(s: &str) -> Result<Vec<Dimension>, String> {
+    let mut out = Vec::new();
+    for part in s.split(',').map(str::trim).filter(|p| !p.is_empty()) {
+        let d = match part {
+            "day" => Dimension::Day,
+            "source" => Dimension::Source,
+            "model" => Dimension::Model,
+            "project" => Dimension::Project,
+            "context_bucket" => Dimension::ContextBucket,
+            "origin_class" => Dimension::OriginClass,
+            other => {
+                return Err(format!(
+                    "unknown --group-by {other:?}: expected day, source, model, project, \
+                     context_bucket or origin_class (comma separated to combine, for example \
+                     --group-by source,model)"
+                ))
+            }
+        };
+        if out.contains(&d) {
+            return Err(format!(
+                "--group-by lists {part:?} twice; list each name once"
+            ));
+        }
+        out.push(d);
+    }
+    Ok(out)
+}
+
+/// Totals for one group.
+#[derive(Debug, Clone, Default, Serialize, Deserialize, PartialEq)]
+pub struct CostTotals {
+    pub turns: u64,
+    pub goals: u64,
+    pub input_tokens: u64,
+    pub output_tokens: u64,
+    pub cache_read_tokens: u64,
+    pub cache_write_tokens: u64,
+    /// Part of `cache_write_tokens` written with the 1 hour TTL.
+    pub cache_write_1h_tokens: u64,
+    pub usd: f64,
+    /// USD reported by the runtime or OMP.
+    pub exact_usd: f64,
+    /// USD computed from a price table.
+    pub estimated_usd: f64,
+    /// Records (turns or goals) by cost kind.
+    pub exact_records: u64,
+    pub estimated_records: u64,
+    pub unpriced_records: u64,
+}
+
+impl CostTotals {
+    fn add(&mut self, r: &CostRecord) {
+        self.turns += r.turns;
+        self.goals += r.goals;
+        self.input_tokens = self.input_tokens.saturating_add(r.usage.input);
+        self.output_tokens = self.output_tokens.saturating_add(r.usage.output);
+        self.cache_read_tokens = self.cache_read_tokens.saturating_add(r.usage.cache_read);
+        self.cache_write_tokens = self
+            .cache_write_tokens
+            .saturating_add(r.usage.cache_creation);
+        self.cache_write_1h_tokens = self.cache_write_1h_tokens.saturating_add(r.cache_write_1h);
+        self.usd += r.usd;
+        match r.kind {
+            CostKind::Exact => {
+                self.exact_usd += r.usd;
+                self.exact_records += 1;
+            }
+            CostKind::Estimated => {
+                self.estimated_usd += r.usd;
+                self.estimated_records += 1;
+            }
+            CostKind::Unpriced => self.unpriced_records += 1,
+        }
+    }
+
+    pub fn total_tokens(&self) -> u64 {
+        self.input_tokens
+            .saturating_add(self.output_tokens)
+            .saturating_add(self.cache_read_tokens)
+            .saturating_add(self.cache_write_tokens)
+    }
+}
+
+/// One row of the grouped table.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct GroupRow {
+    pub group: BTreeMap<String, String>,
+    #[serde(flatten)]
+    pub totals: CostTotals,
+}
+
+/// One row of the context-size table: transcript turns of one source in one bucket.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct BucketRow {
+    pub source: String,
+    pub bucket: String,
+    pub turns: u64,
+    pub cache_read_tokens: u64,
+    pub usd: f64,
+    /// Share of the source's transcript cost, 0 to 100. `0` when the source cost nothing.
+    pub usd_share_percent: f64,
+}
+
+/// The whole report.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct CostReport {
+    pub group_by: Vec<String>,
+    pub since: Option<DateTime<Utc>>,
+    pub until: Option<DateTime<Utc>>,
+    pub project_filter: Option<String>,
+    pub sources: Vec<SourceStatus>,
+    pub read: ReadStats,
+    pub groups: Vec<GroupRow>,
+    pub totals: CostTotals,
+    pub context_buckets: Vec<BucketRow>,
+    /// Models with no price, with the records that used them. Their tokens are
+    /// counted and their usd is 0; add a row to `.ta/pricing.toml` to price them.
+    pub unpriced_models: BTreeMap<String, u64>,
+    /// Records dropped by a time bound because they carry no timestamp.
+    pub undated_records_excluded: u64,
+    pub notes: Vec<String>,
+}
+
+/// Filters applied to the records before totalling.
+#[derive(Debug, Clone, Default)]
+pub struct Filter {
+    pub since: Option<DateTime<Utc>>,
+    pub until: Option<DateTime<Utc>>,
+    /// Matches a project name, case-insensitively.
+    pub project: Option<String>,
+}
+
+/// Group and total `records`. `group_by` empty means one group per source.
+pub fn build_report(
+    records: &[CostRecord],
+    sources: Vec<SourceStatus>,
+    read: ReadStats,
+    group_by: &[Dimension],
+    filter: &Filter,
+) -> CostReport {
+    let group_by: Vec<Dimension> = if group_by.is_empty() {
+        vec![Dimension::Source]
+    } else {
+        group_by.to_vec()
+    };
+    let bounded = filter.since.is_some() || filter.until.is_some();
+    let mut undated = 0u64;
+    let mut kept: Vec<&CostRecord> = Vec::new();
+    for r in records {
+        if let Some(p) = &filter.project {
+            if !r.project.eq_ignore_ascii_case(p) {
+                continue;
+            }
+        }
+        if bounded {
+            match r.timestamp {
+                Some(t) => {
+                    if filter.since.is_some_and(|s| t < s) || filter.until.is_some_and(|u| t >= u) {
+                        continue;
+                    }
+                }
+                None => {
+                    undated += 1;
+                    continue;
+                }
+            }
+        }
+        kept.push(r);
+    }
+
+    let mut rows: BTreeMap<Vec<String>, CostTotals> = BTreeMap::new();
+    let mut totals = CostTotals::default();
+    let mut unpriced_models: BTreeMap<String, u64> = BTreeMap::new();
+    let mut buckets: BTreeMap<(Source, usize), (u64, u64, f64)> = BTreeMap::new();
+    for r in &kept {
+        let key: Vec<String> = group_by.iter().map(|d| d.key(r)).collect();
+        rows.entry(key).or_default().add(r);
+        totals.add(r);
+        if r.kind == CostKind::Unpriced {
+            *unpriced_models.entry(r.model.clone()).or_default() += 1;
+        }
+        if let Some(c) = r.context_tokens {
+            let label = context_bucket(c);
+            let idx = CONTEXT_BUCKETS
+                .iter()
+                .position(|(l, _)| *l == label)
+                .unwrap_or(CONTEXT_BUCKETS.len() - 1);
+            let e = buckets.entry((r.source, idx)).or_default();
+            e.0 += r.turns;
+            e.1 = e.1.saturating_add(r.usage.cache_read);
+            e.2 += r.usd;
+        }
+    }
+    let mut source_usd: HashMap<Source, f64> = HashMap::new();
+    for ((s, _), (_, _, usd)) in &buckets {
+        *source_usd.entry(*s).or_default() += usd;
+    }
+    let mut bucket_rows = Vec::new();
+    for s in [Source::Claude, Source::Omp] {
+        if !buckets.keys().any(|(bs, _)| *bs == s) {
+            continue;
+        }
+        let total = source_usd.get(&s).copied().unwrap_or(0.0);
+        for (idx, (label, _)) in CONTEXT_BUCKETS.iter().enumerate() {
+            let (turns, cache_read, usd) = buckets.get(&(s, idx)).copied().unwrap_or_default();
+            bucket_rows.push(BucketRow {
+                source: s.as_str().to_string(),
+                bucket: (*label).to_string(),
+                turns,
+                cache_read_tokens: cache_read,
+                usd,
+                usd_share_percent: if total > 0.0 {
+                    usd / total * 100.0
+                } else {
+                    0.0
+                },
+            });
+        }
+    }
+
+    let names: Vec<String> = group_by.iter().map(|d| d.as_str().to_string()).collect();
+    let groups = rows
+        .into_iter()
+        .map(|(key, totals)| GroupRow {
+            group: names.iter().cloned().zip(key).collect(),
+            totals,
+        })
+        .collect();
+    CostReport {
+        group_by: names,
+        since: filter.since,
+        until: filter.until,
+        project_filter: filter.project.clone(),
+        sources,
+        read,
+        groups,
+        totals,
+        context_buckets: bucket_rows,
+        unpriced_models,
