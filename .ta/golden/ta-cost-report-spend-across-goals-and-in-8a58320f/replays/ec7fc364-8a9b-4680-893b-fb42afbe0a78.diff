+//! `ta cost report`: spend across TA goals and interactive agent sessions.
+//!
+//! Sources are auto-detected and each is optional: this project's TA goals,
+//! Claude Code sessions (`~/.claude/projects`) and OMP sessions
+//! (`~/.omp/agent/sessions`). A missing source is reported in the header, never
+//! an error. The counting rules live in `ta_goal::cost_report`.
+
+use std::path::PathBuf;
+
+use clap::Subcommand;
+use ta_goal::cost_report::{
+    build_report, goal_records, parse_dimensions, read_claude_sessions, read_omp_sessions,
+    CostReport, CostTotals, Filter, ReadStats, Source, SourceStatus,
+};
+use ta_goal::spend::parse_time_bound;
+use ta_goal::{GoalRunStore, PriceTable};
+use ta_mcp_gateway::GatewayConfig;
+
+#[derive(Debug, Subcommand)]
+pub enum CostCommands {
+    /// Report spend across TA goals, Claude Code sessions and OMP sessions.
+    ///
+    /// Shows which sources were found, totals grouped by `--group-by`, and a
+    /// table of turns, cache-read tokens and cost by context size.
+    Report {
+        /// Only records at or after this time (RFC 3339 or YYYY-MM-DD, UTC).
+        #[arg(long)]
+        since: Option<String>,
+        /// Only records before this time (RFC 3339 or YYYY-MM-DD, UTC).
+        #[arg(long)]
+        until: Option<String>,
+        /// Group by: day, source, model, project, context_bucket, origin_class.
+        /// Comma separated to combine. Default: source.
+        #[arg(long, default_value = "source")]
+        group_by: String,
+        /// Only this project (the directory name of the session's working
+        /// directory, or of this project for goals).
+        #[arg(long)]
+        project: Option<String>,
+        /// Claude Code sessions directory. Default: ~/.claude/projects.
+        #[arg(long)]
+        claude_dir: Option<PathBuf>,
+        /// OMP sessions directory. Default: ~/.omp/agent/sessions.
+        #[arg(long)]
+        omp_dir: Option<PathBuf>,
+        /// Output JSON instead of tables.
+        #[arg(long)]
+        json: bool,
+    },
+}
+
+pub fn execute(cmd: &CostCommands, config: &GatewayConfig) -> anyhow::Result<()> {
+    match cmd {
+        CostCommands::Report {
+            since,
+            until,
+            group_by,
+            project,
+            claude_dir,
+            omp_dir,
+            json,
+        } => {
+            let report = run_report(
+                config,
+                since.as_deref(),
+                until.as_deref(),
+                group_by,
+                project.clone(),
+                claude_dir.clone(),
+                omp_dir.clone(),
+            )?;
+            if *json {
+                println!("{}", serde_json::to_string_pretty(&report)?);
+            } else {
+                print!("{}", render(&report));
+            }
+            Ok(())
+        }
+    }
+}
+
+fn run_report(
+    config: &GatewayConfig,
+    since: Option<&str>,
+    until: Option<&str>,
+    group_by: &str,
+    project: Option<String>,
+    claude_dir: Option<PathBuf>,
+    omp_dir: Option<PathBuf>,
+) -> anyhow::Result<CostReport> {
+    let dims = parse_dimensions(group_by).map_err(anyhow::Error::msg)?;
+    let since = since
+        .map(parse_time_bound)
+        .transpose()
+        .map_err(|e| anyhow::anyhow!("--since: {e}"))?;
+    let until = until
+        .map(parse_time_bound)
+        .transpose()
+        .map_err(|e| anyhow::anyhow!("--until: {e}"))?;
+    if let (Some(s), Some(u)) = (since, until) {
+        if s >= u {
+            anyhow::bail!(
+                "--since {s} is not before --until {u}: the window is empty. Swap them or widen \
+                 the window."
+            );
+        }
+    }
+    let table = PriceTable::load(&config.workspace_root);
+    let home = std::env::var_os("HOME")
+        .or_else(|| std::env::var_os("USERPROFILE"))
+        .filter(|h| !h.is_empty())
+        .map(PathBuf::from);
+    let claude_dir = claude_dir
+        .or_else(|| home.as_ref().map(|h| h.join(".claude").join("projects")))
+        .unwrap_or_else(|| PathBuf::from(".claude/projects"));
+    let omp_dir = omp_dir
+        .or_else(|| {
+            home.as_ref()
+                .map(|h| h.join(".omp").join("agent").join("sessions"))
+        })
+        .unwrap_or_else(|| PathBuf::from(".omp/agent/sessions"));
+
+    let mut stats = ReadStats::default();
+    let mut records = Vec::new();
+    let mut sources = Vec::new();
+
+    // TA goals of this project.
+    let project_name = config
+        .workspace_root
+        .file_name()
+        .map(|n| n.to_string_lossy().into_owned())
+        .unwrap_or_else(|| "project".to_string());
+    let mut goal_status = SourceStatus {
+        source: Source::Goal.as_str().to_string(),
+        location: config.goals_dir.display().to_string(),
+        ..Default::default()
+    };
+    if config.goals_dir.is_dir() {
+        match GoalRunStore::new(&config.goals_dir).and_then(|s| s.list()) {
+            Ok(goals) => {
+                goal_status.found = true;
+                goal_status.records = goals.len() as u64;
+                goal_status.files = goals.len() as u64;
+                records.extend(goal_records(&project_name, &goals));
+            }
+            Err(e) => {
+                tracing::warn!(path = %config.goals_dir.display(), error = %e, "could not read TA goal records");
+                goal_status.note = Some(format!(
+                    "could not read the goal records: {e}. Goals are not counted. Check that \
+                     {} is readable.",
+                    config.goals_dir.display()
+                ));
+            }
+        }
+    } else {
+        goal_status.note = Some(format!(
+            "{} does not exist. Run this from a TA project to include its goals.",
+            config.goals_dir.display()
+        ));
+    }
+    sources.push(goal_status);
+
+    let (r, s) = read_claude_sessions(&claude_dir, &table, &mut stats);
+    records.extend(r);
+    sources.push(s);
+    let (r, s) = read_omp_sessions(&omp_dir, &table, &mut stats);
+    records.extend(r);
+    sources.push(s);
+
+    Ok(build_report(
+        &records,
+        sources,
+        stats,
+        &dims,
+        &Filter {
+            since,
+            until,
+            project,
+        },
+    ))
+}
+
+fn thousands(n: u64) -> String {
+    let s = n.to_string();
+    let mut out = String::new();
+    for (i, c) in s.chars().enumerate() {
+        if i > 0 && (s.len() - i).is_multiple_of(3) {
+            out.push(',');
+        }
+        out.push(c);
+    }
+    out
+}
+
+fn tokens_short(n: u64) -> String {
+    if n >= 1_000_000 {
+        format!("{:.1}M", n as f64 / 1_000_000.0)
+    } else if n >= 1_000 {
+        format!("{:.1}k", n as f64 / 1_000.0)
+    } else {
+        n.to_string()
+    }
+}
+
+fn cost_note(t: &CostTotals) -> String {
+    let mut parts = Vec::new();
+    if t.estimated_records > 0 {
+        parts.push(format!(
+            "${:.2} estimated ({} records)",
+            t.estimated_usd, t.estimated_records
+        ));
+    }
+    if t.exact_records > 0 {
+        parts.push(format!(
+            "${:.2} exact ({} records)",
+            t.exact_usd, t.exact_records
+        ));
+    }
+    if t.unpriced_records > 0 {
+        parts.push(format!(
+            "{} unpriced (no price for the model)",
+            t.unpriced_records
+        ));
+    }
+    parts.join(", ")
+}
+
+pub(crate) fn render(r: &CostReport) -> String {
+    let mut o = String::new();
+    o.push_str("Sources\n");
+    for s in &r.sources {
+        if s.found {
+            o.push_str(&format!(
+                "  [found]   {:<12} {} ({} files, {} records)\n",
+                s.source,
+                s.location,
+                thousands(s.files),
+                thousands(s.records)
+            ));
+        } else {
+            o.push_str(&format!(
+                "  [missing] {:<12} {}\n",
+                s.source,
+                s.note.as_deref().unwrap_or("not found")
+            ));
+        }
+        if s.found {
+            if let Some(n) = &s.note {
+                o.push_str(&format!("            {n}\n"));
+            }
+        }
+    }
+    o.push_str(&format!(
+        "Claude rows read: {}; duplicate rows collapsed: {}; synthetic rows skipped: {}; malformed lines: {}; unreadable files: {}\n",
+        thousands(r.read.claude_rows),
+        thousands(r.read.duplicate_rows_collapsed),
+        thousands(r.read.synthetic_rows_skipped),
+        thousands(r.read.malformed_lines),
+        thousands(r.read.unreadable_files),
+    ));
+    let window = match (r.since, r.until) {
+        (None, None) => "all time".to_string(),
+        (s, u) => format!(
+            "{} to {}",
+            s.map(|d| d.to_rfc3339()).unwrap_or_else(|| "start".into()),
+            u.map(|d| d.to_rfc3339()).unwrap_or_else(|| "now".into())
+        ),
+    };
+    o.push_str(&format!("Window: {window}"));
+    if let Some(p) = &r.project_filter {
+        o.push_str(&format!("; project: {p}"));
+    }
+    o.push('\n');
+    if r.undated_records_excluded > 0 {
+        o.push_str(&format!(
+            "{} records without a timestamp were excluded by the time window.\n",
+            r.undated_records_excluded
+        ));
+    }
+    let costs = cost_note(&r.totals);
+    if !costs.is_empty() {
+        o.push_str(&format!("Costs: {costs}\n"));
+    }
+
+    if !r.unpriced_models.is_empty() {
+        let list: Vec<String> = r
+            .unpriced_models
+            .iter()
+            .map(|(m, n)| format!("{m} ({})", thousands(*n)))
+            .collect();
+        o.push_str(&format!(
+            "Unpriced models (tokens counted, usd 0): {}. Add rows to .ta/pricing.toml to price them.\n",
+            list.join(", ")
+        ));
+    }
+
+    o.push_str(&format!("\nSpend by {}\n", r.group_by.join(", ")));
+    let key_w = r
+        .groups
+        .iter()
+        .map(|g| {
+            g.group
+                .values()
+                .cloned()
+                .collect::<Vec<_>>()
+                .join(" / ")
+                .len()
+        })
+        .max()
+        .unwrap_or(0)
+        .max(5);
+    o.push_str(&format!(
+        "  {:<key_w$} {:>8} {:>6} {:>9} {:>9} {:>9} {:>9} {:>11}\n",
+        "group", "turns", "goals", "input", "output", "cache rd", "cache wr", "usd"
+    ));
+    let line = |label: &str, t: &CostTotals| {
+        format!(
+            "  {:<key_w$} {:>8} {:>6} {:>9} {:>9} {:>9} {:>9} {:>11}\n",
+            label,
+            thousands(t.turns),
+            thousands(t.goals),
+            tokens_short(t.input_tokens),
+            tokens_short(t.output_tokens),
+            tokens_short(t.cache_read_tokens),
+            tokens_short(t.cache_write_tokens),
+            format!("${:.2}", t.usd)
+        )
+    };
+    for g in &r.groups {
+        let label = g.group.values().cloned().collect::<Vec<_>>().join(" / ");
+        o.push_str(&line(&label, &g.totals));
+    }
+    o.push_str(&line("TOTAL", &r.totals));
+
+    if !r.context_buckets.is_empty() {
+        o.push_str("\nBy context size (transcript turns; goals have no per-turn context)\n");
+        o.push_str(&format!(
+            "  {:<12} {:<9} {:>8} {:>10} {:>11} {:>7}\n",
+            "source", "context", "turns", "cache rd", "usd", "share"
+        ));
+        for b in &r.context_buckets {
+            o.push_str(&format!(
+                "  {:<12} {:<9} {:>8} {:>10} {:>11} {:>6.1}%\n",
+                b.source,
+                b.bucket,
+                thousands(b.turns),
+                tokens_short(b.cache_read_tokens),
+                format!("${:.2}", b.usd),
+                b.usd_share_percent
+            ));
+        }
+    }
+    o.push('\n');
+    for n in &r.notes {
+        o.push_str(&format!("Note: {n}\n"));
+    }
+    o
+}
+
