+/// Like [`price_with`], for a transcript that splits cache writes by TTL.
+/// `cache_write_1h` is the part of `usage.cache_creation` written with the
+/// 1 hour TTL (clamped to `cache_creation`); it is billed at
+/// [`ModelRate::cache_write_1h_per_m`] and the rest at the 5 minute rate.
+pub fn price_with_split(rate: &ModelRate, usage: &TokenUsage, cache_write_1h: u64) -> f64 {
+    let w1h = cache_write_1h.min(usage.cache_creation);
+    let w5m = usage.cache_creation - w1h;
     (usage.input as f64 / 1_000_000.0) * rate.input_per_m
         + (usage.output as f64 / 1_000_000.0) * rate.output_per_m
         + (usage.cache_read as f64 / 1_000_000.0) * rate.cache_read_per_m
-        + (usage.cache_creation as f64 / 1_000_000.0) * rate.cache_write_per_m
+        + (w5m as f64 / 1_000_000.0) * rate.cache_write_per_m
+        + (w1h as f64 / 1_000_000.0) * rate.cache_write_1h_per_m()
