+        .unwrap();
+        assert_eq!(rep.totals.turns, 1);
+        assert_eq!(rep.read.duplicate_rows_collapsed, 1);
+        let text = render(&rep);
+        assert!(text.contains("[found]   claude_code"), "{text}");
+        assert!(text.contains("[missing] omp"), "{text}");
+        assert!(text.contains("duplicate rows collapsed: 1"), "{text}");
+        assert!(text.contains("400k+"), "{text}");
+        assert!(text.contains("estimated"), "{text}");
+        let json = serde_json::to_value(&rep).unwrap();
+        assert_eq!(json["totals"]["turns"], 1);
+    }
+
+    #[test]
+    fn bad_flags_say_what_to_do() {
+        let d = tempdir().unwrap();
+        let c = config(d.path());
+        let e = run_report(&c, Some("yesterday"), None, "source", None, None, None).unwrap_err();
+        assert!(e.to_string().contains("--since"), "{e}");
+        let e = run_report(
+            &c,
+            Some("2026-10-05"),
+            Some("2026-10-01"),
+            "source",
+            None,
+            None,
+            None,
+        )
+        .unwrap_err();
+        assert!(e.to_string().contains("window is empty"), "{e}");
+        let e = run_report(&c, None, None, "nope", None, None, None).unwrap_err();
+        assert!(e.to_string().contains("context_bucket"), "{e}");
+    }
+}
