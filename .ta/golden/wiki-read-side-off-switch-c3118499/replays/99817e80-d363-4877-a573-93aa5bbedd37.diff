+/// `[wiki]` in `.ta/workflow.toml`: the read-side off switch.
+///
+/// ```toml
+/// [wiki]
+/// seed_context = false   # agents may not READ the wiki; writes still work
+/// ```
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct WikiConfig {
+    /// When false, wiki read tools (`ta_wiki_search`, `ta_wiki_get`,
+    /// `ta_wiki_types`) are refused. Default: true.
+    #[serde(default = "default_wiki_seed_context")]
+    pub seed_context: bool,
+}
+
+fn default_wiki_seed_context() -> bool {
+    true
+}
+
+impl Default for WikiConfig {
+    fn default() -> Self {
+        Self { seed_context: true }
+    }
+}
+
+impl WikiConfig {
+    /// Resolve `wiki.seed_context` for the project at `project_root`, using
+    /// the same loader (including `workflow.local.toml` overrides) as every
+    /// other section. A missing file, section or key means `true`; a value
+    /// that does not parse is an error naming the file and the key.
+    pub fn seed_context_enabled(project_root: &std::path::Path) -> Result<bool, String> {
+        let path = project_root.join(".ta").join("workflow.toml");
+        if !path.is_file() {
+            return Ok(true);
+        }
+        match WorkflowConfig::load(&path) {
+            Ok(cfg) => Ok(cfg.wiki.seed_context),
+            Err(e) => Err(format!(
+                "could not read [wiki] seed_context from {}: {e}. \
+                 `seed_context` must be true or false; fix the file and retry.",
+                path.display()
+            )),
+        }
+    }
+}
