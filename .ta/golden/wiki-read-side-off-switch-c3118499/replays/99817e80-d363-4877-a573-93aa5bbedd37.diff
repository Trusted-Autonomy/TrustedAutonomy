+/// Read-side off switch: `[wiki] seed_context = false` in
+/// `.ta/workflow.toml` refuses every wiki READ tool. Enforced here, in the
+/// handler, so it holds for goal agents and chat-mode CoS alike (both reach
+/// the wiki only through this gateway). Writes never call this: they stay
+/// reviewed-draft captures. Evaluated on every call so flipping the setting
+/// takes effect without restarting the gateway.
+fn require_wiki_reads_enabled(
+    state: &Arc<Mutex<GatewayState>>,
+    tool: &str,
+) -> Result<(), McpError> {
+    let project_root = state
+        .lock()
+        .map_err(|e| McpError::internal_error(format!("lock poisoned: {}", e), None))?
+        .config
+        .workspace_root
+        .clone();
+    let workflow_toml = project_root.join(".ta").join("workflow.toml");
+    match ta_submit::WikiConfig::seed_context_enabled(&project_root) {
+        Ok(true) => Ok(()),
+        Ok(false) => {
+            tracing::warn!(
+                tool,
+                file = %workflow_toml.display(),
+                "wiki read refused: [wiki] seed_context = false"
+            );
+            Err(McpError::invalid_request(
+                format!(
+                    "{tool}: wiki reads are turned off. `seed_context = false` under [wiki] in \
+                     {} stops agents from reading the wiki (writes via ta_wiki_create and \
+                     ta_wiki_update still work). To turn reads back on, set `seed_context = true` \
+                     or delete the key.",
+                    workflow_toml.display()
+                ),
+                None,
+            ))
+        }
+        Err(e) => {
+            tracing::error!(tool, error = %e, "wiki read refused: invalid [wiki] config");
+            Err(McpError::invalid_request(
+                format!("{tool}: wiki read refused, {e}"),
+                None,
+            ))
+        }
+    }
+}
