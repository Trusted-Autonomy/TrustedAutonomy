+        Ok(true) => None,
+        Ok(false) => Some(CheckResult::warn(
+            "wiki.seed_context",
+            format!(
+                "wiki reads are OFF ([wiki] seed_context = false in {}); \
+                 ta_wiki_search/get/types are refused, wiki writes still work",
+                file.display()
+            ),
+            "To allow wiki reads again, set seed_context = true under [wiki] in .ta/workflow.toml",
+        )),
+        Err(e) => Some(CheckResult::warn(
+            "wiki.seed_context",
+            e,
+            "Fix [wiki] seed_context in .ta/workflow.toml (true or false)",
+        )),
+    }
+}
