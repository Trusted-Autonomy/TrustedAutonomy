+/// `[wiki]` section of `.ta/workflow.toml`: the read-side off switch.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct WikiConfig {
+    /// When false, agents may not READ the wiki (search, get, types, cache,
+    /// context seeding). Wiki writes via draft review are unaffected.
+    /// Missing section or key means true.
+    #[serde(default = "default_true_wiki")]
+    pub seed_context: bool,
+}
+
+fn default_true_wiki() -> bool {
+    true
+}
+
+impl Default for WikiConfig {
+    fn default() -> Self {
+        Self { seed_context: true }
+    }
+}
+
+impl WikiConfig {
+    /// Whether wiki reads are allowed for the project at `project_root`.
+    ///
+    /// Reads `<project_root>/.ta/workflow.toml` through [`WorkflowConfig::load`]
+    /// (including `workflow.local.toml` overrides). A missing file means true.
+    /// A file that fails to parse (including a non-boolean `seed_context`) is an
+    /// error naming the file and key; callers must treat it as "refuse".
+    pub fn seed_context_enabled(project_root: &std::path::Path) -> Result<bool, String> {
+        let path = project_root.join(".ta").join("workflow.toml");
+        if !path.exists() {
+            return Ok(true);
+        }
+        WorkflowConfig::load(&path)
+            .map(|c| c.wiki.seed_context)
+            .map_err(|e| {
+                format!(
+                    "could not read {} while checking [wiki] seed_context (it must be true or \
+                     false): {e}. Fix the file and retry.",
+                    path.display()
+                )
+            })
+    }
+}
