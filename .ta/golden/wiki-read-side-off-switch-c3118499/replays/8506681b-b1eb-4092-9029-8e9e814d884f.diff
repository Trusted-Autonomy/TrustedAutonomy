+/// Read-side off switch: refuses a wiki READ when `[wiki] seed_context = false`
+/// in `.ta/workflow.toml`. Enforced here, in the handler, so it holds for every
+/// caller (goal agents and chat-mode CoS share this gateway). Writes never call
+/// this. An unreadable or malformed workflow.toml also refuses (fail closed),
+/// with an error naming the file and key.
+pub fn require_reads_enabled(state: &Arc<Mutex<GatewayState>>, tool: &str) -> Result<(), McpError> {
+    let project_root = state
+        .lock()
+        .map_err(|e| McpError::internal_error(format!("lock poisoned: {}", e), None))?
+        .config
+        .workspace_root
+        .clone();
+    match ta_submit::WikiConfig::seed_context_enabled(&project_root) {
+        Ok(true) => Ok(()),
+        Ok(false) => {
+            let file = project_root.join(".ta").join("workflow.toml");
+            tracing::warn!(tool, file = %file.display(), "wiki read refused: [wiki] seed_context = false");
+            Err(McpError::invalid_request(
+                format!(
+                    "{tool}: wiki reads are turned off for this project by `[wiki] seed_context = false` \
+                     in {}. Wiki writes (ta_wiki_create, ta_wiki_update) still work through draft \
+                     review. To allow reads again, set `seed_context = true` under [wiki] in that \
+                     file (or remove the key).",
+                    file.display()
+                ),
+                None,
+            ))
+        }
+        Err(msg) => {
+            tracing::warn!(tool, error = %msg, "wiki read refused: cannot determine [wiki] seed_context");
+            Err(McpError::invalid_request(format!("{tool}: {msg}"), None))
+        }
+    }
+}
