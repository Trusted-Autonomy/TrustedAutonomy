+/// `[wiki]` section of `.ta/workflow.toml`: the wiki read-side off switch.
+///
+/// ```toml
+/// [wiki]
+/// seed_context = false   # agents may not READ the wiki; writes still go through draft review
+/// ```
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct WikiConfig {
+    /// When `false`, wiki read tools (`ta_wiki_search`, `ta_wiki_get`,
+    /// `ta_wiki_types`) are refused by the gateway. Default `true`.
+    #[serde(default = "default_wiki_seed_context")]
+    pub seed_context: bool,
+}
+
+fn default_wiki_seed_context() -> bool {
+    true
+}
+
+impl Default for WikiConfig {
+    fn default() -> Self {
+        Self { seed_context: true }
+    }
+}
+
+impl WikiConfig {
+    /// Read `[wiki] seed_context` from the workflow.toml at `path` (with the
+    /// usual `workflow.local.toml` overlay, via [`WorkflowConfig::load`]).
+    ///
+    /// A missing file, section or key means `true`. A malformed file or value
+    /// is an error naming the file and the key, so callers can fail closed
+    /// with an actionable message.
+    pub fn seed_context_enabled(path: &std::path::Path) -> Result<bool, String> {
+        match WorkflowConfig::load(path) {
+            Ok(cfg) => Ok(cfg.wiki.seed_context),
+            Err(e) => {
+                let missing = e
+                    .downcast_ref::<std::io::Error>()
+                    .map(|io| io.kind() == std::io::ErrorKind::NotFound)
+                    .unwrap_or(false);
+                if missing {
+                    Ok(true)
+                } else {
+                    Err(format!(
+                        "could not read `[wiki] seed_context` from {}: {e}. \
+                         Fix the file so that `[wiki]` has `seed_context = true` or `seed_context = false`.",
+                        path.display()
+                    ))
+                }
+            }
+        }
+    }
+}
