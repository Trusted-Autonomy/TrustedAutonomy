+// ── Read-side off switch ─────────────────────────────────────────────────
+
+/// Refuses a wiki READ tool when `[wiki] seed_context = false` in
+/// `.ta/workflow.toml`. Enforced here in the gateway handler (not only in a
+/// prompt) so it also covers chat-mode CoS sessions, which share this server.
+/// A malformed setting fails closed with an error naming the file and key.
+/// Writes (`ta_wiki_create`/`ta_wiki_update`) never call this.
+pub fn require_wiki_reads_enabled(
+    state: &Arc<Mutex<GatewayState>>,
+    tool: &str,
+) -> Result<(), McpError> {
+    let workflow_toml = {
+        let locked = state
+            .lock()
+            .map_err(|e| McpError::internal_error(format!("lock poisoned: {}", e), None))?;
+        locked
+            .config
+            .workspace_root
+            .join(".ta")
+            .join("workflow.toml")
+    };
+    match ta_submit::WikiConfig::seed_context_enabled(&workflow_toml) {
+        Ok(true) => Ok(()),
+        Ok(false) => {
+            tracing::warn!(tool, path = %workflow_toml.display(), "wiki read refused: [wiki] seed_context = false");
+            Err(McpError::invalid_request(
+                format!(
+                    "{tool}: wiki reads are turned off. `[wiki] seed_context = false` in {}. \
+                     Wiki writes (ta_wiki_create/ta_wiki_update) still work. To allow reads again, \
+                     set `seed_context = true` under `[wiki]` in that file (or remove the line).",
+                    workflow_toml.display()
+                ),
+                None,
+            ))
+        }
+        Err(e) => {
+            tracing::error!(tool, error = %e, "wiki read refused: cannot read [wiki] seed_context");
+            Err(McpError::invalid_request(
+                format!("{tool}: wiki reads refused because the setting is unreadable. {e}"),
+                None,
+            ))
+        }
+    }
+}
