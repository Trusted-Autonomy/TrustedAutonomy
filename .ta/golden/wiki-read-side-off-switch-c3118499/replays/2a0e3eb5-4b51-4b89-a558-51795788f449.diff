+/// `[wiki] seed_context = false` makes the gateway refuse wiki reads. Say so
+/// (one line) so the owner can see why; silent when reads are on.
+fn check_wiki_seed_context(config: &GatewayConfig) -> Vec<CheckResult> {
+    let path = config.workspace_root.join(".ta").join("workflow.toml");
+    match ta_submit::WikiConfig::seed_context_enabled(&path) {
+        Ok(true) => Vec::new(),
+        Ok(false) => vec![CheckResult::warn(
+            "wiki reads",
+            format!(
+                "OFF: [wiki] seed_context = false in {} (agents cannot read the wiki; writes still work)",
+                path.display()
+            ),
+            "Set seed_context = true under [wiki] in .ta/workflow.toml to allow reads again",
+        )],
+        Err(e) => vec![CheckResult::warn(
+            "wiki reads",
+            format!("refused: {e}"),
+            "Fix [wiki] seed_context in .ta/workflow.toml",
+        )],
+    }
+}
