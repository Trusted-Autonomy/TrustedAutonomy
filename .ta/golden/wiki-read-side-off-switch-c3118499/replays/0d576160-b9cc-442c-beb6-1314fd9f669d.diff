-    }
-
-    let total_gb: f64 =
-        denied_goals.iter().map(|(_, _, b)| *b as f64).sum::<f64>() / (1024.0 * 1024.0 * 1024.0);
-    let list: Vec<String> = denied_goals
-        .iter()
-        .map(|(id, title, bytes)| {
