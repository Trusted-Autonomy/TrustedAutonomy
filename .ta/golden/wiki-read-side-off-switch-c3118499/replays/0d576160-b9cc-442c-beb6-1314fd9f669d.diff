+
+    let mut results = Vec::new();
+    let detection = ta_submit::detect_vcs(&config.workspace_root);
+    let vcs = detection.backend();
+
+    match &vcs {
+        VcsBackend::None => {
+            results.push(CheckResult::ok(
+                "VCS",
+                "none (skipping VCS checks)".to_string(),
+            ));
+            return results;
+        }
+        VcsBackend::Perforce => {
+            if std::env::var("P4IGNORE").is_err() {
+                results.push(CheckResult::warn(
+                    "VCS P4IGNORE",
+                    "P4IGNORE not set".to_string(),
+                    "export P4IGNORE=.p4ignore  then run: ta setup vcs",
+                ));
+            }
+        }
+        VcsBackend::Git | VcsBackend::Svn | VcsBackend::Plugin(_) => {}
+    }
+
+    results.push(CheckResult::ok("VCS", detection.summary()));
+
+    // Check VCS ignore coverage for .ta/ paths that exist on disk (VCS-agnostic).
+    for path in LOCAL_TA_PATHS {
+        let full = config
+            .workspace_root
+            .join(".ta")
+            .join(path.trim_end_matches('/'));
+        if full.exists() {
+            if let Ok(false) = vcs.is_path_ignored(&config.workspace_root, path) {
+                results.push(CheckResult::warn(
+                    "VCS ignore",
+                    format!(".ta/{} exists but is not ignored by {}", path, vcs.as_str()),
+                    "run: ta setup vcs  (refreshes the TA block in place; --force rewrites it)",
+                ));
+            }
+        }
+    }
+
+    results
+}
+
+fn check_gc(config: &GatewayConfig) -> Vec<CheckResult> {
+    let mut results = Vec::new();
+
+    // Staging and stuck drafts both come from the `ta cleanup` engine, so the
+    // warning, the fix and `ta cleanup` can never disagree, and one setting
+    // (`[gc] stale_threshold_days`) is the only threshold.
+    if config.workspace_root.join(".ta").join("staging").exists() {
+        match super::cleanup::findings(config, &[ta_cleanup::Category::Staging], false) {
+            Ok(found) => {
+                let stale = super::cleanup::actionable(found, &[ta_cleanup::Kind::Staging]);
+                if stale.is_empty() {
+                    results.push(CheckResult::ok("GC staging", "no stale dirs".to_string()));
+                } else {
+                    let bytes: u64 = stale.iter().map(|f| f.bytes).sum();
+                    let lines: Vec<String> = stale
+                        .iter()
+                        .flat_map(super::cleanup::explain_lines)
+                        .collect();
+                    results.push(CheckResult::warn(
+                        "GC staging",
+                        format!(
+                            "{} staging dir(s) can be cleaned ({})\n{}",
+                            stale.len(),
+                            ta_cleanup::scan::human_bytes(bytes),
+                            lines.join("\n")
+                        ),
+                        "Run: ta cleanup --only staging --dry-run, then ta cleanup --only staging",
+                    ));
+                }
+            }
+            Err(e) => results.push(CheckResult::warn(
+                "GC staging",
+                format!("could not scan staging: {e}"),
+                "Run: ta cleanup --only staging",
+            )),
+        }
+    }
+
+    if config.pr_packages_dir.exists() {
+        match super::cleanup::findings(config, &[ta_cleanup::Category::Drafts], true) {
+            Ok(found) => {
+                let stuck = super::cleanup::actionable(found, &[ta_cleanup::Kind::StuckDraft]);
+                if stuck.is_empty() {
+                    results.push(CheckResult::ok("Stale drafts", "none stuck".to_string()));
+                } else {
+                    let lines: Vec<String> = stuck
+                        .iter()
+                        .flat_map(super::cleanup::explain_lines)
+                        .collect();
+                    results.push(CheckResult::warn(
+                        "Stale drafts",
+                        format!(
+                            "{} draft(s) approved or pending but not applied\n{}",
+                            stuck.len(),
+                            lines.join("\n")
+                        ),
+                        "Run: ta cleanup (or the exact command shown for each draft)",
+                    ));
+                }
+            }
+            Err(e) => results.push(CheckResult::warn(
+                "Stale drafts",
+                format!("could not scan drafts: {e}"),
+                "Run: ta cleanup --only drafts",
+            )),
+        }
+    }
+
+    // events.jsonl size.
+    let events_file = config
+        .workspace_root
+        .join(".ta")
+        .join("events")
+        .join("events.jsonl");
+    if events_file.exists() {
+        let size_bytes = events_file.metadata().map(|m| m.len()).unwrap_or(0);
+        let size_mb = size_bytes as f64 / (1024.0 * 1024.0);
+        if size_bytes > 10 * 1024 * 1024 {
+            results.push(CheckResult::warn(
+                "GC events",
+                format!("{:.1} MB (>10 MB threshold)", size_mb),
+                "Run: ta gc --include-events",
+            ));
+        }
+    }
+
+    results
+}
+
+fn check_version_consistency(config: &GatewayConfig) -> Vec<CheckResult> {
+    use super::draft::{read_cargo_version, read_claude_md_version};
+    let mut results = Vec::new();
+    let cargo_ver = read_cargo_version(&config.workspace_root);
+    let claude_ver = read_claude_md_version(&config.workspace_root);
+    match (cargo_ver, claude_ver) {
+        (Some(ref cv), Some(ref mv)) if cv == mv => {
+            results.push(CheckResult::ok("Version", cv.clone()));
+        }
+        (Some(ref cv), Some(ref mv)) => {
+            results.push(CheckResult::fail(
+                "Version",
+                format!("Cargo.toml ({}) != CLAUDE.md ({})", cv, mv),
+                format!("Run from project root: ./scripts/bump-version.sh {}", cv),
+            ));
+        }
+        (Some(ref cv), None) => {
+            results.push(CheckResult::ok("Version", cv.clone()));
+        }
+        (None, _) => {
+            results.push(CheckResult::warn(
+                "Version",
+                "No version in Cargo.toml".to_string(),
+                String::new(),
+            ));
+        }
+    }
+    results
+}
