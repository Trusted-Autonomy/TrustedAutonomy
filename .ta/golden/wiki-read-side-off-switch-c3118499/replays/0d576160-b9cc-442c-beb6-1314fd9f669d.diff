-    };
-    let provider_name = ta_runtime::sandbox_launch::provider_name(&provider);
-    let detail = format!("provider {provider_name}\n{}", text.trim_end());
-    match balanced(RoleClass::Chat) {
-        Some(Outcome::Refused) => {
