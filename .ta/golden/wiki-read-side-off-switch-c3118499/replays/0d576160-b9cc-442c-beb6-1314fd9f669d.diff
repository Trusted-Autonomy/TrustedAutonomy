+/// Refuses a wiki READ when `[wiki] seed_context = false` in `.ta/workflow.toml`.
+///
+/// Called first in every read handler, so the refusal is enforced in the
+/// gateway rather than by prompt. Chat-mode CoS reads go through the same
+/// handlers, so they are covered too. Writes never call this.
+pub fn require_wiki_reads_enabled(
+    state: &Arc<Mutex<GatewayState>>,
+    tool: &str,
+) -> Result<(), McpError> {
+    let project_root = state
+        .lock()
+        .map_err(|e| McpError::internal_error(format!("lock poisoned: {}", e), None))?
+        .config
+        .workspace_root
+        .clone();
+    match ta_submit::config::wiki_seed_context_enabled(&project_root) {
+        Ok(true) => Ok(()),
+        Ok(false) => {
+            tracing::warn!(tool, project = %project_root.display(), "wiki read refused: [wiki] seed_context = false");
+            Err(McpError::invalid_request(
+                format!(
+                    "{tool}: wiki reads are turned off. `[wiki] seed_context = false` is set in {}. \
+                     Writes (ta_wiki_create, ta_wiki_update) still work through draft review. \
+                     To allow reads again, set `seed_context = true` under [wiki] in that file \
+                     (or delete the key).",
+                    project_root.join(".ta").join("workflow.toml").display()
+                ),
+                None,
+            ))
+        }
+        Err(e) => Err(McpError::invalid_request(format!("{tool}: {e}"), None)),
+    }
+}
+
+    require_wiki_reads_enabled(state, "ta_wiki_search")?;
