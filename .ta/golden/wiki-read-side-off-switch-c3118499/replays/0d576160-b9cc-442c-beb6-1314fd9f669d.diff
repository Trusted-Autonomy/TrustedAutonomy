+/// Whether agents may read the wiki for `project_root`, from `[wiki] seed_context`
+/// in `.ta/workflow.toml` (plus any `workflow.local.toml` override), read through
+/// [`WorkflowConfig::load`]. A missing file, section or key means `true`.
+///
+/// A file that exists but cannot be parsed, or holds a non-boolean value, is an
+/// error that names the file and the `wiki.seed_context` key.
+pub fn wiki_seed_context_enabled(project_root: &std::path::Path) -> Result<bool, String> {
+    let path = project_root.join(".ta").join("workflow.toml");
+    if !path.exists() {
+        return Ok(true);
+    }
+    WorkflowConfig::load(&path)
+        .map(|c| c.wiki.seed_context)
+        .map_err(|e| {
+            format!(
+                "could not read [wiki] seed_context from {} ({e}). \
+                 Fix the file: the key must be `seed_context = true` or `seed_context = false` \
+                 under a [wiki] section.",
+                path.display()
+            )
+        })
+}
