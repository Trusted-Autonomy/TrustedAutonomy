+/// `[wiki]` section of `.ta/workflow.toml`.
+///
+/// ```toml
+/// [wiki]
+/// seed_context = false   # default true
+/// ```
+///
+/// `seed_context = false` is a read-side switch only: the gateway refuses
+/// `ta_wiki_search`, `ta_wiki_get` and `ta_wiki_types` (including chat-mode
+/// reads). `ta_wiki_create` and `ta_wiki_update` keep working through draft
+/// review.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct WikiConfig {
+    /// Whether agents may read the wiki. Missing means true.
+    #[serde(default = "default_wiki_seed_context")]
+    pub seed_context: bool,
+}
+
+fn default_wiki_seed_context() -> bool {
+    true
+}
+
+impl Default for WikiConfig {
+    fn default() -> Self {
+        Self { seed_context: true }
+    }
+}
+
+impl WikiConfig {
+    /// Load `[wiki]` for the project rooted at `project_root`, reusing
+    /// [`WorkflowConfig::load`] (so `workflow.local.toml` overrides apply).
+    ///
+    /// A missing `.ta/workflow.toml`, `[wiki]` section or `seed_context` key
+    /// means `seed_context = true`. A file that cannot be parsed, or a
+    /// non-boolean `seed_context`, is an error naming the file and key, so a
+    /// caller that enforces the switch can fail closed instead of guessing.
+    pub fn load_for_project(project_root: &std::path::Path) -> Result<Self, String> {
+        let path = project_root.join(".ta").join("workflow.toml");
+        if !path.exists() {
+            return Ok(Self::default());
+        }
+        WorkflowConfig::load(&path).map(|c| c.wiki).map_err(|e| {
+            format!(
+                "could not read [wiki] seed_context from {}: {e}. \
+                     Fix the file so `[wiki] seed_context` is `true` or `false`.",
+                path.display()
+            )
+        })
+    }
+}
