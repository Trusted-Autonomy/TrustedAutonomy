+// ── Read-side off switch ─────────────────────────────────────────────────
+
+/// Refuses a wiki READ when `[wiki] seed_context = false` in the project's
+/// `.ta/workflow.toml`. Enforced in the handler (so it applies to every
+/// caller, chat mode included), not in a prompt. Writes never call this.
+///
+/// Fails closed: if the file cannot be parsed the read is refused with the
+/// parse error, because the owner's intent cannot be determined.
+fn require_wiki_reads_enabled(
+    state: &Arc<Mutex<GatewayState>>,
+    tool: &str,
+) -> Result<(), McpError> {
+    let project_root = state
+        .lock()
+        .map_err(|e| McpError::internal_error(format!("lock poisoned: {}", e), None))?
+        .config
+        .workspace_root
+        .clone();
+    let wiki = ta_submit::WikiConfig::load_for_project(&project_root)
+        .map_err(|e| McpError::invalid_request(format!("{tool}: wiki read refused: {e}"), None))?;
+    if wiki.seed_context {
+        return Ok(());
+    }
+    let path = project_root.join(".ta").join("workflow.toml");
+    tracing::warn!(tool, path = %path.display(), "wiki read refused: [wiki] seed_context = false");
+    Err(McpError::invalid_request(
+        format!(
+            "{tool}: wiki reads are turned off for this project. \
+             `[wiki] seed_context = false` is set in {}. Wiki writes \
+             (ta_wiki_create, ta_wiki_update) still work. To allow reads again, \
+             set `seed_context = true` under `[wiki]` in that file (or remove the line).",
+            path.display()
+        ),
+        None,
+    ))
+}
