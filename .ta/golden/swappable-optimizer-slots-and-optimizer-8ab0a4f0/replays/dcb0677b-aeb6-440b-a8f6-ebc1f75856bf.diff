+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+use crate::{OptError, Registry, Slot};
+
+/// Override keys look like `optimizers.input.use`.
+pub const OVERRIDE_PREFIX: &str = "optimizers.";
+pub const SLOTS: [Slot; 3] = Slot::ALL;
+
+/// `[optimizers.<slot>]` in `daemon.toml`.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct SlotConfig {
+    /// Optimizer name. Absent means the slot default.
+    #[serde(rename = "use", skip_serializing_if = "Option::is_none")]
+    pub use_: Option<String>,
+}
+
+/// The `[optimizers]` table.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct OptimizersConfig {
+    pub input: SlotConfig,
+    pub context: SlotConfig,
+    pub output: SlotConfig,
+}
+
+impl OptimizersConfig {
+    pub fn configured(&self) -> [Option<&str>; 3] {
+        [
+            self.input.use_.as_deref(),
+            self.context.use_.as_deref(),
+            self.output.use_.as_deref(),
+        ]
+    }
+}
+
+/// The name chosen for one slot and where the choice came from.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SlotChoice {
+    pub name: String,
+    pub from_override: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Selection {
+    pub input: SlotChoice,
+    pub context: SlotChoice,
+    pub output: SlotChoice,
+}
+
+impl Selection {
+    pub fn get(&self, slot: Slot) -> &SlotChoice {
+        match slot {
+            Slot::Input => &self.input,
+            Slot::Context => &self.context,
+            Slot::Output => &self.output,
+        }
+    }
+}
+
+fn parse_key(key: &str) -> Result<Option<Slot>, OptError> {
+    let Some(rest) = key.strip_prefix(OVERRIDE_PREFIX) else {
+        return Ok(None);
+    };
+    rest.strip_suffix(".use")
+        .and_then(Slot::parse)
+        .map(Some)
+        .ok_or_else(|| OptError::BadKey {
+            key: key.to_string(),
+        })
+}
+
+/// Check every `optimizers.*` key in a replay's override object before
+/// anything is launched. Keys outside `optimizers.` are not ours and are ignored.
+pub fn validate_overrides(overrides: &Value, registry: &Registry) -> Result<(), OptError> {
+    let Some(map) = overrides.as_object() else {
+        return Ok(());
+    };
+    for (key, value) in map {
+        let Some(slot) = parse_key(key)? else {
+            continue;
+        };
+        let name = value.as_str().ok_or_else(|| OptError::BadValue {
+            slot: slot.to_string(),
+            got: value.to_string(),
+        })?;
+        registry.get(slot, name)?;
+    }
+    Ok(())
+}
+
+/// Resolve each slot: a goal's override wins over `configured`, which wins
+/// over `defaults`. `configured` and `defaults` are `[input, context, output]`.
+pub fn resolve_selection(
+    configured: [Option<&str>; 3],
+    defaults: [&str; 3],
+    overrides: Option<&Value>,
+    registry: &Registry,
+) -> Result<Selection, OptError> {
+    let mut choices = Vec::with_capacity(3);
+    for (i, slot) in Slot::ALL.into_iter().enumerate() {
+        let key = format!("{OVERRIDE_PREFIX}{slot}.use");
+        let overridden = overrides.and_then(|o| o.get(&key));
+        let (name, from_override) = match overridden {
+            Some(v) => (
+                v.as_str()
+                    .ok_or_else(|| OptError::BadValue {
+                        slot: slot.to_string(),
+                        got: v.to_string(),
+                    })?
+                    .to_string(),
+                true,
+            ),
+            None => (configured[i].unwrap_or(defaults[i]).to_string(), false),
+        };
+        registry.get(slot, &name)?;
+        choices.push(SlotChoice {
+            name,
+            from_override,
+        });
+    }
+    let output = choices.pop().unwrap();
+    let context = choices.pop().unwrap();
+    let input = choices.pop().unwrap();
+    Ok(Selection {
+        input,
+        context,
+        output,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn reg() -> Registry {
+        Registry::with_builtins()
+    }
+
+    #[test]
+    fn override_beats_config_beats_default() {
+        let o = json!({"optimizers.input.use": "none"});
+        let s = resolve_selection(
+            [Some("rtk"), None, None],
+            ["headroom", "none", "none"],
+            Some(&o),
+            &reg(),
+        )
+        .unwrap();
+        assert_eq!(s.input.name, "none");
+        assert!(s.input.from_override);
+
+        let s = resolve_selection(
+            [Some("rtk"), None, None],
+            ["headroom", "none", "none"],
+            None,
+            &reg(),
+        )
+        .unwrap();
+        assert_eq!(s.input.name, "rtk");
+        assert!(!s.input.from_override);
+
+        let s = resolve_selection([None; 3], ["headroom", "none", "none"], None, &reg()).unwrap();
+        assert_eq!(s.input.name, "headroom");
+        assert_eq!(s.get(Slot::Output).name, "none");
+    }
+
+    #[test]
+    fn replay_values_none_rtk_headroom_all_validate() {
+        for v in ["none", "rtk", "headroom"] {
+            validate_overrides(&json!({"optimizers.input.use": v}), &reg()).unwrap();
+        }
+    }
+
+    #[test]
+    fn unknown_names_keys_and_types_are_refused_with_the_valid_choices() {
+        let e = validate_overrides(&json!({"optimizers.input.use": "zip"}), &reg())
+            .unwrap_err()
+            .to_string();
+        assert!(
+            e.contains("zip") && e.contains("headroom") && e.contains("rtk"),
+            "{e}"
+        );
+        // rtk is an input-slot starter only.
+        assert!(validate_overrides(&json!({"optimizers.output.use": "rtk"}), &reg()).is_err());
+        assert!(validate_overrides(&json!({"optimizers.inputs.use": "none"}), &reg()).is_err());
+        assert!(validate_overrides(&json!({"optimizers.input.use": 3}), &reg()).is_err());
+        // Not ours: ignored.
+        validate_overrides(&json!({"wiki.disabled": true}), &reg()).unwrap();
+    }
+}
