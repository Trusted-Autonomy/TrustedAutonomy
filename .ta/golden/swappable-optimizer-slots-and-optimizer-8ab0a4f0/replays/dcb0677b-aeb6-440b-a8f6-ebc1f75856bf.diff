+/// Record why the optimizer last failed, keeping the rest of the status as is.
+fn record_failure(dir: &Path, reason: String) {
+    let Some(mut status) = read_status_file(dir) else {
+        return;
+    };
+    status.last_failure = Some(format!("{} ({})", reason, chrono::Utc::now().to_rfc3339()));
+    if let Ok(json) = serde_json::to_string_pretty(&status) {
+        if let Err(e) = std::fs::write(dir.join("status.json"), json) {
+            tracing::warn!(
+                path = %dir.display(),
+                error = %e,
+                "PromptOptimizerSupervisor: failed to record last failure"
+            );
+        }
+    }
+}
