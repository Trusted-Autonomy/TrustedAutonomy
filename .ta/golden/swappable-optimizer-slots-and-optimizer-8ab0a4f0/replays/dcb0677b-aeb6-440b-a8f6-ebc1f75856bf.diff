+use std::path::{Path, PathBuf};
+use std::time::Instant;
+
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+use crate::{OptError, Optimized, Optimizer, Slot};
+
+/// One application of an optimizer.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct Metrics {
+    pub slot: Slot,
+    pub optimizer: String,
+    pub bytes_in: u64,
+    pub bytes_out: u64,
+    pub est_tokens_in: u64,
+    pub est_tokens_out: u64,
+    pub ms: u64,
+    pub lossless: bool,
+    /// Content hash of the unmodified input, resolvable with [`OriginalStore::recover`].
+    pub original_ref: String,
+}
+
+/// Rough token estimate (about 4 bytes per token). It is an estimate for
+/// comparing optimizers, never a billing figure.
+pub fn est_tokens(bytes: u64) -> u64 {
+    bytes.div_ceil(4)
+}
+
+/// Full originals kept on disk, content addressed, so a reduction can always be undone.
+pub struct OriginalStore {
+    dir: PathBuf,
+}
+
+impl OriginalStore {
+    pub fn new(dir: impl Into<PathBuf>) -> Self {
+        Self { dir: dir.into() }
+    }
+
+    pub fn dir(&self) -> &Path {
+        &self.dir
+    }
+
+    pub fn save(&self, original: &[u8]) -> Result<String, OptError> {
+        let hash = format!("{:x}", Sha256::digest(original));
+        let store_err = |source| OptError::Store {
+            path: self.dir.display().to_string(),
+            source,
+        };
+        std::fs::create_dir_all(&self.dir).map_err(store_err)?;
+        let path = self.dir.join(&hash);
+        if !path.exists() {
+            std::fs::write(&path, original).map_err(store_err)?;
+        }
+        Ok(hash)
+    }
+
+    pub fn recover(&self, original_ref: &str) -> Result<Vec<u8>, OptError> {
+        // A ref is a hex digest. Anything else could be a path escape.
+        if original_ref.is_empty() || !original_ref.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err(OptError::MissingOriginal(original_ref.to_string()));
+        }
+        std::fs::read(self.dir.join(original_ref))
+            .map_err(|_| OptError::MissingOriginal(original_ref.to_string()))
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Applied {
+    pub output: Vec<u8>,
+    pub metrics: Metrics,
+}
+
+/// Run `optimizer` on `input`, keeping the original first. If the optimizer
+/// fails, the error is returned and the original is still on disk.
+pub fn apply_with_metrics(
+    slot: Slot,
+    optimizer: &dyn Optimizer,
+    store: &OriginalStore,
+    input: &[u8],
+) -> Result<Applied, OptError> {
+    let original_ref = store.save(input)?;
+    let started = Instant::now();
+    let Optimized { bytes, lossless } = optimizer.apply(input)?;
+    let ms = started.elapsed().as_millis() as u64;
+    let (bytes_in, bytes_out) = (input.len() as u64, bytes.len() as u64);
+    Ok(Applied {
+        metrics: Metrics {
+            slot,
+            optimizer: optimizer.name().to_string(),
+            bytes_in,
+            bytes_out,
+            est_tokens_in: est_tokens(bytes_in),
+            est_tokens_out: est_tokens(bytes_out),
+            ms,
+            lossless,
+            original_ref,
+        },
+        output: bytes,
+    })
+}
