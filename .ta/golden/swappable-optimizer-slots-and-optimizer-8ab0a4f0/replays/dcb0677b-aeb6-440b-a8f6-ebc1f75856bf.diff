+/// Selected optimizer per slot, with the licence recorded for each.
+fn print_optimizer_slots(workspace_root: &Path, cfg: &CompressionConfig) {
+    let registry = ta_context_opt::Registry::with_builtins();
+    let optimizers = load_optimizers(workspace_root);
+    let default_input = if !cfg.enabled {
+        "none"
+    } else if cfg.plugin.is_some() {
+        "proxy"
+    } else {
+        "headroom"
+    };
+    println!("  Optimizer slots:");
+    match ta_context_opt::resolve_selection(
+        optimizers.configured(),
+        [default_input, "none", "none"],
+        None,
+        &registry,
+    ) {
+        Ok(sel) => {
+            for slot in ta_context_opt::Slot::ALL {
+                let name = &sel.get(slot).name;
+                let info = registry
+                    .infos()
+                    .into_iter()
+                    .find(|i| i.slot == slot && &i.name == name);
+                match info {
+                    Some(i) => println!(
+                        "    {:<8} {} ({}, licence {})",
+                        slot,
+                        i.name,
+                        i.kind.as_str(),
+                        i.licence
+                    ),
+                    None => println!("    {:<8} {}", slot, name),
+                }
+            }
+        }
+        Err(e) => println!("    ⚠ {e}"),
+    }
+}
+
+fn load_optimizers(workspace_root: &Path) -> ta_context_opt::OptimizersConfig {
+    #[derive(serde::Deserialize, Default)]
+    #[serde(default)]
+    struct File {
+        optimizers: ta_context_opt::OptimizersConfig,
+    }
+    std::fs::read_to_string(workspace_root.join(".ta").join("daemon.toml"))
+        .ok()
+        .and_then(|raw| toml::from_str::<File>(&raw).ok())
+        .map(|f| f.optimizers)
+        .unwrap_or_default()
+}
