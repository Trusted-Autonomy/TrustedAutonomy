+/// Build the optimizer command. Returns the creation flags that were requested
+/// alongside it: `std::process::Command` cannot be asked for its flags back, so
+/// the value is returned for a test to assert. They are applied only on Windows;
+/// other platforms have no console window to suppress.
+fn build_command(plugin: &PromptOptimizerPluginConfig) -> (tokio::process::Command, u32) {
+    let mut cmd = tokio::process::Command::new(&plugin.command);
+    cmd.args(&plugin.args)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .kill_on_drop(true);
+    for (k, v) in &plugin.env {
