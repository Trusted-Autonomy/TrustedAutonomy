+use std::collections::BTreeMap;
+use std::sync::Arc;
+
+use serde::{Deserialize, Serialize};
+
+use crate::{OptError, Optimized, Optimizer, Slot};
+
+/// How an optimizer runs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Kind {
+    /// A supervised child process.
+    Process,
+    /// An HTTP proxy on `ANTHROPIC_BASE_URL` (the former `[compression.plugin]`).
+    Proxy,
+    /// A hook that rewrites tool calls.
+    Hook,
+    InProcess,
+}
+
+impl Kind {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Kind::Process => "process",
+            Kind::Proxy => "proxy",
+            Kind::Hook => "hook",
+            Kind::InProcess => "in_process",
+        }
+    }
+}
+
+/// What `ta compression status` shows for one registered optimizer.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct OptimizerInfo {
+    pub slot: Slot,
+    pub name: String,
+    pub kind: Kind,
+    pub licence: String,
+}
+
+/// An external tool TA does not run inside this crate. Applying it here is a
+/// pass-through: the real work happens in the supervised process, proxy or
+/// hook. Registering it makes the name selectable and its licence recorded.
+struct External {
+    name: &'static str,
+    kind: Kind,
+    licence: &'static str,
+}
+
+impl Optimizer for External {
+    fn name(&self) -> &str {
+        self.name
+    }
+    fn kind(&self) -> Kind {
+        self.kind
+    }
+    fn licence(&self) -> &str {
+        self.licence
+    }
+    fn apply(&self, input: &[u8]) -> Result<Optimized, OptError> {
+        Ok(Optimized {
+            bytes: input.to_vec(),
+            lossless: true,
+        })
+    }
+}
+
+/// Optimizers by slot and name.
+pub struct Registry {
+    entries: BTreeMap<(Slot, String), Arc<dyn Optimizer>>,
+}
+
+impl Registry {
+    pub fn empty() -> Self {
+        Self {
+            entries: BTreeMap::new(),
+        }
+    }
+
+    /// `none` for every slot, plus the input-slot starters: `proxy` (any
+    /// `[compression.plugin]`), `headroom` and `rtk`.
+    pub fn with_builtins() -> Self {
+        let mut r = Self::empty();
+        for slot in Slot::ALL {
+            r.register(slot, Arc::new(crate::NoneOptimizer));
+        }
+        for (name, kind, licence) in [
+            ("proxy", Kind::Proxy, "per plugin"),
+            ("headroom", Kind::Proxy, "Apache-2.0"),
+            ("rtk", Kind::Hook, "Apache-2.0"),
+        ] {
+            r.register(
+                Slot::Input,
+                Arc::new(External {
+                    name,
+                    kind,
+                    licence,
+                }),
+            );
+        }
+        r
+    }
+
+    pub fn register(&mut self, slot: Slot, optimizer: Arc<dyn Optimizer>) {
+        self.entries
+            .insert((slot, optimizer.name().to_string()), optimizer);
+    }
+
+    pub fn get(&self, slot: Slot, name: &str) -> Result<Arc<dyn Optimizer>, OptError> {
+        self.entries
+            .get(&(slot, name.to_string()))
+            .cloned()
+            .ok_or_else(|| OptError::UnknownOptimizer {
+                slot,
+                name: name.to_string(),
+                available: self.names(slot).join(", "),
+            })
+    }
+
+    pub fn names(&self, slot: Slot) -> Vec<String> {
+        self.entries
+            .keys()
+            .filter(|(s, _)| *s == slot)
+            .map(|(_, n)| n.clone())
+            .collect()
+    }
+
+    pub fn infos(&self) -> Vec<OptimizerInfo> {
+        self.entries
+            .iter()
+            .map(|((slot, name), o)| OptimizerInfo {
+                slot: *slot,
+                name: name.clone(),
+                kind: o.kind(),
+                licence: o.licence().to_string(),
+            })
+            .collect()
+    }
+}
