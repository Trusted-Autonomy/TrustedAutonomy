+//! Swappable optimizer slots (v0.17.12.21).
+//!
+//! Input, context and output optimization each sit behind one trait. An
+//! implementation is picked per slot by name (`[optimizers.input] use = "rtk"`),
+//! can be overridden per golden replay (`--set optimizers.input.use=none`), and
+//! `none` is always valid and is the baseline for every comparison.
+//!
+//! Every application records a [`Metrics`] record and keeps the full original
+//! on disk ([`OriginalStore`]) so any reduction is reversible and auditable.
+
+mod metrics;
+mod registry;
+mod select;
+
+pub use metrics::{apply_with_metrics, est_tokens, Applied, Metrics, OriginalStore};
+pub use registry::{Kind, OptimizerInfo, Registry};
+pub use select::{
+    resolve_selection, validate_overrides, OptimizersConfig, Selection, SlotChoice, SlotConfig,
+    OVERRIDE_PREFIX, SLOTS,
+};
+
+use serde::{Deserialize, Serialize};
+
+/// The three places an optimizer can act.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Slot {
+    /// Tool and command output, files and logs before they enter context.
+    Input,
+    /// The accumulated conversation (compaction, eviction, prefix).
+    Context,
+    /// What the model writes (terse replies, edit format).
+    Output,
+}
+
+impl Slot {
+    pub const ALL: [Slot; 3] = [Slot::Input, Slot::Context, Slot::Output];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Slot::Input => "input",
+            Slot::Context => "context",
+            Slot::Output => "output",
+        }
+    }
+
+    pub fn parse(s: &str) -> Option<Slot> {
+        Slot::ALL.into_iter().find(|slot| slot.as_str() == s)
+    }
+}
+
+impl std::fmt::Display for Slot {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(self.as_str())
+    }
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum OptError {
+    #[error(
+        "unknown optimizer '{name}' for the {slot} slot. Available: {available}. \
+         Set it with `[optimizers.{slot}] use = \"<name>\"` in .ta/daemon.toml"
+    )]
+    UnknownOptimizer {
+        slot: Slot,
+        name: String,
+        available: String,
+    },
+    #[error(
+        "'{key}' is not an optimizer setting. Expected optimizers.<input|context|output>.use \
+         (for example optimizers.input.use=none)"
+    )]
+    BadKey { key: String },
+    #[error("optimizers.{slot}.use must be a string such as \"none\", got {got}")]
+    BadValue { slot: String, got: String },
+    #[error("optimizer '{name}' failed on the {slot} slot: {reason}")]
+    Failed {
+        slot: Slot,
+        name: String,
+        reason: String,
+    },
+    #[error("original store at {path}: {source}. Check the directory exists and is writable")]
+    Store {
+        path: String,
+        #[source]
+        source: std::io::Error,
+    },
+    #[error("no stored original for reference '{0}'. Run `ls` on the originals directory to see what is kept")]
+    MissingOriginal(String),
+}
+
+/// What an optimizer returns. `lossless` is the optimizer's own claim that
+/// `bytes` can be turned back into the input exactly.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Optimized {
+    pub bytes: Vec<u8>,
+    pub lossless: bool,
+}
+
+/// Common contract. The three slot traits add nothing but a type, so the
+/// compiler stops an output optimizer being wired into the input slot.
+pub trait Optimizer: Send + Sync {
+    fn name(&self) -> &str;
+    fn version(&self) -> &str {
+        env!("CARGO_PKG_VERSION")
+    }
+    fn kind(&self) -> Kind;
+    /// Recorded licence (SPDX), shown by `ta compression status`.
+    fn licence(&self) -> &str;
+    /// Cheap probe. Must never start a visible window.
+    fn available(&self) -> bool {
+        true
+    }
+    fn apply(&self, input: &[u8]) -> Result<Optimized, OptError>;
+}
+
+pub trait InputOptimizer: Optimizer {}
+pub trait ContextOptimizer: Optimizer {}
+pub trait OutputOptimizer: Optimizer {}
+
+/// The baseline: returns its input unchanged, for any slot.
+#[derive(Debug, Default, Clone, Copy)]
+pub struct NoneOptimizer;
+
+impl Optimizer for NoneOptimizer {
+    fn name(&self) -> &str {
+        "none"
+    }
+    fn kind(&self) -> Kind {
+        Kind::InProcess
+    }
+    fn licence(&self) -> &str {
+        "Apache-2.0"
+    }
+    fn apply(&self, input: &[u8]) -> Result<Optimized, OptError> {
+        Ok(Optimized {
+            bytes: input.to_vec(),
+            lossless: true,
+        })
+    }
+}
+
+impl InputOptimizer for NoneOptimizer {}
+impl ContextOptimizer for NoneOptimizer {}
