+
+/// Look up `optimizers.<slot>.use` in a goal's experiment overrides. Accepts
+/// the flat key `"optimizers.input.use"` that `ta golden replay --set` writes
+/// and the nested `{"optimizers": {"input": {"use": ...}}}` form.
+fn override_for(slot: Slot, overrides: Option<&serde_json::Value>) -> Option<String> {
+    let o = overrides?;
+    let flat = format!("optimizers.{}.use", slot.as_str());
+    let v = o
+        .get(&flat)
+        .or_else(|| o.get("optimizers")?.get(slot.as_str())?.get("use"))?;
+    v.as_str().map(|s| s.trim().to_string())
