+use std::path::{Path, PathBuf};
+
+use sha2::{Digest, Sha256};
+
+use crate::OptError;
+
+/// Content-addressed store of unmodified originals, so any reduction can be
+/// reversed. The key is the SHA-256 of the content; saving the same text twice
+/// is a no-op.
+#[derive(Debug, Clone)]
+pub struct OriginalStore {
+    dir: PathBuf,
+}
+
+impl OriginalStore {
+    pub fn new(dir: impl Into<PathBuf>) -> Self {
+        Self { dir: dir.into() }
+    }
+
+    pub fn dir(&self) -> &Path {
+        &self.dir
+    }
+
+    /// Save `content` and return its reference.
+    pub fn save(&self, content: &str) -> Result<String, OptError> {
+        let key = format!("{:x}", Sha256::digest(content.as_bytes()));
+        let path = self.dir.join(&key);
+        let io = |source| OptError::Store {
+            path: path.display().to_string(),
+            source,
+        };
+        std::fs::create_dir_all(&self.dir).map_err(io)?;
+        if !path.exists() {
+            std::fs::write(&path, content).map_err(io)?;
+        }
+        Ok(key)
+    }
+
+    /// Load the original behind `original_ref`.
+    pub fn load(&self, original_ref: &str) -> Result<String, OptError> {
+        // Keys are hex digests; reject anything else so a crafted reference
+        // cannot walk out of the store directory.
+        if original_ref.len() != 64 || !original_ref.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err(OptError::BadRef(original_ref.to_string()));
+        }
+        let path = self.dir.join(original_ref);
+        std::fs::read_to_string(&path).map_err(|source| OptError::Store {
+            path: path.display().to_string(),
+            source,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn save_then_load_round_trips_and_dedupes() {
+        let dir = tempfile::tempdir().unwrap();
+        let store = OriginalStore::new(dir.path().join("originals"));
+        let a = store.save("hello\nworld").unwrap();
+        let b = store.save("hello\nworld").unwrap();
+        assert_eq!(a, b);
+        assert_eq!(store.load(&a).unwrap(), "hello\nworld");
+        assert_eq!(std::fs::read_dir(store.dir()).unwrap().count(), 1);
+    }
+
+    #[test]
+    fn load_rejects_path_traversal() {
+        let dir = tempfile::tempdir().unwrap();
+        let store = OriginalStore::new(dir.path());
+        assert!(matches!(
+            store.load("../../etc/passwd"),
+            Err(OptError::BadRef(_))
+        ));
+    }
+}
