+/// Pick the optimizer for `slot`: override, then config, then default.
+/// Fails, naming the valid choices, when the name is not registered.
+pub fn resolve_selection(
+    registry: &Registry,
+    slot: Slot,
+    config: &OptimizersConfig,
+    overrides: Option<&serde_json::Value>,
+) -> Result<Selection, UnknownOptimizer> {
+    let (name, source) = if let Some(n) = override_for(slot, overrides).filter(|n| !n.is_empty()) {
+        (n, SelectionSource::Override)
+    } else if let Some(n) = config.slot(slot).filter(|n| !n.trim().is_empty()) {
+        (n.trim().to_string(), SelectionSource::Config)
+    } else {
