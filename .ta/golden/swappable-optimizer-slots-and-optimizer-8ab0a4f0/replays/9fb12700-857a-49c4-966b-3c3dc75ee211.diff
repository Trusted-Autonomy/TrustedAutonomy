+/// Spawn optimizer probes without a console window on Windows.
+fn quiet(cmd: &mut std::process::Command) -> &mut std::process::Command {
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        cmd.creation_flags(ta_context_opt::no_window_flags(false));
+    }
+    cmd
+}
+
+struct DaemonTomlOptimizers {
+    optimizers: ta_context_opt::OptimizersConfig,
+}
+
+fn load_optimizers(workspace_root: &Path) -> ta_context_opt::OptimizersConfig {
+    std::fs::read_to_string(workspace_root.join(".ta").join("daemon.toml"))
+        .ok()
+        .and_then(|c| toml::from_str::<DaemonTomlOptimizers>(&c).ok())
+        .map(|p| p.optimizers)
+        .unwrap_or_default()
+}
+
+/// Print each slot's selection with kind, licence and availability.
+fn print_slots(workspace_root: &Path) {
+    let registry = ta_context_opt::Registry::with_builtins();
+    let cfg = load_optimizers(workspace_root);
+    println!("  Optimizer slots:");
+    for slot in ta_context_opt::Slot::ALL {
+        match ta_context_opt::resolve_selection(&registry, slot, &cfg, None) {
+            Ok(sel) => {
+                let info = registry
+                    .get(slot, &sel.name)
+                    .map(|o| (o.info(), o.available()));
+                match info {
+                    Some((i, avail)) => println!(
+                        "    {:<8} {} ({}, licence {}, {})",
+                        slot,
+                        i.name,
+                        i.kind.as_str(),
+                        i.licence,
+                        if avail { "available" } else { "not installed" }
+                    ),
+                    None => println!("    {:<8} {}", slot, sel.name),
+                }
+            }
+            Err(e) => println!("    {:<8} INVALID: {e}", slot),
+        }
+    }
+}
+
+#[derive(Debug, Default, serde::Deserialize)]
+#[serde(default)]
+    #[serde(default)]
+    pub last_failure: Option<String>,
+    #[serde(default)]
+    pub last_failure_at: Option<String>,
+
+    #[test]
+    fn load_optimizers_reads_use_key_and_defaults_when_absent() {
+        let dir = tempfile::tempdir().unwrap();
+        assert_eq!(load_optimizers(dir.path()), Default::default());
+        std::fs::create_dir_all(dir.path().join(".ta")).unwrap();
+        std::fs::write(
+            dir.path().join(".ta/daemon.toml"),
+            "[optimizers.input]\nuse = \"rtk\"\n",
+        )
+        .unwrap();
+        let cfg = load_optimizers(dir.path());
+        assert_eq!(cfg.slot(ta_context_opt::Slot::Input), Some("rtk"));
+    }
+
+    #[test]
+    fn status_file_carries_last_failure() {
+        let f: OptimizerStatusFile = serde_json::from_str(
+            r#"{"status":"suspended","restart_count":5,"last_failure":"boom","last_failure_at":"t"}"#,
+        )
+        .unwrap();
+        assert_eq!(f.last_failure.as_deref(), Some("boom"));
+        assert_eq!(f.restart_count, 5);
+    }
