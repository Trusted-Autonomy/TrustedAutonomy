+    };
+    if registry.get(slot, &name).is_none() {
+        return Err(UnknownOptimizer {
+            slot,
+            valid: registry.names(slot),
+            name,
+            source,
+        });
+    }
+    Ok(Selection { slot, name, source })
+}
