+//! Process-creation flags for optimizer subprocesses.
+//!
+//! On Windows a console child opens a visible window, and a supervised
+//! optimizer that restarts would flash one each time. Every optimizer process
+//! is spawned with `CREATE_NO_WINDOW`. The flag is a plain constant so a test
+//! can assert it on every platform; it is only applied under `cfg(windows)`.
+
+/// `CREATE_NO_WINDOW` from the Win32 process-creation flags.
+pub const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+/// `DETACHED_PROCESS` from the Win32 process-creation flags.
+pub const DETACHED_PROCESS: u32 = 0x0000_0008;
+
+/// Creation flags for an optimizer process. Daemon-kind (long-running,
+/// supervised) processes are also detached from the parent console.
+pub fn no_window_flags(daemon: bool) -> u32 {
+    if daemon {
+        CREATE_NO_WINDOW | DETACHED_PROCESS
+    } else {
+        CREATE_NO_WINDOW
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn flags_match_win32_values() {
+        assert_eq!(CREATE_NO_WINDOW, 0x08000000);
+        assert_eq!(no_window_flags(false), CREATE_NO_WINDOW);
+        assert_eq!(no_window_flags(true) & CREATE_NO_WINDOW, CREATE_NO_WINDOW);
+        assert_eq!(no_window_flags(true) & DETACHED_PROCESS, DETACHED_PROCESS);
+    }
+}
