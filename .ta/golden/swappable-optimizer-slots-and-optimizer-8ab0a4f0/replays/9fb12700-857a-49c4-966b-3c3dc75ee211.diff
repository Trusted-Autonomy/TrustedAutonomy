+++ b/crates/ta-context-opt/src/lib.rs
+//! Swappable optimizer slots (input, context, output).
+//!
+//! Every optimizer implements one contract so the golden set can compare any
+//! of them against `none`, the always-valid baseline:
+//!
+//! - [`Optimizer::info`] reports name, version, kind and licence.
+//! - [`Optimizer::available`] is a cheap probe that never starts a process.
+//! - [`Optimizer::apply`] returns the output plus a [`Metrics`] record. Any
+//!   lossy reduction keeps the full original on disk ([`OriginalStore`]) and
+//!   points at it with `original_ref`, so it is reversible and auditable.
+//!
+//! Selection is per slot (`[optimizers.input] use = "rtk"`) and can be
+//! overridden for one goal with the experiment override
+//! `optimizers.input.use` (see [`resolve_selection`]).
+
+mod metrics;
+mod registry;
+mod selection;
+mod spawn;
+mod store;
+
+pub use metrics::{est_tokens, Applied, Metrics};
+pub use registry::{
+    ContextOptimizer, ExternalOptimizer, InputOptimizer, NoneOptimizer, Optimizer, OptimizerInfo,
+    OptimizerKind, OutputOptimizer, Registry,
+};
+pub use selection::{
+    resolve_selection, OptimizersConfig, Selection, SelectionSource, SlotConfig, UnknownOptimizer,
+};
+pub use spawn::{no_window_flags, CREATE_NO_WINDOW, DETACHED_PROCESS};
+pub use store::OriginalStore;
+
+use serde::{Deserialize, Serialize};
+
+/// The three places an optimizer can act.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Slot {
+    /// Tool and command output, files and logs before they enter context.
+    Input,
+    /// The accumulated conversation (compaction, eviction).
+    Context,
+    /// What the model writes (terse replies, edit format).
+    Output,
+}
+
+impl Slot {
+    pub const ALL: [Slot; 3] = [Slot::Input, Slot::Context, Slot::Output];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Slot::Input => "input",
+            Slot::Context => "context",
+            Slot::Output => "output",
+        }
+    }
+}
+
+impl std::fmt::Display for Slot {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(self.as_str())
+    }
+}
+
+/// Errors from applying an optimizer.
+#[derive(Debug, thiserror::Error)]
+pub enum OptError {
+    #[error(
+        "optimizer '{0}' runs outside this process (proxy or hook), so it has no in-process apply(); \
+         its savings are measured by the golden-set replay (`ta golden report`), not here"
+    )]
+    OutOfProcess(String),
+    #[error("could not read or write the original store at {path}: {source}. Check the directory exists and is writable.")]
+    Store {
+        path: String,
+        source: std::io::Error,
+    },
+    #[error("original reference '{0}' is not a valid reference (expected 64 hex characters)")]
+    BadRef(String),
+}
