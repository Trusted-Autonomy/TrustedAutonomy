-            if let Err(e) = f.write_all(entry.as_bytes()) {
-                tracing::warn!(
-                    goal_id = %goal_id,
-                    label = label,
-                    "append_progress_journal: write failed: {}",
-                    e
-                );
-            }
-        }
-        Err(e) => {
-            tracing::warn!(
-                goal_id = %goal_id,
-                label = label,
-                "append_progress_journal: open failed: {}",
