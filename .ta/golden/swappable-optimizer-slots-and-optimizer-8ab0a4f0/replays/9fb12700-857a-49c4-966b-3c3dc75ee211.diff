+/// Simple shell quoting for display purposes.
+fn shell_quote(s: &str) -> String {
+    if s.contains(' ') || s.contains('\n') {
+        format!("\"{}\"", s.replace('\"', "\\\""))
+    } else {
+        s.to_string()
+    }
+}
