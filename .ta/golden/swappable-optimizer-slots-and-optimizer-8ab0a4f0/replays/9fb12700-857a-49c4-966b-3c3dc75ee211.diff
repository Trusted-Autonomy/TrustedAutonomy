+/// Whether the input slot's proxy may be used for this goal. A per-goal
+/// override (`ta golden replay --set optimizers.input.use=none`) wins over
+/// `[optimizers.input]`. Only `headroom` (the proxy kind) routes the agent
+/// through `ANTHROPIC_BASE_URL`; `none` and the hook-kind `rtk` do not. An
+/// unknown name is a warning and keeps the configured behaviour, naming the
+/// valid choices.
+fn input_slot_allows_proxy(
+    project_root: &std::path::Path,
+    overrides: Option<&serde_json::Value>,
+) -> bool {
+    let registry = ta_context_opt::Registry::with_builtins();
+    let cfg = load_optimizers_section(project_root);
+    match ta_context_opt::resolve_selection(&registry, ta_context_opt::Slot::Input, &cfg, overrides)
+    {
+        Ok(sel) => {
+            if sel.source == ta_context_opt::SelectionSource::Override {
+                tracing::info!(
+                    optimizer = %sel.name,
+                    "Input optimizer selected by experiment override"
+                );
+            }
+            sel.name == "headroom"
+        }
+        Err(e) => {
+            tracing::warn!(error = %e, "Ignoring invalid optimizer selection; using the configured compression behaviour");
+            eprintln!("Warning: {e}");
+            true
+        }
+    }
+}
+
+/// Load the `[compression]` section from `project_root/.ta/daemon.toml`.
+fn load_compression_section(project_root: &std::path::Path) -> CompressionSection {
+    let path = project_root.join(".ta").join("daemon.toml");
+    if let Ok(content) = std::fs::read_to_string(&path) {
+        if let Ok(parsed) = toml::from_str::<DaemonTomlCompression>(&content) {
+            return parsed.compression;
+        }
+    }
+    CompressionSection::default()
+}
+
+/// Return the headroom proxy URL (as `ANTHROPIC_BASE_URL`) if compression is
+/// enabled for this agent AND the headroom proxy is currently running.
+fn compression_base_url(project_root: &std::path::Path, agent_name: &str) -> Option<String> {
+    let cfg = load_compression_section(project_root);
+
+    if !cfg.enabled {
+        return None;
+    }
+
+    // Per-agent check: on by default for claude-code, off for everything else.
+    let agent_on = cfg
+        .per_agent
+        .get(agent_name)
+        .copied()
+        .unwrap_or(agent_name == "claude-code");
+    if !agent_on {
+        return None;
+    }
+
+    // Only inject if the compression proxy appears to be running (read status file).
+    let status_path = project_root
+        .join(".ta")
+        .join("compression")
+        .join("status.json");
+    if let Ok(raw) = std::fs::read_to_string(&status_path) {
+        #[derive(serde::Deserialize)]
+        struct Status {
+            status: String,
+        }
+        if let Ok(s) = serde_json::from_str::<Status>(&raw) {
+            if s.status == "running" {
+                // Prefer the plugin's proxy_base_url if explicitly configured.
+                let url = cfg
+                    .plugin
+                    .as_ref()
+                    .filter(|p| !p.proxy_base_url.is_empty())
+                    .map(|p| p.proxy_base_url.clone())
+                    .unwrap_or_else(|| format!("http://127.0.0.1:{}", cfg.port));
+                return Some(url);
+            }
+        }
+    }
+
+    None
+}
+
+/// Inject `ANTHROPIC_BASE_URL` into the agent env when compression is active.
+fn inject_compression_url(
+    env: &mut std::collections::HashMap<String, String>,
+    config: &AgentLaunchConfig,
+    staging_path: &std::path::Path,
+    goal_id: Option<uuid::Uuid>,
+) {
+    // Derive project_root from staging_path (project_root/.ta/staging/<uuid>).
+    let project_root = staging_path
+        .parent()
+        .and_then(|p| p.parent())
+        .and_then(|p| p.parent());
+
+    let Some(root) = project_root else { return };
+
+    let agent_name = config.name.as_deref().unwrap_or("claude-code");
+
+    let overrides = goal_id.and_then(|id| {
+        ta_goal::GoalRunStore::new(root.join(".ta").join("goals"))
+            .ok()?
+            .get(id)
+            .ok()??
+            .experiment_overrides
+    });
+    if !input_slot_allows_proxy(root, overrides.as_ref()) {
+        tracing::info!(
+            agent = %agent_name,
+            "Input optimizer is not the compression proxy: ANTHROPIC_BASE_URL left unchanged"
+        );
+        return;
+    }
+
+    if let Some(url) = compression_base_url(root, agent_name) {
+        env.insert("ANTHROPIC_BASE_URL".to_string(), url.clone());
+        tracing::info!(
+            agent = %agent_name,
+            url = %url,
+            "Compression active: routing agent API calls through compression proxy"
+        );
+    }
+}
