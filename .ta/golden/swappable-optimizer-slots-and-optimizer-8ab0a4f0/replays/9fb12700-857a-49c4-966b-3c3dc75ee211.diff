+use std::fmt;
+
+use serde::{Deserialize, Serialize};
+
+use crate::{Registry, Slot};
+
+/// `[optimizers.<slot>] use = "<name>"`. Absent means the slot default.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct SlotConfig {
+    #[serde(rename = "use", skip_serializing_if = "Option::is_none")]
+    pub use_: Option<String>,
+}
+
+/// The `[optimizers]` table of `.ta/daemon.toml`.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct OptimizersConfig {
+    pub input: SlotConfig,
+    pub context: SlotConfig,
+    pub output: SlotConfig,
+}
+
+impl OptimizersConfig {
+    pub fn slot(&self, slot: Slot) -> Option<&str> {
+        match slot {
+            Slot::Input => self.input.use_.as_deref(),
+            Slot::Context => self.context.use_.as_deref(),
+            Slot::Output => self.output.use_.as_deref(),
+        }
+    }
+}
+
+/// Where the chosen optimizer name came from.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SelectionSource {
+    /// A per-goal experiment override (`--set optimizers.input.use=...`).
+    Override,
+    /// `[optimizers.<slot>]` in config.
+    Config,
+    /// The slot default.
+    Default,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Selection {
+    pub slot: Slot,
+    pub name: String,
+    pub source: SelectionSource,
+}
+
+/// A name that no optimizer in the slot has.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct UnknownOptimizer {
+    pub slot: Slot,
+    pub name: String,
+    pub source: SelectionSource,
+    pub valid: Vec<String>,
+}
+
+impl fmt::Display for UnknownOptimizer {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let from = match self.source {
+            SelectionSource::Override => "the experiment override",
+            SelectionSource::Config => "[optimizers] in .ta/daemon.toml",
+            SelectionSource::Default => "the slot default",
+        };
+        write!(
+            f,
+            "unknown {} optimizer '{}' (from {}). Valid choices: {}. \
+             Set optimizers.{}.use to one of them, or 'none' for no optimization.",
+            self.slot,
