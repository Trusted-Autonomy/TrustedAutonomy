+/// Per-slot default when nothing is configured. Input keeps today's behaviour
+/// (the headroom proxy, still gated by `[compression] enabled`); the other
+/// slots default to `none`.
+fn default_for(slot: Slot) -> &'static str {
+    match slot {
+        Slot::Input => "headroom",
+        Slot::Context | Slot::Output => "none",
+    }
