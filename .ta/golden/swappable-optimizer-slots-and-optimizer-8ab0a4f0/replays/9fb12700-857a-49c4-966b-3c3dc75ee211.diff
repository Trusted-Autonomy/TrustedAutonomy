+use serde::{Deserialize, Serialize};
+
+/// Rough token estimate (4 bytes per token). Used only for comparison between
+/// optimizers; real token counts come from the agent's own usage report.
+pub fn est_tokens(bytes: usize) -> usize {
+    bytes.div_ceil(4)
+}
+
+/// What one `apply` call did.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Metrics {
+    pub bytes_in: usize,
+    pub bytes_out: usize,
+    pub est_tokens_in: usize,
+    pub est_tokens_out: usize,
+    pub ms: u64,
+    /// True when `output` carries all the information in the input.
+    pub lossless: bool,
+    /// Key of the full original in the [`crate::OriginalStore`]; present
+    /// whenever the output differs from the input.
+    pub original_ref: Option<String>,
+}
+
+impl Metrics {
+    pub fn measure(
+        input: &str,
+        output: &str,
+        ms: u64,
+        lossless: bool,
+        original_ref: Option<String>,
+    ) -> Self {
+        Self {
+            bytes_in: input.len(),
+            bytes_out: output.len(),
+            est_tokens_in: est_tokens(input.len()),
+            est_tokens_out: est_tokens(output.len()),
+            ms,
+            lossless,
+            original_ref,
+        }
+    }
+}
+
+/// Output text plus its metrics.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Applied {
+    pub output: String,
+    pub metrics: Metrics,
+}
