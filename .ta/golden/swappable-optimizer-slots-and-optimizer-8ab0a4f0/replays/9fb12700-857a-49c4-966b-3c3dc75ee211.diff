+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::time::Instant;
+
+use serde::{Deserialize, Serialize};
+
+use crate::{Applied, Metrics, OptError, OriginalStore, Slot};
+
+/// How an optimizer runs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum OptimizerKind {
+    /// A command run per call.
+    Process,
+    /// A supervised HTTP proxy on `ANTHROPIC_BASE_URL` (today's `[compression.plugin]`).
+    Proxy,
+    /// A hook installed in the agent that rewrites tool calls.
+    Hook,
+    /// Code in this process.
+    InProcess,
+}
+
+impl OptimizerKind {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            OptimizerKind::Process => "process",
+            OptimizerKind::Proxy => "proxy",
+            OptimizerKind::Hook => "hook",
+            OptimizerKind::InProcess => "in_process",
+        }
+    }
+}
+
+/// Identity of an optimizer, shown by `ta compression status`.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct OptimizerInfo {
+    pub name: String,
+    pub version: String,
+    pub kind: OptimizerKind,
+    /// SPDX-style licence, recorded so it is visible before anyone enables it.
+    pub licence: String,
+}
+
+/// The contract every optimizer implements.
+pub trait Optimizer: Send + Sync {
+    fn info(&self) -> OptimizerInfo;
+    /// Cheap probe. Must not start a process or open a window.
+    fn available(&self) -> bool;
+    /// Transform `input`. Lossy results must save the original to `store` and
+    /// return its key in `Metrics::original_ref`.
+    fn apply(&self, input: &str, store: &OriginalStore) -> Result<Applied, OptError>;
+}
+
+/// Acts on tool output, files and logs before they enter context.
+pub trait InputOptimizer: Optimizer {}
+/// Acts on the accumulated conversation.
+pub trait ContextOptimizer: Optimizer {}
+/// Acts on what the model writes.
+pub trait OutputOptimizer: Optimizer {}
+
+/// The baseline: returns the input unchanged. Valid in every slot.
+pub struct NoneOptimizer;
+
+impl Optimizer for NoneOptimizer {
+    fn info(&self) -> OptimizerInfo {
+        OptimizerInfo {
+            name: "none".into(),
+            version: env!("CARGO_PKG_VERSION").into(),
+            kind: OptimizerKind::InProcess,
+            licence: "Apache-2.0".into(),
+        }
+    }
+    fn available(&self) -> bool {
+        true
+    }
+    fn apply(&self, input: &str, _store: &OriginalStore) -> Result<Applied, OptError> {
+        let start = Instant::now();
+        let output = input.to_string();
+        let ms = start.elapsed().as_millis() as u64;
+        let metrics = Metrics::measure(input, &output, ms, true, None);
+        Ok(Applied { output, metrics })
+    }
+}
+impl InputOptimizer for NoneOptimizer {}
+impl ContextOptimizer for NoneOptimizer {}
+impl OutputOptimizer for NoneOptimizer {}
+
+/// An optimizer that runs in another process (a proxy such as headroom, or a
+/// hook such as RTK). TA starts or installs it; it does not call it per
+/// string, so `apply` reports that rather than pretending to transform.
+pub struct ExternalOptimizer {
+    name: String,
+    kind: OptimizerKind,
+    licence: String,
+    /// Binary probed on PATH by `available()`.
+    binary: String,
+}
+
+impl ExternalOptimizer {
+    pub fn new(name: &str, kind: OptimizerKind, licence: &str, binary: &str) -> Self {
+        Self {
+            name: name.into(),
+            kind,
+            licence: licence.into(),
+            binary: binary.into(),
+        }
+    }
+}
+
+impl Optimizer for ExternalOptimizer {
+    fn info(&self) -> OptimizerInfo {
+        OptimizerInfo {
+            name: self.name.clone(),
+            // Reading the version means running the binary; `available()` and
+            // `info()` must never do that, so it stays unknown here.
+            version: "unknown".into(),
+            kind: self.kind,
+            licence: self.licence.clone(),
+        }
+    }
+    fn available(&self) -> bool {
+        which::which(&self.binary).is_ok()
+    }
+    fn apply(&self, _input: &str, _store: &OriginalStore) -> Result<Applied, OptError> {
+        Err(OptError::OutOfProcess(self.name.clone()))
+    }
+}
+impl InputOptimizer for ExternalOptimizer {}
+
+/// Optimizers by slot and name.
+#[derive(Default)]
+pub struct Registry {
+    slots: BTreeMap<(Slot, String), Arc<dyn Optimizer>>,
+}
+
+impl Registry {
+    /// `none` in every slot, plus the starter input optimizers: `headroom`
+    /// (proxy, Apache-2.0) and `rtk` (hook, Apache-2.0 core; the full `rtk`
+    /// and `rtk-proxy` add BUSL-1.1 components).
+    pub fn with_builtins() -> Self {
+        let mut r = Self::default();
+        r.register_input(Arc::new(NoneOptimizer));
+        r.register_context(Arc::new(NoneOptimizer));
+        r.register_output(Arc::new(NoneOptimizer));
+        r.register_input(Arc::new(ExternalOptimizer::new(
+            "headroom",
+            OptimizerKind::Proxy,
+            "Apache-2.0",
+            "headroom",
+        )));
+        r.register_input(Arc::new(ExternalOptimizer::new(
+            "rtk",
+            OptimizerKind::Hook,
+            "Apache-2.0 (core); BUSL-1.1 (rtk, rtk-proxy)",
+            "rtk",
+        )));
+        r
+    }
+
+    pub fn register_input<T: InputOptimizer + 'static>(&mut self, o: Arc<T>) {
+        self.insert(Slot::Input, o);
+    }
+    pub fn register_context<T: ContextOptimizer + 'static>(&mut self, o: Arc<T>) {
+        self.insert(Slot::Context, o);
+    }
+    pub fn register_output<T: OutputOptimizer + 'static>(&mut self, o: Arc<T>) {
+        self.insert(Slot::Output, o);
+    }
+
+    fn insert<T: Optimizer + 'static>(&mut self, slot: Slot, o: Arc<T>) {
+        self.slots.insert((slot, o.info().name), o);
+    }
+
+    pub fn get(&self, slot: Slot, name: &str) -> Option<Arc<dyn Optimizer>> {
+        self.slots.get(&(slot, name.to_string())).cloned()
+    }
+
+    /// Registered names for a slot, sorted.
+    pub fn names(&self, slot: Slot) -> Vec<String> {
+        self.slots
+            .keys()
+            .filter(|(s, _)| *s == slot)
+            .map(|(_, n)| n.clone())
+            .collect()
+    }
+}
+
