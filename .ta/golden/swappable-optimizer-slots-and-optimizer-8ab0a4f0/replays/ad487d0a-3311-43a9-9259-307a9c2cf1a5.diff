+/// Apply the input-slot selection to the compression config. `none` and `rtk`
+/// start no proxy; `headroom` uses the built-in headroom defaults; `proxy` keeps
+/// `[compression.plugin]`. An invalid selection is logged and the legacy
+/// `[compression]` behaviour is kept, so a typo never silently disables the daemon.
+pub fn effective_compression(
+    compression: &CompressionConfig,
+    optimizers: &ta_context_opt::OptimizersConfig,
+) -> CompressionConfig {
+    let mut cfg = compression.clone();
+    let selection = match optimizers.select(compression.default_input_optimizer(), None) {
+        Ok(s) => s,
+        Err(e) => {
+            tracing::error!(error = %e, "invalid [optimizers] selection; keeping [compression] behaviour");
+            return cfg;
+        }
+    };
+    match selection.input.as_str() {
+        "none" | "rtk" => cfg.enabled = false,
+        "headroom" => cfg.plugin = None,
+        _ => {}
+    }
+    cfg
+}
