+//! ta-context-opt: three swappable optimizer slots behind one contract.
+//!
+//! | Slot    | Acts on                                   | Trait              |
+//! |---------|-------------------------------------------|--------------------|
+//! | Input   | command output, files, logs before context | [`InputOptimizer`]   |
+//! | Context | the accumulated conversation              | [`ContextOptimizer`] |
+//! | Output  | what the model writes                     | [`OutputOptimizer`]  |
+//!
+//! Every slot accepts `none`, which is the baseline for every comparison.
+//! Every reduction keeps the full original on disk ([`OriginalStore`]) so it
+//! is reversible and auditable. Selection is made per slot in config
+//! (`[optimizers.input] use = "rtk"`) and can be overridden per golden replay
+//! (`--set optimizers.input.use=none`).
+
+mod config;
+mod registry;
+mod store;
+
+pub use config::{validate_overrides, OptimizersConfig, Selection, SlotConfig};
+pub use registry::{Descriptor, Registry};
+pub use store::OriginalStore;
+
+use serde::{Deserialize, Serialize};
+
+/// One of the three places an optimizer can act.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Slot {
+    Input,
+    Context,
+    Output,
+}
+
+impl Slot {
+    pub const ALL: [Slot; 3] = [Slot::Input, Slot::Context, Slot::Output];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Slot::Input => "input",
+            Slot::Context => "context",
+            Slot::Output => "output",
+        }
+    }
+
+    pub fn parse(s: &str) -> Option<Slot> {
+        Slot::ALL.into_iter().find(|slot| slot.as_str() == s)
+    }
+}
+
+impl std::fmt::Display for Slot {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(self.as_str())
+    }
+}
+
+/// How an optimizer runs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Kind {
+    /// A supervised child process.
+    Process,
+    /// An HTTP proxy on `ANTHROPIC_BASE_URL`.
+    Proxy,
+    /// A hook that rewrites tool calls in the agent.
+    Hook,
+    /// Code in the TA process itself.
+    InProcess,
+}
+
+impl Kind {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Kind::Process => "process",
+            Kind::Proxy => "proxy",
+            Kind::Hook => "hook",
+            Kind::InProcess => "in_process",
+        }
+    }
+}
+
+/// What one `apply` call did. `original_ref` is the content address of the
+/// unmodified input in the [`OriginalStore`]; it is `None` when nothing was
+/// reduced, because there is then nothing to recover.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct Metrics {
+    pub bytes_in: usize,
+    pub bytes_out: usize,
+    pub est_tokens_in: usize,
+    pub est_tokens_out: usize,
+    pub ms: u128,
+    pub lossless: bool,
+    pub original_ref: Option<String>,
+}
+
+/// Rough token estimate: one token per four bytes, rounded up.
+pub fn estimate_tokens(bytes: usize) -> usize {
+    bytes.div_ceil(4)
+}
+
+/// Result of an `apply` call.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Applied {
+    pub output: String,
+    pub metrics: Metrics,
+}
+
+/// Identity and probing shared by every optimizer.
+pub trait Optimizer {
+    fn name(&self) -> &str;
+    fn version(&self) -> &str;
+    fn kind(&self) -> Kind;
+    /// SPDX-style licence recorded for the optimizer.
+    fn licence(&self) -> &str;
+    /// Cheap probe. Must never start a visible window.
+    fn available(&self) -> bool;
+}
+
+/// Acts on tool and command output, files and logs before they enter context.
+pub trait InputOptimizer: Optimizer {
+    fn apply(&self, input: &str, store: &OriginalStore) -> anyhow::Result<Applied>;
+}
+
+/// Acts on the accumulated conversation (compaction, supersession, eviction).
+pub trait ContextOptimizer: Optimizer {
+    fn apply(&self, input: &str, store: &OriginalStore) -> anyhow::Result<Applied>;
+}
+
+/// Acts on what the model writes (terse replies, edit format).
+pub trait OutputOptimizer: Optimizer {
+    fn apply(&self, input: &str, store: &OriginalStore) -> anyhow::Result<Applied>;
+}
+
+/// The baseline for every slot: passes content through unchanged.
+#[derive(Debug, Default, Clone, Copy)]
+pub struct NoneOptimizer;
+
+impl NoneOptimizer {
+    fn pass_through(input: &str) -> Applied {
+        let start = std::time::Instant::now();
+        let bytes = input.len();
+        Applied {
+            output: input.to_string(),
+            metrics: Metrics {
+                bytes_in: bytes,
+                bytes_out: bytes,
+                est_tokens_in: estimate_tokens(bytes),
+                est_tokens_out: estimate_tokens(bytes),
+                ms: start.elapsed().as_millis(),
+                lossless: true,
+                original_ref: None,
+            },
+        }
+    }
+}
+
+impl Optimizer for NoneOptimizer {
+    fn name(&self) -> &str {
+        "none"
+    }
+    fn version(&self) -> &str {
+        env!("CARGO_PKG_VERSION")
+    }
+    fn kind(&self) -> Kind {
+        Kind::InProcess
+    }
+    fn licence(&self) -> &str {
+        "Apache-2.0"
+    }
+    fn available(&self) -> bool {
+        true
+    }
+}
+
+impl InputOptimizer for NoneOptimizer {
+    fn apply(&self, input: &str, _store: &OriginalStore) -> anyhow::Result<Applied> {
+        Ok(Self::pass_through(input))
+    }
+}
+impl ContextOptimizer for NoneOptimizer {
+    fn apply(&self, input: &str, _store: &OriginalStore) -> anyhow::Result<Applied> {
+        Ok(Self::pass_through(input))
+    }
+}
+impl OutputOptimizer for NoneOptimizer {
+    fn apply(&self, input: &str, _store: &OriginalStore) -> anyhow::Result<Applied> {
+        Ok(Self::pass_through(input))
+    }
+}
+
+/// Build a metrics record for an optimizer that shortened `input` to `output`,
+/// saving the original so the reduction can be undone.
+pub fn reduction_metrics(
+    input: &str,
+    output: &str,
+    ms: u128,
+    lossless: bool,
+    store: &OriginalStore,
+) -> anyhow::Result<Metrics> {
+    let original_ref = if input == output {
+        None
+    } else {
+        Some(store.save(input)?)
+    };
+    Ok(Metrics {
+        bytes_in: input.len(),
+        bytes_out: output.len(),
+        est_tokens_in: estimate_tokens(input.len()),
+        est_tokens_out: estimate_tokens(output.len()),
+        ms,
+        lossless,
+        original_ref,
+    })
+}
