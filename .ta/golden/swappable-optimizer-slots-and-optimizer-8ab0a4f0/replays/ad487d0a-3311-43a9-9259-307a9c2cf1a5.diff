+/// Windows process-creation flag: do not create a console window for the child.
+pub(crate) const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+
+/// Process-creation flags applied to every optimizer process. Non-zero only on
+/// Windows, where a console child would otherwise open a visible window.
+pub(crate) fn optimizer_creation_flags() -> u32 {
+    if cfg!(windows) {
+        CREATE_NO_WINDOW
+    } else {
+        0
+    }
+}
+
+/// Build the optimizer command: args, env, null stdio, `kill_on_drop`, and on
+/// Windows `CREATE_NO_WINDOW`. Every optimizer spawn goes through here.
+pub(crate) fn build_command(plugin: &PromptOptimizerPluginConfig) -> tokio::process::Command {
+    let mut cmd = tokio::process::Command::new(&plugin.command);
+    cmd.args(&plugin.args)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .kill_on_drop(true);
+    for (k, v) in &plugin.env {
+        cmd.env(k, v);
+    }
+    let flags = optimizer_creation_flags();
+    #[cfg(windows)]
+    cmd.creation_flags(flags);
+    #[cfg(not(windows))]
+    debug_assert_eq!(flags, 0, "creation flags are Windows-only");
+    cmd
+}
