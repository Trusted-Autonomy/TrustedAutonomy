+
+#[test]
+fn input_slot_lists_kind_and_licence_for_rtk_headroom_and_proxy() {
+    let r = Registry::builtin();
+    let rtk = r.get(Slot::Input, "rtk").unwrap();
+    assert_eq!(rtk.kind, Kind::Hook);
+    assert!(rtk.licence.contains("Apache-2.0"));
+    let headroom = r.get(Slot::Input, "headroom").unwrap();
+    assert_eq!(headroom.kind, Kind::Proxy);
+    assert_eq!(r.get(Slot::Input, "proxy").unwrap().kind, Kind::Proxy);
+    assert!(r.get(Slot::Output, "rtk").is_none());
+}
+
+#[test]
+fn unset_slot_uses_legacy_input_and_none_elsewhere() {
+    let cfg = OptimizersConfig::default();
+    let sel = cfg.select("headroom", None).unwrap();
+    assert_eq!(sel.input, "headroom");
+    assert_eq!(sel.context, "none");
+    assert_eq!(sel.output, "none");
+    assert_eq!(cfg.select("none", None).unwrap().input, "none");
+}
+
+#[test]
+fn config_selection_parses_from_toml_and_override_wins() {
+    let cfg: OptimizersConfig = toml_like(r#"{"input":{"use":"rtk"}}"#);
+    assert_eq!(cfg.select("headroom", None).unwrap().input, "rtk");
+    let o = json!({"optimizers.input.use": "none"});
+    assert_eq!(cfg.select("headroom", Some(&o)).unwrap().input, "none");
+}
+
+fn toml_like(s: &str) -> OptimizersConfig {
+    serde_json::from_str(s).unwrap()
+}
+
+#[test]
+fn unknown_names_and_slots_are_refused_with_choices() {
+    let bad = json!({"optimizers.input.use": "turbo"});
+    let err = validate_overrides(&bad).unwrap_err().to_string();
+    assert!(err.contains("turbo") && err.contains("none, proxy, headroom, rtk"));
+    assert!(validate_overrides(&json!({"optimizers.sideways.use": "none"})).is_err());
+    assert!(validate_overrides(&json!({"optimizers.input.mode": "none"})).is_err());
+    assert!(validate_overrides(&json!({"optimizers.input.use": 3})).is_err());
+    assert!(validate_overrides(&json!({"optimizers.output.use": "rtk"})).is_err());
+    // Keys that are not ours are left alone.
+    assert!(validate_overrides(&json!({"wiki.disabled": true})).is_ok());
+    assert!(validate_overrides(&json!({"optimizers.input.use": "rtk"})).is_ok());
+}
+
+#[test]
+fn bad_config_value_is_refused_at_selection() {
+    let cfg = toml_like(r#"{"context":{"use":"rtk"}}"#);
+    assert!(cfg.select("none", None).is_err());
+}
+
+#[test]
+fn none_baseline_passes_content_through_with_metrics() {
+    let dir = tempfile::tempdir().unwrap();
+    let store = OriginalStore::new(dir.path());
+    let out = InputOptimizer::apply(&NoneOptimizer, "hello world", &store).unwrap();
+    assert_eq!(out.output, "hello world");
+    assert_eq!(out.metrics.bytes_in, 11);
+    assert_eq!(out.metrics.bytes_out, 11);
+    assert_eq!(out.metrics.est_tokens_in, 3);
+    assert!(out.metrics.lossless);
+    assert_eq!(out.metrics.original_ref, None);
+    assert!(NoneOptimizer.available());
+}
+
+#[test]
+fn reduction_keeps_the_original_recoverable() {
+    let dir = tempfile::tempdir().unwrap();
+    let store = OriginalStore::new(dir.path().join("originals"));
+    let original = "line\n".repeat(100);
+    let reduced = "line x100\n";
+    let m = reduction_metrics(&original, reduced, 2, false, &store).unwrap();
+    assert_eq!(m.bytes_in, 500);
+    assert_eq!(m.bytes_out, reduced.len());
+    assert!(m.bytes_out < m.bytes_in);
+    assert!(!m.lossless);
+    let reference = m.original_ref.expect("a reduction must keep its original");
+    assert_eq!(store.load(&reference).unwrap(), original);
+    // Same content, same reference, one file.
+    assert_eq!(store.save(&original).unwrap(), reference);
+    assert_eq!(std::fs::read_dir(store.dir()).unwrap().count(), 1);
+}
+
+#[test]
+fn store_refuses_path_like_references_and_reports_missing() {
+    let dir = tempfile::tempdir().unwrap();
+    let store = OriginalStore::new(dir.path());
+    assert!(store.load("../../etc/passwd").is_err());
+    let missing = "0".repeat(64);
+    assert!(store
+        .load(&missing)
+        .unwrap_err()
+        .to_string()
+        .contains("cleaned up"));
+}
