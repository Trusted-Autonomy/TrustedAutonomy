+use anyhow::{bail, Result};
+use serde::{Deserialize, Serialize};
+
+use crate::{Registry, Slot};
+
+/// `[optimizers.<slot>]` in daemon.toml.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SlotConfig {
+    /// Optimizer name for the slot. Absent means the legacy default for the slot.
+    #[serde(rename = "use", default, skip_serializing_if = "Option::is_none")]
+    pub use_: Option<String>,
+}
+
+/// `[optimizers]` in daemon.toml.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct OptimizersConfig {
+    #[serde(default)]
+    pub input: SlotConfig,
+    #[serde(default)]
+    pub context: SlotConfig,
+    #[serde(default)]
+    pub output: SlotConfig,
+}
+
+/// The optimizer chosen for each slot after applying overrides.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Selection {
+    pub input: String,
+    pub context: String,
+    pub output: String,
+}
+
+impl OptimizersConfig {
+    fn slot(&self, slot: Slot) -> &SlotConfig {
+        match slot {
+            Slot::Input => &self.input,
+            Slot::Context => &self.context,
+            Slot::Output => &self.output,
+        }
+    }
+
+    /// Resolve the choice per slot. `legacy_input` is what the input slot uses
+    /// when `[optimizers.input]` is unset (derived from `[compression]`, so
+    /// existing installs keep their behaviour). `overrides` is the flat goal
+    /// override object (`{"optimizers.input.use": "none"}`) and wins over
+    /// config. Unknown names are refused with the valid choices listed.
+    pub fn select(
+        &self,
+        legacy_input: &str,
+        overrides: Option<&serde_json::Value>,
+    ) -> Result<Selection> {
+        if let Some(o) = overrides {
+            validate_overrides(o)?;
+        }
+        let registry = Registry::builtin();
+        let pick = |slot: Slot| -> Result<String> {
+            let key = format!("optimizers.{slot}.use");
+            let name = overrides
+                .and_then(|o| o.get(&key))
+                .and_then(|v| v.as_str())
+                .map(str::to_string)
+                .or_else(|| self.slot(slot).use_.clone())
+                .unwrap_or_else(|| {
+                    if slot == Slot::Input {
+                        legacy_input.to_string()
+                    } else {
+                        "none".to_string()
+                    }
+                });
+            if registry.get(slot, &name).is_none() {
+                bail!(unknown_message(slot, &name, "daemon.toml"));
+            }
+            Ok(name)
+        };
+        Ok(Selection {
+            input: pick(Slot::Input)?,
+            context: pick(Slot::Context)?,
+            output: pick(Slot::Output)?,
+        })
+    }
+}
+
+fn unknown_message(slot: Slot, name: &str, origin: &str) -> String {
+    format!(
+        "unknown {slot} optimizer '{name}' (from {origin}). Valid choices for the {slot} slot: {}. \
+         Example: --set optimizers.{slot}.use=none",
+        Registry::builtin().names(slot).join(", ")
+    )
+}
+
+/// Check every `optimizers.*` key in a goal override object: the key must be
+/// `optimizers.<slot>.use`, the value a string, and the name registered for
+/// that slot. Other keys are not ours and are ignored. Fails before anything
+/// is launched, so a typo never costs a scratch checkout or a goal.
+pub fn validate_overrides(overrides: &serde_json::Value) -> Result<()> {
+    let Some(map) = overrides.as_object() else {
+        return Ok(());
+    };
+    for (key, value) in map {
+        let Some(rest) = key.strip_prefix("optimizers.") else {
+            continue;
+        };
+        let (slot_name, field) = rest.split_once('.').unwrap_or((rest, ""));
+        let Some(slot) = Slot::parse(slot_name) else {
+            bail!(
+                "override '{key}' names unknown slot '{slot_name}'. Slots: input, context, output. \
+                 Example: --set optimizers.input.use=none"
+            );
+        };
+        if field != "use" {
+            bail!(
+                "override '{key}' is not supported. Only optimizers.{slot}.use can be overridden. \
+                 Example: --set optimizers.{slot}.use=none"
+            );
+        }
+        let Some(name) = value.as_str() else {
+            bail!(
+                "override '{key}' must be a name such as \"none\", got {value}. \
+                 Valid choices: {}",
+                Registry::builtin().names(slot).join(", ")
+            );
+        };
+        if Registry::builtin().get(slot, name).is_none() {
+            bail!(unknown_message(slot, name, "--set"));
+        }
+    }
+    Ok(())
+}
