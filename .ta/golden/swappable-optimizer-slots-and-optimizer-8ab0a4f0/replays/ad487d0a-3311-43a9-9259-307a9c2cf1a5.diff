+use crate::{Kind, Slot};
+
+/// A selectable optimizer for a slot, with the facts shown to the user.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Descriptor {
+    pub slot: Slot,
+    pub name: &'static str,
+    pub kind: Kind,
+    pub licence: &'static str,
+    pub note: &'static str,
+}
+
+const ENTRIES: &[Descriptor] = &[
+    Descriptor {
+        slot: Slot::Input,
+        name: "none",
+        kind: Kind::InProcess,
+        licence: "Apache-2.0",
+        note: "baseline: no optimization",
+    },
+    Descriptor {
+        slot: Slot::Input,
+        name: "proxy",
+        kind: Kind::Proxy,
+        licence: "per plugin",
+        note: "the [compression.plugin] proxy (headroom unless configured otherwise)",
+    },
+    Descriptor {
+        slot: Slot::Input,
+        name: "headroom",
+        kind: Kind::Proxy,
+        licence: "Apache-2.0",
+        note: "headroom proxy with the built-in defaults",
+    },
+    Descriptor {
+        slot: Slot::Input,
+        name: "rtk",
+        kind: Kind::Hook,
+        licence: "Apache-2.0 (rtk-oss; the full rtk adds BUSL-1.1 components)",
+        note: "rewrites shell commands in the agent; fires on Bash tool calls only",
+    },
+    Descriptor {
+        slot: Slot::Context,
+        name: "none",
+        kind: Kind::InProcess,
+        licence: "Apache-2.0",
+        note: "baseline: the agent's own compaction",
+    },
+    Descriptor {
+        slot: Slot::Output,
+        name: "none",
+        kind: Kind::InProcess,
+        licence: "Apache-2.0",
+        note: "baseline: no output shaping",
+    },
+];
+
+/// The known optimizers per slot. `none` is registered for every slot.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Registry;
+
+impl Registry {
+    pub fn builtin() -> Self {
+        Registry
+    }
+
+    pub fn descriptors(&self, slot: Slot) -> impl Iterator<Item = &'static Descriptor> {
+        ENTRIES.iter().filter(move |d| d.slot == slot)
+    }
+
+    pub fn get(&self, slot: Slot, name: &str) -> Option<&'static Descriptor> {
+        self.descriptors(slot).find(|d| d.name == name)
+    }
+
+    pub fn names(&self, slot: Slot) -> Vec<&'static str> {
+        self.descriptors(slot).map(|d| d.name).collect()
+    }
+}
