+use std::path::{Path, PathBuf};
+
+use anyhow::{bail, Context, Result};
+use sha2::{Digest, Sha256};
+
+/// Content-addressed store of unmodified originals, so any reduction is
+/// reversible. The reference is the SHA-256 of the content in lowercase hex.
+#[derive(Debug, Clone)]
+pub struct OriginalStore {
+    dir: PathBuf,
+}
+
+impl OriginalStore {
+    /// Store under `dir`; the directory is created on first save.
+    pub fn new(dir: impl Into<PathBuf>) -> Self {
+        Self { dir: dir.into() }
+    }
+
+    /// The conventional location under a project: `.ta/optimizer-originals`.
+    pub fn for_project(project_root: &Path) -> Self {
+        Self::new(project_root.join(".ta").join("optimizer-originals"))
+    }
+
+    pub fn dir(&self) -> &Path {
+        &self.dir
+    }
+
+    /// Save `content` and return its reference. Saving the same content twice
+    /// returns the same reference and writes once.
+    pub fn save(&self, content: &str) -> Result<String> {
+        let reference: String = Sha256::digest(content.as_bytes())
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect();
+        let path = self.dir.join(&reference);
+        if !path.exists() {
+            std::fs::create_dir_all(&self.dir).with_context(|| {
+                format!(
+                    "creating optimizer original store {} (check the directory is writable)",
+                    self.dir.display()
+                )
+            })?;
+            std::fs::write(&path, content)
+                .with_context(|| format!("writing optimizer original {}", path.display()))?;
+        }
+        Ok(reference)
+    }
+
+    /// Recover the full original for a reference returned by [`save`](Self::save).
+    pub fn load(&self, reference: &str) -> Result<String> {
+        if reference.len() != 64 || !reference.bytes().all(|b| b.is_ascii_hexdigit()) {
+            bail!("'{reference}' is not an original reference (expected 64 hex characters)");
+        }
+        let path = self.dir.join(reference);
+        std::fs::read_to_string(&path).with_context(|| {
+            format!(
+                "reading optimizer original {}; it may have been cleaned up",
+                path.display()
+            )
+        })
+    }
+}
