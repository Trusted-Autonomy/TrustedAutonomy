+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    struct Upper;
+    impl InputOptimizer for Upper {
+        fn name(&self) -> &str {
+            "upper"
+        }
+        fn optimize_input(&self, p: &str) -> Result<Optimized> {
+            Ok(Optimized {
+                text: p.chars().take(4).collect(),
+                lossless: false,
+            })
+        }
+    }
+
+    #[test]
+    fn none_is_a_lossless_passthrough_in_every_slot() {
+        let n = NoneOptimizer;
+        for out in [
+            n.optimize_input("abc").unwrap(),
+            n.optimize_context("abc").unwrap(),
+            n.optimize_output("abc").unwrap(),
+        ] {
+            assert_eq!(out.text, "abc");
+            assert!(out.lossless);
+        }
+    }
+
+    #[test]
+    fn default_selection_keeps_headroom_on_input_and_none_elsewhere() {
+        let cfg = OptimizersConfig::default();
+        assert_eq!(cfg.selected(Slot::Input), "headroom");
+        assert_eq!(cfg.selected(Slot::Context), "none");
+        assert_eq!(cfg.selected(Slot::Output), "none");
+        cfg.validate(&Registry::default()).unwrap();
+    }
+
+    #[test]
+    fn toml_selects_a_slot_with_use() {
+        let toml_like = json!({"input": {"use": "rtk"}});
+        let cfg: OptimizersConfig = serde_json::from_value(toml_like).unwrap();
+        assert_eq!(cfg.selected(Slot::Input), "rtk");
+        assert_eq!(cfg.selected(Slot::Output), "none");
+    }
+
+    #[test]
+    fn unknown_optimizer_is_refused_with_the_choices() {
+        let reg = Registry::default();
+        let err = reg.validate(Slot::Input, "rtkk").unwrap_err().to_string();
+        assert!(err.contains("rtkk") && err.contains("headroom") && err.contains("rtk"));
+        let err = reg
+            .validate(Slot::Output, "headroom")
+            .unwrap_err()
+            .to_string();
+        assert!(err.contains("output") && err.contains("none"));
+    }
+
+    #[test]
+    fn registered_in_process_optimizer_becomes_selectable() {
+        let mut reg = Registry::default();
+        assert!(reg.input("upper").is_none());
+        reg.register_input(Arc::new(Upper));
+        reg.validate(Slot::Input, "upper").unwrap();
+        assert!(reg.input("upper").is_some());
+        // Proxy kinds are selectable but have no in-process implementation.
+        reg.validate(Slot::Input, "headroom").unwrap();
+        assert!(reg.input("headroom").is_none());
+    }
+
+    #[test]
+    fn override_switches_the_input_slot() {
+        let reg = Registry::default();
+        let base = OptimizersConfig::default();
+        let out = base
+            .with_overrides(&json!({"optimizers.input.use": "none"}), &reg)
+            .unwrap();
+        assert_eq!(out.selected(Slot::Input), "none");
+        assert_eq!(base.selected(Slot::Input), "headroom", "base is untouched");
+    }
+
+    #[test]
+    fn unrelated_override_keys_are_ignored() {
+        let reg = Registry::default();
+        let out = OptimizersConfig::default()
+            .with_overrides(&json!({"feature.disabled": true}), &reg)
+            .unwrap();
+        assert_eq!(out, OptimizersConfig::default());
+    }
+
+    #[test]
+    fn bad_overrides_name_the_problem() {
+        let reg = Registry::default();
+        let cfg = OptimizersConfig::default();
+        let e = |v| format!("{:#}", cfg.with_overrides(&v, &reg).unwrap_err());
+        assert!(e(json!({"optimizers.inptu.use": "none"})).contains("not an optimizer slot"));
+        assert!(e(json!({"optimizers.input.port": "1"})).contains("only 'use'"));
+        assert!(e(json!({"optimizers.input.use": 3})).contains("optimizer name"));
+        assert!(e(json!({"optimizers.input.use": "nope"})).contains("Choose one of"));
+    }
+
+    #[test]
+    fn metrics_and_original_recovery() {
+        let dir = tempfile::tempdir().unwrap();
+        let store = OriginalStore::new(dir.path().join("originals"));
+        let original = "x".repeat(40);
+        let (text, m) = run_input(&Upper, &store, &original).unwrap();
+        assert_eq!(text.len(), 4);
+        assert_eq!(m.bytes_in, 40);
+        assert_eq!(m.bytes_out, 4);
+        assert_eq!(m.est_tokens_in, 10);
+        assert_eq!(m.est_tokens_out, 1);
+        assert!(!m.lossless);
+        assert_eq!(store.recover(&m.original_ref).unwrap(), original);
+    }
+
+    #[test]
+    fn none_baseline_reports_no_reduction() {
+        let dir = tempfile::tempdir().unwrap();
+        let store = OriginalStore::new(dir.path());
+        let (text, m) = run_output(&NoneOptimizer, &store, "tool output").unwrap();
+        assert_eq!(text, "tool output");
+        assert_eq!(m.bytes_in, m.bytes_out);
+        assert_eq!(m.est_tokens_in, m.est_tokens_out);
+        assert!(m.lossless);
+    }
+
+    #[test]
+    fn same_original_is_stored_once() {
+        let dir = tempfile::tempdir().unwrap();
+        let store = OriginalStore::new(dir.path());
+        let a = store.save("same").unwrap();
+        let b = store.save("same").unwrap();
+        assert_eq!(a, b);
+        assert_eq!(std::fs::read_dir(dir.path()).unwrap().count(), 1);
+    }
+
+    #[test]
+    fn recover_refuses_paths_and_missing_refs() {
+        let dir = tempfile::tempdir().unwrap();
+        let store = OriginalStore::new(dir.path());
+        assert!(store.recover("../secret").is_err());
+        assert!(store.recover("").is_err());
+        let err = store.recover("abcdef").unwrap_err().to_string();
+        assert!(err.contains("no stored original"));
+    }
+
+    #[test]
+    fn metrics_append_as_json_lines() {
+        let dir = tempfile::tempdir().unwrap();
+        let store = OriginalStore::new(dir.path().join("o"));
+        let (_, m) = run_context(&NoneOptimizer, &store, "ctx").unwrap();
+        append_metrics(dir.path(), Slot::Context, "none", &m).unwrap();
+        append_metrics(dir.path(), Slot::Context, "none", &m).unwrap();
+        let raw = std::fs::read_to_string(dir.path().join("metrics.jsonl")).unwrap();
+        let lines: Vec<serde_json::Value> = raw
+            .lines()
+            .map(|l| serde_json::from_str(l).unwrap())
+            .collect();
+        assert_eq!(lines.len(), 2);
+        assert_eq!(lines[0]["slot"], "context");
+        assert_eq!(lines[0]["optimizer"], "none");
+        assert_eq!(lines[0]["original_ref"], m.original_ref.as_str());
+    }
+
+    #[test]
+    fn every_proxy_and_builtin_records_a_licence() {
+        for info in catalog() {
+            assert!(!info.licence.is_empty(), "{} has no licence", info.name);
+        }
+        let reg = Registry::default();
+        assert_eq!(reg.info(Slot::Input, "rtk").unwrap().licence, "MIT");
+        assert_eq!(reg.info(Slot::Input, "headroom").unwrap().kind, Kind::Proxy);
+    }
