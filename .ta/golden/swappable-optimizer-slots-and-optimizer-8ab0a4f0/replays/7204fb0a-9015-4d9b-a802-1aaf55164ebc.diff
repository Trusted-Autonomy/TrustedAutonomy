+#[derive(Debug, Clone, PartialEq, Eq)]
+struct SpawnPlan {
+    program: String,
+    args: Vec<String>,
+    env: Vec<(String, String)>,
+    /// Windows `dwCreationFlags`. Always `CREATE_NO_WINDOW`; ignored elsewhere.
+    creation_flags: u32,
