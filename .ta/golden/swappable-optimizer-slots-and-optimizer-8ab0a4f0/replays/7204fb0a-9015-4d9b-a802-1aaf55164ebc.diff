+//! Swappable optimizer slots (v0.17.12.21).
+//!
+//! Token reduction happens in three places: the prompt going in (**input**),
+//! the working context an agent accumulates (**context**) and tool output
+//! coming back (**output**). Each is a *slot*. A slot names one optimizer with
+//! `use`, so an open-source tool (RTK, headroom) can be tried and replaced
+//! without touching the code that calls it.
+//!
+//! ```toml
+//! [optimizers.input]
+//! use = "headroom"   # none | headroom | rtk | proxy
+//! ```
+//!
+//! Two kinds of optimizer exist:
+//!
+//! * **in-process** (`none`): a Rust implementation of one of the slot traits.
+//! * **proxy**: an external HTTP proxy the daemon supervises (`headroom`,
+//!   `rtk`, `proxy`). It compresses on the wire, so TA sees no per-call
+//!   metrics for it.
+//!
+//! Every reduction is reversible: [`run_input`] and friends keep the full
+//! original on disk ([`OriginalStore`]) and return a [`Metrics`] record whose
+//! `original_ref` recovers it.
+
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::Instant;
+
+use anyhow::{Context, Result};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+/// Which stage of a run an optimizer works on.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Slot {
+    Input,
+    Context,
+    Output,
+}
+
+impl Slot {
+    pub const ALL: [Slot; 3] = [Slot::Input, Slot::Context, Slot::Output];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Slot::Input => "input",
+            Slot::Context => "context",
+            Slot::Output => "output",
+        }
+    }
+}
+
+impl std::fmt::Display for Slot {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(self.as_str())
+    }
+}
+
+/// How an optimizer runs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Kind {
+    /// Implemented in this process through a slot trait.
+    InProcess,
+    /// An external HTTP proxy the daemon supervises (`[compression.plugin]`).
+    Proxy,
+}
+
+/// What an optimizer returns: the reduced text and whether nothing was lost.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Optimized {
+    pub text: String,
+    /// True when the original can be rebuilt exactly from `text` alone.
+    pub lossless: bool,
+}
+
+/// Optimizes the prompt before it is sent.
+pub trait InputOptimizer: Send + Sync {
+    fn name(&self) -> &str;
+    fn optimize_input(&self, prompt: &str) -> Result<Optimized>;
+}
+
+/// Optimizes the working context an agent carries between turns.
+pub trait ContextOptimizer: Send + Sync {
+    fn name(&self) -> &str;
+    fn optimize_context(&self, context: &str) -> Result<Optimized>;
+}
+
+/// Optimizes tool output before the agent reads it.
+pub trait OutputOptimizer: Send + Sync {
+    fn name(&self) -> &str;
+    fn optimize_output(&self, output: &str) -> Result<Optimized>;
+}
+
+/// The baseline: returns its input unchanged. Selecting `none` in a slot
+/// turns that slot off, which is the control arm of a golden replay.
+#[derive(Debug, Default, Clone, Copy)]
+pub struct NoneOptimizer;
+
+impl InputOptimizer for NoneOptimizer {
+    fn name(&self) -> &str {
+        NONE
+    }
+    fn optimize_input(&self, prompt: &str) -> Result<Optimized> {
+        Ok(passthrough(prompt))
+    }
+}
+
+impl ContextOptimizer for NoneOptimizer {
+    fn name(&self) -> &str {
+        NONE
+    }
+    fn optimize_context(&self, context: &str) -> Result<Optimized> {
+        Ok(passthrough(context))
+    }
+}
+
+impl OutputOptimizer for NoneOptimizer {
+    fn name(&self) -> &str {
+        NONE
+    }
+    fn optimize_output(&self, output: &str) -> Result<Optimized> {
+        Ok(passthrough(output))
+    }
+}
+
+fn passthrough(text: &str) -> Optimized {
+    Optimized {
+        text: text.to_string(),
+        lossless: true,
+    }
+}
+
+// ── Metrics and original recovery ───────────────────────────────────────
+
+/// One optimization, measured.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct Metrics {
+    pub bytes_in: usize,
+    pub bytes_out: usize,
+    pub est_tokens_in: usize,
+    pub est_tokens_out: usize,
+    /// Wall time spent in the optimizer.
+    pub ms: u64,
+    pub lossless: bool,
+    /// Key that [`OriginalStore::recover`] turns back into the full original.
+    pub original_ref: String,
+}
+
+/// Rough token estimate (about four bytes per token). Good enough to compare
+/// two arms; it is not a billing figure.
+pub fn estimate_tokens(text: &str) -> usize {
+    text.len().div_ceil(4)
+}
+
+/// Full originals kept on disk, content-addressed by SHA-256, so any reduction
+/// can be undone and audited.
+#[derive(Debug, Clone)]
+pub struct OriginalStore {
+    dir: PathBuf,
+}
+
+impl OriginalStore {
+    pub fn new(dir: impl Into<PathBuf>) -> Self {
+        Self { dir: dir.into() }
+    }
+
+    /// The conventional location under a project root.
+    pub fn for_project(project_root: &Path) -> Self {
+        Self::new(
+            project_root
+                .join(".ta")
+                .join("compression")
+                .join("originals"),
+        )
+    }
+
+    /// Store `text` and return its reference. Storing the same text twice
+    /// yields the same reference and one file.
+    pub fn save(&self, text: &str) -> Result<String> {
+        let key: String = Sha256::digest(text.as_bytes())
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect();
+        std::fs::create_dir_all(&self.dir).with_context(|| {
+            format!(
+                "cannot create the originals directory {}. Check that it is writable",
+                self.dir.display()
+            )
+        })?;
+        let path = self.dir.join(&key);
+        if !path.exists() {
+            std::fs::write(&path, text)
+                .with_context(|| format!("cannot write original {}", path.display()))?;
+        }
+        Ok(key)
+    }
+
+    /// Read back the original for `original_ref`.
+    pub fn recover(&self, original_ref: &str) -> Result<String> {
+        // A reference is a hex digest; refuse anything that could leave the directory.
+        anyhow::ensure!(
+            !original_ref.is_empty() && original_ref.bytes().all(|b| b.is_ascii_hexdigit()),
+            "'{original_ref}' is not a valid original reference (expected a hex digest)"
+        );
+        let path = self.dir.join(original_ref);
+        std::fs::read_to_string(&path).with_context(|| {
+            format!(
+                "no stored original for reference {original_ref} at {}. It may have been cleaned up",
+                path.display()
+            )
+        })
+    }
+}
+
+fn measure(
+    store: &OriginalStore,
+    original: &str,
+    run: impl FnOnce() -> Result<Optimized>,
+) -> Result<(String, Metrics)> {
+    // Keep the original before optimizing so a failure still leaves it recoverable.
+    let original_ref = store.save(original)?;
+    let start = Instant::now();
+    let out = run()?;
+    let ms = start.elapsed().as_millis() as u64;
+    let metrics = Metrics {
+        bytes_in: original.len(),
+        bytes_out: out.text.len(),
+        est_tokens_in: estimate_tokens(original),
+        est_tokens_out: estimate_tokens(&out.text),
+        ms,
+        lossless: out.lossless,
+        original_ref,
+    };
+    Ok((out.text, metrics))
+}
+
+/// Run an input optimizer, keeping the original and measuring the result.
+pub fn run_input(
+    opt: &dyn InputOptimizer,
+    store: &OriginalStore,
+    prompt: &str,
+) -> Result<(String, Metrics)> {
+    measure(store, prompt, || opt.optimize_input(prompt))
+}
+
+/// Run a context optimizer, keeping the original and measuring the result.
+pub fn run_context(
+    opt: &dyn ContextOptimizer,
+    store: &OriginalStore,
+    context: &str,
+) -> Result<(String, Metrics)> {
+    measure(store, context, || opt.optimize_context(context))
+}
+
+/// Run an output optimizer, keeping the original and measuring the result.
+pub fn run_output(
+    opt: &dyn OutputOptimizer,
+    store: &OriginalStore,
+    output: &str,
+) -> Result<(String, Metrics)> {
+    measure(store, output, || opt.optimize_output(output))
+}
+
+/// Append a metrics record to `<dir>/metrics.jsonl`.
+pub fn append_metrics(dir: &Path, slot: Slot, optimizer: &str, m: &Metrics) -> Result<()> {
+    use std::io::Write;
+    std::fs::create_dir_all(dir)
+        .with_context(|| format!("cannot create metrics directory {}", dir.display()))?;
+    let path = dir.join("metrics.jsonl");
+    let mut line = serde_json::to_value(m)?;
+    line["slot"] = slot.as_str().into();
+    line["optimizer"] = optimizer.into();
+    let mut f = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(&path)
+        .with_context(|| format!("cannot open {}", path.display()))?;
+    writeln!(f, "{line}").with_context(|| format!("cannot append to {}", path.display()))
+}
+
+// ── Registry ────────────────────────────────────────────────────────────
+
+/// The name that turns a slot off.
+pub const NONE: &str = "none";
+
+/// What the registry knows about one selectable optimizer.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct OptimizerInfo {
+    pub name: &'static str,
+    pub slot: Slot,
+    pub kind: Kind,
+    /// Licence of the upstream tool, recorded so adopting it is a visible choice.
+    pub licence: &'static str,
+    pub homepage: &'static str,
+}
+
+const CATALOG: &[OptimizerInfo] = &[
+    OptimizerInfo {
+        name: NONE,
+        slot: Slot::Input,
+        kind: Kind::InProcess,
+        licence: "Apache-2.0 (built in)",
+        homepage: "",
+    },
+    OptimizerInfo {
+        name: "headroom",
+        slot: Slot::Input,
+        kind: Kind::Proxy,
+        licence: "Apache-2.0",
+        homepage: "https://github.com/chopratejas/headroom",
+    },
+    OptimizerInfo {
+        name: "rtk",
+        slot: Slot::Input,
+        kind: Kind::Proxy,
+        licence: "MIT",
+        homepage: "https://github.com/rtk-ai/rtk",
+    },
+    OptimizerInfo {
+        name: "proxy",
+        slot: Slot::Input,
+        kind: Kind::Proxy,
+        licence: "depends on the tool you configure",
+        homepage: "",
+    },
+    OptimizerInfo {
+        name: NONE,
+        slot: Slot::Context,
+        kind: Kind::InProcess,
+        licence: "Apache-2.0 (built in)",
+        homepage: "",
+    },
+    OptimizerInfo {
+        name: NONE,
+        slot: Slot::Output,
+        kind: Kind::InProcess,
+        licence: "Apache-2.0 (built in)",
+        homepage: "",
+    },
+];
+
+/// Selectable optimizers per slot, plus in-process implementations.
+#[derive(Clone)]
+pub struct Registry {
+    input: BTreeMap<String, Arc<dyn InputOptimizer>>,
+    context: BTreeMap<String, Arc<dyn ContextOptimizer>>,
+    output: BTreeMap<String, Arc<dyn OutputOptimizer>>,
+}
+
+impl Default for Registry {
+    fn default() -> Self {
+        let mut r = Registry {
+            input: BTreeMap::new(),
+            context: BTreeMap::new(),
+            output: BTreeMap::new(),
+        };
+        r.register_input(Arc::new(NoneOptimizer));
+        r.register_context(Arc::new(NoneOptimizer));
+        r.register_output(Arc::new(NoneOptimizer));
+        r
+    }
+}
+
+impl Registry {
+    pub fn register_input(&mut self, o: Arc<dyn InputOptimizer>) {
+        self.input.insert(o.name().to_string(), o);
+    }
+    pub fn register_context(&mut self, o: Arc<dyn ContextOptimizer>) {
+        self.context.insert(o.name().to_string(), o);
+    }
+    pub fn register_output(&mut self, o: Arc<dyn OutputOptimizer>) {
+        self.output.insert(o.name().to_string(), o);
+    }
+
+    /// In-process input optimizer by name. `None` for proxy kinds.
+    pub fn input(&self, name: &str) -> Option<Arc<dyn InputOptimizer>> {
+        self.input.get(name).cloned()
+    }
+    pub fn context(&self, name: &str) -> Option<Arc<dyn ContextOptimizer>> {
+        self.context.get(name).cloned()
+    }
+    pub fn output(&self, name: &str) -> Option<Arc<dyn OutputOptimizer>> {
+        self.output.get(name).cloned()
+    }
+
+    /// Names selectable in `slot`: the catalog plus anything registered.
+    pub fn names(&self, slot: Slot) -> Vec<String> {
+        let mut names: Vec<String> = CATALOG
+            .iter()
+            .filter(|i| i.slot == slot)
+            .map(|i| i.name.to_string())
+            .collect();
+        let registered: Vec<&String> = match slot {
+            Slot::Input => self.input.keys().collect(),
+            Slot::Context => self.context.keys().collect(),
+            Slot::Output => self.output.keys().collect(),
+        };
+        for n in registered {
+            if !names.contains(n) {
+                names.push(n.clone());
+            }
+        }
+        names
+    }
+
+    /// Catalog entry for `name` in `slot`, if it is a known optimizer.
+    pub fn info(&self, slot: Slot, name: &str) -> Option<&'static OptimizerInfo> {
+        CATALOG.iter().find(|i| i.slot == slot && i.name == name)
+    }
+
+    /// Reject a name that is not selectable in `slot`, listing the choices.
+    pub fn validate(&self, slot: Slot, name: &str) -> Result<()> {
+        let names = self.names(slot);
+        anyhow::ensure!(
+            names.iter().any(|n| n == name),
+            "'{name}' is not an optimizer for the {slot} slot. Choose one of: {}",
+            names.join(", ")
+        );
+        Ok(())
+    }
+}
+
+/// Every optimizer TA knows about, for `ta compression status` and docs.
+pub fn catalog() -> &'static [OptimizerInfo] {
+    CATALOG
+}
+
+// ── Config ──────────────────────────────────────────────────────────────
+
+/// One slot's selection: `[optimizers.<slot>] use = "<name>"`.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SlotConfig {
+    #[serde(rename = "use")]
+    pub use_: String,
+}
+
+/// `[optimizers]` in `daemon.toml`.
+///
+/// The input slot defaults to `headroom`, which is what ran before slots
+/// existed; the other two default to `none`.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct OptimizersConfig {
+    pub input: SlotConfig,
+    pub context: SlotConfig,
+    pub output: SlotConfig,
+}
+
+impl Default for OptimizersConfig {
+    fn default() -> Self {
+        Self {
+            input: SlotConfig {
+                use_: "headroom".to_string(),
+            },
+            context: SlotConfig {
+                use_: NONE.to_string(),
+            },
+            output: SlotConfig {
+                use_: NONE.to_string(),
+            },
+        }
+    }
+}
+
+impl Default for SlotConfig {
+    fn default() -> Self {
+        Self {
+            use_: NONE.to_string(),
+        }
+    }
+}
+
+impl OptimizersConfig {
+    pub fn selected(&self, slot: Slot) -> &str {
+        match slot {
+            Slot::Input => &self.input.use_,
+            Slot::Context => &self.context.use_,
+            Slot::Output => &self.output.use_,
+        }
+    }
+
+    fn set(&mut self, slot: Slot, name: String) {
+        let target = match slot {
+            Slot::Input => &mut self.input,
+            Slot::Context => &mut self.context,
+            Slot::Output => &mut self.output,
+        };
+        target.use_ = name;
+    }
+
+    /// Check every slot names a selectable optimizer.
+    pub fn validate(&self, registry: &Registry) -> Result<()> {
+        for slot in Slot::ALL {
+            registry
+                .validate(slot, self.selected(slot))
+                .with_context(|| format!("invalid [optimizers.{slot}] use in .ta/daemon.toml"))?;
+        }
+        Ok(())
+    }
+
+    /// Apply replay overrides (`--set optimizers.input.use=none`). Keys that do
+    /// not start with `optimizers.` are ignored; a bad slot, field or value is
+    /// an error that names the valid choices.
+    pub fn with_overrides(
+        &self,
+        overrides: &serde_json::Value,
+        registry: &Registry,
+    ) -> Result<OptimizersConfig> {
+        let mut cfg = self.clone();
+        for (slot, name) in parse_overrides(overrides, registry)? {
+            cfg.set(slot, name);
+        }
+        Ok(cfg)
+    }
+}
+
+/// Pull the `optimizers.<slot>.use` entries out of a golden-replay override
+/// object and validate them.
+pub fn parse_overrides(
+    overrides: &serde_json::Value,
+    registry: &Registry,
+) -> Result<Vec<(Slot, String)>> {
+    let mut found = Vec::new();
+    let Some(map) = overrides.as_object() else {
+        return Ok(found);
+    };
+    for (key, value) in map {
+        let Some(rest) = key.strip_prefix("optimizers.") else {
+            continue;
+        };
+        let (slot_name, field) = rest.split_once('.').unwrap_or((rest, ""));
+        let slot = Slot::ALL
+            .into_iter()
+            .find(|s| s.as_str() == slot_name)
+            .with_context(|| {
+                format!(
+                    "--set {key}: '{slot_name}' is not an optimizer slot. Slots are: input, context, output"
+                )
+            })?;
+        anyhow::ensure!(
+            field == "use",
+            "--set {key}: only 'use' can be set on a slot. Example: --set optimizers.{slot}.use=none"
+        );
+        let name = value.as_str().with_context(|| {
+            format!("--set {key}: the value must be an optimizer name, got {value}")
+        })?;
+        registry
+            .validate(slot, name)
+            .with_context(|| format!("--set {key}={name}"))?;
+        found.push((slot, name.to_string()));
+    }
+    Ok(found)
+}
