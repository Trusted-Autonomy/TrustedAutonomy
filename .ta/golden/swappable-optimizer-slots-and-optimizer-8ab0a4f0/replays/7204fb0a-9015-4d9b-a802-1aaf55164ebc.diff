+/// Lines describing restarts and the last failure for `ta compression status`.
+fn failure_lines(status: &OptimizerStatusFile, display_name: &str) -> Vec<String> {
+    let mut lines = vec![format!("  Restarts:       {}", status.restart_count)];
+    if let Some(reason) = &status.last_failure {
+        let when = status
+            .last_failure_at
+            .as_deref()
+            .map(|t| format!(" at {t}"))
+            .unwrap_or_default();
+        lines.push(format!("  Last failure:   {reason}{when}"));
+    }
+    if status.status == "disabled_for_session" || status.status == "suspended" {
+        lines.push(format!(
+            "\n  ⚠ {display_name} failed repeatedly and is disabled for this session; agents run \
+             without it.\n  To try again:  ta compression enable\n  To stop using it:  set \
+             [optimizers.input] use = \"none\" in .ta/daemon.toml"
+        ));
+    }
+    lines
+}
