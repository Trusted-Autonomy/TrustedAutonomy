+/// The proxy the input slot should supervise, or `None` when the slot is off.
+///
+/// `headroom` uses the built-in defaults, or the `[compression.plugin]` block
+/// when one exists (configs written before slots existed keep working).
+/// `rtk` and `proxy` have no built-in command line, so they need the block.
+pub fn resolve_input_plugin(
+    compression: &CompressionConfig,
+    optimizers: &ta_context_opt::OptimizersConfig,
+) -> Result<Option<PromptOptimizerPluginConfig>, String> {
+    match optimizers.input.use_.as_str() {
+        ta_context_opt::NONE => Ok(None),
+        "headroom" => Ok(Some(compression.effective_plugin())),
+        other @ ("rtk" | "proxy") => match compression.plugin {
+            Some(ref p) => Ok(Some(p.clone())),
+            None => Err(format!(
+                "[optimizers.input] use = \"{other}\" needs a [compression.plugin] block in \
+                 .ta/daemon.toml that gives its command, args, proxy_base_url and health_endpoint. \
+                 Add the block, or set use = \"headroom\" or \"none\"."
