-#[allow(clippy::too_many_arguments)]
-fn build_context_content(
-    title: &str,
-    goal_id: &str,
-    plan_phase: Option<&str>,
-    source_dir: Option<&Path>,
-    parent_goal_id: Option<uuid::Uuid>,
-    goal_store: &ta_goal::GoalRunStore,
