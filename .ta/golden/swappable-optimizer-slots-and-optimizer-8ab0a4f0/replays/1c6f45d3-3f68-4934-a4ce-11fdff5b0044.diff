+/// The `[optimizers]` section of daemon.toml (empty when absent or unreadable).
+fn load_optimizers(workspace_root: &Path) -> ta_context_opt::OptimizersConfig {
+    #[derive(serde::Deserialize, Default)]
+    #[serde(default)]
+    struct File {
+        optimizers: ta_context_opt::OptimizersConfig,
+    }
+    std::fs::read_to_string(workspace_root.join(".ta").join("daemon.toml"))
+        .ok()
+        .and_then(|raw| toml::from_str::<File>(&raw).ok())
+        .map(|f| f.optimizers)
+        .unwrap_or_default()
+}
+
+/// Print the three optimizer slots with the chosen optimizer and its licence.
+fn print_slots(workspace_root: &Path, plugin_name: &str) {
+    use ta_context_opt::{OptimizerRegistry, Slot};
+    let mut registry = OptimizerRegistry::with_defaults();
+    registry.register_proxy(plugin_name, "see the plugin's own licence");
+    let explicit = load_optimizers(workspace_root).explicit();
+    println!("  Optimizer slots:");
+    for slot in Slot::ALL {
+        let (name, source) = match explicit.get(&slot) {
+            Some(n) => (n.clone(), "optimizers config"),
+            None if slot == Slot::Input => (plugin_name.to_string(), "[compression] default"),
+            None => ("none".to_string(), "default"),
+        };
+        match registry.info(slot, &name) {
+            Ok(info) => println!(
+                "    {:<8} {} ({:?}, licence: {}; {})",
+                slot, info.name, info.kind, info.license, source
+            ),
+            Err(e) => println!("    {:<8} {}", slot, e),
+        }
+    }
