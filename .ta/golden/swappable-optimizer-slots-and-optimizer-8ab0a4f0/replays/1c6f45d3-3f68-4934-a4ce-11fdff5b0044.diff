+//! Per-slot optimizer registry and selection.
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+
+use serde::{Deserialize, Serialize};
+
+use crate::{NoneOptimizer, Optimizer, Slot};
+
+/// Prefix of the experiment-override keys: `optimizers.<slot>.use`.
+pub const OVERRIDE_KEY_PREFIX: &str = "optimizers";
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum OptimizerKind {
+    /// Passes data through untouched.
+    Passthrough,
+    /// Runs as a local HTTP proxy in front of the model API
+    /// (`[compression.plugin]`). Reduction happens in the proxy process.
+    Proxy,
+    /// Reduces text in-process through [`Optimizer::reduce`].
+    Inline,
+}
+
+/// What is known about a registered optimizer, for `ta compression status`
+/// and the docs. The licence is recorded per optimizer.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct OptimizerInfo {
+    pub name: String,
+    pub slot: Slot,
+    pub kind: OptimizerKind,
+    /// SPDX identifier, or a note when it has not been verified yet.
+    pub license: String,
+}
+
+#[derive(Debug, thiserror::Error, PartialEq, Eq)]
+pub enum RegistryError {
+    #[error(
+        "unknown {slot} optimizer '{name}'. Registered for this slot: {known}. \
+         Set `optimizers.{slot}.use` (daemon.toml or `--set`) to one of them."
+    )]
+    Unknown {
+        slot: Slot,
+        name: String,
+        known: String,
+    },
+    #[error("optimizers.{slot}.use must be a string, got {got}")]
+    NotAString { slot: Slot, got: String },
+}
+
+struct Entry {
+    info: OptimizerInfo,
+    /// Present for `Passthrough` and `Inline`; a `Proxy` has no in-process half.
+    imp: Option<Arc<dyn Optimizer>>,
+}
+
+/// Optimizers registered per slot.
+pub struct OptimizerRegistry {
+    entries: BTreeMap<(u8, String), Entry>,
+}
+
+fn slot_ord(slot: Slot) -> u8 {
+    match slot {
+        Slot::Input => 0,
+        Slot::Context => 1,
+        Slot::Output => 2,
+    }
+}
+
+impl OptimizerRegistry {
+    /// Registry with `none` in every slot and the known open-source input
+    /// proxies (`headroom`, `rtk`). Licences for those two are not verified
+    /// in this repository; confirm upstream before bundling either.
+    pub fn with_defaults() -> Self {
+        let mut r = Self {
+            entries: BTreeMap::new(),
+        };
+        for slot in Slot::ALL {
+            r.insert(
+                OptimizerInfo {
+                    name: "none".into(),
+                    slot,
+                    kind: OptimizerKind::Passthrough,
+                    license: "Apache-2.0 (built in)".into(),
+                },
+                Some(Arc::new(NoneOptimizer)),
+            );
+        }
+        for name in ["headroom", "rtk"] {
+            r.insert(
+                OptimizerInfo {
+                    name: name.into(),
+                    slot: Slot::Input,
+                    kind: OptimizerKind::Proxy,
+                    license: "unverified: confirm upstream before bundling".into(),
+                },
+                None,
+            );
+        }
+        r
+    }
+
+    fn insert(&mut self, info: OptimizerInfo, imp: Option<Arc<dyn Optimizer>>) {
+        self.entries.insert(
+            (slot_ord(info.slot), info.name.clone()),
+            Entry { info, imp },
+        );
+    }
+
+    /// Register an in-process optimizer for a slot, replacing any entry of
+    /// the same name.
+    pub fn register_inline(
+        &mut self,
+        slot: Slot,
+        license: &str,
+        imp: Arc<dyn Optimizer>,
+    ) -> &mut Self {
+        let info = OptimizerInfo {
+            name: imp.name().to_string(),
+            slot,
+            kind: OptimizerKind::Inline,
+            license: license.to_string(),
+        };
+        self.insert(info, Some(imp));
+        self
+    }
+
+    /// Register the `[compression.plugin]` proxy as a `proxy` optimizer of
+    /// the input slot under its configured name.
+    pub fn register_proxy(&mut self, name: &str, license: &str) -> &mut Self {
+        self.insert(
+            OptimizerInfo {
+                name: name.to_string(),
+                slot: Slot::Input,
+                kind: OptimizerKind::Proxy,
+                license: license.to_string(),
+            },
+            None,
+        );
+        self
+    }
+
+    pub fn names(&self, slot: Slot) -> Vec<String> {
+        self.entries
+            .iter()
+            .filter(|((s, _), _)| *s == slot_ord(slot))
+            .map(|((_, n), _)| n.clone())
+            .collect()
+    }
+
+    pub fn info(&self, slot: Slot, name: &str) -> Result<&OptimizerInfo, RegistryError> {
+        self.entry(slot, name).map(|e| &e.info)
+    }
+
+    /// The in-process half of an optimizer. `Ok(None)` for a proxy.
+    pub fn get(&self, slot: Slot, name: &str) -> Result<Option<Arc<dyn Optimizer>>, RegistryError> {
+        self.entry(slot, name).map(|e| e.imp.clone())
+    }
+
+    fn entry(&self, slot: Slot, name: &str) -> Result<&Entry, RegistryError> {
+        self.entries
+            .get(&(slot_ord(slot), name.to_string()))
+            .ok_or_else(|| RegistryError::Unknown {
+                slot,
+                name: name.to_string(),
+                known: self.names(slot).join(", "),
+            })
+    }
+}
+
+/// The chosen optimizer name for one slot and where the choice came from.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SlotSelection {
+    pub name: String,
+    pub from_override: bool,
+}
+
+/// The resolved choice for all three slots.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Selection {
+    pub input: SlotSelection,
+    pub context: SlotSelection,
+    pub output: SlotSelection,
+}
+
+impl Selection {
+    pub fn get(&self, slot: Slot) -> &SlotSelection {
+        match slot {
+            Slot::Input => &self.input,
+            Slot::Context => &self.context,
+            Slot::Output => &self.output,
+        }
+    }
+}
+
+/// Resolve each slot: an experiment override `optimizers.<slot>.use` (as set
+/// by `ta golden replay --set`) wins over the configured name. Every name is
+/// checked against the registry, so a typo fails loudly instead of silently
+/// running the baseline.
+pub fn resolve_selection(
+    registry: &OptimizerRegistry,
+    configured: &BTreeMap<Slot, String>,
+    overrides: Option<&serde_json::Value>,
+) -> Result<Selection, RegistryError> {
+    let pick = |slot: Slot| -> Result<SlotSelection, RegistryError> {
+        let key = format!("{OVERRIDE_KEY_PREFIX}.{slot}.use");
+        let (name, from_override) = match overrides.and_then(|o| o.get(&key)) {
+            Some(serde_json::Value::String(s)) => (s.clone(), true),
+            Some(other) => {
+                return Err(RegistryError::NotAString {
+                    slot,
+                    got: other.to_string(),
+                })
+            }
+            None => (
+                configured
+                    .get(&slot)
+                    .cloned()
+                    .unwrap_or_else(|| "none".to_string()),
+                false,
+            ),
+        };
+        registry.info(slot, &name)?;
+        Ok(SlotSelection {
+            name,
+            from_override,
+        })
+    };
+    Ok(Selection {
+        input: pick(Slot::Input)?,
+        context: pick(Slot::Context)?,
+        output: pick(Slot::Output)?,
+    })
+}
+
+/// One slot's configuration: `[optimizers.<slot>] use = "<name>"`.
+#[derive(Debug, Default, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct SlotConfig {
+    #[serde(rename = "use", skip_serializing_if = "Option::is_none")]
+    pub use_: Option<String>,
+}
+
+/// The `[optimizers]` section of `daemon.toml`. Shared by the daemon and the
+/// CLI so both read the same shape. An absent slot means the existing
+/// behaviour: the input slot is the `[compression]` proxy, the others `none`.
+#[derive(Debug, Default, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct OptimizersConfig {
+    pub input: SlotConfig,
+    pub context: SlotConfig,
+    pub output: SlotConfig,
+}
+
+impl OptimizersConfig {
+    /// Names set explicitly, by slot.
+    pub fn explicit(&self) -> BTreeMap<Slot, String> {
+        let mut m = BTreeMap::new();
+        for (slot, cfg) in [
+            (Slot::Input, &self.input),
+            (Slot::Context, &self.context),
+            (Slot::Output, &self.output),
+        ] {
+            if let Some(name) = &cfg.use_ {
+                m.insert(slot, name.clone());
+            }
+        }
+        m
+    }
+}
