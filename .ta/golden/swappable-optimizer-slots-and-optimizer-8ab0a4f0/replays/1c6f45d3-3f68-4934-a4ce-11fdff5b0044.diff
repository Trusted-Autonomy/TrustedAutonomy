+//! # ta-context-opt
+//!
+//! Input, context and output optimization behind one abstraction, so an
+//! open-source tool (RTK, headroom) can be started with and replaced later.
+//!
+//! | Slot | Trait | What it reduces |
+//! |------|-------|-----------------|
+//! | input | [`InputOptimizer`] | what goes to the model: prompts, tool results |
+//! | context | [`ContextOptimizer`] | accumulated conversation or file context |
+//! | output | [`OutputOptimizer`] | what comes back: logs, command output |
+//!
+//! Each slot is chosen by name through an [`OptimizerRegistry`]. `none` is
+//! always registered and is the baseline for comparing any other choice.
+//!
+//! Every reduction is reversible: [`apply`] keeps the full original on disk
+//! and records a [`Metrics`] row whose `original_ref` recovers it through
+//! [`recover`].
+
+mod registry;
+mod store;
+
+pub use registry::{
+    resolve_selection, OptimizerInfo, OptimizerKind, OptimizerRegistry, OptimizersConfig,
+    RegistryError, Selection, SlotConfig, SlotSelection, OVERRIDE_KEY_PREFIX,
+};
+pub use store::{apply, recover, StoreError};
+
+use serde::{Deserialize, Serialize};
+
+/// The three places an optimizer can sit.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Slot {
+    Input,
+    Context,
+    Output,
+}
+
+impl Slot {
+    pub const ALL: [Slot; 3] = [Slot::Input, Slot::Context, Slot::Output];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Slot::Input => "input",
+            Slot::Context => "context",
+            Slot::Output => "output",
+        }
+    }
+}
+
+impl std::fmt::Display for Slot {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(self.as_str())
+    }
+}
+
+/// What an optimizer produced for one piece of text.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Reduction {
+    pub text: String,
+    /// True when `text` carries exactly the information of the input.
+    pub lossless: bool,
+}
+
+/// Behaviour shared by every slot. Slot traits add nothing beyond the
+/// slot they belong to, so an implementation can serve several slots.
+pub trait Optimizer: Send + Sync {
+    /// Registry name, as used in `optimizers.<slot>.use`.
+    fn name(&self) -> &str;
+    /// Reduce `input`. Must not fail the caller's work: an optimizer that
+    /// cannot reduce returns the input unchanged with `lossless: true`.
+    fn reduce(&self, input: &str) -> Reduction;
+}
+
+/// Optimizes what is sent to the model.
+pub trait InputOptimizer: Optimizer {}
+/// Optimizes accumulated context.
+pub trait ContextOptimizer: Optimizer {}
+/// Optimizes what comes back from the model or tools.
+pub trait OutputOptimizer: Optimizer {}
+
+/// The `none` optimizer: passes everything through untouched.
+#[derive(Debug, Default, Clone, Copy)]
+pub struct NoneOptimizer;
+
+impl Optimizer for NoneOptimizer {
+    fn name(&self) -> &str {
+        "none"
+    }
+    fn reduce(&self, input: &str) -> Reduction {
+        Reduction {
+            text: input.to_string(),
+            lossless: true,
+        }
+    }
+}
+impl InputOptimizer for NoneOptimizer {}
+impl ContextOptimizer for NoneOptimizer {}
+impl OutputOptimizer for NoneOptimizer {}
+
+/// One measurement of one reduction.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct Metrics {
+    pub slot: Slot,
+    pub optimizer: String,
+    pub bytes_in: u64,
+    pub bytes_out: u64,
+    pub est_tokens_in: u64,
+    pub est_tokens_out: u64,
+    pub ms: u64,
+    pub lossless: bool,
+    /// File name (inside the store directory) holding the full original.
+    /// `None` when the output equals the input, so there is nothing to recover.
+    pub original_ref: Option<String>,
+}
+
+/// Rough token estimate (4 bytes per token). Used for comparison between
+/// optimizers, not for billing.
+pub fn estimate_tokens(bytes: u64) -> u64 {
+    bytes.div_ceil(4)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::BTreeMap;
+    use std::sync::Arc;
+
+    struct Squash;
+    impl Optimizer for Squash {
+        fn name(&self) -> &str {
+            "squash"
+        }
+        fn reduce(&self, input: &str) -> Reduction {
+            Reduction {
+                text: input.split_whitespace().collect::<Vec<_>>().join(" "),
+                lossless: false,
+            }
+        }
+    }
+
+    #[test]
+    fn none_is_the_baseline_and_keeps_no_original() {
+        let dir = tempfile::tempdir().unwrap();
+        let (out, m) = apply(Slot::Input, &NoneOptimizer, "a  b\n c", dir.path()).unwrap();
+        assert_eq!(out, "a  b\n c");
+        assert_eq!(m.bytes_in, m.bytes_out);
+        assert!(m.lossless);
+        assert_eq!(m.original_ref, None);
+        assert_eq!(std::fs::read_dir(dir.path()).unwrap().count(), 0);
+    }
+
+    #[test]
+    fn metrics_and_original_recovery() {
+        let dir = tempfile::tempdir().unwrap();
+        let input = "one   two\n\nthree     four";
+        let (out, m) = apply(Slot::Output, &Squash, input, dir.path()).unwrap();
+        assert_eq!(out, "one two three four");
+        assert_eq!(m.slot, Slot::Output);
+        assert_eq!(m.optimizer, "squash");
+        assert_eq!(m.bytes_in, input.len() as u64);
+        assert_eq!(m.bytes_out, out.len() as u64);
+        assert_eq!(m.est_tokens_in, estimate_tokens(m.bytes_in));
+        assert!(m.est_tokens_out < m.est_tokens_in);
+        assert!(!m.lossless);
+        let r = m.original_ref.expect("a reduction keeps its original");
+        assert_eq!(recover(dir.path(), &r).unwrap(), input);
+    }
+
+    #[test]
+    fn recover_rejects_path_traversal_and_reports_missing() {
+        let dir = tempfile::tempdir().unwrap();
+        assert!(matches!(
+            recover(dir.path(), "../../etc/passwd"),
+            Err(StoreError::BadReference(_))
+        ));
+        let missing = format!("{}.orig", "0".repeat(64));
+        let err = recover(dir.path(), &missing).unwrap_err().to_string();
+        assert!(err.contains("pruned"), "{err}");
+    }
+
+    #[test]
+    fn unwritable_store_refuses_the_reduction() {
+        let dir = tempfile::tempdir().unwrap();
+        let blocker = dir.path().join("file");
+        std::fs::write(&blocker, "x").unwrap();
+        let err = apply(Slot::Input, &Squash, "a   b", &blocker.join("sub")).unwrap_err();
+        assert!(err.to_string().contains("not applied"), "{err}");
+    }
+
+    #[test]
+    fn slot_selection_defaults_config_and_override() {
+        let reg = OptimizerRegistry::with_defaults();
+        let sel = resolve_selection(&reg, &BTreeMap::new(), None).unwrap();
+        assert_eq!(sel.input.name, "none");
+        assert_eq!(sel.context.name, "none");
+
+        let mut cfg = BTreeMap::new();
+        cfg.insert(Slot::Input, "headroom".to_string());
+        let sel = resolve_selection(&reg, &cfg, None).unwrap();
+        assert_eq!(sel.input.name, "headroom");
+        assert!(!sel.input.from_override);
+
+        let ov = serde_json::json!({"optimizers.input.use": "none"});
+        let sel = resolve_selection(&reg, &cfg, Some(&ov)).unwrap();
+        assert_eq!(sel.input.name, "none");
+        assert!(sel.input.from_override);
+        assert!(!sel.output.from_override);
+
+        let ov = serde_json::json!({"optimizers.input.use": "rtk"});
+        assert_eq!(
+            resolve_selection(&reg, &cfg, Some(&ov)).unwrap().input.name,
+            "rtk"
+        );
+    }
+
+    #[test]
+    fn unknown_or_mistyped_selection_fails_loudly() {
+        let reg = OptimizerRegistry::with_defaults();
+        let ov = serde_json::json!({"optimizers.input.use": "headrom"});
+        let err = resolve_selection(&reg, &BTreeMap::new(), Some(&ov)).unwrap_err();
+        assert!(err.to_string().contains("headroom, none, rtk"), "{err}");
+        let ov = serde_json::json!({"optimizers.output.use": "rtk"});
+        assert!(resolve_selection(&reg, &BTreeMap::new(), Some(&ov)).is_err());
+        let ov = serde_json::json!({"optimizers.input.use": 3});
+        assert!(matches!(
+            resolve_selection(&reg, &BTreeMap::new(), Some(&ov)),
+            Err(RegistryError::NotAString { .. })
+        ));
+    }
+
+    #[test]
+    fn config_section_parses_use_key() {
+        let cfg: OptimizersConfig =
+            serde_json::from_str(r#"{"input":{"use":"rtk"},"output":{"use":"none"}}"#).unwrap();
+        let m = cfg.explicit();
+        assert_eq!(m.get(&Slot::Input).map(String::as_str), Some("rtk"));
+        assert_eq!(m.get(&Slot::Output).map(String::as_str), Some("none"));
+        assert!(!m.contains_key(&Slot::Context));
+        assert!(OptimizersConfig::default().explicit().is_empty());
+    }
+
+    #[test]
+    fn plugin_proxy_is_the_proxy_kind_of_the_input_slot() {
+        let mut reg = OptimizerRegistry::with_defaults();
+        reg.register_proxy("my-proxy", "MIT");
+        let info = reg.info(Slot::Input, "my-proxy").unwrap();
+        assert_eq!(info.kind, OptimizerKind::Proxy);
+        assert!(reg.info(Slot::Output, "my-proxy").is_err());
+    }
+
+    #[test]
+    fn inline_registration_and_licences_recorded() {
+        let mut reg = OptimizerRegistry::with_defaults();
+        reg.register_inline(Slot::Output, "MIT", Arc::new(Squash));
+        assert!(reg.get(Slot::Output, "squash").unwrap().is_some());
+        assert_eq!(reg.info(Slot::Output, "squash").unwrap().license, "MIT");
+        // proxies have no in-process half
+        assert!(reg.get(Slot::Input, "headroom").unwrap().is_none());
+        for slot in Slot::ALL {
+            for n in reg.names(slot) {
+                assert!(!reg.info(slot, &n).unwrap().license.is_empty());
+            }
+        }
+    }
+}
