+//! Reversible application of an optimizer: the original is kept on disk.
+
+use std::path::Path;
+use std::time::Instant;
+
+use sha2::{Digest, Sha256};
+
+use crate::{estimate_tokens, Metrics, Optimizer, Slot};
+
+#[derive(Debug, thiserror::Error)]
+pub enum StoreError {
+    #[error(
+        "cannot keep the original under {path}: {source}. \
+         The reduction was not applied; check the directory is writable or choose `use = \"none\"`."
+    )]
+    Write {
+        path: String,
+        source: std::io::Error,
+    },
+    #[error(
+        "original '{reference}' not found under {dir}: {source}. \
+         It may have been pruned; the reduced text cannot be reversed without it."
+    )]
+    Read {
+        reference: String,
+        dir: String,
+        source: std::io::Error,
+    },
+    #[error("'{0}' is not a valid original reference (expected '<sha256>.orig')")]
+    BadReference(String),
+}
+
+/// Run `optimizer` over `input`, keeping the full original in `store_dir`
+/// whenever the output differs from it. Returns the text to use and the
+/// metrics row. If the original cannot be saved the input is returned
+/// unchanged, so a reduction is never applied without a way back.
+pub fn apply(
+    slot: Slot,
+    optimizer: &dyn Optimizer,
+    input: &str,
+    store_dir: &Path,
+) -> Result<(String, Metrics), StoreError> {
+    let started = Instant::now();
+    let reduction = optimizer.reduce(input);
+    let ms = started.elapsed().as_millis() as u64;
+
+    let changed = reduction.text != input;
+    let original_ref = if changed {
+        let digest = Sha256::digest(input.as_bytes());
+        let name = format!("{}.orig", hex(&digest));
+        let path = store_dir.join(&name);
+        std::fs::create_dir_all(store_dir)
+            .and_then(|_| {
+                if path.exists() {
+                    Ok(())
+                } else {
+                    std::fs::write(&path, input)
+                }
+            })
+            .map_err(|source| StoreError::Write {
+                path: path.display().to_string(),
+                source,
+            })?;
+        Some(name)
+    } else {
+        None
+    };
+
+    let bytes_in = input.len() as u64;
+    let bytes_out = reduction.text.len() as u64;
+    let metrics = Metrics {
+        slot,
+        optimizer: optimizer.name().to_string(),
+        bytes_in,
+        bytes_out,
+        est_tokens_in: estimate_tokens(bytes_in),
+        est_tokens_out: estimate_tokens(bytes_out),
+        ms,
+        lossless: reduction.lossless,
+        original_ref,
+    };
+    Ok((reduction.text, metrics))
+}
+
+/// Read back the full original named by [`Metrics::original_ref`].
+pub fn recover(store_dir: &Path, original_ref: &str) -> Result<String, StoreError> {
+    let valid = original_ref
+        .strip_suffix(".orig")
+        .is_some_and(|h| h.len() == 64 && h.bytes().all(|b| b.is_ascii_hexdigit()));
+    if !valid {
+        return Err(StoreError::BadReference(original_ref.to_string()));
+    }
+    std::fs::read_to_string(store_dir.join(original_ref)).map_err(|source| StoreError::Read {
+        reference: original_ref.to_string(),
+        dir: store_dir.display().to_string(),
+        source,
+    })
+}
+
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
