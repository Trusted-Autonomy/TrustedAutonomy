-        let dir = tempfile::tempdir().unwrap();
-        let _ = std::process::Command::new("git")
-            .args(["init"])
-            .current_dir(dir.path())
-            .env_remove("GIT_DIR")
-            .env_remove("GIT_WORK_TREE")
-            .env_remove("GIT_INDEX_FILE")
-            .env_remove("GIT_COMMON_DIR")
-            .output();
-        let _ = std::process::Command::new("git")
