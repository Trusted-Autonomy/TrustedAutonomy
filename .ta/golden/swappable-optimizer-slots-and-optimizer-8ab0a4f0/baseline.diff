+/// `TA_KEEP_TRANSCRIPT` set to `1`, `true` or `yes`.
+fn keep_transcript_env() -> bool {
+    std::env::var("TA_KEEP_TRANSCRIPT")
+        .map(|v| matches!(v.trim().to_ascii_lowercase().as_str(), "1" | "true" | "yes"))
+        .unwrap_or(false)
