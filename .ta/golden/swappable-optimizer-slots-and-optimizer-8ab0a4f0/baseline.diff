-    channel: &dyn ta_runtime::AgentContextChannel,
-) -> anyhow::Result<()> {
-    let wp_path = match std::env::var("TA_WORK_PLAN_JSON_PATH") {
-        Ok(p) if !p.is_empty() => std::path::PathBuf::from(p),
