+// ── .mcp.json injection for macro goals (#60) ──────────────────
+
+pub(crate) const MCP_JSON_PATH: &str = ".mcp.json";
+pub(crate) const MCP_JSON_BACKUP: &str = ".ta/mcp_json_original";
+
+/// Inject TA MCP server config into a directory's `.mcp.json`.
+///
+/// This allows agents to call TA's MCP tools (ta_plan, ta_goal,
+/// ta_draft, ta_context). Without this, the agent sees tool documentation
+/// in CLAUDE.md but has no MCP server configured to handle the calls.
+///
+/// Used by both `ta run --macro` (staging workspace) and `ta dev` (project root).
+pub(crate) fn inject_mcp_server_config(staging_path: &Path) -> anyhow::Result<()> {
+    let mcp_json_path = staging_path.join(MCP_JSON_PATH);
+    let backup_path = staging_path.join(MCP_JSON_BACKUP);
+
+    // §4.2 constitution fix: if a backup already exists (follow-up reusing parent staging),
+    // restore the original .mcp.json first so we inject on top of the real file, not a
+    // stale previously-injected copy.
+    if backup_path.exists() {
+        let saved_original = std::fs::read_to_string(&backup_path)?;
+        if saved_original == NO_ORIGINAL_SENTINEL {
+            if mcp_json_path.exists() {
+                std::fs::remove_file(&mcp_json_path)?;
+            }
+        } else {
+            std::fs::write(&mcp_json_path, &saved_original)?;
+        }
+    }
+
+    // Save original content (or sentinel if file doesn't exist).
+    let original_content = if mcp_json_path.exists() {
+        std::fs::read_to_string(&mcp_json_path)?
+    } else {
+        NO_ORIGINAL_SENTINEL.to_string()
+    };
+
+    let backup_dir = staging_path.join(".ta");
+    std::fs::create_dir_all(&backup_dir)?;
+    std::fs::write(&backup_path, &original_content)?;
+
+    // Build the MCP config with TA server entry.
+    // Resolve the `ta` binary path for the server command.
+    let ta_binary = std::env::current_exe()
+        .ok()
+        .map(|p| p.display().to_string())
+        .unwrap_or_else(|| "ta".to_string());
+
+    let ta_server_entry = serde_json::json!({
+        "command": ta_binary,
+        "args": ["serve"],
+        "env": {
+            "TA_PROJECT_ROOT": staging_path.display().to_string(),
+            "TA_IS_STAGING": "1"
+        }
+    });
+
+    // Write a minimal MCP config with only the `ta` server — do NOT merge with
+    // the original .mcp.json. The original file typically contains project-level
+    // servers (e.g. claude-flow) that are not needed inside staging and would
+    // trigger Claude Code's per-project MCP approval dialog for every new staging
+    // path. Memory and community tools are native tools on the "ta" server itself
+    // (see write_stable_agent_mcp_config); claude-flow is never needed inside an
+    // agent run.
+    let mcp_config = serde_json::json!({
+        "mcpServers": {
+            "ta": ta_server_entry
+        }
+    });
+
+    std::fs::write(&mcp_json_path, serde_json::to_string_pretty(&mcp_config)?)?;
+    Ok(())
+}
+
+/// Write a stable MCP config at `project_root/.ta/mcp-agent.json`.
+///
+/// This file has content that NEVER changes between goal runs — no `TA_PROJECT_ROOT`
+/// env var that would differ per staging UUID. When `ta serve` is launched by Claude
+/// Code as an MCP subprocess, it inherits the cwd (= staging_path) from Claude and
+/// discovers the project root that way.
+///
+/// Claude Code keys MCP approval per server config. A stable config = approved once,
+/// never re-prompted. A staging-path-scoped config = new UUID per run = re-prompt
+/// on every single goal.
+///
+/// Call this after inject_mcp_server_config, which sets up the staging .mcp.json
+/// for backup/restore. That writes to staging/.mcp.json; this writes the stable
+/// copy used for the actual --mcp-config flag. Memory (ta_context) and community
+/// (community_*) tools are native tools on the "ta" server itself — no separate
+/// ta-memory / ta-community-hub MCP server entries are needed.
+pub(crate) fn write_stable_agent_mcp_config(
+    project_root: &Path,
+    meridian_binary: Option<&str>,
+) -> anyhow::Result<()> {
+    let ta_binary = std::env::current_exe()
+        .ok()
+        .map(|p| p.display().to_string())
+        .unwrap_or_else(|| "ta".to_string());
+
+    // No TA_PROJECT_ROOT — ta serve inherits Claude's cwd (staging_path) at launch time.
+    // TA_IS_STAGING=1 prevents re-entrant goal creation from inside a goal.
+    let ta_server = serde_json::json!({
+        "command": ta_binary,
+        "args": ["serve"],
+        // The whiteboard session reaches the gateway through the agent's own
+        // environment (the daemon hands `ta run` a per-role token); the config
+        // holds only the placeholders, so no token is ever written to disk.
+        // `:-` defaults keep the config valid for goals with no session.
+        "env": {
+            "TA_IS_STAGING": "1",
+            "TA_WHITEBOARD_TOKEN": "${TA_WHITEBOARD_TOKEN:-}",
+            "TA_WHITEBOARD_TEAM_SESSION": "${TA_WHITEBOARD_TEAM_SESSION:-}",
+            "TA_WHITEBOARD_SOURCE_DIR": "${TA_WHITEBOARD_SOURCE_DIR:-}"
+        }
+    });
+
+    let mut servers = serde_json::Map::new();
+    servers.insert("ta".to_string(), ta_server);
+
+    if let Some(binary) = meridian_binary {
+        // Meridian MCP sidecar: agents get meridian_report, meridian_analyze,
+        // meridian_kpis, meridian_suggest as native tool calls.
+        // Uses the resolved binary path (which may differ from bare "meridian" on
+        // Windows or when configured via TA_MERIDIAN_BINARY / daemon.toml).
+        let meridian_server = serde_json::json!({
+            "command": binary,
+            "args": ["serve"]
+        });
+        servers.insert("meridian-analytics".to_string(), meridian_server);
+    }
+
+    let config = serde_json::json!({ "mcpServers": servers });
+    let ta_dir = project_root.join(".ta");
+    std::fs::create_dir_all(&ta_dir)?;
+    std::fs::write(
+        ta_dir.join("mcp-agent.json"),
+        serde_json::to_string_pretty(&config)?,
+    )?;
+    Ok(())
+}
+
+/// Team-session role launches receive their whiteboard session in the
+/// environment of this process (`TA_WHITEBOARD_TOKEN`,
+/// `TA_WHITEBOARD_TEAM_SESSION`, `TA_WHITEBOARD_SOURCE_DIR`), minted per role
+/// by the daemon at launch. Nothing is written to disk: the token must never
+/// appear in any file under the project's `.ta/` (red-team CR-03). The agent
+/// forwards it to the `ta serve` MCP gateway via `${TA_WHITEBOARD_TOKEN:-}`
+/// in `mcp-agent.json`.
+///
+/// This only reports, loudly, when a `--team-session-id` launch arrived
+/// without a token; the goal still runs, without `ta_whiteboard_*` tools.
+#[derive(Debug, PartialEq, Eq)]
+enum WhiteboardEnvStatus {
+    NotATeamLaunch,
+    Present,
+    Missing,
+}
+
+fn whiteboard_env_status(
+    team_session_id: Option<&str>,
+    env: &dyn Fn(&str) -> Option<String>,
+) -> WhiteboardEnvStatus {
+    if team_session_id.is_none() {
+        return WhiteboardEnvStatus::NotATeamLaunch;
+    }
+    let set = |k: &str| env(k).is_some_and(|v| !v.trim().is_empty());
+    if set("TA_WHITEBOARD_TOKEN")
+        && set("TA_WHITEBOARD_TEAM_SESSION")
+        && set("TA_WHITEBOARD_SOURCE_DIR")
+    {
+        WhiteboardEnvStatus::Present
+    } else {
+        WhiteboardEnvStatus::Missing
+    }
+}
+
+fn check_whiteboard_env(team_session_id: Option<&str>) {
+    if whiteboard_env_status(team_session_id, &|k| std::env::var(k).ok())
+        == WhiteboardEnvStatus::Missing
+    {
+        tracing::warn!(
+            team_session = ?team_session_id,
+            "ta run --team-session-id: no whiteboard token in the environment (TA_WHITEBOARD_TOKEN, \
+             TA_WHITEBOARD_TEAM_SESSION, TA_WHITEBOARD_SOURCE_DIR). The daemon sets these for each \
+             role when the project has `[whiteboard] enabled = true`; ta_whiteboard_* MCP tools will \
+             be unavailable for this goal. Launch the role through the daemon, or enable the whiteboard."
+        );
+    }
+}
+
+/// Restore the original `.mcp.json` after agent exits.
+///
+/// Used by both `ta run --macro` (before diff) and `ta dev` (cleanup).
+pub(crate) fn restore_mcp_server_config(staging_path: &Path) -> anyhow::Result<()> {
+    let mcp_json_path = staging_path.join(MCP_JSON_PATH);
+    let backup_path = staging_path.join(MCP_JSON_BACKUP);
+
+    if backup_path.exists() {
+        let original = std::fs::read_to_string(&backup_path)?;
+        if original == NO_ORIGINAL_SENTINEL {
+            if mcp_json_path.exists() {
+                std::fs::remove_file(&mcp_json_path)?;
+            }
+        } else {
+            std::fs::write(&mcp_json_path, original)?;
+        }
+        std::fs::remove_file(&backup_path)?;
+    } else {
+        // No TA-server backup, but ta-memory / ta-community-hub may still have been injected.
+        // Remove injected keys if present so they don't pollute the source.
+        if mcp_json_path.exists() {
+            if let Ok(content) = std::fs::read_to_string(&mcp_json_path) {
+                if let Ok(mut val) = serde_json::from_str::<serde_json::Value>(&content) {
+                    let removed = val
+                        .get_mut("mcpServers")
+                        .and_then(|s| s.as_object_mut())
+                        .map(|s| {
+                            let r1 = s.remove("ta-memory").is_some();
+                            let r2 = s.remove("ta-community-hub").is_some();
+                            r1 || r2
+                        })
+                        .unwrap_or(false);
+                    if removed {
+                        if let Ok(cleaned) = serde_json::to_string_pretty(&val) {
+                            let _ = std::fs::write(&mcp_json_path, cleaned);
+                        }
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
