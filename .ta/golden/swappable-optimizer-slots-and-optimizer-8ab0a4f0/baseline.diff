-                phase_id,
-                phase_id,
-                phase_id,
-                String::from_utf8_lossy(&out.stderr).trim()
-            );
-        }
-        None => {
-            anyhow::bail!(
-                "Failed to run `git push` for in_progress commit (phase {}).\n\
-                 Ensure git is installed and accessible on PATH.",
-                phase_id
-            );
