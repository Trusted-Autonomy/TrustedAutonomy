+pub const METRIC_CADENCES: [&str; 4] = ["none", "daily", "weekly", "monthly"];
+pub const METRIC_KINDS: [&str; 2] = ["task_count", "external"];
+pub const METRIC_AGGREGATIONS: [&str; 2] = ["sum", "latest"];
