+    #[serde(default)]
+    pub source_ref: Option<String>,
+    /// When true the KPI is org-wide. By default it is tied to this
+    /// project (the project pinned in `[plan.wayfinder]`).
+    #[serde(default)]
+    pub org_wide: Option<bool>,
