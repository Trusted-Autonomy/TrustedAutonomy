+    /// `POST /api/orgs/:org_id/kpis`.
+    pub fn create_org_kpi(
+        &self,
+        req: &CreateOrgKpiRequest,
+    ) -> Result<CreatedResource, WayfinderWriteError> {
+        let mut url = self.base_url.clone();
+        {
+            let mut path = url
+                .path_segments_mut()
+                .expect("base_url is validated to be a path-having http(s) URL");
+            path.push("api")
+                .push("orgs")
+                .push(&self.org_id)
+                .push("kpis");
+        }
+        self.post_create(url, req, RIGHT_KPIS_MANAGE, ORG_KPI_CONFLICT_FIX)
+    }
+
+    fn post_create<B: Serialize>(
+        &self,
+        url: Url,
+        body: &B,
+        right: &'static str,
+        conflict_fix: &'static str,
+    ) -> Result<CreatedResource, WayfinderWriteError> {
+        let route = url.path().to_string();
+        let response = self
+            .http
+            .post(url)
+            .bearer_auth(self.secret.expose_secret())
+            .json(body)
+            .send()
+            .map_err(|source| {
+                if source.is_timeout() {
+                    WayfinderWriteError::Timeout {
+                        route: route.clone(),
+                        timeout: self.timeout,
+                    }
+                } else {
+                    WayfinderWriteError::Request {
+                        route: route.clone(),
+                        message: source.without_url().to_string(),
+                    }
+                }
+            })?;
+        let status = response.status();
+        if status.is_success() {
+            let value: serde_json::Value =
+                response
+                    .json()
+                    .map_err(|source| WayfinderWriteError::Request {
+                        route: route.clone(),
+                        message: format!("response was not valid JSON: {}", source.without_url()),
+                    })?;
+            let Some(id) = value.get("id").and_then(|v| v.as_str()) else {
+                return Err(WayfinderWriteError::Request {
+                    route,
+                    message: format!("{status} response carried no string `id`"),
+                });
+            };
+            return Ok(CreatedResource {
+                id: id.to_string(),
+                created: status == reqwest::StatusCode::CREATED,
+            });
+        }
+        let detail = error_detail(response);
+        Err(match status {
+            s if s == reqwest::StatusCode::UNAUTHORIZED => {
+                WayfinderWriteError::Unauthorized { route }
+            }
+            s if s == reqwest::StatusCode::FORBIDDEN => {
+                WayfinderWriteError::Forbidden { route, right }
+            }
+            s if s == reqwest::StatusCode::NOT_FOUND => {
+                WayfinderWriteError::NotFound { route, detail }
+            }
+            s if s == reqwest::StatusCode::CONFLICT => WayfinderWriteError::Conflict {
+                route,
+                detail,
+                fix: conflict_fix,
+            },
+            s if s == reqwest::StatusCode::BAD_REQUEST
+                || s == reqwest::StatusCode::UNPROCESSABLE_ENTITY =>
+            {
+                WayfinderWriteError::Rejected {
+                    route,
+                    status,
+                    detail,
+                }
+            }
+            _ => WayfinderWriteError::UnexpectedStatus {
+                route,
+                status,
+                detail,
+            },
+        })
+    }
+}
