+/// One goal/KPI create or datapoint. Returns (summary, returned id).
+fn replay_planning_one(
+    client: &WayfinderClient,
+    kind: ProposeKind,
+    p: &serde_json::Value,
+    external_id: String,
+    ids: &HashMap<usize, String>,
+    unavailable: &HashMap<usize, String>,
+) -> anyhow::Result<(String, String)> {
+    let num = |key: &str| -> anyhow::Result<f64> {
+        p.get(key)
+            .and_then(|v| v.as_f64())
+            .ok_or_else(|| anyhow::anyhow!("pending action is missing numeric parameter `{key}`"))
+    };
+    let status = |r: &ta_plan_wayfinder::CreatedResource| {
+        if r.created {
+            "created"
+        } else {
+            "already existed (idempotent repeat)"
+        }
+    };
+    match kind {
+        ProposeKind::GoalCreate => {
+            let parent = match str_param(p, "parent_goal_id") {
+                Some(v) => Some(resolve_id(v, ids, unavailable)?),
+                None => None,
+            };
+            let name = required(p, "name")?;
+            let r = client.create_goal(&CreateGoalRequest {
+                name: name.to_string(),
+                description: str_param(p, "description").map(str::to_string),
+                kind: required(p, "kind")?.to_string(),
+                parent_goal_id: parent,
+                target_date: str_param(p, "target_date").map(str::to_string),
+                external_id: Some(external_id.clone()),
+            })?;
+            Ok((
+                format!(
+                    "goal {} \"{name}\" {} (external_id {external_id})",
+                    r.id,
+                    status(&r)
+                ),
+                r.id,
+            ))
+        }
+        ProposeKind::KpiMetricCreate => {
+            let goal_id = resolve_id(required(p, "goal_id")?, ids, unavailable)?;
+            let label = required(p, "label")?;
+            let r = client.create_kpi_metric(
+                &goal_id,
+                &CreateKpiMetricRequest {
+                    label: label.to_string(),
+                    unit: required(p, "unit")?.to_string(),
+                    target: num("target")?,
+                    cadence: required(p, "cadence")?.to_string(),
+                    kind: required(p, "kind")?.to_string(),
+                    aggregation: required(p, "aggregation")?.to_string(),
+                    require_gate: p
+                        .get("require_gate")
+                        .and_then(|v| v.as_bool())
+                        .unwrap_or(false),
+                    weight: p.get("weight").and_then(|v| v.as_f64()).unwrap_or(1.0),
+                    external_id: Some(external_id.clone()),
+                },
+            )?;
+            Ok((
+                format!(
+                    "KPI metric {} \"{label}\" on goal {goal_id} {} (external_id {external_id})",
+                    r.id,
+                    status(&r)
+                ),
+                r.id,
+            ))
+        }
+        ProposeKind::KpiDatapointAdd => {
+            let metric_id = resolve_id(required(p, "metric_id")?, ids, unavailable)?;
+            let value = num("value")?;
+            let r = client.add_kpi_datapoint(
+                &metric_id,
+                &AddKpiDatapointRequest {
+                    value,
+                    source: str_param(p, "source").unwrap_or("manual").to_string(),
+                    external_id: Some(external_id.clone()),
+                },
+            )?;
+            Ok((
+                format!(
+                    "datapoint {value} on metric {metric_id} {} (external_id {external_id})",
+                    status(&r)
+                ),
+                r.id,
+            ))
+        }
+        ProposeKind::KpiCreate => {
+            let label = required(p, "label")?;
+            let r = client.create_org_kpi(&CreateOrgKpiRequest {
+                project_id: str_param(p, "project_id").map(str::to_string),
+                label: label.to_string(),
+                description: str_param(p, "description").unwrap_or("").to_string(),
+                weight: p.get("weight").and_then(|v| v.as_f64()).unwrap_or(1.0),
+                created_by: str_param(p, "created_by")
+                    .unwrap_or(ta_mcp_gateway::tools::wayfinder_task::KPI_CREATED_BY)
+                    .to_string(),
+                source_ref: str_param(p, "source_ref").map(str::to_string),
+                external_id: Some(external_id.clone()),
+            })?;
+            Ok((
+                format!(
+                    "org KPI {} \"{label}\" {} (external_id {external_id})",
+                    r.id,
+                    status(&r)
+                ),
+                r.id,
+            ))
+        }
+        _ => anyhow::bail!("{} is not a goal/KPI proposal", kind.tool_name()),
+    }
+}
