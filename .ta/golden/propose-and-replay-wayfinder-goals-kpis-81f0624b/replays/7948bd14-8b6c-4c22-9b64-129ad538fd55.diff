+    let parent_ref = match &params.parent_goal_id {
+        Some(p) => validate_id_or_ref(kind, "parent_goal_id", p)?,
+        None => None,
+    };
+    if let Some(d) = &params.target_date {
+        validate_date(kind, "target_date", d)?;
+    }
+
+    capture_with(
+        state,
+        kind,
+        &params.goal_run_id,
+        |_, action_id, existing| {
+            if let Some(n) = parent_ref {
+                check_ref(kind, "parent_goal_id", n, existing, ProposeKind::GoalCreate)?;
+            }
+            let mut description = format!(
+                "Propose creating goal \"{}\" (kind {})",
+                params.name, params.kind
