+/// Replays the goal/KPI proposals in declared order. See the module docs.
+fn replay_planning_actions(
+    config: &GatewayConfig,
+    draft_id: &str,
+    actions: &[PendingAction],
+    summary: &mut ReplaySummary,
+) {
+    let ours: Vec<(usize, ProposeKind, &PendingAction)> = actions
+        .iter()
+        .enumerate()
+        .filter_map(|(i, a)| {
+            ProposeKind::from_tool_name(&a.tool_name)
+                .filter(|k| k.is_planning())
+                .map(|k| (i, k, a))
+        })
+        .collect();
+    if ours.is_empty() {
+        return;
+    }
+    let ledger_path = config.workspace_root.join(".ta").join(LEDGER_FILE);
+    let ledger = read_ledger_ids(&ledger_path);
+
+    let approved = |a: &PendingAction| {
+        !matches!(
+            a.disposition,
+            ArtifactDisposition::Rejected | ArtifactDisposition::Discuss
+        )
+    };
+    let needs_client = ours
+        .iter()
+        .any(|(_, _, a)| approved(a) && !ledger.contains_key(&a.action_id.to_string()));
+    let client = if needs_client {
+        match load_client(config, ours.len()) {
+            Some(c) => Some(c),
+            None => {
+                summary.backend_unavailable = true;
+                return;
+            }
+        }
+    } else {
+        None
+    };
+
+    let mut ids: HashMap<usize, String> = HashMap::new();
+    let mut unavailable: HashMap<usize, String> = HashMap::new();
+    let (mut replayed, mut failed, mut already) = (0usize, 0usize, 0usize);
+
+    for (index, kind, action) in ours {
+        let key = action.action_id.to_string();
+        if !approved(action) {
+            tracing::info!(
+                action_id = %action.action_id,
+                tool_name = %action.tool_name,
+                disposition = %action.disposition,
+                "not replaying goal/KPI proposal: reviewer did not approve this action"
+            );
+            summary.skipped_by_reviewer += 1;
+            unavailable.insert(index, "the reviewer did not approve".to_string());
+            continue;
+        }
+        if let Some(returned) = ledger.get(&key) {
+            tracing::info!(
+                action_id = %action.action_id,
+                tool_name = %action.tool_name,
+                index,
+                "skipping goal/KPI proposal: already replayed against Wayfinder (ledger hit)"
+            );
+            already += 1;
+            if let Some(id) = returned
+                .as_ref()
+                .filter(|_| kind != ProposeKind::KpiDatapointAdd)
+            {
+                ids.insert(index, id.clone());
+            }
+            continue;
+        }
+        let Some(client) = client.as_ref() else {
+            continue;
+        };
+        let external_id = planning_external_id(draft_id, index);
+        match replay_planning_one(
+            client,
+            kind,
+            &action.parameters,
+            external_id,
+            &ids,
+            &unavailable,
+        ) {
+            Ok((what, id)) => {
+                println!("  [applied] Wayfinder: {what}");
+                replayed += 1;
+                if let Err(e) = append_ledger(&ledger_path, &format!("{key}\t{id}")) {
+                    tracing::warn!(
+                        action_id = %action.action_id,
+                        tool_name = %action.tool_name,
+                        path = %ledger_path.display(),
+                        error = %e,
+                        "replayed goal/KPI proposal but could not record its id in the replay \
+                         ledger; a re-apply repeats it under the same external_id (safe) but \
+                         later ref:<n> steps need the ledger"
+                    );
+                }
+                ids.insert(index, id);
+            }
+            Err(e) => {
+                failed += 1;
+                unavailable.insert(index, format!("failed ({})", action.tool_name));
+                tracing::warn!(
+                    action_id = %action.action_id,
+                    tool_name = %action.tool_name,
+                    index,
+                    error = %e,
+                    "failed to replay approved goal/KPI proposal against Wayfinder"
+                );
+                eprintln!(
+                    "  [failed] Wayfinder {} (draft action {index}, ref:{index}): {e}\n           \
+                     Steps that reference ref:{index} were not attempted. The rest of the draft \
+                     is applied. Fix the cause above, then re-run `ta draft apply` for this \
+                     draft (finished steps are not repeated), or make the change in Wayfinder \
+                     by hand.",
+                    action.tool_name,
+                );
+            }
+        }
+    }
+
+    summary.replayed += replayed;
+    summary.failed += failed;
+    summary.already_replayed += already;
+    if replayed + failed + already > 0 {
+        println!(
+            "  Wayfinder goal/KPI proposals: {replayed} applied, {failed} failed, {already} already applied earlier"
+        );
     }
 }
 
