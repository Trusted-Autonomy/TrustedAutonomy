+/// Resolves a real id or `ref:<n>` parameter to a Wayfinder id.
+/// `unavailable` maps an action index to why it produced no id.
+fn resolve_id(
+    value: &str,
+    ids: &HashMap<usize, String>,
+    unavailable: &HashMap<usize, String>,
+) -> anyhow::Result<String> {
+    if !value.starts_with(REF_PREFIX) {
+        return Ok(value.to_string());
+    }
+    let Some(n) = parse_ref(value) else {
+        anyhow::bail!("`{value}` is not a valid reference (expected ref:<n>)");
+    };
+    if let Some(id) = ids.get(&n) {
+        return Ok(id.clone());
+    }
+    match unavailable.get(&n) {
+        Some(why) => anyhow::bail!("depends on {value} (action {n}), which {why}"),
+        None => anyhow::bail!(
+            "{value} does not name an earlier goal/KPI proposal that produced an id \
+             (action {n} is not a replayed goal or metric create)"
+        ),
+    }
+}
