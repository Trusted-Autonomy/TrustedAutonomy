+/// A reference must point at an EARLIER action of the right tool. Returns
+/// that action so a caller can inspect its parameters.
+fn check_ref<'a>(
+    kind: ProposeKind,
+    field: &str,
+    index: usize,
+    existing: &'a [PendingAction],
+    expect: ProposeKind,
+) -> Result<&'a PendingAction, McpError> {
+    let Some(target) = existing.get(index) else {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} ref:{index} points at no earlier proposal (this draft has {} so far); \
+                 a reference must name an earlier proposal in the same draft",
+                existing.len()
+            ),
+        ));
+    };
+    if target.tool_name != expect.tool_name() {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} ref:{index} is a {} proposal, but this needs a {} proposal",
+                target.tool_name,
+                expect.tool_name()
+            ),
+        ));
+    }
+    Ok(target)
+}
