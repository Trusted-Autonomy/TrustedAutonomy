+/// Finite and within +-[`MAX_ABS_VALUE`].
+fn validate_number(kind: ProposeKind, field: &str, value: f64) -> Result<(), McpError> {
+    if !value.is_finite() || value.abs() > MAX_ABS_VALUE {
+        return Err(invalid(
+            kind,
+            format!("{field} must be a finite number within +-1e12 (got {value})"),
+        ));
+    }
+    Ok(())
+}
+
+fn validate_choice(
+    kind: ProposeKind,
+    field: &str,
+    value: &str,
+    allowed: &[&str],
+) -> Result<(), McpError> {
+    if allowed.contains(&value) {
+        return Ok(());
+    }
+    Err(invalid(
+        kind,
+        format!(
+            "{field} {value:?} is not one of: {} (Wayfinder's closed list)",
+            allowed.join(", ")
+        ),
+    ))
+}
+
+/// Lowercase slug: letters, digits, '_' and '-', non-empty, at most `max`.
+fn validate_slug(kind: ProposeKind, field: &str, value: &str, max: usize) -> Result<(), McpError> {
+    if value.is_empty()
+        || value.len() > max
+        || !value
+            .chars()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_' || c == '-')
+    {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} must be 1 to {max} lowercase ASCII letters, digits, '_' or '-' \
+                 (e.g. \"objective\")"
+            ),
+        ));
+    }
+    Ok(())
+}
+
+fn validate_date(kind: ProposeKind, field: &str, value: &str) -> Result<(), McpError> {
+    let ok = value.len() == 10 && chrono::NaiveDate::parse_from_str(value, "%Y-%m-%d").is_ok();
+    if ok {
+        Ok(())
+    } else {
+        Err(invalid(
+            kind,
+            format!("{field} must be a real calendar date formatted YYYY-MM-DD (got {value:?})"),
+        ))
+    }
+}
+
+/// A Wayfinder id or a `ref:<n>` reference to an earlier proposal. Returns
+/// the referenced index for a reference.
+fn validate_id_or_ref(
+    kind: ProposeKind,
+    field: &str,
+    value: &str,
+) -> Result<Option<usize>, McpError> {
+    if value.starts_with(REF_PREFIX) {
+        return parse_ref(value).map(Some).ok_or_else(|| {
+            invalid(
+                kind,
+                format!(
+                    "{field} {value:?} is not a valid reference; use ref:<n> where n is the \
+                     index returned as `ref` by the earlier proposal (e.g. ref:0)"
+                ),
+            )
+        });
+    }
+    validate_id(kind, field, value, MAX_ID_LEN)?;
+    Ok(None)
+}
