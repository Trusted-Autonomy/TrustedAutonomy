+pub fn handle_propose_goal_create(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeGoalCreateParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::GoalCreate;
+    validate_title(kind, "name", &params.name)?;
+    validate_opt_description(kind, "description", params.description.as_deref())?;
+    validate_slug(kind, "kind", &params.kind)?;
+    if let Some(p) = &params.parent_goal_id {
+        validate_id_or_ref(kind, "parent_goal_id", p)?;
+        check_ref(
+            state,
+            kind,
+            &params.goal_run_id,
+            "parent_goal_id",
+            p,
+            ProposeKind::GoalCreate,
+        )?;
+    }
+    if let Some(d) = &params.target_date {
+        if chrono::NaiveDate::parse_from_str(d, "%Y-%m-%d").is_err() || d.len() != 10 {
+            return Err(invalid(
+                kind,
+                format!("target_date {d:?} must be a real date as YYYY-MM-DD"),
+            ));
+        }
+    }
+    let description = format!(
+        "Propose creating goal \"{}\" (kind {})",
+        params.name, params.kind
+    );
+    capture(state, kind, &params.goal_run_id, |_, _| Proposal {
+        parameters: serde_json::json!({
+            "name": params.name,
+            "description": params.description,
+            "kind": params.kind,
+            "parent_goal_id": params.parent_goal_id,
+            "target_date": params.target_date,
+        }),
+        description,
+        target_uri: format!("wayfinder://goals/new/{}", params.name),
+        result: serde_json::json!({}),
+    })
+}
+
+pub fn handle_propose_kpi_metric_create(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeKpiMetricCreateParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::KpiMetricCreate;
+    validate_id_or_ref(kind, "goal_id", &params.goal_id)?;
+    check_ref(
+        state,
+        kind,
+        &params.goal_run_id,
+        "goal_id",
+        &params.goal_id,
+        ProposeKind::GoalCreate,
+    )?;
+    validate_title(kind, "label", &params.label)?;
+    validate_slug(kind, "unit", &params.unit)?;
+    validate_number(kind, "target", params.target)?;
+    validate_one_of(kind, "cadence", &params.cadence, &METRIC_CADENCES)?;
+    validate_one_of(kind, "kind", &params.kind, &METRIC_KINDS)?;
+    validate_one_of(
+        kind,
+        "aggregation",
+        &params.aggregation,
+        &METRIC_AGGREGATIONS,
+    )?;
+    let weight = params.weight.unwrap_or(1.0);
+    validate_number(kind, "weight", weight)?;
+    let description = format!(
+        "Propose KPI metric \"{}\" on goal {}: target {} {} ({}, {}, {})",
+        params.label,
+        params.goal_id,
+        params.target,
+        params.unit,
+        params.cadence,
+        params.kind,
+        params.aggregation
+    );
+    capture(state, kind, &params.goal_run_id, |_, _| Proposal {
+        parameters: serde_json::json!({
+            "goal_id": params.goal_id,
+            "label": params.label,
+            "unit": params.unit,
+            "target": params.target,
+            "cadence": params.cadence,
+            "kind": params.kind,
+            "aggregation": params.aggregation,
+            "require_gate": params.require_gate.unwrap_or(false),
+            "weight": weight,
+        }),
+        description,
+        target_uri: format!("wayfinder://goals/{}/kpi-metrics/new", params.goal_id),
+        result: serde_json::json!({}),
+    })
+}
+
+pub fn handle_propose_kpi_datapoint_add(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeKpiDatapointAddParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::KpiDatapointAdd;
+    validate_id_or_ref(kind, "metric_id", &params.metric_id)?;
+    check_ref(
+        state,
+        kind,
+        &params.goal_run_id,
+        "metric_id",
+        &params.metric_id,
+        ProposeKind::KpiMetricCreate,
+    )?;
+    validate_number(kind, "value", params.value)?;
+    let source = params.source.clone().unwrap_or_else(|| "manual".into());
+    validate_slug(kind, "source", &source)?;
+    let description = format!(
+        "Propose datapoint {} on KPI metric {} (source {source})",
+        params.value, params.metric_id
+    );
+    capture(state, kind, &params.goal_run_id, |_, _| Proposal {
+        parameters: serde_json::json!({
+            "metric_id": params.metric_id,
+            "value": params.value,
+            "source": source,
+        }),
+        description,
+        target_uri: format!("wayfinder://kpi-metrics/{}/datapoints", params.metric_id),
+        result: serde_json::json!({}),
+    })
+}
