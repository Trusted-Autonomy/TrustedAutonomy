+    /// `POST /api/orgs/:org_id/kpis` (org id from config).
+    pub fn create_org_kpi(
+        &self,
+        req: &CreateOrgKpiRequest,
+    ) -> Result<CreatedResource, WayfinderWriteError> {
+        let mut url = self.base_url.clone();
+        url.path_segments_mut()
+            .expect("base_url is validated to be a path-having http(s) URL")
+            .push("api")
+            .push("orgs")
+            .push(&self.org_id)
+            .push("kpis");
+        self.post_create(url, "kpis:manage", req)
+    }
+
+    fn post_create<B: Serialize>(
+        &self,
+        url: Url,
+        right: &'static str,
+        body: &B,
+    ) -> Result<CreatedResource, WayfinderWriteError> {
+        let route = url.path().to_string();
+        let response = self
+            .http
+            .post(url)
+            .bearer_auth(self.secret.expose_secret())
+            .json(body)
+            .send()
+            .map_err(|e| WayfinderWriteError::Request {
+                route: route.clone(),
+                message: if e.is_timeout() {
+                    format!("timed out after {:?}", self.timeout)
+                } else {
+                    e.to_string()
+                },
+            })?;
+        let status = response.status();
+        if status.is_success() {
+            return response.json().map_err(|e| WayfinderWriteError::Request {
+                route,
+                message: format!("the response was not a resource with an id: {e}"),
+            });
+        }
+        let text = response.text().unwrap_or_default();
+        let message = error_message(&text);
+        Err(match status {
+            reqwest::StatusCode::UNAUTHORIZED => WayfinderWriteError::Unauthorized { route },
+            reqwest::StatusCode::FORBIDDEN => WayfinderWriteError::Forbidden { route, right },
+            reqwest::StatusCode::CONFLICT => WayfinderWriteError::Conflict { route, message },
+            _ => WayfinderWriteError::Rejected {
+                route,
+                status,
+                message,
+            },
+        })
+    }
+}
