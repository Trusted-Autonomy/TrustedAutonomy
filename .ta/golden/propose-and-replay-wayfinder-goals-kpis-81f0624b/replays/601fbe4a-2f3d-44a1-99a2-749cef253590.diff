+/// The human-readable part of a Wayfinder error body: its `error` or
+/// `message` string when the body is JSON, else the trimmed text, capped.
+fn error_message(body: &str) -> String {
+    let from_json = serde_json::from_str::<serde_json::Value>(body)
+        .ok()
+        .and_then(|v| {
+            ["error", "message"]
+                .iter()
+                .find_map(|k| v.get(*k).and_then(|m| m.as_str()).map(str::to_string))
+        });
+    let text = from_json.unwrap_or_else(|| body.trim().to_string());
+    if text.is_empty() {
+        return "(no message in the response body)".to_string();
+    }
+    text.chars().take(300).collect()
