+/// Resolves a goal/metric id parameter: a literal id passes through, a
+/// `ref:<n>` is looked up among the ids returned earlier in this replay (or
+/// recorded in the ledger by a previous one).
+fn resolve_id(
+    value: &str,
+    created: &HashMap<usize, String>,
+    unavailable: &HashMap<usize, String>,
+) -> anyhow::Result<String> {
+    let Some(n) = parse_ref(value) else {
+        return Ok(value.to_string());
+    };
+    if let Some(id) = created.get(&n) {
+        return Ok(id.clone());
+    }
+    match unavailable.get(&n) {
+        Some(why) => anyhow::bail!(
+            "not sent: it depends on `{value}`, but {}. Fix that step, then re-run \
+             `ta draft apply` for this draft (steps that already succeeded are not repeated)",
+            why.trim_end_matches('.')
+        ),
+        None => anyhow::bail!(
+            "not sent: it depends on `{value}`, which has not produced an id (the step is \
+             missing, later in the draft, or not a goal/metric create)"
+        ),
+    }
+}
+
+fn f64_param(p: &serde_json::Value, key: &str) -> anyhow::Result<f64> {
+    p.get(key)
+        .and_then(|v| v.as_f64())
+        .ok_or_else(|| anyhow::anyhow!("pending action is missing numeric parameter `{key}`"))
+}
+
+/// Replays one goal/KPI planning create. Returns a one-line summary and the
+/// id Wayfinder returned.
+fn replay_planning(
+    client: &WayfinderClient,
+    kind: ProposeKind,
+    p: &serde_json::Value,
+    external_id: &str,
+    created: &HashMap<usize, String>,
+    unavailable: &HashMap<usize, String>,
+) -> anyhow::Result<(String, String)> {
+    match kind {
+        ProposeKind::GoalCreate => {
+            let name = required(p, "name")?;
+            let parent = match str_param(p, "parent_goal_id").filter(|s| !s.is_empty()) {
+                Some(v) => Some(resolve_id(v, created, unavailable)?),
+                None => None,
+            };
+            let r = client.create_goal(&CreateGoalRequest {
+                name: name.to_string(),
+                description: str_param(p, "description").map(str::to_string),
+                kind: required(p, "kind")?.to_string(),
+                parent_goal_id: parent,
+                target_date: str_param(p, "target_date").map(str::to_string),
+                external_id: external_id.to_string(),
+            })?;
+            Ok((
+                format!("goal {} created: {name} (external_id {external_id})", r.id),
+                r.id,
+            ))
+        }
+        ProposeKind::KpiMetricCreate => {
+            let goal_id = resolve_id(required(p, "goal_id")?, created, unavailable)?;
+            let label = required(p, "label")?;
+            let r = client.create_kpi_metric(
+                &goal_id,
+                &CreateKpiMetricRequest {
+                    label: label.to_string(),
+                    unit: required(p, "unit")?.to_string(),
+                    target: f64_param(p, "target")?,
+                    cadence: required(p, "cadence")?.to_string(),
+                    kind: required(p, "kind")?.to_string(),
+                    aggregation: required(p, "aggregation")?.to_string(),
+                    require_gate: p
+                        .get("require_gate")
+                        .and_then(|v| v.as_bool())
+                        .unwrap_or(false),
+                    weight: p.get("weight").and_then(|v| v.as_f64()).unwrap_or(1.0),
+                    external_id: external_id.to_string(),
+                },
+            )?;
+            Ok((
+                format!(
+                    "KPI metric {} created on goal {goal_id}: {label} (external_id {external_id})",
+                    r.id
+                ),
+                r.id,
+            ))
+        }
+        ProposeKind::KpiDatapointAdd => {
+            let metric_id = resolve_id(required(p, "metric_id")?, created, unavailable)?;
+            let value = f64_param(p, "value")?;
+            let r = client.add_kpi_datapoint(
+                &metric_id,
+                &AddKpiDatapointRequest {
+                    value,
+                    source: str_param(p, "source").unwrap_or("manual").to_string(),
+                    external_id: external_id.to_string(),
+                },
+            )?;
+            Ok((
+                format!(
+                    "datapoint {} added to metric {metric_id}: {value} (external_id {external_id})",
+                    r.id
+                ),
+                r.id,
+            ))
+        }
+        ProposeKind::KpiCreate => {
+            let label = required(p, "label")?;
+            let scoped = p
+                .get("project_scoped")
+                .and_then(|v| v.as_bool())
+                .unwrap_or(false);
+            let r = client.create_org_kpi(&CreateOrgKpiRequest {
+                project_id: scoped.then(|| client.project_id().to_string()),
+                label: label.to_string(),
+                description: str_param(p, "description").unwrap_or("").to_string(),
+                weight: p.get("weight").and_then(|v| v.as_f64()).unwrap_or(1.0),
+                created_by: str_param(p, "created_by")
+                    .unwrap_or("trusted-autonomy")
+                    .to_string(),
+                source_ref: str_param(p, "source_ref").map(str::to_string),
+                external_id: external_id.to_string(),
+            })?;
+            Ok((
+                format!(
+                    "org KPI {} created: {label} (external_id {external_id})",
+                    r.id
+                ),
+                r.id,
+            ))
+        }
+        other => anyhow::bail!("{} is not a planning proposal", other.tool_name()),
+    }
+}
