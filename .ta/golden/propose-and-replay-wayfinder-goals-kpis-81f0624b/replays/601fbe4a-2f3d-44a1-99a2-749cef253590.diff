+/// Lines `ta draft view` prints under a pending planning proposal, one fact
+/// per line, so a reviewer sees exactly what will be sent.
+pub fn review_lines(tool_name: &str, p: &serde_json::Value) -> Vec<String> {
+    let s = |k: &str| {
+        p.get(k)
+            .and_then(|v| v.as_str())
+            .filter(|v| !v.is_empty())
+            .unwrap_or("(none)")
+            .to_string()
+    };
+    let n = |k: &str| {
+        p.get(k)
+            .and_then(|v| v.as_f64())
+            .map(|v| v.to_string())
+            .unwrap_or_else(|| "(none)".into())
+    };
+    let r = |k: &str| {
+        let v = s(k);
+        if parse_ref(&v).is_some() {
+            format!("{v} (created earlier in this draft)")
+        } else {
+            v
+        }
+    };
+    match ProposeKind::from_tool_name(tool_name) {
+        Some(ProposeKind::GoalCreate) => vec![
+            format!("Goal: {} (kind {})", s("name"), s("kind")),
+            format!("Parent goal: {}", r("parent_goal_id")),
+            format!("Target date: {}", s("target_date")),
+            format!("Description: {}", s("description")),
+        ],
+        Some(ProposeKind::KpiMetricCreate) => vec![
+            format!("KPI metric: {} on goal {}", s("label"), r("goal_id")),
+            format!("Target: {} {} ({})", n("target"), s("unit"), s("cadence")),
+            format!(
+                "Kind: {}, aggregation {}, weight {}, gate required: {}",
+                s("kind"),
+                s("aggregation"),
+                n("weight"),
+                p.get("require_gate")
+                    .and_then(|v| v.as_bool())
+                    .unwrap_or(false)
+            ),
+        ],
+        Some(ProposeKind::KpiDatapointAdd) => vec![
+            format!("Datapoint: {} on metric {}", n("value"), r("metric_id")),
+            format!("Source: {}", s("source")),
+        ],
+        Some(ProposeKind::KpiCreate) => vec![
+            format!(
+                "KPI: {} ({}-level, weight {})",
+                s("label"),
+                if p.get("project_scoped")
+                    .and_then(|v| v.as_bool())
+                    .unwrap_or(false)
+                {
+                    "project"
+                } else {
+                    "org"
+                },
+                n("weight")
+            ),
+            format!("Created by: {}", s("created_by")),
+            format!("Source ref: {}", s("source_ref")),
+            format!("Description: {}", s("description")),
+        ],
+        _ => Vec::new(),
+    }
+}
