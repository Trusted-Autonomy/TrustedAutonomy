+fn read_ledger_ids(path: &Path) -> HashMap<String, String> {
+    std::fs::read_to_string(path)
+        .map(|s| {
+            s.lines()
+                .filter_map(|l| {
+                    let (a, id) = l.split_once('\t')?;
+                    let (a, id) = (a.trim(), id.trim());
+                    (!a.is_empty() && !id.is_empty()).then(|| (a.to_string(), id.to_string()))
+                })
+                .collect()
+        })
+        .unwrap_or_default()
+}
