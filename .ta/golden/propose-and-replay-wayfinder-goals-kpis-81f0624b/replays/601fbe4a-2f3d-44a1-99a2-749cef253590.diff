+#[derive(Debug, thiserror::Error)]
+pub enum WayfinderWriteError {
+    #[error(
+        "Wayfinder returned 401 Unauthorized for POST {route}: the service-account token is \
+         unknown or revoked. Re-issue it in Wayfinder's Settings and store it again with \
+         `ta credential add`, then re-run `ta draft apply`."
+    )]
+    Unauthorized { route: String },
+    #[error(
+        "Wayfinder returned 403 Forbidden for POST {route}: the service account lacks the \
+         `{right}` right. Grant `{right}` to the service account in Wayfinder's Settings, then \
+         re-run `ta draft apply`."
+    )]
+    Forbidden { route: String, right: &'static str },
+    #[error(
+        "Wayfinder returned 409 conflict for POST {route}: {message}. Either the same \
+         external_id was already used with a different body, the change is refused by a rule \
+         (a datapoint on a `task_count` metric, a goal cycle), or the target changed. Check the \
+         resource in Wayfinder; if it is wrong, fix it by hand or propose a corrected change."
+    )]
+    Conflict { route: String, message: String },
+    #[error(
+        "Wayfinder returned status {status} for POST {route}: {message}. Check the ids and \
+         values in the proposal, and that `project_id` and `org_id` under [plan.wayfinder] in \
+         .ta/workflow.toml are right."
+    )]
+    Rejected {
+        route: String,
+        status: reqwest::StatusCode,
+        message: String,
+    },
+    #[error(
+        "request POST {route} to Wayfinder failed: {message}. Check that `base_url` under \
+         [plan.wayfinder] in .ta/workflow.toml is correct and reachable, then re-run \
+         `ta draft apply`."
+    )]
+    Request { route: String, message: String },
