+/// `Some(n)` when `value` is a `ref:<n>` symbolic reference.
+pub fn parse_ref(value: &str) -> Option<usize> {
+    value.strip_prefix(REF_PREFIX)?.parse().ok()
+}
+
+/// The `external_id` replay sends for the planning create at position
+/// `index` of draft `draft_id`. Deterministic, so re-applying the draft is
+/// idempotent.
+pub fn planning_external_id(draft_id: &str, index: usize) -> String {
+    format!("{PLANNING_EXTERNAL_ID_PREFIX}:{draft_id}:{index}")
+}
+
+fn validate_number(kind: ProposeKind, field: &str, value: f64) -> Result<(), McpError> {
+    if !value.is_finite() || value.abs() > MAX_ABS_VALUE {
+        return Err(invalid(
+            kind,
+            format!("{field} must be a finite number within +-1e12 (got {value})"),
+        ));
+    }
+    Ok(())
+}
+
+fn validate_slug(kind: ProposeKind, field: &str, value: &str) -> Result<(), McpError> {
+    if value.is_empty()
+        || value.len() > MAX_SHORT_LEN
+        || !value
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, '_' | '-' | '.' | ' '))
+        || value.trim() != value
+    {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} must be 1 to {MAX_SHORT_LEN} ASCII letters, digits, spaces, '_', '-' or \
+                 '.', without leading or trailing spaces"
+            ),
+        ));
+    }
+    Ok(())
+}
+
+fn validate_one_of(
+    kind: ProposeKind,
+    field: &str,
+    value: &str,
+    allowed: &[&str],
+) -> Result<(), McpError> {
+    if !allowed.contains(&value) {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} must be one of {} (got {value:?})",
+                allowed.join(", ")
+            ),
+        ));
+    }
+    Ok(())
+}
+
+/// A real Wayfinder id, or a `ref:<n>` reference.
+fn validate_id_or_ref(kind: ProposeKind, field: &str, value: &str) -> Result<(), McpError> {
+    if value.starts_with(REF_PREFIX) {
+        if parse_ref(value).is_none() {
+            return Err(invalid(
+                kind,
+                format!("{field} {value:?} is not a valid reference; use ref:<n> with the index a earlier proposal returned"),
+            ));
+        }
+        return Ok(());
+    }
+    validate_id(kind, field, value, MAX_ID_LEN)
+}
+
+/// If `value` is a `ref:<n>`, checks it names an EARLIER proposal of this
+/// goal run, made with the `expected` tool; for a datapoint, also that the
+/// metric is not `task_count` (Wayfinder refuses those).
+fn check_ref(
+    state: &Arc<Mutex<GatewayState>>,
+    kind: ProposeKind,
+    goal_run_id: &str,
+    field: &str,
+    value: &str,
+    expected: ProposeKind,
+) -> Result<(), McpError> {
+    let Some(n) = parse_ref(value) else {
+        return Ok(());
+    };
+    let goal_id = parse_goal_id(kind, goal_run_id)?;
+    let guard = state
+        .lock()
+        .map_err(|e| McpError::internal_error(format!("lock poisoned: {e}"), None))?;
+    let list = guard
+        .pending_actions
+        .get(&goal_id)
+        .map(Vec::as_slice)
+        .unwrap_or(&[]);
+    let Some(target) = list.get(n) else {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} {value} refers to a proposal that does not exist yet (this draft has {} \
+                 so far); a reference must name an earlier proposal, use the `ref` its tool \
+                 returned",
+                list.len()
+            ),
+        ));
+    };
+    if target.tool_name != expected.tool_name() {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} {value} refers to a {} proposal but a {} proposal is needed",
+                target.tool_name,
+                expected.tool_name()
+            ),
+        ));
+    }
+    if kind == ProposeKind::KpiDatapointAdd
+        && target.parameters.get("kind").and_then(|v| v.as_str()) == Some("task_count")
+    {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} {value} is a task_count metric; Wayfinder derives its value from tasks \
+                 and refuses datapoints (409). Propose the metric with kind \"external\" instead"
+            ),
+        ));
+    }
+    Ok(())
+}
