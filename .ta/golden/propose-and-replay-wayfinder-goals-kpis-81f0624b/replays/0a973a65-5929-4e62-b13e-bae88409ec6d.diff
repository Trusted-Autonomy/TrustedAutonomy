+pub fn handle_propose_kpi_metric_create(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeKpiMetricCreateParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::KpiMetricCreate;
+    validate_id_or_ref(kind, "goal_id", &params.goal_id)?;
+    validate_text(kind, "label", &params.label, MAX_NAME_LEN, true, true)?;
+    validate_text(kind, "unit", &params.unit, MAX_UNIT_LEN, true, true)?;
+    validate_number(kind, "target", params.target, false)?;
+    validate_choice(kind, "cadence", &params.cadence, &METRIC_CADENCES)?;
+    validate_choice(kind, "kind", &params.kind, &METRIC_KINDS)?;
+    validate_choice(
+        kind,
+        "aggregation",
+        &params.aggregation,
+        &METRIC_AGGREGATIONS,
+    )?;
+    let weight = params.weight.unwrap_or(1.0);
+    validate_number(kind, "weight", weight, true)?;
+    let require_gate = params.require_gate.unwrap_or(false);
+
+    let description = format!(
+        "Propose KPI metric \"{}\" on goal {}: target {} {} ({}, {}, {})",
+        params.label,
+        params.goal_id,
+        params.target,
+        params.unit,
+        params.cadence,
+        params.kind,
+        params.aggregation
+    );
+    let goal_ref = params.goal_id.clone();
+    capture_with(
+        state,
+        kind,
+        &params.goal_run_id,
+        |existing| check_ref(kind, "goal_id", &goal_ref, RefTarget::Goal, existing, false),
+        |_, _| Proposal {
+            parameters: serde_json::json!({
+                "goal_id": params.goal_id,
+                "label": params.label,
+                "unit": params.unit,
+                "target": params.target,
+                "cadence": params.cadence,
+                "kind": params.kind,
+                "aggregation": params.aggregation,
+                "require_gate": require_gate,
+                "weight": weight,
+            }),
+            description,
+            target_uri: format!("wayfinder://goals/{}/kpi-metrics/new", params.goal_id),
+            result: serde_json::json!({
+                "ref_hint": "pass ref:<index> as metric_id in a later datapoint proposal"
+            }),
+        },
+    )
+}
