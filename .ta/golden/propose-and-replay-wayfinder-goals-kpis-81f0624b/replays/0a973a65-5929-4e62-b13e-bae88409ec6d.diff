+/// Lines `ta draft view` prints under a goal/KPI proposal. Empty for any
+/// other tool. `index` is the action's position in the draft, shown so the
+/// reviewer can see the `external_id` apply will send and follow `ref:<n>`.
+pub fn review_lines(tool_name: &str, index: usize, p: &serde_json::Value) -> Vec<String> {
+    let Some(kind) = ProposeKind::from_tool_name(tool_name).filter(|k| k.is_planning()) else {
+        return Vec::new();
+    };
+    let get = |k: &str| {
+        p.get(k)
+            .map(|v| match v.as_str() {
+                Some(s) => s.to_string(),
+                None => v.to_string(),
+            })
+            .filter(|s| s != "null" && !s.is_empty())
+            .unwrap_or_else(|| "(none)".to_string())
+    };
+    let mut lines = vec![format!("Action #{index} (refer to it as ref:{index})")];
+    match kind {
+        ProposeKind::GoalCreate => {
+            lines.push(format!("Goal: {} ({})", get("name"), get("kind")));
+            lines.push(format!("Parent goal: {}", get("parent_goal_id")));
+            lines.push(format!("Target date: {}", get("target_date")));
+            lines.push(format!("Description: {}", get("description")));
+        }
+        ProposeKind::KpiMetricCreate => {
+            lines.push(format!(
+                "KPI metric: {} on goal {}",
+                get("label"),
+                get("goal_id")
+            ));
+            lines.push(format!("Target: {} {}", get("target"), get("unit")));
+            lines.push(format!(
+                "Cadence: {}, kind: {}, aggregation: {}",
+                get("cadence"),
+                get("kind"),
+                get("aggregation")
+            ));
+            lines.push(format!(
+                "Gate required: {}, weight: {}",
+                get("require_gate"),
+                get("weight")
+            ));
+        }
+        ProposeKind::KpiDatapointAdd => {
+            lines.push(format!(
+                "Datapoint: {} on KPI metric {}",
+                get("value"),
+                get("metric_id")
+            ));
+            lines.push(format!("Source: {}", get("source")));
+        }
+        ProposeKind::KpiCreate => {
+            lines.push(format!(
+                "Org KPI: {} (weight {})",
+                get("label"),
+                get("weight")
+            ));
+            lines.push(format!(
+                "Scope: {}",
+                if p.get("project_scoped").and_then(|v| v.as_bool()) == Some(false) {
+                    "org-wide"
+                } else {
+                    "this project"
+                }
+            ));
+            lines.push(format!("Created by: {}", get("created_by")));
+            lines.push(format!("Source ref: {}", get("source_ref")));
+            lines.push(format!("Description: {}", get("description")));
+        }
+        _ => {}
+    }
+    lines.push(format!(
+        "Sent with external_id ta_draft:<draft id>:{index} so re-applying never duplicates it."
+    ));
+    lines
+}
