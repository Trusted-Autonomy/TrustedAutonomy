+
+    fn post_create<B: Serialize>(
+        &self,
+        url: Url,
+        body: &B,
+        right: &'static str,
+    ) -> Result<CreatedResource, WayfinderWriteError> {
+        let route = url.path().to_string();
+        let response = self
+            .http
+            .post(url)
+            .bearer_auth(self.secret.expose_secret())
+            .json(body)
+            .send()
+            .map_err(|source| WayfinderWriteError::Request {
+                route: route.clone(),
+                message: source.without_url().to_string(),
+            })?;
+        let status = response.status();
+        if status.is_success() {
+            return response.json::<CreatedResource>().map_err(|source| {
+                WayfinderWriteError::Request {
+                    route,
+                    message: format!(
+                        "response had no string `id` field: {}",
+                        source.without_url()
+                    ),
+                }
+            });
+        }
+        let detail = error_detail(response);
+        Err(match status {
+            s if s == reqwest::StatusCode::UNAUTHORIZED => {
+                WayfinderWriteError::Unauthorized { route }
+            }
+            s if s == reqwest::StatusCode::FORBIDDEN => {
+                WayfinderWriteError::Forbidden { route, right }
+            }
+            s if s == reqwest::StatusCode::NOT_FOUND => WayfinderWriteError::NotFound { route },
+            s if s == reqwest::StatusCode::CONFLICT => {
+                WayfinderWriteError::Conflict { route, detail }
+            }
+            status => WayfinderWriteError::UnexpectedStatus {
+                route,
+                status,
+                detail,
+            },
+        })
+    }
+
+/// Wayfinder's own error text from a non-2xx response: the JSON `error` or
+/// `message` field when present, else the raw body, capped so a huge body
+/// cannot flood the apply output.
+fn error_detail(response: reqwest::blocking::Response) -> String {
+    let text = response.text().unwrap_or_default();
+    let from_json = serde_json::from_str::<serde_json::Value>(&text)
+        .ok()
+        .and_then(|v| {
+            ["error", "message", "detail"]
+                .iter()
+                .find_map(|k| v.get(*k).and_then(|m| m.as_str()).map(str::to_string))
+        });
+    let detail = from_json.unwrap_or(text);
+    let detail = detail.trim();
+    if detail.is_empty() {
+        return "(no message in the response body)".to_string();
+    }
+    let capped: String = detail.chars().take(500).collect();
+    capped
+}
