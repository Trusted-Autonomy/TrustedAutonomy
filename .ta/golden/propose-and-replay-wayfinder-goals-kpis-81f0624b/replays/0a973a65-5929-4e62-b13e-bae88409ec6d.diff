+/// Replays one goal/KPI proposal, returning a one-line summary and the
+/// Wayfinder id of the resource it created (recorded in the ledger so
+/// later `ref:<n>` fields resolve, including on a re-apply).
+fn replay_planning(
+    client: &WayfinderClient,
+    kind: ProposeKind,
+    p: &serde_json::Value,
+    ctx: &PlanningContext<'_>,
+) -> anyhow::Result<(String, String)> {
+    let external_id = planning_external_id(ctx.draft_id, ctx.index);
+    match kind {
+        ProposeKind::GoalCreate => {
+            let parent = match str_param(p, "parent_goal_id") {
+                Some(v) => Some(ctx.resolve("parent_goal_id", v)?),
+                None => None,
+            };
+            let name = required(p, "name")?;
+            let goal = client.create_goal(&CreateGoalRequest {
+                name: name.to_string(),
+                description: str_param(p, "description").map(str::to_string),
+                kind: str_param(p, "kind").unwrap_or("milestone").to_string(),
+                parent_goal_id: parent,
+                target_date: str_param(p, "target_date").map(str::to_string),
+                external_id: Some(external_id.clone()),
+            })?;
+            Ok((
+                format!(
+                    "goal {} \"{name}\" created/upserted (external_id {external_id})",
+                    goal.id
+                ),
+                goal.id,
+            ))
+        }
+        ProposeKind::KpiMetricCreate => {
+            let goal_id = ctx.resolve("goal_id", required(p, "goal_id")?)?;
+            let label = required(p, "label")?;
+            let metric = client.create_kpi_metric(
+                &goal_id,
+                &CreateKpiMetricRequest {
+                    label: label.to_string(),
+                    unit: required(p, "unit")?.to_string(),
+                    target: f64_param(p, "target")?,
+                    cadence: required(p, "cadence")?.to_string(),
+                    kind: required(p, "kind")?.to_string(),
+                    aggregation: required(p, "aggregation")?.to_string(),
+                    require_gate: p
+                        .get("require_gate")
+                        .and_then(|v| v.as_bool())
+                        .unwrap_or(false),
+                    weight: p.get("weight").and_then(|v| v.as_f64()).unwrap_or(1.0),
+                    external_id: Some(external_id.clone()),
+                },
+            )?;
+            Ok((
+                format!(
+                    "KPI metric {} \"{label}\" created under goal {goal_id} (external_id {external_id})",
+                    metric.id
+                ),
+                metric.id,
+            ))
+        }
+        ProposeKind::KpiDatapointAdd => {
+            let metric_id = ctx.resolve("metric_id", required(p, "metric_id")?)?;
+            let value = f64_param(p, "value")?;
+            let dp = client.add_kpi_datapoint(
+                &metric_id,
+                &AddKpiDatapointRequest {
+                    value,
+                    source: str_param(p, "source").unwrap_or("manual").to_string(),
+                    external_id: Some(external_id.clone()),
+                },
+            )?;
+            Ok((
+                format!(
+                    "datapoint {} ({value}) recorded on KPI metric {metric_id} (external_id {external_id})",
+                    dp.id
+                ),
+                dp.id,
+            ))
+        }
+        ProposeKind::KpiCreate => {
+            let label = required(p, "label")?;
+            let project_scoped = p
+                .get("project_scoped")
+                .and_then(|v| v.as_bool())
+                .unwrap_or(true);
+            let kpi = client.create_org_kpi(&CreateOrgKpiRequest {
+                project_id: project_scoped.then(|| client.project_id().to_string()),
+                label: label.to_string(),
+                description: str_param(p, "description").unwrap_or("").to_string(),
+                weight: p.get("weight").and_then(|v| v.as_f64()).unwrap_or(1.0),
+                created_by: str_param(p, "created_by")
+                    .unwrap_or("trusted-autonomy")
+                    .to_string(),
+                source_ref: str_param(p, "source_ref").map(str::to_string),
+                external_id: Some(external_id.clone()),
+            })?;
+            Ok((
+                format!(
+                    "org KPI {} \"{label}\" created (external_id {external_id})",
+                    kpi.id
+                ),
+                kpi.id,
+            ))
+        }
+        other => anyhow::bail!(
+            "internal error: {} is not a goal/KPI proposal",
+            other.tool_name()
+        ),
+    }
+}
