+/// Validates the shape of an id field that is either a real Wayfinder id or
+/// `ref:<n>`. What a ref points at is checked later, under the state lock
+/// (see [`check_ref`]).
+fn validate_id_or_ref(kind: ProposeKind, field: &str, value: &str) -> Result<(), McpError> {
+    if value.starts_with(REF_PREFIX) {
+        if ref_index(value).is_none() {
+            return Err(invalid(
+                kind,
+                format!("{field} {value:?} is not a valid reference; write ref:<n> where n is the `index` an earlier proposal returned"),
+            ));
+        }
+        return Ok(());
+    }
+    validate_id(kind, field, value, MAX_ID_LEN)
+}
