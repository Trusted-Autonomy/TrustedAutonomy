+/// Everything a planning step needs to resolve its `ref:<n>` fields.
+struct PlanningContext<'a> {
+    draft_id: &'a str,
+    index: usize,
+    actions: &'a [PendingAction],
+    created: &'a HashMap<usize, String>,
+    unresolved: &'a HashMap<usize, String>,
+}
+
+impl PlanningContext<'_> {
+    /// A real id passes through; `ref:<n>` becomes the id action `n` created.
+    fn resolve(&self, field: &str, value: &str) -> anyhow::Result<String> {
+        let Some(n) = ref_index(value) else {
+            return Ok(value.to_string());
+        };
+        if n >= self.index {
+            anyhow::bail!(
+                "{field} {value} must refer to an EARLIER action than this one (#{}); the \
+                 proposal is malformed, ask the worker to propose it again",
+                self.index
+            );
+        }
+        if let Some(id) = self.created.get(&n) {
+            return Ok(id.clone());
+        }
+        let step = self
+            .actions
+            .get(n)
+            .map(|a| a.tool_name.as_str())
+            .unwrap_or("(no such action)");
+        let why = self
+            .unresolved
+            .get(&n)
+            .map(String::as_str)
+            .unwrap_or("produced no Wayfinder id (it is not in the replay ledger)");
+        Err(BlockedByEarlierAction(format!(
+            "blocked: {field} {value} refers to action #{n} ({step}), which {why}, so this step \
+             was not attempted"
+        ))
+        .into())
+    }
+}
