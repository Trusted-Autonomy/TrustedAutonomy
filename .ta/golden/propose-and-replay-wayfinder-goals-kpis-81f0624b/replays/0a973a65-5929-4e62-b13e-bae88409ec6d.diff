+/// Finite and within +-[`MAX_ABS_NUMBER`] (NaN and infinities are rejected).
+fn validate_number(
+    kind: ProposeKind,
+    field: &str,
+    value: f64,
+    non_negative: bool,
+) -> Result<(), McpError> {
+    if !value.is_finite() || value.abs() > MAX_ABS_NUMBER {
+        return Err(invalid(
+            kind,
+            format!("{field} must be a finite number within +-1e12 (got {value})"),
+        ));
+    }
+    if non_negative && value < 0.0 {
+        return Err(invalid(kind, format!("{field} must not be negative")));
+    }
+    Ok(())
+}
+
+fn validate_choice(
+    kind: ProposeKind,
+    field: &str,
+    value: &str,
+    allowed: &[&str],
+) -> Result<(), McpError> {
+    if allowed.contains(&value) {
+        Ok(())
+    } else {
+        Err(invalid(
+            kind,
+            format!(
+                "{field} {value:?} is not valid; use one of: {}",
+                allowed.join(", ")
+            ),
+        ))
+    }
+}
+
+fn validate_slug(kind: ProposeKind, field: &str, value: &str) -> Result<(), McpError> {
+    if value.is_empty()
+        || value.len() > MAX_KIND_LEN
+        || !value
+            .chars()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_' || c == '-')
+    {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} must be a lowercase slug of at most {MAX_KIND_LEN} characters \
+                 (a-z, 0-9, '_', '-'), e.g. \"milestone\""
+            ),
+        ));
+    }
+    Ok(())
+}
+
+fn validate_date(kind: ProposeKind, field: &str, value: &str) -> Result<(), McpError> {
+    let ok = value.len() == 10 && chrono::NaiveDate::parse_from_str(value, "%Y-%m-%d").is_ok();
+    if ok {
+        Ok(())
+    } else {
+        Err(invalid(
+            kind,
+            format!("{field} must be a real date written exactly YYYY-MM-DD (got {value:?})"),
+        ))
+    }
+}
