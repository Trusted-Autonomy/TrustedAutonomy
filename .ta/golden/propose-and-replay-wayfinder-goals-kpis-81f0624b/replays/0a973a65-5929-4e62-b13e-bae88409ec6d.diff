+/// Ledger lines that carry a returned Wayfinder id: `action_id<TAB>id`.
+fn read_ledger_ids(path: &Path) -> HashMap<String, String> {
+    std::fs::read_to_string(path)
+        .map(|s| {
+            s.lines()
+                .filter_map(|l| {
+                    let (action, id) = l.split_once('\t')?;
+                    let (action, id) = (action.trim(), id.trim());
+                    (!action.is_empty() && !id.is_empty())
+                        .then(|| (action.to_string(), id.to_string()))
+                })
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+fn append_ledger_id(path: &Path, action_id: &str, created_id: &str) -> std::io::Result<()> {
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent)?;
+    }
+    let mut f = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)?;
+    writeln!(f, "{action_id}\t{created_id}")
+}
