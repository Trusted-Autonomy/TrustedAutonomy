+fn f64_param(params: &serde_json::Value, key: &str) -> anyhow::Result<f64> {
+    params
+        .get(key)
+        .and_then(|v| v.as_f64())
+        .ok_or_else(|| anyhow::anyhow!("pending action is missing numeric parameter `{key}`"))
+}
