+pub fn handle_propose_goal_create(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeGoalCreateParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::GoalCreate;
+    validate_text(kind, "name", &params.name, MAX_NAME_LEN, true, true)?;
+    if let Some(d) = &params.description {
+        validate_text(
+            kind,
+            "description",
+            d,
+            MAX_GOAL_DESCRIPTION_LEN,
+            false,
+            false,
+        )?;
+    }
+    let goal_kind = params
+        .kind
+        .clone()
+        .unwrap_or_else(|| DEFAULT_GOAL_KIND.to_string());
+    validate_slug(kind, "kind", &goal_kind)?;
+    if let Some(p) = &params.parent_goal_id {
+        validate_id_or_ref(kind, "parent_goal_id", p)?;
+    }
+    if let Some(d) = &params.target_date {
+        validate_date(kind, "target_date", d)?;
+    }
+
+    let mut description = format!("Propose creating goal \"{}\" ({goal_kind})", params.name);
+    if let Some(p) = &params.parent_goal_id {
+        description.push_str(&format!(", under goal {p}"));
+    }
+    let parent = params.parent_goal_id.clone();
+    capture_with(
+        state,
+        kind,
+        &params.goal_run_id,
+        |existing| match &parent {
+            Some(p) => check_ref(kind, "parent_goal_id", p, RefTarget::Goal, existing, false),
+            None => Ok(()),
+        },
+        |_, _| Proposal {
+            parameters: serde_json::json!({
+                "name": params.name,
+                "description": params.description,
+                "kind": goal_kind,
+                "parent_goal_id": params.parent_goal_id,
+                "target_date": params.target_date,
+            }),
+            description,
+            target_uri: "wayfinder://goals/new".to_string(),
+            result: serde_json::json!({
+                "ref_hint": "pass ref:<index> as goal_id or parent_goal_id in later proposals"
+            }),
+        },
+    )
+}
