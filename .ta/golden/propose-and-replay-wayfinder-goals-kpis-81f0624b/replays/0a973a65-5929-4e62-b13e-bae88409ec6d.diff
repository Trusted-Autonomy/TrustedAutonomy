+pub fn handle_propose_kpi_datapoint_add(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeKpiDatapointAddParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::KpiDatapointAdd;
+    validate_id_or_ref(kind, "metric_id", &params.metric_id)?;
+    validate_number(kind, "value", params.value, false)?;
+    let source = params
+        .source
+        .clone()
+        .unwrap_or_else(|| DEFAULT_DATAPOINT_SOURCE.to_string());
+    validate_id(kind, "source", &source, MAX_VERB_LEN)?;
+
+    let description = format!(
+        "Propose datapoint {} (source {source}) on KPI metric {}",
+        params.value, params.metric_id
+    );
+    let metric_ref = params.metric_id.clone();
+    capture_with(
+        state,
+        kind,
+        &params.goal_run_id,
+        |existing| {
+            check_ref(
+                kind,
+                "metric_id",
+                &metric_ref,
+                RefTarget::Metric,
+                existing,
+                true,
+            )
+        },
+        |_, _| Proposal {
+            parameters: serde_json::json!({
+                "metric_id": params.metric_id,
+                "value": params.value,
+                "source": source,
+            }),
+            description,
+            target_uri: format!(
+                "wayfinder://kpi-metrics/{}/datapoints/new",
+                params.metric_id
+            ),
+            result: serde_json::json!({}),
