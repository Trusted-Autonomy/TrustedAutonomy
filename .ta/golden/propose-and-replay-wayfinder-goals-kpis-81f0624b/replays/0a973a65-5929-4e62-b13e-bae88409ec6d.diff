+pub fn handle_propose_kpi_create(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeKpiCreateParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::KpiCreate;
+    validate_text(kind, "label", &params.label, MAX_NAME_LEN, true, true)?;
+    if let Some(d) = &params.description {
+        validate_text(
+            kind,
+            "description",
+            d,
+            MAX_GOAL_DESCRIPTION_LEN,
+            false,
+            false,
+        )?;
+    }
+    let weight = params.weight.unwrap_or(1.0);
+    validate_number(kind, "weight", weight, true)?;
+    let created_by = params
+        .created_by
+        .clone()
+        .unwrap_or_else(|| DEFAULT_CREATED_BY.to_string());
+    validate_id(kind, "created_by", &created_by, MAX_ID_LEN)?;
