+            kind,
+            format!(
+                "{field} {value} refers to an action that does not exist yet: {} proposal(s) \
+                 are captured so far (indexes 0..{}); a reference must name an EARLIER proposal",
+                existing.len(),
+                existing.len()
+            ),
+        ));
+    };
+    if earlier.tool_name != target.creator().tool_name() {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} {value} refers to action {n} ({}), but a {} reference needs a {} proposal",
+                earlier.tool_name,
+                match target {
+                    RefTarget::Goal => "goal",
+                    RefTarget::Metric => "metric",
+                },
+                target.creator().tool_name()
+            ),
+        ));
+    }
+    if veto_task_count
+        && earlier.parameters.get("kind").and_then(|v| v.as_str()) == Some("task_count")
+    {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} {value} is a task_count metric (action {n}): Wayfinder derives its \
+                 progress from tasks and refuses datapoints on it. Use kind \"external\" for the \
+                 metric, or drop this datapoint"
+            ),
+        ));
+    }
+    Ok(())
+}
