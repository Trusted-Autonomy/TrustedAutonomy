+fn error_message(response: reqwest::blocking::Response) -> String {
+    let text = response.text().unwrap_or_default();
+    let from_json = serde_json::from_str::<serde_json::Value>(&text)
+        .ok()
+        .and_then(|v| {
+            let e = v.get("error").or_else(|| v.get("message"))?;
+            match e {
+                serde_json::Value::String(s) => Some(s.clone()),
+                other => other
+                    .get("message")
+                    .and_then(|m| m.as_str())
+                    .map(str::to_string),
+            }
+        });
+    let msg = from_json.unwrap_or(text);
+    let msg = msg.trim();
+    if msg.is_empty() {
+        return "(no message in the response body)".to_string();
+    }
+    msg.chars().take(300).collect()
+}
