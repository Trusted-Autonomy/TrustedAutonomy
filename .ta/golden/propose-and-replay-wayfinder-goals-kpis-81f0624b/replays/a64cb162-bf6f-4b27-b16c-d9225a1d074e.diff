+            anyhow::bail!(
+                "{field} `{raw}` points at proposal {n} ({}), but a {} is needed here",
+                target.tool_name,
+                expected.tool_name()
+            );
+        }
+        self.returned.get(&n).cloned().ok_or_else(|| {
+            anyhow::anyhow!(
+                "{field} `{raw}` needs proposal {n} ({}), which has not been applied: it \
+                 failed, was not approved by the reviewer, or was applied without recording \
+                 its id. Fix or approve that proposal, then re-run `ta draft apply` for this \
+                 draft; this step was not attempted",
