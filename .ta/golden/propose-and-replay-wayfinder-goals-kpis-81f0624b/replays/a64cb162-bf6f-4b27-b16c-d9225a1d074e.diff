+    fn post_create<B: Serialize>(
+        &self,
+        url: Url,
+        body: &B,
+        right: &'static str,
+        noun: &str,
+    ) -> Result<CreatedResource, WayfinderWriteError> {
+        let route = url.path().to_string();
+        let response = self
+            .http
+            .post(url)
+            .bearer_auth(self.secret.expose_secret())
+            .json(body)
+            .send()
+            .map_err(|source| {
+                if source.is_timeout() {
+                    WayfinderWriteError::Timeout {
+                        route: route.clone(),
+                        timeout: self.timeout,
+                    }
+                } else {
+                    WayfinderWriteError::Request {
+                        route: route.clone(),
+                        message: source.without_url().to_string(),
+                    }
+                }
+            })?;
+        let status = response.status();
+        if status.is_success() {
+            let value: serde_json::Value =
+                response
+                    .json()
+                    .map_err(|source| WayfinderWriteError::BadResponse {
+                        route: route.clone(),
+                        message: format!("not valid JSON: {}", source.without_url()),
+                    })?;
+            return match extract_id(&value, noun) {
+                Some(id) => Ok(CreatedResource { id, body: value }),
+                None => Err(WayfinderWriteError::BadResponse {
+                    route,
+                    message: "no string `id` field".to_string(),
+                }),
+            };
+        }
+        let message = error_message(response);
+        Err(match status {
+            s if s == reqwest::StatusCode::UNAUTHORIZED => {
+                WayfinderWriteError::Unauthorized { route }
+            }
+            s if s == reqwest::StatusCode::FORBIDDEN => {
+                WayfinderWriteError::Forbidden { route, right }
+            }
+            s if s == reqwest::StatusCode::NOT_FOUND => WayfinderWriteError::NotFound { route },
+            s if s == reqwest::StatusCode::CONFLICT => {
+                WayfinderWriteError::Conflict { route, message }
+            }
+            _ => WayfinderWriteError::Rejected {
+                route,
+                status,
+                message,
+            },
+        })
+    }
