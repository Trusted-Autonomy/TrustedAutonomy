+pub fn handle_propose_goal_create(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeGoalCreateParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::GoalCreate;
+    validate_text(kind, "name", &params.name, MAX_NAME_LEN, true, true)?;
+    if let Some(d) = &params.description {
+        validate_text(kind, "description", d, MAX_PM_DESCRIPTION_LEN, false, false)?;
+    }
+    let goal_kind = params.kind.clone().unwrap_or_else(|| "milestone".into());
+    validate_slug(kind, "kind", &goal_kind, MAX_GOAL_KIND_LEN)?;
+    if let Some(p) = &params.parent_goal_id {
+        validate_id_or_ref(
+            state,
+            kind,
+            "parent_goal_id",
+            p,
+            &params.goal_run_id,
+            ProposeKind::GoalCreate,
+        )?;
+    }
+    if let Some(d) = &params.target_date {
+        validate_date(kind, "target_date", d)?;
+    }
+    let mut description = format!(
+        "Propose creating Wayfinder goal \"{}\" (kind {goal_kind})",
+        params.name
+    );
+    if let Some(p) = &params.parent_goal_id {
+        description.push_str(&format!(", under {p}"));
+    }
+    if let Some(d) = &params.target_date {
+        description.push_str(&format!(", target {d}"));
+    }
+    capture(state, kind, &params.goal_run_id, |_, _| Proposal {
+        parameters: serde_json::json!({
+            "name": params.name,
+            "description": params.description,
+            "kind": goal_kind,
+            "parent_goal_id": params.parent_goal_id,
+            "target_date": params.target_date,
+        }),
+        description,
+        target_uri: "wayfinder://goals/new".to_string(),
+        result: serde_json::json!({}),
+    })
+}
+
+pub fn handle_propose_kpi_metric_create(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeKpiMetricCreateParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::KpiMetricCreate;
+    validate_id_or_ref(
+        state,
+        kind,
+        "goal_id",
+        &params.goal_id,
+        &params.goal_run_id,
+        ProposeKind::GoalCreate,
+    )?;
+    validate_text(kind, "label", &params.label, MAX_NAME_LEN, true, true)?;
+    validate_text(kind, "unit", &params.unit, MAX_UNIT_LEN, true, true)?;
+    validate_number(kind, "target", params.target, true, false)?;
+    validate_enum(kind, "cadence", &params.cadence, &METRIC_CADENCES)?;
+    validate_enum(kind, "kind", &params.kind, &METRIC_KINDS)?;
+    let aggregation = params.aggregation.clone().unwrap_or_else(|| "sum".into());
+    validate_enum(kind, "aggregation", &aggregation, &METRIC_AGGREGATIONS)?;
+    let weight = params.weight.unwrap_or(1.0);
+    validate_number(kind, "weight", weight, false, false)?;
+    let require_gate = params.require_gate.unwrap_or(false);
+    let description = format!(
+        "Propose KPI metric \"{}\" on goal {}: target {} {} per {} ({}, {})",
+        params.label,
+        params.goal_id,
+        params.target,
+        params.unit,
+        params.cadence,
+        params.kind,
+        aggregation
+    );
+    capture(state, kind, &params.goal_run_id, |_, _| Proposal {
+        parameters: serde_json::json!({
+            "goal_id": params.goal_id,
+            "label": params.label,
+            "unit": params.unit,
+            "target": params.target,
+            "cadence": params.cadence,
+            "kind": params.kind,
+            "aggregation": aggregation,
+            "require_gate": require_gate,
+            "weight": weight,
+        }),
+        description,
+        target_uri: "wayfinder://kpi-metrics/new".to_string(),
+        result: serde_json::json!({}),
+    })
+}
