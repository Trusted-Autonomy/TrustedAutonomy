+/// The four goal/KPI kinds. Returns a one-line summary and the id the
+/// create returned (recorded in the ledger so later `ref:<n>` resolve).
+fn replay_pm_write(
+    client: &WayfinderClient,
+    kind: ProposeKind,
+    p: &serde_json::Value,
+    ctx: &PmContext,
+) -> anyhow::Result<(String, Option<String>)> {
+    let external_id = ctx.external_id();
+    match kind {
+        ProposeKind::GoalCreate => {
+            let parent_goal_id = match str_param(p, "parent_goal_id") {
+                Some(raw) => Some(ctx.resolve("parent_goal_id", raw, ProposeKind::GoalCreate)?),
+                None => None,
+            };
+            let name = required(p, "name")?;
+            let created = client.create_goal(&CreateGoalRequest {
+                name: name.to_string(),
+                description: str_param(p, "description").map(str::to_string),
+                kind: str_param(p, "kind").unwrap_or("milestone").to_string(),
+                parent_goal_id,
+                target_date: str_param(p, "target_date").map(str::to_string),
+                external_id: Some(external_id.clone()),
+            })?;
+            Ok((
+                format!(
+                    "goal \"{name}\" created as {} (external_id {})",
+                    created.id, external_id
+                ),
+                Some(created.id),
+            ))
+        }
+        ProposeKind::KpiMetricCreate => {
+            let goal_id =
+                ctx.resolve("goal_id", required(p, "goal_id")?, ProposeKind::GoalCreate)?;
+            let label = required(p, "label")?;
+            let created = client.create_kpi_metric(
+                &goal_id,
+                &CreateKpiMetricRequest {
+                    label: label.to_string(),
+                    unit: required(p, "unit")?.to_string(),
+                    target: number(p, "target")?,
+                    cadence: required(p, "cadence")?.to_string(),
+                    kind: required(p, "kind")?.to_string(),
+                    aggregation: str_param(p, "aggregation").unwrap_or("sum").to_string(),
+                    require_gate: p
+                        .get("require_gate")
+                        .and_then(|v| v.as_bool())
+                        .unwrap_or(false),
+                    weight: p.get("weight").and_then(|v| v.as_f64()).unwrap_or(1.0),
+                    external_id: Some(external_id.clone()),
+                },
+            )?;
+            Ok((
+                format!(
+                    "KPI metric \"{label}\" created as {} on goal {goal_id} (external_id {})",
+                    created.id, external_id
+                ),
+                Some(created.id),
+            ))
+        }
+        ProposeKind::KpiDatapointAdd => {
+            let metric_id = ctx.resolve(
+                "metric_id",
+                required(p, "metric_id")?,
+                ProposeKind::KpiMetricCreate,
+            )?;
+            let value = number(p, "value")?;
+            let created = client.add_kpi_datapoint(
+                &metric_id,
+                &AddKpiDatapointRequest {
+                    value,
+                    source: str_param(p, "source").unwrap_or("manual").to_string(),
+                    external_id: Some(external_id.clone()),
+                },
+            )?;
+            Ok((
+                format!(
+                    "datapoint {value} recorded as {} on metric {metric_id} (external_id {})",
+                    created.id, external_id
+                ),
+                None,
+            ))
+        }
+        ProposeKind::KpiCreate => {
+            let label = required(p, "label")?;
+            let project_scoped = p
+                .get("project_scoped")
+                .and_then(|v| v.as_bool())
+                .unwrap_or(false);
+            let created = client.create_org_kpi(&CreateOrgKpiRequest {
+                project_id: project_scoped.then(|| client.project_id().to_string()),
+                label: label.to_string(),
+                description: required(p, "description")?.to_string(),
+                weight: p.get("weight").and_then(|v| v.as_f64()).unwrap_or(1.0),
+                created_by: "virtual_team".to_string(),
+                source_ref: str_param(p, "source_ref").map(str::to_string),
+                external_id: Some(external_id.clone()),
+            })?;
+            Ok((
+                format!(
+                    "KPI \"{label}\" created as {} in org {} (external_id {})",
+                    created.id,
+                    client.org_id(),
+                    external_id
+                ),
+                None,
+            ))
+        }
+        other => anyhow::bail!("{} is not a goal/KPI proposal", other.tool_name()),
+    }
