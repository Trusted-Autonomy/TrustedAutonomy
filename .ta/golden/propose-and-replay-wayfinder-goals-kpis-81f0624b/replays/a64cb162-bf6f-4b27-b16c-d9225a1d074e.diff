+/// The new resource's id: top-level `id`, or `id` inside an envelope named
+/// for the resource (`{"goal": {"id": ..}}`).
+fn extract_id(value: &serde_json::Value, noun: &str) -> Option<String> {
+    value
+        .get("id")
+        .or_else(|| value.get(noun).and_then(|v| v.get("id")))
+        .and_then(|v| v.as_str())
+        .filter(|s| !s.is_empty())
+        .map(str::to_string)
+}
