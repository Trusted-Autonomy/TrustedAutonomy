+/// Parses `ref:<n>`. `None` when `raw` is not a reference at all.
+pub fn parse_ref(raw: &str) -> Option<Result<usize, String>> {
+    let rest = raw.strip_prefix(REF_PREFIX)?;
+    Some(match rest.parse::<usize>() {
+        Ok(n) if n <= MAX_REF_INDEX => Ok(n),
+        _ => Err(format!(
+            "`{raw}` is not a valid reference: use ref:<n> with n a whole number from 0 to \
+             {MAX_REF_INDEX}, the `ref` returned by the earlier proposal"
+        )),
+    })
+}
+
+/// A real Wayfinder id, or a reference to an earlier proposal of kind
+/// `expected` in this goal's pending list.
+fn validate_id_or_ref(
+    state: &Arc<Mutex<GatewayState>>,
+    kind: ProposeKind,
+    field: &str,
+    raw: &str,
+    goal_run_id: &str,
+    expected: ProposeKind,
+) -> Result<(), McpError> {
+    let Some(parsed) = parse_ref(raw) else {
+        return validate_id(kind, field, raw, MAX_ID_LEN);
+    };
+    let n = parsed.map_err(|m| invalid(kind, format!("{field}: {m}")))?;
+    let goal_id = parse_goal_id(kind, goal_run_id)?;
+    let guard = state
+        .lock()
+        .map_err(|e| McpError::internal_error(format!("lock poisoned: {e}"), None))?;
+    let target = guard.pending_actions.get(&goal_id).and_then(|l| l.get(n));
+    match target {
+        Some(a) if a.tool_name == expected.tool_name() => Ok(()),
+        Some(a) => Err(invalid(
+            kind,
+            format!(
+                "{field} `{raw}` points at proposal {n}, which is {} not {}; use the `ref` \
+                 returned by a {} call",
+                a.tool_name,
+                expected.tool_name(),
+                expected.tool_name()
+            ),
+        )),
+        None => Err(invalid(
+            kind,
+            format!(
+                "{field} `{raw}` points at proposal {n}, which does not exist yet in this \
+                 goal; propose the {} first and use the `ref` it returns",
+                expected.tool_name()
+            ),
+        )),
+    }
+}
+
+fn validate_number(
+    kind: ProposeKind,
+    field: &str,
+    value: f64,
+    min_exclusive_zero: bool,
+    allow_negative: bool,
+) -> Result<(), McpError> {
+    if !value.is_finite() || value.abs() > MAX_ABS_VALUE {
+        return Err(invalid(
+            kind,
+            format!("{field} must be a finite number within +-{MAX_ABS_VALUE:e}, got {value}"),
+        ));
+    }
+    if min_exclusive_zero && value <= 0.0 {
+        return Err(invalid(
+            kind,
+            format!("{field} must be greater than zero, got {value}"),
+        ));
+    }
+    if !allow_negative && value < 0.0 {
+        return Err(invalid(
+            kind,
+            format!("{field} must not be negative, got {value}"),
+        ));
+    }
+    Ok(())
+}
+
+fn validate_enum(
+    kind: ProposeKind,
+    field: &str,
+    value: &str,
+    allowed: &[&str],
+) -> Result<(), McpError> {
+    if allowed.contains(&value) {
+        Ok(())
+    } else {
+        Err(invalid(
+            kind,
+            format!(
+                "{field} `{value}` is not valid; allowed values: {}",
+                allowed.join(", ")
+            ),
+        ))
+    }
+}
+
+/// Lowercase slug of 1..=`max` chars (`[a-z0-9_-]`).
+fn validate_slug(kind: ProposeKind, field: &str, value: &str, max: usize) -> Result<(), McpError> {
+    if value.is_empty()
+        || value.len() > max
+        || !value
+            .chars()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_' || c == '-')
+    {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} must be a lowercase slug of 1-{max} characters (a-z, 0-9, '_', '-'), \
+                 e.g. \"milestone\""
+            ),
+        ));
+    }
+    Ok(())
+}
+
+/// `YYYY-MM-DD`, a real calendar date.
+fn validate_date(kind: ProposeKind, field: &str, value: &str) -> Result<(), McpError> {
+    if chrono::NaiveDate::parse_from_str(value, "%Y-%m-%d").is_err() || value.len() != 10 {
+        return Err(invalid(
+            kind,
+            format!("{field} must be a calendar date as YYYY-MM-DD, got `{value}`"),
+        ));
+    }
+    Ok(())
+}
