+pub fn ref_index(value: &str) -> Option<usize> {
+    let digits = value.strip_prefix("ref:")?;
+    if digits.is_empty() || digits.len() > 6 || !digits.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    digits.parse().ok()
