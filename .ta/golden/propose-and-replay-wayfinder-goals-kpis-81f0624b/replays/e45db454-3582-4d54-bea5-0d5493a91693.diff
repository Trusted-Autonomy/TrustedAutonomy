+/// A finite number with `|v| <= MAX_KPI_NUMBER`; `positive` additionally
+/// requires `v > 0`, `non_negative` requires `v >= 0`.
+fn validate_number(
+    kind: ProposeKind,
+    field: &str,
+    value: f64,
+    positive: bool,
+    non_negative: bool,
+) -> Result<(), McpError> {
+    if !value.is_finite() || value.abs() > MAX_KPI_NUMBER {
+        return Err(invalid(
+            kind,
+            format!("{field} must be a finite number within +-1e12, got {value}"),
+        ));
+    }
+    if positive && value <= 0.0 {
+        return Err(invalid(kind, format!("{field} must be greater than 0")));
+    }
+    if non_negative && value < 0.0 {
+        return Err(invalid(kind, format!("{field} must not be negative")));
+    }
+    Ok(())
+}
+
+fn validate_one_of(
+    kind: ProposeKind,
+    field: &str,
+    value: &str,
+    allowed: &[&str],
+) -> Result<(), McpError> {
+    if allowed.contains(&value) {
+        Ok(())
+    } else {
+        Err(invalid(
+            kind,
+            format!(
+                "{field} {value:?} is not valid; use one of: {}",
+                allowed.join(", ")
+            ),
+        ))
+    }
+}
+
+/// A lowercase slug (`[a-z0-9_-]`, bounded).
+fn validate_slug(kind: ProposeKind, field: &str, value: &str, max: usize) -> Result<(), McpError> {
+    if value.is_empty()
+        || value.len() > max
+        || !value
+            .chars()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_' || c == '-')
+    {
+        return Err(invalid(
+            kind,
+            format!("{field} must be 1-{max} lowercase letters, digits, '_' or '-'"),
+        ));
+    }
+    Ok(())
+}
+
+/// A real Wayfinder id, or a well-formed `ref:<n>`.
+fn validate_ref_or_id(kind: ProposeKind, field: &str, value: &str) -> Result<(), McpError> {
+    if value.starts_with("ref:") {
+        if ref_index(value).is_none() {
+            return Err(invalid(
+                kind,
+                format!(
+                    "{field} {value:?} is not a valid reference; use ref:<n> with the number \
+                     from the `ref` an earlier proposal returned (e.g. ref:0)"
+                ),
+            ));
+        }
+        return Ok(());
+    }
+    validate_id(kind, field, value, MAX_ID_LEN)
+}
