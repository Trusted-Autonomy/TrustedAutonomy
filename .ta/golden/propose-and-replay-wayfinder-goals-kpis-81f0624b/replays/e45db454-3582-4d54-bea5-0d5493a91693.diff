+/// One planning call. Returns a summary line and the Wayfinder id it
+/// produced (goals, metrics and KPIs), for the ledger and later refs.
+fn replay_planning_one(
+    client: &WayfinderClient,
+    kind: ProposeKind,
+    p: &serde_json::Value,
+    external_id: &str,
+    draft_id: &str,
+) -> anyhow::Result<(String, Option<String>)> {
+    let num = |key: &str| -> anyhow::Result<f64> {
+        p.get(key)
+            .and_then(|v| v.as_f64())
+            .ok_or_else(|| anyhow::anyhow!("pending action is missing numeric parameter `{key}`"))
+    };
+    match kind {
+        ProposeKind::GoalCreate => {
+            let r = client.create_goal(&CreateGoalRequest {
+                name: required(p, "name")?.to_string(),
+                description: str_param(p, "description").map(str::to_string),
+                kind: str_param(p, "kind").unwrap_or("milestone").to_string(),
+                parent_goal_id: str_param(p, "parent_goal_id").map(str::to_string),
+                target_date: str_param(p, "target_date").map(str::to_string),
+                external_id: Some(external_id.to_string()),
+            })?;
+            Ok((
+                format!(
+                    "goal {} created/upserted (external_id {external_id})",
+                    r.id.as_deref().unwrap_or("?")
+                ),
+                r.id,
+            ))
+        }
+        ProposeKind::KpiMetricCreate => {
+            let goal_id = required(p, "goal_id")?;
+            let r = client.create_kpi_metric(
+                goal_id,
+                &CreateKpiMetricRequest {
+                    label: required(p, "label")?.to_string(),
+                    unit: required(p, "unit")?.to_string(),
+                    target: num("target")?,
+                    cadence: required(p, "cadence")?.to_string(),
+                    kind: required(p, "kind")?.to_string(),
+                    aggregation: str_param(p, "aggregation").unwrap_or("sum").to_string(),
+                    require_gate: p
+                        .get("require_gate")
+                        .and_then(|v| v.as_bool())
+                        .unwrap_or(false),
+                    weight: p.get("weight").and_then(|v| v.as_f64()).unwrap_or(1.0),
+                    external_id: Some(external_id.to_string()),
+                },
+            )?;
+            Ok((
+                format!(
+                    "KPI metric {} created/upserted on goal {goal_id} (external_id {external_id})",
+                    r.id.as_deref().unwrap_or("?")
+                ),
+                r.id,
+            ))
+        }
+        ProposeKind::KpiDatapointAdd => {
+            let metric_id = required(p, "metric_id")?;
+            let value = num("value")?;
+            client.add_kpi_datapoint(
+                metric_id,
+                &AddKpiDatapointRequest {
+                    value,
+                    source: str_param(p, "source").unwrap_or("manual").to_string(),
+                    external_id: Some(external_id.to_string()),
+                },
+            )?;
+            Ok((
+                format!(
+                    "datapoint {value} recorded on metric {metric_id} (external_id {external_id})"
+                ),
+                None,
+            ))
+        }
+        ProposeKind::KpiCreate => {
+            let org_wide = p.get("org_wide").and_then(|v| v.as_bool()) == Some(true);
+            let r = client.create_org_kpi(&CreateOrgKpiRequest {
+                project_id: (!org_wide).then(|| client.project_id().to_string()),
+                label: required(p, "label")?.to_string(),
+                description: str_param(p, "description").unwrap_or("").to_string(),
+                weight: p.get("weight").and_then(|v| v.as_f64()).unwrap_or(1.0),
+                created_by: "trusted-autonomy".to_string(),
+                source_ref: Some(format!("ta_draft:{draft_id}")),
+                external_id: Some(external_id.to_string()),
+            })?;
+            Ok((
+                format!(
+                    "{} KPI {} created/upserted (external_id {external_id})",
+                    if org_wide { "org-wide" } else { "project" },
+                    r.id.as_deref().unwrap_or("?")
+                ),
+                r.id,
+            ))
+        }
+        _ => anyhow::bail!("{} is not a planning proposal", kind.tool_name()),
+    }
+}
