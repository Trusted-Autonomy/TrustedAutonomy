+/// Failure of a planning write (`POST`). Every variant names the route and
+/// what to do about it; 403 names the missing right and 409 is reported as
+/// a conflict with Wayfinder's own message.
+#[derive(Debug, thiserror::Error)]
+pub enum WayfinderWriteError {
+    #[error(
+        "Wayfinder returned 401 Unauthorized for POST {route}: the service-account token is \
+         unknown or revoked. Re-issue it in Wayfinder's Settings and store it again with \
+         `ta credential add`, then re-run `ta draft apply` for this draft."
+    )]
+    Unauthorized { route: String },
+    #[error(
+        "Wayfinder returned 403 Forbidden for POST {route}: the service account lacks the \
+         `{right}` right. Grant `{right}` to the pairing service account in Wayfinder's \
+         Settings, then re-run `ta draft apply` for this draft."
+    )]
+    Forbidden { route: String, right: &'static str },
+    #[error(
+        "Wayfinder returned 404 Not Found for POST {route}: the id in that route does not exist \
+         in this project (or the project/org id is wrong). Check that the goal or metric still \
+         exists, and `org_id`/`project_id` under [plan.wayfinder] in .ta/workflow.toml."
+    )]
+    NotFound { route: String },
+    #[error("conflict: Wayfinder returned 409 for POST {route}: {detail}. {fix}")]
+    Conflict {
+        route: String,
+        detail: String,
+        fix: &'static str,
+    },
+    #[error(
+        "Wayfinder rejected the body of POST {route} with status {status}: {detail}. Fix the \
+         proposal (re-propose with valid values), then re-apply."
+    )]
+    Rejected {
+        route: String,
+        status: reqwest::StatusCode,
+        detail: String,
+    },
+    #[error(
+        "Wayfinder returned unexpected status {status} for POST {route}{detail}. Check that \
+         Wayfinder is healthy and that `base_url` under [plan.wayfinder] in .ta/workflow.toml \
+         points at it, then re-run `ta draft apply` for this draft."
+    )]
+    UnexpectedStatus {
+        route: String,
+        status: reqwest::StatusCode,
+        detail: String,
+    },
+    #[error(
+        "POST {route} to Wayfinder timed out after {timeout:?}. Wayfinder may be down or \
+         overloaded: retry shortly with `ta draft apply` (the write is idempotent by external_id)."
+    )]
+    Timeout { route: String, timeout: Duration },
+    #[error(
+        "request POST {route} to Wayfinder failed: {message}. Check that `base_url` under \
+         [plan.wayfinder] in .ta/workflow.toml is correct and reachable."
+    )]
