+/// Fields of a planning proposal that may hold a `ref:<n>`.
+fn ref_fields(kind: ProposeKind) -> &'static [&'static str] {
+    match kind {
+        ProposeKind::GoalCreate => &["parent_goal_id"],
+        ProposeKind::KpiMetricCreate => &["goal_id"],
+        ProposeKind::KpiDatapointAdd => &["metric_id"],
+        _ => &[],
+    }
