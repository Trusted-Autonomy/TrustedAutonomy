+pub fn handle_propose_kpi_datapoint_add(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeKpiDatapointAddParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::KpiDatapointAdd;
+    validate_ref_or_id(kind, "metric_id", &params.metric_id)?;
+    validate_number(kind, "value", params.value, false, false)?;
+    let source = params
+        .source
+        .clone()
+        .unwrap_or_else(|| DEFAULT_DATAPOINT_SOURCE.into());
+    if source.is_empty()
+        || source.len() > MAX_SOURCE_LEN
+        || !source
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, '.' | '_' | '-'))
+    {
+        return Err(invalid(
+            kind,
+            format!(
+                "source must be 1-{MAX_SOURCE_LEN} ASCII letters, digits, '.', '_' or '-' \
+                 (default \"{DEFAULT_DATAPOINT_SOURCE}\")"
+            ),
+        ));
+    }
+    let refs = [RefCheck {
+        field: "metric_id",
+        value: &params.metric_id,
+        expect: ProposeKind::KpiMetricCreate,
+        veto: Some(veto_task_count_metric),
+    }];
+    capture_indexed(state, kind, &params.goal_run_id, &refs, |_, _, _| {
+        Proposal {
+            parameters: serde_json::json!({
+                "metric_id": params.metric_id,
+                "value": params.value,
+                "source": source,
+            }),
+            description: format!(
+                "Propose recording datapoint {} on KPI metric {} (source {source})",
+                params.value, params.metric_id
+            ),
+            target_uri: format!("wayfinder://kpi-metrics/{}/datapoints", params.metric_id),
+            result: serde_json::json!({}),
+        }
+    })
+}
