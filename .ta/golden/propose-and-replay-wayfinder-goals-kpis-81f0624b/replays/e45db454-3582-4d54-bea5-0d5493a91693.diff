+    /// `POST /api/orgs/:org_id/kpis`.
+    pub fn create_org_kpi(
+        &self,
+        req: &CreateOrgKpiRequest,
+    ) -> Result<CreatedResource, WayfinderWriteError> {
+        let mut url = self.base_url.clone();
+        {
+            let mut path = url
+                .path_segments_mut()
+                .expect("base_url is validated to be a path-having http(s) URL");
+            path.push("api")
+                .push("orgs")
+                .push(&self.org_id)
+                .push("kpis");
+        }
+        self.post_planning(url, req, RIGHT_KPIS_MANAGE, FIX_KPI_CONFLICT, Some("kpi"))
+    }
+
+    /// One `POST`, mapped onto [`WayfinderWriteError`]. `id_key` names the
+    /// nested object an `id` may live in when the response wraps the
+    /// resource (`{"goal": {"id": ..}}`); `None` means the caller does not
+    /// need an id back.
+    fn post_planning<B: Serialize>(
+        &self,
+        url: Url,
+        body: &B,
+        right: &'static str,
+        conflict_fix: &'static str,
+        id_key: Option<&'static str>,
+    ) -> Result<CreatedResource, WayfinderWriteError> {
+        let route = url.path().to_string();
+        let response = self
+            .http
+            .post(url)
+            .bearer_auth(self.secret.expose_secret())
+            .json(body)
+            .send()
+            .map_err(|source| {
+                if source.is_timeout() {
+                    WayfinderWriteError::Timeout {
+                        route: route.clone(),
+                        timeout: self.timeout,
+                    }
+                } else {
+                    WayfinderWriteError::Request {
+                        route: route.clone(),
+                        message: source.without_url().to_string(),
+                    }
+                }
+            })?;
+        let status = response.status();
+        if status.is_success() {
+            let body: serde_json::Value = response.json().unwrap_or(serde_json::Value::Null);
+            let id = id_key.and_then(|k| extract_id(&body, k));
+            if id_key.is_some() && id.is_none() {
+                return Err(WayfinderWriteError::MissingId {
+                    route,
+                    what: id_key.unwrap_or("resource"),
+                });
+            }
+            return Ok(CreatedResource { id, body });
+        }
+        let detail = error_detail(response);
+        Err(match status {
+            s if s == reqwest::StatusCode::UNAUTHORIZED => {
+                WayfinderWriteError::Unauthorized { route }
+            }
+            s if s == reqwest::StatusCode::FORBIDDEN => {
+                WayfinderWriteError::Forbidden { route, right }
+            }
+            s if s == reqwest::StatusCode::NOT_FOUND => WayfinderWriteError::NotFound { route },
+            s if s == reqwest::StatusCode::CONFLICT => WayfinderWriteError::Conflict {
+                route,
+                detail: if detail.is_empty() {
+                    "no message given".to_string()
+                } else {
+                    detail
+                },
+                fix: conflict_fix,
+            },
+            s if s == reqwest::StatusCode::BAD_REQUEST
+                || s == reqwest::StatusCode::UNPROCESSABLE_ENTITY =>
+            {
+                WayfinderWriteError::Rejected {
+                    route,
+                    status,
+                    detail: if detail.is_empty() {
+                        "no message given".to_string()
+                    } else {
+                        detail
+                    },
+                }
+            }
+            _ => WayfinderWriteError::UnexpectedStatus {
+                route,
+                status,
+                detail: if detail.is_empty() {
+                    String::new()
+                } else {
+                    format!(" ({detail})")
+                },
+            },
+        })
+    }
+}
