+pub fn handle_propose_kpi_metric_create(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeKpiMetricCreateParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::KpiMetricCreate;
+    validate_ref_or_id(kind, "goal_id", &params.goal_id)?;
+    validate_text(kind, "label", &params.label, MAX_LABEL_LEN, true, true)?;
+    validate_text(kind, "unit", &params.unit, MAX_UNIT_LEN, true, true)?;
+    validate_number(kind, "target", params.target, true, false)?;
+    validate_one_of(kind, "cadence", &params.cadence, METRIC_CADENCES)?;
+    validate_one_of(kind, "kind", &params.kind, METRIC_KINDS)?;
+    let aggregation = params.aggregation.clone().unwrap_or_else(|| "sum".into());
+    validate_one_of(kind, "aggregation", &aggregation, METRIC_AGGREGATIONS)?;
+    let weight = params.weight.unwrap_or(1.0);
+    validate_number(kind, "weight", weight, false, true)?;
+    let require_gate = params.require_gate.unwrap_or(false);
+
+    let refs = [RefCheck {
+        field: "goal_id",
+        value: &params.goal_id,
+        expect: ProposeKind::GoalCreate,
+        veto: None,
+    }];
+    capture_indexed(state, kind, &params.goal_run_id, &refs, |_, _, index| {
+        Proposal {
+            parameters: serde_json::json!({
+                "goal_id": params.goal_id,
+                "label": params.label,
+                "unit": params.unit,
+                "target": params.target,
+                "cadence": params.cadence,
+                "kind": params.kind,
+                "aggregation": aggregation,
+                "require_gate": require_gate,
+                "weight": weight,
+            }),
+            description: format!(
+                "Propose KPI metric \"{}\" on goal {}: target {} {} ({}, {}, {})",
+                params.label,
+                params.goal_id,
+                params.target,
+                params.unit,
+                params.cadence,
+                params.kind,
+                aggregation
+            ),
+            target_uri: format!(
+                "wayfinder://goals/{}/kpi-metrics/new/{index}",
+                params.goal_id
+            ),
+            result: serde_json::json!({
+                "ref": format!("ref:{index}"),
+                "note_ref": "Use this `ref` as metric_id in later datapoint proposals of this draft.",
+            }),
+        }
+    })
+}
