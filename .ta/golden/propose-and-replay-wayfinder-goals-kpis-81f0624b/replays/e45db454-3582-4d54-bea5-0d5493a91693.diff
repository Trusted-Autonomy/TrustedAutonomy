+            "description",
+            d,
+            MAX_GOAL_DESCRIPTION_LEN,
+            false,
+            false,
+        )?;
+    }
+    let goal_kind = params
+        .kind
+        .clone()
+        .unwrap_or_else(|| DEFAULT_GOAL_KIND.into());
+    validate_slug(kind, "kind", &goal_kind, MAX_GOAL_KIND_LEN)?;
+    if let Some(p) = &params.parent_goal_id {
+        validate_ref_or_id(kind, "parent_goal_id", p)?;
+    }
+    if let Some(d) = &params.target_date {
+        if chrono::NaiveDate::parse_from_str(d, "%Y-%m-%d").is_err() || d.len() != 10 {
+            return Err(invalid(
+                kind,
+                format!("target_date {d:?} is not a valid date; use YYYY-MM-DD"),
+            ));
+        }
+    }
+    let refs: Vec<RefCheck> = params
+        .parent_goal_id
+        .iter()
+        .map(|p| RefCheck {
+            field: "parent_goal_id",
+            value: p,
+            expect: ProposeKind::GoalCreate,
+            veto: None,
+        })
+        .collect();
+    capture_indexed(state, kind, &params.goal_run_id, &refs, |_, _, index| {
+        let mut description = format!(
+            "Propose creating goal \"{}\" (kind {goal_kind})",
+            params.name
+        );
+        if let Some(p) = &params.parent_goal_id {
+            description.push_str(&format!(", under parent {p}"));
+        }
+        if let Some(d) = &params.target_date {
+            description.push_str(&format!(", target {d}"));
+        }
+        Proposal {
+            parameters: serde_json::json!({
+                "name": params.name,
+                "description": params.description,
+                "kind": goal_kind,
+                "parent_goal_id": params.parent_goal_id,
+                "target_date": params.target_date,
+            }),
+            description,
+            target_uri: format!("wayfinder://goals/new/{index}"),
+            result: serde_json::json!({
+                "ref": format!("ref:{index}"),
+                "note_ref": "Use this `ref` as parent_goal_id / goal_id in later proposals of this draft.",
+            }),
+        }
+    })
+}
