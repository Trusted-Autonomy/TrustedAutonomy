+/// Reviewer-facing lines for a planning proposal in `ta draft view`: what
+/// will be sent, and the `external_id` replay will use. Empty for any other
+/// tool.
+pub fn review_lines(
+    tool_name: &str,
+    parameters: &serde_json::Value,
+    draft_id: impl std::fmt::Display,
+    index: usize,
+) -> Vec<String> {
+    let Some(kind) = ProposeKind::from_tool_name(tool_name).filter(|k| k.is_planning()) else {
+        return Vec::new();
+    };
+    let text = |key: &str| {
+        parameters
+            .get(key)
+            .and_then(|v| v.as_str())
+            .unwrap_or("(none)")
+            .to_string()
+    };
+    let num = |key: &str| {
+        parameters
+            .get(key)
+            .map(|v| v.to_string())
+            .unwrap_or_else(|| "(none)".into())
+    };
+    let mut lines = match kind {
+        ProposeKind::GoalCreate => vec![
+            "Wayfinder: create goal".to_string(),
+            format!("Name: {}", text("name")),
+            format!("Kind: {}", text("kind")),
+            format!("Parent goal: {}", text("parent_goal_id")),
+            format!("Target date: {}", text("target_date")),
+            format!("Description: {}", text("description")),
+        ],
+        ProposeKind::KpiMetricCreate => vec![
+            "Wayfinder: add KPI metric to goal".to_string(),
+            format!("Goal: {}", text("goal_id")),
+            format!(
+                "Label: {}  Unit: {}  Target: {}",
+                text("label"),
+                text("unit"),
+                num("target")
+            ),
+            format!(
+                "Cadence: {}  Kind: {}  Aggregation: {}",
+                text("cadence"),
+                text("kind"),
+                text("aggregation")
+            ),
+            format!(
+                "Weight: {}  Require gate: {}",
+                num("weight"),
+                num("require_gate")
+            ),
+        ],
+        ProposeKind::KpiDatapointAdd => vec![
+            "Wayfinder: record KPI datapoint".to_string(),
+            format!("Metric: {}", text("metric_id")),
+            format!("Value: {}  Source: {}", num("value"), text("source")),
+        ],
+        _ => vec![
+            "Wayfinder: create KPI".to_string(),
+            format!("Label: {}", text("label")),
+            format!(
+                "Scope: {}  Weight: {}",
+                if parameters.get("org_wide").and_then(|v| v.as_bool()) == Some(true) {
+                    "org-wide"
+                } else {
+                    "this project"
+                },
+                num("weight")
+            ),
+            format!("Description: {}", text("description")),
+        ],
+    };
+    lines.push(format!(
+        "external_id on apply: {} (re-applying never duplicates)",
+        planning_external_id(draft_id, index)
+    ));
+    if kind != ProposeKind::KpiCreate {
+        lines.push(format!(
+            "Refer to this proposal as ref:{index} (within this draft)"
+        ));
+    }
+    lines
