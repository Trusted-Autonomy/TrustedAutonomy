+/// Replays the planning proposals (goals, KPI metrics, datapoints, KPIs) in
+/// declared order. See the module docs for the ref and ledger rules.
+fn replay_planning_actions(
+    config: &GatewayConfig,
+    draft_id: &str,
+    actions: &[PendingAction],
+    summary: &mut ReplaySummary,
+) {
+    let planning: Vec<(usize, ProposeKind, &PendingAction)> = actions
+        .iter()
+        .enumerate()
+        .filter_map(|(i, a)| {
+            ProposeKind::from_tool_name(&a.tool_name)
+                .filter(|k| k.is_planning())
+                .map(|k| (i, k, a))
+        })
+        .collect();
+    if planning.is_empty() {
+        return;
+    }
+    let approved = planning
+        .iter()
+        .filter(|(_, _, a)| {
+            !matches!(
+                a.disposition,
+                ArtifactDisposition::Rejected | ArtifactDisposition::Discuss
+            )
+        })
+        .count();
+    let mut client = None;
+    if approved > 0 {
+        client = load_client(config, approved);
+        if client.is_none() {
+            summary.backend_unavailable = true;
+        }
+    }
+
+    let ledger_path = config.workspace_root.join(".ta").join(LEDGER_FILE);
+    let entries = read_ledger_entries(&ledger_path);
+    // Wayfinder ids by declared index, from this pass and earlier ones.
+    let mut ids: HashMap<usize, String> = HashMap::new();
+    // Why a declared index produced no usable id (failed, blocked, not approved).
+    let mut unusable: HashMap<usize, String> = HashMap::new();
+    let (mut replayed, mut failed, mut already) = (0usize, 0usize, 0usize);
+
+    for (index, kind, action) in planning {
+        let tool = action.tool_name.as_str();
+        if matches!(
+            action.disposition,
+            ArtifactDisposition::Rejected | ArtifactDisposition::Discuss
+        ) {
+            tracing::info!(
+                action_id = %action.action_id,
+                tool_name = %tool,
+                disposition = %action.disposition,
+                "not replaying planning proposal: reviewer did not approve this action"
+            );
+            summary.skipped_by_reviewer += 1;
+            unusable.insert(index, "was not approved by the reviewer".to_string());
+            continue;
+        }
+        let key = action.action_id.to_string();
+        if let Some(recorded) = entries.get(&key) {
+            let needs_id = matches!(kind, ProposeKind::GoalCreate | ProposeKind::KpiMetricCreate);
+            match recorded {
+                Some(id) => {
+                    ids.insert(index, id.clone());
+                    already += 1;
+                    continue;
+                }
+                None if !needs_id => {
+                    already += 1;
+                    continue;
+                }
+                // Applied earlier but no id was recorded: re-POST. The
+                // external_id makes that return the same resource.
+                None => {}
+            }
+        }
+        let Some(client) = client.as_ref() else {
+            failed += 1;
+            unusable.insert(index, "could not be sent (no Wayfinder client)".to_string());
+            continue;
+        };
+
+        let mut resolved = action.parameters.clone();
+        let mut blocked_by: Option<String> = None;
+        for field in ref_fields(kind) {
+            let Some(raw) = str_param(&action.parameters, field) else {
+                continue;
+            };
+            let Some(target) = ref_index(raw) else {
+                continue;
+            };
+            match ids.get(&target) {
+                Some(id) => resolved[*field] = serde_json::Value::String(id.clone()),
+                None => {
+                    let why = unusable
+                        .get(&target)
+                        .cloned()
+                        .unwrap_or_else(|| "has no recorded Wayfinder id".to_string());
+                    blocked_by = Some(format!(
+                        "`{field}` is {raw}, but step {target} ({}) {why}",
+                        actions
+                            .get(target)
+                            .map(|a| a.tool_name.as_str())
+                            .unwrap_or("unknown step")
+                    ));
+                    break;
+                }
+            }
+        }
+        if let Some(reason) = blocked_by {
+            failed += 1;
+            tracing::warn!(
+                action_id = %action.action_id, tool_name = %tool, index, reason = %reason,
+                "planning proposal blocked by an earlier step"
+            );
+            eprintln!(
+                "  [blocked] Wayfinder {tool} (step {index}, action {}): {reason}\n           \
+                 Fix the earlier step, then re-run `ta draft apply` for this draft.",
+                action.action_id
+            );
+            unusable.insert(index, format!("was blocked ({reason})"));
+            continue;
+        }
+
+        let external_id = planning_external_id(draft_id, index);
+        match replay_planning_one(client, kind, &resolved, &external_id, draft_id) {
+            Ok((what, id)) => {
+                println!("  [applied] Wayfinder: {what}");
+                replayed += 1;
+                if let Err(e) = append_ledger(&ledger_path, &key, id.as_deref()) {
+                    tracing::warn!(
+                        action_id = %action.action_id, tool_name = %tool,
+                        path = %ledger_path.display(), error = %e,
+                        "replayed planning proposal but could not record it in the replay \
+                         ledger; a later re-apply repeats it (safe: external_id upserts)"
+                    );
+                }
+                if let Some(id) = id {
+                    ids.insert(index, id);
+                }
+            }
+            Err(e) => {
+                failed += 1;
+                tracing::warn!(
+                    action_id = %action.action_id, tool_name = %tool, index, external_id = %external_id,
+                    error = %e, "failed to replay approved planning proposal against Wayfinder"
+                );
+                eprintln!(
+                    "  [failed] Wayfinder {tool} (step {index}, action {}): {e}\n           \
+                     The rest of the draft is applied; later steps that depend on this one are \
+                     blocked. Fix the cause above, then re-run `ta draft apply` for this draft \
+                     (steps already applied are not repeated), or make the change in Wayfinder \
+                     by hand.",
+                    action.action_id
+                );
+                unusable.insert(index, "failed".to_string());
+            }
+        }
+    }
+
+    summary.replayed += replayed;
+    summary.failed += failed;
+    summary.already_replayed += already;
+    if replayed + failed > 0 {
+        println!(
+            "  Wayfinder planning proposals: {replayed} applied, {failed} failed, \
+             {already} already applied earlier"
+        );
+    }
+}
