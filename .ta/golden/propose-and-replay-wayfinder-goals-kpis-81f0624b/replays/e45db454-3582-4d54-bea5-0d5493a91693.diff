+/// The resource id from a create response: top-level `id`, else
+/// `<nested>.id`.
+fn extract_id(body: &serde_json::Value, nested: &str) -> Option<String> {
+    body.get("id")
+        .or_else(|| body.get(nested).and_then(|n| n.get("id")))
+        .and_then(|v| v.as_str())
+        .filter(|s| !s.is_empty())
+        .map(str::to_string)
+}
+
+/// Wayfinder's own error message from a failed response: the JSON `error`
+/// or `message` field, else the (truncated) body text. Never includes
+/// request headers, so it cannot carry the token.
+fn error_detail(response: reqwest::blocking::Response) -> String {
+    let text = response.text().unwrap_or_default();
+    let message = serde_json::from_str::<serde_json::Value>(&text)
+        .ok()
+        .and_then(|v| {
+            v.get("error")
+                .or_else(|| v.get("message"))
+                .and_then(|m| m.as_str().map(str::to_string))
+                .or_else(|| {
+                    v.get("error")
+                        .and_then(|e| e.get("message"))
+                        .and_then(|m| m.as_str().map(str::to_string))
+                })
+        })
+        .unwrap_or(text);
+    let message = message.trim();
+    if message.chars().count() > 300 {
+        format!("{}...", message.chars().take(300).collect::<String>())
+    } else {
+        message.to_string()
+    }
+}
