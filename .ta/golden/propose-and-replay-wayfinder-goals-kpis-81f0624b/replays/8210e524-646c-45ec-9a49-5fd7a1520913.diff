+/// Reviewer-facing lines for a planning proposal's parameters, printed under
+/// the one-line description in `ta draft view`. Empty for non-planning tools.
+pub fn review_lines(tool_name: &str, p: &serde_json::Value) -> Vec<String> {
+    let s = |k: &str| p.get(k).and_then(|v| v.as_str()).unwrap_or("");
+    let n = |k: &str| {
+        p.get(k)
+            .and_then(|v| v.as_f64())
+            .map(|v| v.to_string())
+            .unwrap_or_default()
+    };
+    let b = |k: &str| p.get(k).and_then(|v| v.as_bool()).unwrap_or(false);
+    let refer = |v: &str| {
+        if parse_ref(v).is_some() {
+            format!("{v} (created earlier in this draft)")
+        } else {
+            v.to_string()
+        }
+    };
+    match ProposeKind::from_tool_name(tool_name) {
+        Some(ProposeKind::GoalCreate) => {
+            let mut lines = vec![format!("Goal: {} (kind {})", s("name"), s("kind"))];
+            if !s("description").is_empty() {
+                lines.push(format!("Description: {}", s("description")));
+            }
+            if !s("parent_goal_id").is_empty() {
+                lines.push(format!("Parent goal: {}", refer(s("parent_goal_id"))));
+            }
+            if !s("target_date").is_empty() {
+                lines.push(format!("Target date: {}", s("target_date")));
+            }
+            lines
+        }
+        Some(ProposeKind::KpiMetricCreate) => vec![
+            format!("KPI metric: {}", s("label")),
+            format!("Goal: {}", refer(s("goal_id"))),
+            format!(
+                "Target: {} {} per {} cadence, {} metric, {} aggregation",
+                n("target"),
+                s("unit"),
+                s("cadence"),
+                s("kind"),
+                s("aggregation")
+            ),
+            format!(
+                "Weight: {}, gate required: {}",
+                n("weight"),
+                b("require_gate")
+            ),
+        ],
+        Some(ProposeKind::KpiDatapointAdd) => vec![
+            format!("Datapoint: {} (source {})", n("value"), s("source")),
+            format!("Metric: {}", refer(s("metric_id"))),
+        ],
+        Some(ProposeKind::KpiCreate) => {
+            let mut lines = vec![format!(
+                "KPI: {} (weight {}, {})",
+                s("label"),
+                n("weight"),
+                if b("project_scoped") {
+                    "this project only"
+                } else {
+                    "org-wide"
+                }
+            )];
+            if !s("description").is_empty() {
+                lines.push(format!("Description: {}", s("description")));
+            }
+            lines
+        }
+        _ => Vec::new(),
+    }
+}
