+pub fn handle_propose_kpi_datapoint_add(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeKpiDatapointAddParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::KpiDatapointAdd;
+    validate_id_or_ref(kind, "metric_id", &params.metric_id)?;
+    validate_number(kind, "value", params.value)?;
+    let source = params
+        .source
+        .as_deref()
+        .unwrap_or(DEFAULT_DATAPOINT_SOURCE)
+        .to_string();
+    validate_text(kind, "source", &source, MAX_SOURCE_LEN, true, true)?;
+    let description = format!(
+        "Propose recording datapoint {} on KPI metric {} (source {source})",
+        params.value, params.metric_id
+    );
+    capture_checked(
+        state,
+        kind,
+        &params.goal_run_id,
+        |pending| {
+            let target = check_ref(
+                kind,
+                "metric_id",
+                &params.metric_id,
+                ProposeKind::KpiMetricCreate,
+                pending,
+            )?;
+            if target.is_some_and(|t| {
+                t.parameters.get("kind").and_then(|k| k.as_str()) == Some("task_count")
+            }) {
+                return Err(invalid(
+                    kind,
+                    format!(
+                        "metric_id {} is a task_count metric; Wayfinder refuses datapoints on \
+                         those (their progress derives from tasks). Propose the metric with \
+                         kind \"external\" if values will be recorded by hand",
+                        params.metric_id
+                    ),
+                ));
+            }
+            Ok(())
+        },
+        |_, action_id| Proposal {
+            parameters: serde_json::json!({
+                "metric_id": params.metric_id,
+                "value": params.value,
+                "source": source,
+            }),
+            description,
+            target_uri: format!("wayfinder://kpi-datapoints/proposed/{action_id}"),
