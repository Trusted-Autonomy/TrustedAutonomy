+/// What a planning replay step needs beyond its own parameters.
+struct ReplayCtx<'a> {
+    draft_id: &'a str,
+    /// This action's index in the draft (the `n` of its `external_id`).
+    index: usize,
+    actions: &'a [PendingAction],
+    /// Ids returned by earlier planning steps, by action index.
+    returned: &'a HashMap<usize, String>,
+    /// Earlier steps whose id cannot be used, with the reason.
+    unavailable: &'a HashMap<usize, &'static str>,
+}
+
+impl ReplayCtx<'_> {
+    fn external_id(&self) -> String {
+        planning_external_id(self.draft_id, self.index)
+    }
+
+    /// A real id passes through; `ref:<n>` becomes the id step `n` returned,
+    /// or an error naming the step that stops this one.
+    fn resolve(&self, field: &str, value: &str) -> anyhow::Result<String> {
+        let Some(n) = parse_ref(value) else {
+            return Ok(value.to_string());
+        };
+        if let Some(id) = self.returned.get(&n) {
+            return Ok(id.clone());
+        }
+        let tool = self
+            .actions
+            .get(n)
+            .map(|a| a.tool_name.as_str())
+            .unwrap_or("(no such action)");
+        let why = self
+            .unavailable
+            .get(&n)
+            .copied()
+            .unwrap_or("it has not been applied and returned an id");
+        anyhow::bail!(
+            "blocked: {field} {value} refers to step {n} ({tool}), but {why}. Nothing was sent \
+             for this step. Fix step {n}, then re-run `ta draft apply`"
+        )
+    }
+}
+
+fn f64_param(params: &serde_json::Value, key: &str) -> anyhow::Result<f64> {
+    params
+        .get(key)
+        .and_then(|v| v.as_f64())
+        .ok_or_else(|| anyhow::anyhow!("pending action is missing numeric parameter `{key}`"))
+}
