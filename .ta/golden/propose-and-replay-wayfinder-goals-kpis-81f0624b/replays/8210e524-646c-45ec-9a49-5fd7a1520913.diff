+/// `Some(n)` when `value` is a `ref:<n>` reference.
+pub fn parse_ref(value: &str) -> Option<usize> {
+    value.strip_prefix(REF_PREFIX)?.parse().ok()
+}
+
+/// Deterministic Wayfinder `external_id` of the planning proposal at index
+/// `n` of draft `draft_id`. Derived at apply time (the draft id does not
+/// exist when the agent proposes), so re-applying a draft upserts the same
+/// records.
+pub fn planning_external_id(draft_id: impl std::fmt::Display, n: usize) -> String {
+    format!("ta_draft:{draft_id}:{n}")
+}
+
+/// A goal / metric id field that may be a real id or `ref:<n>`.
+fn validate_id_or_ref(kind: ProposeKind, field: &str, value: &str) -> Result<(), McpError> {
+    if value.starts_with(REF_PREFIX) {
+        if parse_ref(value).is_none() {
+            return Err(invalid(
+                kind,
+                format!(
+                    "{field} {value:?} is not a valid reference; use ref:<n> where <n> is the \
+                     index returned when the earlier proposal was captured (e.g. ref:0)"
+                ),
+            ));
+        }
+        return Ok(());
+    }
+    validate_id(kind, field, value, MAX_ID_LEN)
+}
+
+fn validate_number(kind: ProposeKind, field: &str, value: f64) -> Result<(), McpError> {
+    if !value.is_finite() || value.abs() > MAX_NUMBER {
+        return Err(invalid(
+            kind,
+            format!("{field} must be a finite number within +-1e12"),
+        ));
+    }
+    Ok(())
+}
+
+fn validate_closed(
+    kind: ProposeKind,
+    field: &str,
+    value: &str,
+    allowed: &[&str],
+) -> Result<(), McpError> {
+    if allowed.contains(&value) {
+        Ok(())
+    } else {
+        Err(invalid(
+            kind,
+            format!(
+                "{field} {value:?} is not valid; use one of: {}",
+                allowed.join(", ")
+            ),
+        ))
+    }
+}
+
+fn validate_slug(kind: ProposeKind, field: &str, value: &str) -> Result<(), McpError> {
+    if value.is_empty()
+        || value.len() > MAX_KIND_LEN
+        || !value
+            .chars()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_' || c == '-')
+    {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} must be 1-{MAX_KIND_LEN} lowercase letters, digits, '_' or '-' \
+                 (e.g. \"{DEFAULT_GOAL_KIND}\")"
+            ),
+        ));
+    }
+    Ok(())
+}
+
+fn validate_date(kind: ProposeKind, field: &str, value: &str) -> Result<(), McpError> {
+    let shaped = value.len() == 10 && chrono::NaiveDate::parse_from_str(value, "%Y-%m-%d").is_ok();
+    if shaped {
+        Ok(())
+    } else {
+        Err(invalid(
+            kind,
+            format!("{field} must be a real date as YYYY-MM-DD"),
+        ))
+    }
+}
