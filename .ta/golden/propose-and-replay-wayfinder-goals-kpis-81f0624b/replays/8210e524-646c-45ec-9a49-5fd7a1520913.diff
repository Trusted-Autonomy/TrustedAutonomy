+/// Checks a `ref:<n>` against the goal's pending actions captured so far:
+/// it must point at an EARLIER proposal of the `expected` tool. Plain ids
+/// pass untouched. Returns the referenced action for further checks.
+fn check_ref<'a>(
+    kind: ProposeKind,
+    field: &str,
+    value: &str,
+    expected: ProposeKind,
+    pending: &'a [PendingAction],
+) -> Result<Option<&'a PendingAction>, McpError> {
+    let Some(n) = parse_ref(value) else {
+        return Ok(None);
+    };
+    let Some(target) = pending.get(n) else {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} {value} points at proposal {n}, but only {} proposal(s) have been \
+                 captured so far in this goal; a reference must point at an EARLIER proposal",
+                pending.len()
+            ),
+        ));
+    };
+    if target.tool_name != expected.tool_name() {
+        return Err(invalid(
+            kind,
+            format!(
+                "{field} {value} points at a {} proposal, but this field needs one from {}",
+                target.tool_name,
+                expected.tool_name()
+            ),
+        ));
+    }
+    Ok(Some(target))
+}
