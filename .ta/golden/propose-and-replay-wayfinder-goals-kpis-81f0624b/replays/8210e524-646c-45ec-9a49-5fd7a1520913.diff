+pub fn handle_propose_goal_create(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeGoalCreateParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::GoalCreate;
+    validate_text(kind, "name", &params.name, MAX_NAME_LEN, true, true)?;
+    if let Some(d) = &params.description {
+        validate_text(
+            kind,
+            "description",
+            d,
+            MAX_GOAL_DESCRIPTION_LEN,
+            false,
+            false,
+        )?;
+    }
+    let goal_kind = params
+        .kind
+        .as_deref()
+        .unwrap_or(DEFAULT_GOAL_KIND)
+        .to_string();
+    validate_slug(kind, "kind", &goal_kind)?;
+    if let Some(p) = &params.parent_goal_id {
+        validate_id_or_ref(kind, "parent_goal_id", p)?;
+    }
+    if let Some(d) = &params.target_date {
+        validate_date(kind, "target_date", d)?;
+    }
+    let description = format!(
+        "Propose creating goal \"{}\" (kind {goal_kind})",
+        params.name
+    );
+    capture_checked(
+        state,
+        kind,
+        &params.goal_run_id,
+        |pending| {
+            if let Some(p) = &params.parent_goal_id {
+                check_ref(kind, "parent_goal_id", p, ProposeKind::GoalCreate, pending)?;
+            }
+            Ok(())
+        },
+        |_, action_id| Proposal {
+            parameters: serde_json::json!({
+                "name": params.name,
+                "description": params.description,
+                "kind": goal_kind,
+                "parent_goal_id": params.parent_goal_id,
+                "target_date": params.target_date,
+            }),
+            description,
+            target_uri: format!("wayfinder://goals/proposed/{action_id}"),
+            result: serde_json::json!({}),
+        },
+    )
+}
+
+pub fn handle_propose_kpi_metric_create(
+    state: &Arc<Mutex<GatewayState>>,
+    params: ProposeKpiMetricCreateParams,
+) -> Result<CallToolResult, McpError> {
+    let kind = ProposeKind::KpiMetricCreate;
+    validate_id_or_ref(kind, "goal_id", &params.goal_id)?;
+    validate_text(kind, "label", &params.label, MAX_NAME_LEN, true, true)?;
+    validate_text(kind, "unit", &params.unit, MAX_UNIT_LEN, true, true)?;
+    validate_number(kind, "target", params.target)?;
+    if params.target <= 0.0 {
+        return Err(invalid(kind, "target must be greater than 0"));
+    }
+    validate_closed(kind, "cadence", &params.cadence, &METRIC_CADENCES)?;
+    validate_closed(kind, "kind", &params.kind, &METRIC_KINDS)?;
+    let aggregation = params.aggregation.as_deref().unwrap_or("sum").to_string();
+    validate_closed(kind, "aggregation", &aggregation, &METRIC_AGGREGATIONS)?;
+    let weight = params.weight.unwrap_or(1.0);
+    validate_number(kind, "weight", weight)?;
+    if weight < 0.0 {
+        return Err(invalid(kind, "weight must not be negative"));
+    }
+    let require_gate = params.require_gate.unwrap_or(false);
+    let description = format!(
+        "Propose adding KPI metric \"{}\" ({} {}, {}, {}) to goal {}",
+        params.label, params.target, params.unit, params.cadence, params.kind, params.goal_id
+    );
+    capture_checked(
+        state,
+        kind,
+        &params.goal_run_id,
+        |pending| {
+            check_ref(
+                kind,
+                "goal_id",
+                &params.goal_id,
+                ProposeKind::GoalCreate,
+                pending,
+            )?;
+            Ok(())
+        },
+        |_, action_id| Proposal {
+            parameters: serde_json::json!({
+                "goal_id": params.goal_id,
+                "label": params.label,
+                "unit": params.unit,
+                "target": params.target,
+                "cadence": params.cadence,
+                "kind": params.kind,
+                "aggregation": aggregation,
+                "require_gate": require_gate,
+                "weight": weight,
+            }),
+            description,
+            target_uri: format!("wayfinder://kpi-metrics/proposed/{action_id}"),
+            result: serde_json::json!({}),
+        },
+    )
+}
