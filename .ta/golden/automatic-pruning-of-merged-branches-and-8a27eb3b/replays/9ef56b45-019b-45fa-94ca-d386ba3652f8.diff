+//! The `branches` group: finished local branches and the worktrees they are checked out in.
+//!
+//! Ground truth is the PR state from the VCS adapter (through [`GroundTruth::branch_review`]),
+//! not `git branch -d` or `git cherry`: a squash merge rewrites patch ids, so both call a
+//! finished branch unmerged. A branch is deleted without asking only when
+//!
+//! * its tip is an ancestor of the default branch (nothing on it that the default lacks), or
+//! * its PR is merged and the branch has no commits beyond the PR head.
+//!
+//! Everything else is a question or is kept. The current branch, the default branch and any
+//! branch checked out in a worktree with uncommitted or untracked files are never deleted.
+//! Remote branches are never touched; a PR closed unmerged is only reported.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use serde_json::json;
+
+use crate::model::*;
+use crate::scan::mk;
+use crate::state;
+
+/// Remote branches probed per run. Each probe is a VCS lookup, so this keeps a repo with
+/// hundreds of stale remote branches from turning one cleanup into hundreds of API calls.
+const MAX_REMOTE_PROBES: usize = 50;
+
+/// A git command for the repository at `dir`. Variables that redirect git to another
+/// repository (`GIT_DIR` is set inside hooks and some dev shells) are cleared: `-C dir` must
+/// mean `dir`, or a branch could be judged in one repository and deleted in another.
+pub(crate) fn git_cmd(dir: &Path) -> Command {
+    let mut c = Command::new("git");
+    c.arg("-C").arg(dir);
+    for v in [
+        "GIT_DIR",
+        "GIT_WORK_TREE",
+        "GIT_INDEX_FILE",
+        "GIT_COMMON_DIR",
+        "GIT_OBJECT_DIRECTORY",
+        "GIT_NAMESPACE",
+        "GIT_PREFIX",
+    ] {
+        c.env_remove(v);
+    }
+    c.env("GIT_TERMINAL_PROMPT", "0");
+    c
+}
+
+/// Run git in `dir`. `Err` carries the command line and stderr so the caller can say what failed.
+fn git(dir: &Path, args: &[&str]) -> Result<String, String> {
+    let out = git_cmd(dir)
+        .args(args)
+        .output()
+        .map_err(|e| format!("could not run `git {}`: {e}", args.join(" ")))?;
+    if out.status.success() {
+        Ok(String::from_utf8_lossy(&out.stdout).trim_end().to_string())
+    } else {
+        Err(format!(
+            "`git {}` failed: {}",
+            args.join(" "),
+            String::from_utf8_lossy(&out.stderr).trim()
+        ))
+    }
+}
+
+/// `git merge-base --is-ancestor a b`: exit 0 yes, 1 no, anything else is "cannot tell" (false).
+fn is_ancestor(dir: &Path, a: &str, b: &str) -> bool {
+    git_cmd(dir)
+        .args(["merge-base", "--is-ancestor", a, b])
+        .output()
+        .map(|o| o.status.success())
+        .unwrap_or(false)
+}
+
+fn has_commit(dir: &Path, sha: &str) -> bool {
+    git(dir, &["cat-file", "-e", &format!("{sha}^{{commit}}")]).is_ok()
+}
+
+fn short_sha(s: &str) -> &str {
+    &s[..s.len().min(8)]
+}
+
+#[derive(Debug, Clone)]
+struct Worktree {
+    path: PathBuf,
+    branch: Option<String>,
+    locked: bool,
+    prunable: bool,
+}
+
+fn worktrees(root: &Path) -> Vec<Worktree> {
+    let Ok(text) = git(root, &["worktree", "list", "--porcelain"]) else {
+        return Vec::new();
+    };
+    let mut out = Vec::new();
+    for block in text.split("\n\n") {
+        let mut wt = Worktree {
+            path: PathBuf::new(),
+            branch: None,
+            locked: false,
+            prunable: false,
+        };
+        for line in block.lines() {
+            if let Some(p) = line.strip_prefix("worktree ") {
+                wt.path = PathBuf::from(p);
+            } else if let Some(b) = line.strip_prefix("branch refs/heads/") {
+                wt.branch = Some(b.to_string());
+            } else if line == "locked" || line.starts_with("locked ") {
+                wt.locked = true;
+            } else if line == "prunable" || line.starts_with("prunable ") {
+                wt.prunable = true;
+            }
+        }
+        if !wt.path.as_os_str().is_empty() {
+            out.push(wt);
+        }
+    }
+    out
+}
+
+fn same_path(a: &Path, b: &Path) -> bool {
+    match (a.canonicalize(), b.canonicalize()) {
+        (Ok(x), Ok(y)) => x == y,
+        _ => a == b,
+    }
+}
+
+/// Files with uncommitted changes or untracked files in a worktree. `Err` when git cannot say,
+/// which callers treat as dirty: an unreadable worktree is never removed.
+fn dirty_files(worktree: &Path) -> Result<Vec<String>, String> {
+    git(
+        worktree,
+        &["status", "--porcelain", "--untracked-files=all"],
+    )
+    .map(|s| s.lines().map(|l| l.trim_end().to_string()).collect())
+}
+
+fn default_branch(root: &Path, locals: &[(String, String)]) -> Option<String> {
+    if let Ok(r) = git(
+        root,
+        &[
+            "symbolic-ref",
+            "--quiet",
+            "--short",
+            "refs/remotes/origin/HEAD",
+        ],
+    ) {
+        if let Some(b) = r.strip_prefix("origin/") {
+            return Some(b.to_string());
+        }
+    }
+    ["main", "master"]
+        .iter()
+        .find(|c| locals.iter().any(|(n, _)| n == *c))
+        .map(|c| c.to_string())
+}
+
+fn ref_sha(root: &Path, r: &str) -> Option<String> {
+    git(root, &["rev-parse", "--verify", "--quiet", r]).ok()
+}
+
+fn local_branches(root: &Path) -> Result<Vec<(String, String)>, String> {
+    let listing = git(
+        root,
+        &[
+            "for-each-ref",
+            "--format=%(refname:short)%09%(objectname)",
+            "refs/heads",
+        ],
+    )?;
+    Ok(listing
+        .lines()
+        .filter_map(|l| l.split_once('\t'))
+        .map(|(n, s)| (n.to_string(), s.to_string()))
+        .collect())
+}
+
+fn keep_option() -> Vec<AnswerOption> {
+    vec![AnswerOption {
+        key: "keep".into(),
+        label: "Keep it (nothing is deleted)".into(),
+        action: Action::None,
+    }]
+}
+
+struct Ctx<'a> {
+    e: &'a Engine<'a>,
+    root: &'a Path,
+    default: Option<String>,
+    default_tip: Option<String>,
+    origin_default_tip: Option<String>,
+    current: Option<String>,
+    wts: Vec<Worktree>,
+}
+
+impl Ctx<'_> {
+    /// Tip is contained in the default branch (local or origin's copy).
+    fn in_default(&self, tip: &str) -> bool {
+        [&self.default_tip, &self.origin_default_tip]
+            .into_iter()
+            .flatten()
+            .any(|d| is_ancestor(self.root, tip, d))
+    }
+
+    fn at_default_tip(&self, tip: &str) -> bool {
+        [&self.default_tip, &self.origin_default_tip]
+            .into_iter()
+            .flatten()
+            .any(|d| d == tip)
+    }
+
+    /// The linked worktree (never the project root) that has `branch` checked out.
+    fn worktree_of(&self, branch: &str) -> Option<&Worktree> {
+        self.wts
+            .iter()
+            .find(|w| w.branch.as_deref() == Some(branch) && !same_path(&w.path, self.root))
+    }
+}
+
+pub fn scan_branches(e: &Engine, out: &mut Vec<Finding>) {
+    if !e.settings.prune_branches {
+        return;
+    }
+    let root = e.paths.root.as_path();
+    if !root.join(".git").exists() {
+        return;
+    }
+    let locals = match local_branches(root) {
+        Ok(l) => l,
+        Err(err) => {
+            tracing::warn!(path = %root.display(), error = %err, "cleanup: cannot list branches; skipping the branches group");
+            return;
+        }
+    };
+    let default = default_branch(root, &locals);
+    let ctx = Ctx {
+        e,
+        root,
+        default_tip: default
+            .as_deref()
+            .and_then(|d| ref_sha(root, &format!("refs/heads/{d}"))),
+        origin_default_tip: default
+            .as_deref()
+            .and_then(|d| ref_sha(root, &format!("refs/remotes/origin/{d}"))),
+        default,
+        current: git(root, &["symbolic-ref", "--quiet", "--short", "HEAD"]).ok(),
+        wts: worktrees(root),
+    };
+
+    for (name, tip) in &locals {
+        if Some(name) == ctx.default.as_ref() || Some(name) == ctx.current.as_ref() {
+            continue;
+        }
+        out.push(judge_branch(&ctx, name, tip));
+    }
+
+    let gone: Vec<PathBuf> = ctx
+        .wts
+        .iter()
+        .filter(|w| w.prunable)
+        .map(|w| w.path.clone())
+        .collect();
+    if !gone.is_empty() {
+        let list = gone
+            .iter()
+            .map(|p| p.display().to_string())
+            .collect::<Vec<_>>()
+            .join(", ");
+        let mut f = mk(
+            Kind::Worktree,
+            "worktree:prune".into(),
+            format!("{} worktree record(s) whose directory is gone", gone.len()),
+            vec![Evidence::new("git", format!("missing directories: {list}"))],
+            Verdict::AutoSafe,
+            "git lists these worktrees as prunable: the directory no longer exists, so only the leftover record is removed",
+            Action::PruneWorktrees { paths: gone },
+            &[("worktrees", list)],
+        );
+        f.manual_command = Some("git worktree prune".into());
+        out.push(f);
+    }
+
+    remote_findings(&ctx, out);
+}
+
+fn judge_branch(ctx: &Ctx, name: &str, tip: &str) -> Finding {
+    let id = format!("branch:{name}");
+    let title = format!("Branch {name}");
+    let wt = ctx.worktree_of(name);
+    let mut evidence = vec![Evidence::new("git", format!("tip {}", short_sha(tip)))];
+    if let Some(w) = wt {
+        evidence.push(Evidence::new(
+            "git",
+            format!("checked out in worktree {}", w.path.display()),
+        ));
+    }
+    let recover = format!("git branch {name} {tip}");
+
+    // Decide whether the branch is finished. `Ok(reason)` is safe to delete, `Err` carries the
+    // verdict and why not. Containment in the default branch needs no VCS lookup at all.
+    let mut state_fact = String::from("no PR lookup needed");
+    let decision: Result<String, (Verdict, String)> = if ctx.in_default(tip)
+        && !ctx.at_default_tip(tip)
+    {
+        evidence.push(Evidence::new(
+            "git",
+            format!(
+                "tip is an ancestor of {}: nothing on this branch is missing from it",
+                ctx.default.as_deref().unwrap_or("the default branch")
+            ),
+        ));
+        Ok("its commits are all in the default branch".to_string())
+    } else {
+        let review = ctx.e.truth.branch_review(name);
+        let pr = review
+            .number
+            .as_deref()
+            .map(|n| format!("PR #{n}"))
+            .unwrap_or_else(|| "PR".into());
+        state_fact = format!(
+            "{:?}/{}",
+            review.state,
+            review.head_sha.as_deref().unwrap_or("-")
+        );
+        match &review.state {
+            ReviewState::Merged => {
+                evidence.push(Evidence::new(
+                    "vcs",
+                    format!(
+                        "{pr} is merged (head {})",
+                        review
+                            .head_sha
+                            .as_deref()
+                            .map(short_sha)
+                            .unwrap_or("unknown")
+                    ),
+                ));
+                match review.head_sha.as_deref() {
+                    Some(h) if h == tip => {
+                        Ok(format!("{pr} is merged and the branch is at the PR head"))
+                    }
+                    Some(h) if has_commit(ctx.root, h) && is_ancestor(ctx.root, tip, h) => Ok(
+                        format!("{pr} is merged and the branch has nothing beyond the PR head"),
+                    ),
+                    Some(h) => {
+                        let extra = git(
+                            ctx.root,
+                            &["rev-list", "--count", &format!("{h}..{tip}")],
+                        )
+                        .map(|n| format!("{n} commit(s)"))
+                        .unwrap_or_else(|_| "commits".into());
+                        Err((
+                            Verdict::Ask,
+                            format!("{pr} is merged but the branch has {extra} beyond the PR head ({}); they may be unmerged work", short_sha(h)),
+                        ))
+                    }
+                    None => Err((
+                        Verdict::Ask,
+                        format!("{pr} is merged but the VCS did not report its head commit, so \"no commits beyond the PR\" cannot be checked"),
+                    )),
+                }
+            }
+            ReviewState::Open => {
+                evidence.push(Evidence::new("vcs", format!("{pr} is open")));
+                Err((Verdict::Skip, format!("kept: {pr} is still open")))
+            }
+            ReviewState::Closed => {
+                evidence.push(Evidence::new(
+                    "vcs",
+                    format!("{pr} was closed without merging"),
+                ));
+                Err((
+                    Verdict::Ask,
+                    format!("{pr} was closed without merging, so the branch may hold abandoned or unmerged work"),
+                ))
+            }
+            ReviewState::Unknown(why) => {
+                evidence.push(Evidence::new("vcs", why.clone()));
+                let hint = if ctx.at_default_tip(tip) {
+                    " (it has no commits of its own and may be brand new)"
+                } else {
+                    ""
+                };
+                Err((
+                    Verdict::Ask,
+                    format!("no merged PR is known for this branch{hint}: {why}"),
+                ))
+            }
+        }
+    };
+
+    let facts = [
+        ("branch", name.to_string()),
+        ("tip", tip.to_string()),
+        ("pr", state_fact),
+    ];
+
+    match decision {
+        Ok(reason) => {
+            // Safe by history. Now the working tree: never remove one with unsaved files.
+            if let Some(w) = wt {
+                let blocked = if w.locked {
+                    Some(vec!["(the worktree is locked)".to_string()])
+                } else {
+                    match dirty_files(&w.path) {
+                        Ok(f) if f.is_empty() => None,
+                        Ok(f) => Some(f),
+                        Err(err) => Some(vec![format!("(cannot read its status: {err})")]),
+                    }
+                };
+                if let Some(files) = blocked {
+                    let mut ev = evidence;
+                    for f in files.iter().take(20) {
+                        ev.push(Evidence::new("worktree", f.clone()));
+                    }
+                    if files.len() > 20 {
+                        ev.push(Evidence::new(
+                            "worktree",
+                            format!("... and {} more", files.len() - 20),
+                        ));
+                    }
+                    let mut fnd = mk(
+                        Kind::Branch,
+                        id,
+                        title,
+                        ev,
+                        Verdict::Ask,
+                        format!(
+                            "finished ({reason}) but its worktree {} has uncommitted or untracked files, listed below; nothing was deleted",
+                            w.path.display()
+                        ),
+                        Action::None,
+                        &facts,
+                    );
+                    fnd.options = keep_option();
+                    fnd.recommended = Some("keep".into());
+                    fnd.manual_command = Some(format!("git -C {} status", w.path.display()));
+                    return fnd;
+                }
+            }
+            let mut fnd = mk(
+                Kind::Branch,
+                id,
+                title,
+                evidence,
+                Verdict::AutoSafe,
+                format!(
+                    "{reason}; deleting records the tip {} so it can be restored with `{recover}`{}",
+                    short_sha(tip),
+                    wt.map(|w| format!(" (the clean worktree {} is removed first)", w.path.display()))
+                        .unwrap_or_default()
+                ),
+                Action::DeleteBranch {
+                    branch: name.to_string(),
+                    tip_sha: tip.to_string(),
+                    worktree: wt.map(|w| w.path.clone()),
+                    reason,
+                },
+                &facts,
+            );
+            fnd.manual_command = Some(format!("git branch -D {name}"));
+            fnd
+        }
+        Err((verdict, why)) => {
+            let mut fnd = mk(
+                Kind::Branch,
+                id,
+                title,
+                evidence,
+                verdict,
+                why,
+                Action::None,
+                &facts,
+            );
+            if verdict == Verdict::Ask {
+                fnd.options = keep_option();
+                fnd.recommended = Some("keep".into());
+                fnd.manual_command = Some(format!(
+                    "git log {}..{name} --oneline",
+                    ctx.default.as_deref().unwrap_or("main")
+                ));
+            }
+            fnd
+        }
+    }
+}
+
+/// Remote branches whose PR was closed unmerged: findings only, never deleted.
+fn remote_findings(ctx: &Ctx, out: &mut Vec<Finding>) {
+    let Ok(listing) = git(
+        ctx.root,
+        &[
+            "for-each-ref",
+            "--format=%(refname:short)%09%(objectname)",
+            "refs/remotes",
+        ],
+    ) else {
+        return;
+    };
+    let mut probes = 0;
+    for line in listing.lines() {
+        let Some((full, sha)) = line.split_once('\t') else {
+            continue;
+        };
+        let Some((remote, branch)) = full.split_once('/') else {
+            continue;
+        };
+        if branch == "HEAD" || Some(branch) == ctx.default.as_deref() {
+            continue;
+        }
+        if probes >= MAX_REMOTE_PROBES {
+            tracing::info!(
+                limit = MAX_REMOTE_PROBES,
+                "cleanup: remote branch report capped; run `ta cleanup --only branches` again after pruning"
+            );
+            break;
+        }
+        probes += 1;
+        let review = ctx.e.truth.branch_review(branch);
+        if review.state != ReviewState::Closed {
+            continue;
+        }
+        let pr = review
+            .number
+            .as_deref()
+            .map(|n| format!("PR #{n}"))
+            .unwrap_or_else(|| "its PR".into());
+        let mut f = mk(
+            Kind::RemoteBranch,
+            format!("remote_branch:{full}"),
+            format!("Remote branch {full}"),
+            vec![
+                Evidence::new("git", format!("{full} at {}", short_sha(sha))),
+                Evidence::new("vcs", format!("{pr} was closed without merging")),
+            ],
+            Verdict::Skip,
+            format!("{pr} was closed without merging. Remote branches are never deleted by cleanup; delete it on {remote} if the work is abandoned"),
+            Action::None,
+            &[("remote_branch", full.to_string()), ("tip", sha.to_string())],
+        );
+        f.manual_command = Some(format!("git push {remote} --delete {branch}"));
+        out.push(f);
+    }
+}
+
+/// Delete a branch the scan judged finished. Every precondition is re-checked here because the
+/// scan may be minutes old (a person answering a batch prompt, or the daemon between passes).
+pub fn delete_branch(
+    e: &Engine,
+    branch: &str,
+    tip_sha: &str,
+    worktree: Option<&Path>,
+    reason: &str,
+) -> anyhow::Result<String> {
+    let root = e.paths.root.as_path();
+    if branch.starts_with('-') || branch.is_empty() {
+        anyhow::bail!("refusing to delete '{branch}': not a valid branch name");
+    }
+    let current = git(root, &["symbolic-ref", "--quiet", "--short", "HEAD"]).ok();
+    if current.as_deref() == Some(branch) {
+        anyhow::bail!("'{branch}' is the current branch; check out another branch first");
+    }
+    let locals = local_branches(root).map_err(anyhow::Error::msg)?;
+    if default_branch(root, &locals).as_deref() == Some(branch) {
+        anyhow::bail!("'{branch}' is the default branch; cleanup never deletes it");
+    }
+    let now = ref_sha(root, &format!("refs/heads/{branch}"))
+        .ok_or_else(|| anyhow::anyhow!("branch '{branch}' no longer exists; nothing to delete"))?;
+    if now != tip_sha {
+        anyhow::bail!(
+            "branch '{branch}' moved from {} to {} since cleanup looked at it, so it was kept. Run `ta cleanup --dry-run --only branches` to re-check.",
+            short_sha(tip_sha),
+            short_sha(&now)
+        );
+    }
+    let mut removed_wt = None;
+    if let Some(w) = worktree {
+        match dirty_files(w) {
+            Ok(f) if f.is_empty() => {}
+            Ok(f) => anyhow::bail!(
+                "worktree {} now has uncommitted or untracked files ({}); branch '{branch}' was kept",
+                w.display(),
+                f.iter().take(5).cloned().collect::<Vec<_>>().join(", ")
+            ),
+            Err(err) => anyhow::bail!(
+                "cannot confirm worktree {} is clean ({err}); branch '{branch}' was kept",
+                w.display()
+            ),
+        }
+        let w = w
+            .to_str()
+            .ok_or_else(|| anyhow::anyhow!("worktree path {} is not valid UTF-8", w.display()))?;
+        // No --force: git itself refuses a worktree with changes, a second line of defence.
+        git(root, &["worktree", "remove", w]).map_err(|err| {
+            anyhow::anyhow!("{err}. Branch '{branch}' was kept; remove the worktree by hand")
+        })?;
+        removed_wt = Some(w.to_string());
+    }
+    // `-D` is deliberate: after a squash merge git cannot see the branch as merged, and the
+    // tip was verified above, so the deletion is exactly the one that was judged safe.
+    git(root, &["branch", "-D", "--", branch]).map_err(anyhow::Error::msg)?;
+
+    let line = json!({
+        "action": "delete_branch",
+        "branch": branch,
+        "tip_sha": tip_sha,
+        "worktree": removed_wt,
+        "reason": reason,
+        "recover": format!("git branch {branch} {tip_sha}"),
+        "at": chrono::Utc::now().to_rfc3339(),
+    });
+    if let Err(err) = state::append_jsonl(&e.paths.cleanup_dir().join("branches.jsonl"), &line) {
+        tracing::warn!(branch, tip_sha, error = %err, "cleanup: deleted the branch but could not write .ta/cleanup/branches.jsonl; the audit log still has it");
+    }
+    Ok(format!(
+        "deleted branch {branch} (tip {tip_sha}){}; restore with `git branch {branch} {tip_sha}`",
+        removed_wt
+            .map(|w| format!(" and removed worktree {w}"))
+            .unwrap_or_default()
+    ))
+}
+
+pub fn prune_worktrees(e: &Engine, paths: &[PathBuf]) -> anyhow::Result<String> {
+    git(&e.paths.root, &["worktree", "prune"]).map_err(anyhow::Error::msg)?;
+    Ok(format!(
+        "pruned {} worktree record(s) whose directory was gone",
+        paths.len()
+    ))
+}
