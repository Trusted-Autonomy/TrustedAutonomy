+//! The `branches` group against real git repositories in temp dirs: a bare repo as `origin`,
+//! a clone as the project, and PR state faked through [`GroundTruth::branch_review`].
+//! Nothing here touches the repository the tests run from.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+use crate::act::FileCloser;
+use crate::*;
+
+fn git(dir: &Path, args: &[&str]) -> String {
+    let out = crate::branches::git_cmd(dir)
+        .args([
+            "-c",
+            "user.name=Test",
+            "-c",
+            "user.email=test@example.com",
+            "-c",
+            "commit.gpgsign=false",
+        ])
+        .args(args)
+        .output()
+        .expect("git runs");
+    assert!(
+        out.status.success(),
+        "git {args:?} failed: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    String::from_utf8_lossy(&out.stdout).trim().to_string()
+}
+
+#[derive(Default)]
+struct PrTruth {
+    prs: HashMap<String, BranchReview>,
+}
+
+impl GroundTruth for PrTruth {
+    fn review_state(&self, _r: &str) -> ReviewState {
+        ReviewState::Unknown("not used".into())
+    }
+    fn phase_done(&self, _p: &str) -> bool {
+        false
+    }
+    fn branch_review(&self, branch: &str) -> BranchReview {
+        self.prs
+            .get(branch)
+            .cloned()
+            .unwrap_or_else(BranchReview::none)
+    }
+}
+
+fn pr(state: ReviewState, head: Option<&str>) -> BranchReview {
+    BranchReview {
+        state,
+        number: Some("7".into()),
+        head_sha: head.map(str::to_string),
+    }
+}
+
+struct Repo {
+    dir: tempfile::TempDir,
+}
+
+impl Repo {
+    /// `origin` (bare) and `work` (a clone on `main` with one commit pushed).
+    fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let origin = dir.path().join("origin.git");
+        std::fs::create_dir_all(&origin).unwrap();
+        git(&origin, &["init", "--bare", "-b", "main"]);
+        let work = dir.path().join("work");
+        std::fs::create_dir_all(&work).unwrap();
+        git(&work, &["init", "-b", "main"]);
+        git(
+            &work,
+            &["remote", "add", "origin", origin.to_str().unwrap()],
+        );
+        let r = Repo { dir };
+        r.commit("base.txt", "base");
+        git(&work, &["push", "-u", "origin", "main"]);
+        git(&work, &["remote", "set-head", "origin", "main"]);
+        r
+    }
+
+    fn work(&self) -> PathBuf {
+        self.dir.path().join("work")
+    }
+
+    fn commit(&self, file: &str, msg: &str) -> String {
+        std::fs::write(self.work().join(file), msg).unwrap();
+        git(&self.work(), &["add", file]);
+        git(&self.work(), &["commit", "-m", msg]);
+        git(&self.work(), &["rev-parse", "HEAD"])
+    }
+
+    /// A branch with one commit, left on `main`. Returns its tip.
+    fn branch(&self, name: &str) -> String {
+        git(&self.work(), &["checkout", "-b", name, "main"]);
+        let tip = self.commit(&format!("{}.txt", name.replace('/', "_")), name);
+        git(&self.work(), &["checkout", "main"]);
+        tip
+    }
+
+    /// Squash-merge `name` into `main`: the branch is now unmerged as far as git can tell.
+    fn squash(&self, name: &str) {
+        git(&self.work(), &["merge", "--squash", name]);
+        git(&self.work(), &["commit", "-m", &format!("squash {name}")]);
+    }
+
+    fn exists(&self, name: &str) -> bool {
+        !git(&self.work(), &["branch", "--list", name]).is_empty()
+    }
+
+    fn engine<'a>(&self, truth: &'a PrTruth, settings: Settings) -> Engine<'a> {
+        Engine {
+            paths: Paths::for_project(&self.work()),
+            settings,
+            truth,
+            closer: &FileCloser,
+            assistant: None,
+        }
+    }
+}
+
+fn only_branches(dry_run: bool, yes: bool) -> RunOptions {
+    RunOptions {
+        dry_run,
+        yes,
+        only: Some(vec![Category::Branches]),
+        auto_safe_only: false,
+    }
+}
+
+fn finding<'a>(r: &'a Report, id: &str) -> &'a Finding {
+    r.findings.iter().find(|f| f.id == id).unwrap_or_else(|| {
+        panic!(
+            "no finding {id}: {:?}",
+            r.findings.iter().map(|f| &f.id).collect::<Vec<_>>()
+        )
+    })
+}
+
+#[test]
+fn merged_squash_branch_is_deleted_and_logged_with_its_tip() {
+    let repo = Repo::new();
+    let tip = repo.branch("feature/a");
+    repo.squash("feature/a");
+    // git itself calls this branch unmerged: that is the point of using the PR state.
+    assert!(git(&repo.work(), &["branch", "--no-merged", "main"]).contains("feature/a"));
+    let mut t = PrTruth::default();
+    t.prs
+        .insert("feature/a".into(), pr(ReviewState::Merged, Some(&tip)));
+    let e = repo.engine(&t, Settings::default());
+
+    let r = run(&e, &only_branches(false, false), None).unwrap();
+
+    assert!(!repo.exists("feature/a"));
+    assert!(
+        r.done.iter().any(|d| d.summary.contains(&tip)),
+        "{:?}",
+        r.done
+    );
+    let log = std::fs::read_to_string(e.paths.cleanup_dir().join("branches.jsonl")).unwrap();
+    assert!(log.contains("feature/a") && log.contains(&tip), "{log}");
+    assert!(
+        log.contains(&format!("git branch feature/a {tip}")),
+        "{log}"
+    );
+    // The recovery command in the log really restores it.
+    git(&repo.work(), &["branch", "feature/a", &tip]);
+    assert!(repo.exists("feature/a"));
+}
