+#[test]
+fn current_and_default_branches_are_never_touched() {
+    let repo = Repo::new();
+    let tip = repo.branch("feature/here");
+    git(&repo.work(), &["checkout", "feature/here"]);
+    let main_tip = git(&repo.work(), &["rev-parse", "main"]);
+    let mut t = PrTruth::default();
+    // The PR lookup says merged for both; the safety rules must still hold.
+    t.prs
+        .insert("feature/here".into(), pr(ReviewState::Merged, Some(&tip)));
+    t.prs
+        .insert("main".into(), pr(ReviewState::Merged, Some(&main_tip)));
+    let e = repo.engine(&t, Settings::default());
+
+    let r = run(&e, &only_branches(false, true), None).unwrap();
+
+    assert!(repo.exists("feature/here") && repo.exists("main"));
+    assert!(r.findings.iter().all(|f| f.id != "branch:feature/here"));
+    assert!(r.findings.iter().all(|f| f.id != "branch:main"));
+    assert!(r.done.is_empty());
+
+    // And the deleter itself refuses, should a stale action ever reach it.
+    let err = act::execute(
+        &e,
+        &Action::DeleteBranch {
+            branch: "feature/here".into(),
+            tip_sha: tip,
+            worktree: None,
+            reason: "test".into(),
+        },
+    )
+    .unwrap_err()
+    .to_string();
+    assert!(err.contains("current branch"), "{err}");
+    assert!(repo.exists("feature/here"));
+}
