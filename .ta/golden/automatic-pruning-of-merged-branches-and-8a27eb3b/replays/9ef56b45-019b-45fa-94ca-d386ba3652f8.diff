+#[test]
+fn dirty_worktree_is_a_question_listing_the_files_and_clean_one_is_removed() {
+    let repo = Repo::new();
+    let dirty_tip = repo.branch("feature/dirty");
+    let clean_tip = repo.branch("feature/clean");
+    let wt_dirty = repo.dir.path().join("wt-dirty");
+    let wt_clean = repo.dir.path().join("wt-clean");
+    git(
+        &repo.work(),
+        &[
+            "worktree",
+            "add",
+            wt_dirty.to_str().unwrap(),
+            "feature/dirty",
+        ],
+    );
+    git(
+        &repo.work(),
+        &[
+            "worktree",
+            "add",
+            wt_clean.to_str().unwrap(),
+            "feature/clean",
+        ],
+    );
+    std::fs::write(wt_dirty.join("scratch.txt"), "unsaved").unwrap();
+    let mut t = PrTruth::default();
+    t.prs.insert(
+        "feature/dirty".into(),
+        pr(ReviewState::Merged, Some(&dirty_tip)),
+    );
+    t.prs.insert(
+        "feature/clean".into(),
+        pr(ReviewState::Merged, Some(&clean_tip)),
+    );
+    let e = repo.engine(&t, Settings::default());
+
+    let r = run(&e, &only_branches(false, true), None).unwrap();
+
+    assert!(repo.exists("feature/dirty") && wt_dirty.join("scratch.txt").exists());
+    let f = finding(&r, "branch:feature/dirty");
+    assert_eq!(f.verdict, Verdict::Ask);
+    assert!(
+        f.evidence.iter().any(|e| e.fact.contains("scratch.txt")),
+        "file list missing: {:?}",
+        f.evidence
+    );
+    assert!(!repo.exists("feature/clean"));
+    assert!(
+        !wt_clean.exists(),
+        "the clean worktree should be pruned too"
+    );
+}
