+/// Pick the PR that speaks for a branch from `gh pr list --json number,state,headRefOid`:
+/// an open PR wins (the branch is in use), then the newest merged one, then the newest closed
+/// one. No PRs at all is a valid answer: `state` is empty.
+pub(crate) fn parse_branch_reviews(json: &str) -> Result<BranchReview> {
+    let list: Vec<serde_json::Value> = serde_json::from_str(json)
+        .map_err(|e| SubmitError::VcsError(format!("Failed to parse gh pr list output: {e}")))?;
+    let mut best: Option<(u8, u64, BranchReview)> = None;
+    for pr in &list {
+        let state = pr
+            .get("state")
+            .and_then(|v| v.as_str())
+            .unwrap_or("")
+            .to_lowercase();
+        let rank = match state.as_str() {
+            "open" => 3,
+            "merged" => 2,
+            "closed" => 1,
+            _ => 0,
+        };
+        let number = pr.get("number").and_then(|v| v.as_u64()).unwrap_or(0);
+        if best
+            .as_ref()
+            .is_none_or(|(r, n, _)| (rank, number) > (*r, *n))
+        {
+            best = Some((
+                rank,
+                number,
+                BranchReview {
+                    number: Some(number.to_string()),
+                    state,
+                    head_sha: pr
+                        .get("headRefOid")
+                        .and_then(|v| v.as_str())
+                        .filter(|s| !s.is_empty())
+                        .map(str::to_string),
+                },
+            ));
+        }
+    }
+    Ok(best.map(|(_, _, r)| r).unwrap_or(BranchReview {
+        number: None,
+        state: String::new(),
+        head_sha: None,
+    }))
+}
