+//! The `branches` group: local branches (and their worktrees) whose work has
+//! landed, and remote branches whose PR was closed unmerged.
+//!
+//! Ground truth is the PR state from the VCS adapter, never `git branch -d` or
+//! `git cherry` (a squash merge rewrites patch ids, so both call finished
+//! branches unmerged). A local branch is deleted without asking only when
+//!
+//! * its tip is a strict ancestor of the default branch, or
+//! * its PR is merged and the tip is at or behind the PR head (no commits of
+//!   its own beyond what the PR merged),
+//!
+//! and, if it is checked out in a linked worktree, that worktree has no
+//! uncommitted or untracked files. Everything else is kept or put to a person.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+
+use crate::model::*;
+use crate::scan::{mk, Scan};
+
+/// At most this many remote branches are looked up per scan. Each lookup is a
+/// network call, and `delete_branch_on_merge` keeps the real number small.
+const MAX_REMOTE_LOOKUPS: usize = 50;
+
+fn short_sha(s: &str) -> &str {
+    &s[..s.len().min(8)]
+}
+
+pub(crate) fn branches(s: &Scan, out: &mut Vec<Finding>) {
+    let Some(truth) = s.e.truth.branches() else {
+        return;
+    };
+    let inv = match truth.inventory() {
+        Ok(i) => i,
+        Err(e) => {
+            tracing::warn!(error = %e, "cleanup: could not inspect branches; skipping the branches group");
+            return;
+        }
+    };
+    let default_tip = inv
+        .default_branch
+        .as_deref()
+        .and_then(|d| inv.branches.iter().find(|b| b.name == d))
+        .map(|b| b.tip.clone());
+
+    let pr_cache: RefCell<HashMap<String, BranchPr>> = RefCell::new(HashMap::new());
+    let pr_for = |name: &str| -> BranchPr {
+        if let Some(hit) = pr_cache.borrow().get(name) {
+            return hit.clone();
+        }
+        let pr = truth.pr_for_branch(name);
+        pr_cache.borrow_mut().insert(name.to_string(), pr.clone());
+        pr
+    };
+
+    for b in &inv.branches {
+        if Some(&b.name) == inv.default_branch.as_ref()
+            || Some(&b.name) == inv.current_branch.as_ref()
+        {
+            continue;
+        }
+        let tip7 = short_sha(&b.tip);
+        let wt = inv
+            .worktrees
+            .iter()
+            .find(|w| w.branch.as_deref() == Some(b.name.as_str()));
+        let mut evidence = vec![Evidence::new("git", format!("tip {tip7}"))];
+        let mut facts: Vec<(&str, String)> = vec![("tip", b.tip.clone())];
+        if let Some(w) = wt {
+            evidence.push(Evidence::new(
+                "git",
+                format!("checked out in worktree {}", w.path.display()),
+            ));
+        }
+
+        // Landed: Ok(why) or Err((verdict, why not)).
+        let mut landed: Result<String, (Verdict, String)> = Err((
+            Verdict::Ask,
+            "no PR was found for this branch and it is not in the default branch".into(),
+        ));
+        let mut resolved = false;
+
+        if let (Some(dt), Some(db)) = (&default_tip, &inv.default_branch) {
+            // Equal tips are ambiguous (a fresh branch looks the same as one fast-forwarded
+            // into the default), so only a strict ancestor counts.
+            if *dt != b.tip && matches!(truth.is_ancestor(&b.tip, dt), Ok(true)) {
+                landed = Ok(format!("its tip {tip7} is an ancestor of '{db}'"));
+                evidence.push(Evidence::new(
+                    "git",
+                    format!("tip is an ancestor of '{db}'"),
+                ));
+                resolved = true;
+            }
+        }
+        if !resolved {
+            match pr_for(&b.name) {
+                BranchPr::Found {
+                    review_id,
+                    state,
+                    head_sha,
+                } => {
+                    evidence.push(Evidence::new(
+                        "vcs",
+                        format!("PR #{review_id} is {}", state_word(&state)),
+                    ));
+                    facts.push(("pr", format!("{review_id}:{}", state_word(&state))));
+                    landed = match state {
+                        ReviewState::Open => Err((
+                            Verdict::Skip,
+                            format!("PR #{review_id} is still open, so the branch is in use"),
+                        )),
+                        ReviewState::Closed => Err((
+                            Verdict::Ask,
+                            format!("PR #{review_id} was closed without merging"),
+                        )),
+                        ReviewState::Unknown(w) => Err((Verdict::Ask, w)),
+                        ReviewState::Merged => match &head_sha {
+                            None => Err((
+                                Verdict::Ask,
+                                format!("PR #{review_id} is merged but its head commit is unknown, so \"no commits beyond the PR head\" cannot be shown"),
+                            )),
+                            Some(h) => match truth.is_ancestor(&b.tip, h) {
+                                Ok(true) => {
+                                    evidence.push(Evidence::new(
+                                        "git",
+                                        format!("tip {tip7} is at or behind the PR head {}", short_sha(h)),
+                                    ));
+                                    Ok(format!("PR #{review_id} is merged and the branch has no commits beyond the PR head {}", short_sha(h)))
+                                }
+                                Ok(false) => Err((
+                                    Verdict::Ask,
+                                    format!("PR #{review_id} is merged but the branch has commits beyond the PR head {}", short_sha(h)),
+                                )),
+                                Err(e) => Err((
+                                    Verdict::Ask,
+                                    format!("PR #{review_id} is merged but the PR head {} could not be compared ({e})", short_sha(h)),
+                                )),
+                            },
+                        },
+                    };
+                }
+                BranchPr::NotFound => {
+                    evidence.push(Evidence::new("vcs", "no PR found for this branch"));
+                    facts.push(("pr", "none".into()));
+                    if default_tip.as_deref() == Some(b.tip.as_str()) {
+                        landed = Err((
+                            Verdict::Ask,
+                            "it points at the same commit as the default branch and has no PR; it may be new, or fully merged".into(),
+                        ));
+                    }
+                }
+                BranchPr::Unknown(why) => {
+                    evidence.push(Evidence::new("vcs", format!("PR lookup failed: {why}")));
+                    facts.push(("pr", "unknown".into()));
+                    landed = Err((
+                        Verdict::Ask,
+                        format!("the PR state could not be read ({why})"),
+                    ));
+                }
+            }
+        }
+
+        // Worktree: removable only when linked and clean.
+        let mut dirty: Vec<String> = Vec::new();
+        let mut wt_problem: Option<String> = None;
+        let mut removable_wt: Option<std::path::PathBuf> = None;
+        if let Some(w) = wt {
+            if w.is_main {
+                wt_problem = Some(format!(
+                    "it is checked out in the main worktree {}; switch that worktree to another branch first",
+                    w.path.display()
+                ));
+            } else {
+                match truth.uncommitted_files(&w.path) {
+                    Ok(files) if files.is_empty() => removable_wt = Some(w.path.clone()),
+                    Ok(files) => {
+                        wt_problem = Some(format!(
+                            "its worktree {} has {} uncommitted or untracked file(s)",
+                            w.path.display(),
+                            files.len()
+                        ));
+                        dirty = files;
+                    }
+                    Err(e) => {
+                        wt_problem = Some(format!(
+                            "its worktree {} could not be checked for uncommitted files ({e})",
+                            w.path.display()
+                        ));
+                    }
+                }
+            }
+        }
+        if !dirty.is_empty() {
+            let shown: Vec<&str> = dirty.iter().take(20).map(String::as_str).collect();
+            let more = dirty.len().saturating_sub(shown.len());
+            evidence.push(Evidence::new(
+                "git",
+                format!(
+                    "uncommitted files: {}{}",
+                    shown.join(", "),
+                    if more > 0 {
+                        format!(" and {more} more")
+                    } else {
+                        String::new()
+                    }
+                ),
+            ));
+            facts.push(("dirty", dirty.join("\n")));
+        }
+
+        let id = format!("branch:{}", b.name);
+        let delete = Action::DeleteBranch {
+            name: b.name.clone(),
+            tip: b.tip.clone(),
+            worktree: removable_wt.clone(),
+            reason: String::new(),
+        };
+        let with_reason = |why: &str| match &delete {
+            Action::DeleteBranch {
+                name,
+                tip,
+                worktree,
+                ..
+            } => Action::DeleteBranch {
+                name: name.clone(),
+                tip: tip.clone(),
+                worktree: worktree.clone(),
+                reason: why.to_string(),
+            },
+            other => other.clone(),
+        };
+        let recover = format!("git branch {} {}", b.name, b.tip);
+        match landed {
+            Ok(why) if wt_problem.is_none() => {
+                let wt_note = removable_wt
+                    .as_ref()
+                    .map(|p| format!(" and remove its clean worktree {}", p.display()))
+                    .unwrap_or_default();
+                let mut f = mk(
+                    Kind::Branch,
+                    id,
+                    format!("branch {}", b.name),
+                    evidence,
+                    Verdict::AutoSafe,
+                    format!("Delete{wt_note}: {why}. Recover with `{recover}`."),
+                    with_reason(&why),
+                    &facts,
+                );
+                f.manual_command = Some(format!("git branch -D {} (tip was {})", b.name, b.tip));
+                out.push(f);
+            }
+            Ok(why) => {
+                let problem = wt_problem.unwrap_or_default();
+                out.push(question(
+                    id,
+                    &b.name,
+                    evidence,
+                    format!("Work has landed ({why}) but {problem}. Left alone."),
+                    None,
+                    &recover,
+                    &facts,
+                ));
+            }
+            Err((Verdict::Skip, why)) => {
+                out.push(mk(
+                    Kind::Branch,
+                    id,
+                    format!("branch {}", b.name),
+                    evidence,
+                    Verdict::Skip,
+                    format!("Kept: {why}."),
+                    Action::None,
+                    &facts,
+                ));
+            }
+            Err((_, why)) => {
+                let can_delete = wt_problem.is_none();
+                let mut reason = format!("Not deleted: {why}.");
+                if let Some(p) = &wt_problem {
+                    reason.push_str(&format!(" Also {p}."));
+                }
+                out.push(question(
+                    id,
+                    &b.name,
+                    evidence,
+                    reason,
+                    can_delete.then(|| with_reason("confirmed by a person")),
+                    &recover,
+                    &facts,
+                ));
+            }
+        }
+    }
+
+    // Remote branches: never deleted here (the repository deletes head
+    // branches on merge). Closed-unmerged ones are reported for a human.
+    let mut lookups = 0;
+    for r in &inv.remote_branches {
+        if Some(r) == inv.default_branch.as_ref() {
+            continue;
+        }
+        if lookups >= MAX_REMOTE_LOOKUPS {
+            tracing::warn!(
+                limit = MAX_REMOTE_LOOKUPS,
+                "cleanup: stopped looking up remote branch PRs; remaining remote branches were not checked"
+            );
+            break;
+        }
+        if !pr_cache.borrow().contains_key(r) {
+            lookups += 1;
+        }
+        if let BranchPr::Found {
+            review_id,
+            state: ReviewState::Closed,
+            ..
+        } = pr_for(r)
+        {
+            let mut f = mk(
+                Kind::RemoteBranch,
+                format!("remote-branch:{r}"),
+                format!("remote branch {r}"),
+                vec![Evidence::new(
+                    "vcs",
+                    format!("PR #{review_id} was closed without merging"),
+                )],
+                Verdict::Skip,
+                format!("Finding only: PR #{review_id} was closed without merging, so the remote branch '{r}' may be abandoned. Remote branches are never deleted by cleanup."),
+                Action::None,
+                &[("remote", r.clone()), ("pr", review_id)],
+            );
+            f.manual_command = Some(format!("git push origin --delete {r}"));
+            out.push(f);
+        }
+    }
+}
+
+fn state_word(s: &ReviewState) -> &'static str {
+    match s {
+        ReviewState::Open => "open",
+        ReviewState::Merged => "merged",
+        ReviewState::Closed => "closed without merging",
+        ReviewState::Unknown(_) => "unknown",
+    }
+}
+
+/// An `Ask` finding: keep, or (when it is safe to offer) delete.
+fn question(
+    id: String,
+    name: &str,
+    evidence: Vec<Evidence>,
+    reason: String,
+    delete: Option<Action>,
+    recover: &str,
+    facts: &[(&str, String)],
+) -> Finding {
+    let mut f = mk(
+        Kind::Branch,
+        id,
+        format!("branch {name}"),
+        evidence,
+        Verdict::Ask,
+        reason,
+        Action::None,
+        facts,
+    );
+    f.options.push(AnswerOption {
+        key: "keep".into(),
+        label: "Keep the branch".into(),
+        action: Action::None,
+    });
+    if let Some(a) = delete {
+        f.options.push(AnswerOption {
+            key: "delete".into(),
+            label: format!("Delete the branch (recover with `{recover}`)"),
+            action: a,
+        });
+    }
+    f.recommended = Some("keep".into());
+    f.manual_command = Some(format!(
+        "to delete by hand: git branch -D {name}; to undo: {recover}"
+    ));
+    f
+}
