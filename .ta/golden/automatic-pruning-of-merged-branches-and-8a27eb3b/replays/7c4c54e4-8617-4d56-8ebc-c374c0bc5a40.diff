+    repo.prs.insert("feat-wt".into(), merged("12", &tip));
+    let wt = repo.work.parent().unwrap().join("wt-dirty");
+    git(
+        &repo.work,
+        &["worktree", "add", wt.to_str().unwrap(), "feat-wt"],
+    );
+    std::fs::write(wt.join("scratch.txt"), "not committed\n").unwrap();
+
+    let r = repo.run_branches();
+    let f = finding(&r, "branch:feat-wt");
+    assert_eq!(f.verdict, Verdict::Ask);
+    let text = format!("{} {:?}", f.reason, f.evidence);
+    assert!(text.contains("scratch.txt"), "{text}");
+    assert!(
+        f.options.iter().all(|o| o.key == "keep"),
+        "no delete offered"
+    );
+    assert!(repo.has_branch("feat-wt"));
+    assert!(wt.exists(), "worktree untouched");
+    assert!(wt.join("scratch.txt").exists());
+}
