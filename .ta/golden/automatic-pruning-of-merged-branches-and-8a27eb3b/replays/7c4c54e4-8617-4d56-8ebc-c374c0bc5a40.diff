+//! [`BranchTruth`] on top of the project's [`SourceAdapter`], so git calls stay
+//! inside the adapter (constitution section 16) and cleanup works with any
+//! adapter that implements the branch methods.
+
+use std::path::Path;
+
+use ta_submit::SourceAdapter;
+
+use crate::model::*;
+
+fn err(e: impl std::fmt::Display) -> anyhow::Error {
+    anyhow::anyhow!("{e}")
+}
+
+impl BranchTruth for Box<dyn SourceAdapter> {
+    fn inventory(&self) -> anyhow::Result<BranchInventory> {
+        let Some(branches) = self.list_local_branches().map_err(err)? else {
+            anyhow::bail!(
+                "the '{}' VCS adapter has no branches, so there is nothing to prune",
+                self.name()
+            );
+        };
+        Ok(BranchInventory {
+            default_branch: self.default_branch().map_err(err)?,
+            current_branch: self
+                .current_branch()
+                .ok()
+                .filter(|b| b != "HEAD" && b != "unknown"),
+            branches: branches
+                .into_iter()
+                .map(|b| BranchTip {
+                    name: b.name,
+                    tip: b.tip,
+                })
+                .collect(),
+            worktrees: self
+                .list_worktrees()
+                .map_err(err)?
+                .into_iter()
+                .map(|w| WorktreeEntry {
+                    path: w.path,
+                    branch: w.branch,
+                    is_main: w.is_main,
+                })
+                .collect(),
+            remote_branches: self.list_remote_branches().map_err(err)?,
+        })
+    }
+
+    fn pr_for_branch(&self, branch: &str) -> BranchPr {
+        match self.branch_review(branch) {
+            Ok(None) => BranchPr::NotFound,
