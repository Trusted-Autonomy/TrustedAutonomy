+                println!("[cleanup] {}", d.summary);
+            }
+            for (id, err) in &r.failed {
+                eprintln!("[warn] cleanup could not prune {id}: {err}. Run `ta cleanup --only branches --dry-run` to see why.");
+            }
+            if !r.questions_open.is_empty() {
+                println!(
+                    "[cleanup] {} branch(es) need a decision. Run `ta cleanup --only branches`.",
+                    r.questions_open.len()
+                );
+            }
+        }
+        Err(e) => eprintln!(
+            "[warn] branch cleanup failed: {e}. Run `ta cleanup --only branches --dry-run` for details."
+        ),
+    }
