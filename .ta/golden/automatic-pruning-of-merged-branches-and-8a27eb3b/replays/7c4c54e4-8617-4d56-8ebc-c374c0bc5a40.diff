+//! `branches` group tests: real git repositories in tempdirs with a local bare
+//! repository as `origin`; only the PR state is faked.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use ta_submit::{GitAdapter, SourceAdapter};
+
+use crate::act::FileCloser;
+use crate::*;
+
+fn git(dir: &Path, args: &[&str]) -> String {
+    let out = Command::new("git")
+        .args([
+            "-c",
+            "user.name=Test",
+            "-c",
+            "user.email=test@example.com",
+            "-c",
+            "commit.gpgsign=false",
+            "-c",
+            "init.defaultBranch=main",
+        ])
+        .args(args)
+        .current_dir(dir)
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .output()
+        .expect("git runs");
+    assert!(
+        out.status.success(),
+        "git {args:?} in {} failed: {}",
+        dir.display(),
+        String::from_utf8_lossy(&out.stderr)
+    );
+    String::from_utf8_lossy(&out.stdout).trim().to_string()
+}
+
+/// PR state per branch on top of the real git adapter.
+struct FakePrs {
+    git: Box<dyn SourceAdapter>,
+    prs: HashMap<String, BranchPr>,
+}
+
+impl BranchTruth for FakePrs {
+    fn inventory(&self) -> anyhow::Result<BranchInventory> {
+        self.git.inventory()
+    }
+    fn pr_for_branch(&self, branch: &str) -> BranchPr {
+        self.prs.get(branch).cloned().unwrap_or(BranchPr::NotFound)
+    }
+    fn is_ancestor(&self, a: &str, d: &str) -> anyhow::Result<bool> {
+        BranchTruth::is_ancestor(&self.git, a, d)
+    }
+    fn uncommitted_files(&self, p: &Path) -> anyhow::Result<Vec<String>> {
+        BranchTruth::uncommitted_files(&self.git, p)
+    }
+    fn delete_branch(&self, n: &str, t: &str) -> anyhow::Result<()> {
+        self.git.delete_branch(n, t)
+    }
+    fn remove_worktree(&self, p: &Path) -> anyhow::Result<()> {
+        BranchTruth::remove_worktree(&self.git, p)
+    }
+}
+
+struct Truth(FakePrs);
+
+impl GroundTruth for Truth {
+    fn review_state(&self, _: &str) -> ReviewState {
+        ReviewState::Unknown("not used".into())
+    }
+    fn phase_done(&self, _: &str) -> bool {
+        false
+    }
+    fn branches(&self) -> Option<&dyn BranchTruth> {
+        Some(&self.0)
+    }
+}
+
+struct Repo {
+    _dir: tempfile::TempDir,
+    work: PathBuf,
+    origin: PathBuf,
+    prs: HashMap<String, BranchPr>,
+}
+
+fn merged(n: &str, head: &str) -> BranchPr {
+    BranchPr::Found {
+        review_id: n.into(),
+        state: ReviewState::Merged,
+        head_sha: Some(head.into()),
+    }
+}
+
+impl Repo {
+    fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let origin = dir.path().join("origin.git");
+        let work = dir.path().join("work");
+        std::fs::create_dir_all(&origin).unwrap();
+        std::fs::create_dir_all(&work).unwrap();
+        git(&origin, &["init", "--bare"]);
+        git(&work, &["init"]);
+        git(&work, &["checkout", "-b", "main"]);
+        git(
+            &work,
+            &["remote", "add", "origin", origin.to_str().unwrap()],
+        );
+        std::fs::write(work.join("a.txt"), "base\n").unwrap();
+        git(&work, &["add", "."]);
+        git(&work, &["commit", "-m", "base"]);
+        git(&work, &["push", "-u", "origin", "main"]);
+        Repo {
+            _dir: dir,
+            work,
+            origin,
+            prs: HashMap::new(),
+        }
+    }
+
+    fn commit_file(&self, name: &str, body: &str) -> String {
+        std::fs::write(self.work.join(name), body).unwrap();
+        git(&self.work, &["add", "."]);
+        git(&self.work, &["commit", "-m", name]);
+        git(&self.work, &["rev-parse", "HEAD"])
+    }
+
+    /// A feature branch with one commit, then back to main. Returns its tip.
+    fn feature(&self, name: &str) -> String {
+        git(&self.work, &["checkout", "-b", name]);
+        let tip = self.commit_file(&format!("{name}.txt"), "feature\n");
+        git(&self.work, &["checkout", "main"]);
+        tip
+    }
+
+    /// Main moves on with an unrelated commit, as after a squash merge.
+    fn advance_main(&self) {
+        self.commit_file("main-moves.txt", "squashed elsewhere\n");
+    }
+
+    fn has_branch(&self, name: &str) -> bool {
+        !git(&self.work, &["branch", "--list", name]).is_empty()
+    }
+
+    fn adapter(&self) -> Box<dyn SourceAdapter> {
+        Box::new(GitAdapter::new(&self.work))
+    }
+
+    fn run(&self, opts: RunOptions) -> Report {
+        let truth = Truth(FakePrs {
+            git: self.adapter(),
+            prs: self.prs.clone(),
+        });
+        let paths = Paths::for_project(&self.work);
+        let e = Engine {
+            paths,
+            settings: Settings::default(),
+            truth: &truth,
+            closer: &FileCloser,
+            assistant: None,
+        };
+        run(&e, &opts, None).unwrap()
+    }
+
+    fn run_branches(&self) -> Report {
+        self.run(RunOptions {
+            only: Some(vec![Category::Branches]),
+            auto_safe_only: true,
+            ..Default::default()
+        })
+    }
+}
+
+fn finding<'a>(r: &'a Report, id: &str) -> &'a Finding {
+    r.findings.iter().find(|f| f.id == id).unwrap_or_else(|| {
+        panic!(
+            "no finding {id} in {:?}",
+            r.findings.iter().map(|f| &f.id).collect::<Vec<_>>()
+        )
+    })
+}
+
+#[test]
+fn merged_squash_branch_is_deleted_and_logged_with_its_tip() {
+    let mut repo = Repo::new();
+    let tip = repo.feature("feat-a");
+    repo.advance_main(); // tip is NOT an ancestor of main now: squash merge shape
+    repo.prs.insert("feat-a".into(), merged("7", &tip));
+
+    let r = repo.run_branches();
+    let f = finding(&r, "branch:feat-a");
+    assert_eq!(f.verdict, Verdict::AutoSafe, "{}", f.reason);
+    assert!(f.reason.contains("PR #7 is merged"), "{}", f.reason);
+    assert!(!repo.has_branch("feat-a"), "branch should be gone");
+    assert!(r.failed.is_empty(), "{:?}", r.failed);
+
+    let summary = &r.done[0].summary;
+    assert!(
+        summary.contains("feat-a") && summary.contains(&tip),
+        "{summary}"
+    );
+    let log = std::fs::read_to_string(repo.work.join(".ta/cleanup/branches.jsonl")).unwrap();
+    assert!(
+        log.contains("\"branch\":\"feat-a\"") && log.contains(&tip),
+        "{log}"
+    );
+    assert!(log.contains(&format!("git branch feat-a {tip}")), "{log}");
+    let audit = std::fs::read_to_string(repo.work.join(".ta/audit.jsonl")).unwrap();
+    assert!(audit.contains(&tip), "audit has the tip: {audit}");
+
+    // The logged recovery command really recovers it.
+    git(&repo.work, &["branch", "feat-a", &tip]);
+    assert!(repo.has_branch("feat-a"));
+}
