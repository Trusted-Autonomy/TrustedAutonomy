+        paths: Paths::for_project(dir.path()),
+        settings: Settings::default(),
+        truth: &Bare,
+        closer: &FileCloser,
+        assistant: None,
+    };
+    assert!(scan_findings(&e, Some(&[Category::Branches]))
+        .unwrap()
+        .is_empty());
+}
