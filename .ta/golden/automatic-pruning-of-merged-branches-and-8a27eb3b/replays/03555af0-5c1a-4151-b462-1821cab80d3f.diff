+//! The `branches` group: local branches and linked worktrees whose work has landed.
+//!
+//! Ground truth is the PR state from the VCS adapter, never `git branch -d` or
+//! `git cherry` (a squash merge rewrites patch ids, so finished branches look
+//! unmerged to both). A branch is auto-safe to delete only when
+//!
+//! * its PR is merged and the branch has no commits beyond the PR head, or
+//! * its tip is already an ancestor of the default branch (and it is not a branch
+//!   somebody just created: same commit as the default tip, or open in a worktree).
+//!
+//! Everything else (open PR, no PR, closed PR, extra commits, unknown state, a
+//! dirty worktree) is a question, never an automatic delete. The current and
+//! default branches are never touched. Remote branches are only reported.
+
+use ta_submit::{LocalBranch, SourceAdapter};
+
+use crate::model::*;
+use crate::scan::mk;
+
+/// How many dirty files to list in a finding before summarising.
+const MAX_FILES_SHOWN: usize = 15;
+
+enum Judgement {
+    /// Delete without asking.
+    Safe(String),
+    /// Ask a person; never deleted automatically.
+    Ask { reason: String, code: &'static str },
+}
+
+pub(crate) fn branches(e: &Engine, out: &mut Vec<Finding>) {
+    let Some(vcs) = e.truth.vcs() else {
+        tracing::debug!("cleanup: no VCS adapter; skipping the branches group");
+        return;
+    };
+    let list = match vcs.list_local_branches() {
+        Ok(l) => l,
+        Err(err) => {
+            tracing::warn!(error = %err, "cleanup: could not list local branches; skipping the branches group. Is this a git repository?");
+            return;
+        }
+    };
+    for b in list.iter().filter(|b| !b.is_current && !b.is_default) {
+        out.push(judge_branch(e, vcs, b));
+    }
+    match vcs.closed_unmerged_remote_branches() {
+        Ok(notes) => {
+            for n in notes {
+                let mut f = mk(
+                    Kind::RemoteBranch,
+                    format!("remote-branch:{}", n.name),
+                    format!("Remote branch {}", n.name),
+                    vec![Evidence::new(
+                        "vcs",
+                        format!("PR {} was closed without merging", pr_label(&n.review_ref)),
+                    )],
+                    Verdict::Skip,
+                    format!(
+                        "PR {} was closed unmerged but the remote branch still exists. Cleanup never deletes remote branches; delete it on the host if you no longer need it.",
+                        pr_label(&n.review_ref)
+                    ),
+                    Action::None,
+                    &[("remote", n.name.clone()), ("pr", n.review_ref.clone())],
+                );
+                f.manual_command = Some(format!("git push origin --delete {}", n.name));
+                out.push(f);
+            }
+        }
+        Err(err) => {
+            tracing::warn!(error = %err, "cleanup: could not list remote branches with closed PRs; skipping that report");
+        }
+    }
+}
+
+fn pr_label(r: &str) -> String {
+    if r.chars().all(|c| c.is_ascii_digit()) {
+        format!("#{r}")
+    } else {
+        r.to_string()
+    }
+}
+
+fn short_sha(s: &str) -> &str {
+    &s[..s.len().min(8)]
+}
+
+fn judge_branch(e: &Engine, vcs: &dyn SourceAdapter, b: &LocalBranch) -> Finding {
+    let mut evidence = vec![Evidence::new(
+        "git",
+        format!("branch '{}' at {}", b.name, b.tip),
+    )];
+    if let Some(w) = &b.worktree {
+        evidence.push(Evidence::new(
+            "git",
+            format!("checked out in worktree {}", w.display()),
+        ));
+    }
+    let id = format!("branch:{}", b.name);
+    let title = format!("Branch {}", b.name);
+    let prune = Action::PruneBranch {
+        name: b.name.clone(),
+        tip: b.tip.clone(),
+        worktree: b.worktree.clone(),
+    };
+
+    // 1. A worktree with local changes is only ever a question, and never
+    //    offers a delete: removing it would throw the changes away.
+    if let Some(w) = &b.worktree {
+        match vcs.worktree_dirty_files(w) {
+            Ok(files) if !files.is_empty() => {
+                let shown = files.iter().take(MAX_FILES_SHOWN);
+                for line in shown {
+                    evidence.push(Evidence::new("worktree", line.clone()));
+                }
+                if files.len() > MAX_FILES_SHOWN {
+                    evidence.push(Evidence::new(
+                        "worktree",
+                        format!("... and {} more", files.len() - MAX_FILES_SHOWN),
+                    ));
+                }
+                let mut f = mk(
+                    Kind::Branch,
+                    id,
+                    title,
+                    evidence,
+                    Verdict::Ask,
+                    format!(
+                        "Worktree {} has {} uncommitted or untracked file(s). Commit, stash or discard them there; cleanup will not touch the worktree or the branch.",
+                        w.display(),
+                        files.len()
+                    ),
+                    Action::None,
+                    &[("why", "dirty_worktree".into()), ("tip", b.tip.clone())],
+                );
+                f.options = vec![keep_option()];
+                f.recommended = Some("keep".into());
+                return f;
+            }
+            Ok(_) => {}
+            Err(err) => {
+                return ask(
+                    id,
+                    title,
+                    evidence,
+                    b,
+                    format!(
+                        "Could not check worktree {} for local changes ({err}), so it is left alone.",
+                        w.display()
+                    ),
+                    "worktree_unreadable",
+                    None,
+                );
+            }
+        }
+    }
+
+    // 2. Decide from ground truth.
+    let j = assess(e, vcs, b, &mut evidence);
+    match j {
+        Judgement::Safe(why) => {
+            let mut f = mk(
+                Kind::Branch,
+                id,
+                title,
+                evidence,
+                Verdict::AutoSafe,
+                format!(
+                    "{why}. Deleting it keeps the tip recoverable: `git branch {} {}`.",
+                    b.name, b.tip
+                ),
+                prune,
+                &[("why", "landed".into()), ("tip", b.tip.clone())],
+            );
+            f.manual_command = Some(format!("git branch -D {}   # tip {}", b.name, b.tip));
+            f
+        }
+        Judgement::Ask { reason, code } => ask(id, title, evidence, b, reason, code, Some(prune)),
+    }
+}
+
+fn keep_option() -> AnswerOption {
+    AnswerOption {
+        key: "keep".into(),
+        label: "Keep it".into(),
+        action: Action::None,
+    }
+}
+
+fn ask(
+    id: String,
+    title: String,
+    evidence: Vec<Evidence>,
+    b: &LocalBranch,
+    reason: String,
+    code: &'static str,
+    delete: Option<Action>,
+) -> Finding {
+    let mut f = mk(
+        Kind::Branch,
+        id,
+        title,
+        evidence,
+        Verdict::Ask,
+        reason,
+        Action::None,
+        &[("why", code.into()), ("tip", b.tip.clone())],
+    );
+    f.options = vec![keep_option()];
+    if let Some(action) = delete {
+        f.options.push(AnswerOption {
+            key: "delete".into(),
+            label: format!(
+                "Delete the local branch (tip {} stays recoverable with `git branch {} {}`)",
+                short_sha(&b.tip),
+                b.name,
+                b.tip
+            ),
+            action,
+        });
+    }
+    f.recommended = Some("keep".into());
+    f
+}
+
+fn assess(
+    e: &Engine,
+    vcs: &dyn SourceAdapter,
+    b: &LocalBranch,
+    evidence: &mut Vec<Evidence>,
+) -> Judgement {
+    // Contained in the default branch: nothing on it can be lost. A branch at the
+    // very tip of the default branch, or open in a worktree, may be brand new
+    // rather than finished, so those need a merged PR as well.
+    if b.in_default && !b.at_default_tip && b.worktree.is_none() {
+        evidence.push(Evidence::new(
+            "git",
+            "tip is an ancestor of the default branch",
+        ));
+        return Judgement::Safe("Its tip is already contained in the default branch".into());
+    }
+
+    match e.truth.branch_review(&b.name, &b.tip) {
+        BranchPrLookup::Unknown(why) => {
+            evidence.push(Evidence::new("vcs", format!("PR state unknown: {why}")));
+            Judgement::Ask {
+                reason: format!("Could not read the PR state ({why}), so the branch is kept."),
+                code: "pr_unknown",
+            }
+        }
+        BranchPrLookup::NoPr => {
+            evidence.push(Evidence::new("vcs", "no PR found for this branch"));
+            let reason = if b.in_default {
+                "No PR, and the branch has no commits of its own yet (it sits on the default branch's tip or is open in a worktree). It may be a branch you just created."
+            } else {
+                "No PR was found for this branch, so nothing shows its work landed."
+            };
+            Judgement::Ask {
+                reason: reason.into(),
+                code: "no_pr",
+            }
+        }
+        BranchPrLookup::Pr {
+            review_ref,
+            state,
+            head_sha,
+        } => {
+            let label = pr_label(&review_ref);
+            match state {
+                ReviewState::Open => {
+                    evidence.push(Evidence::new("vcs", format!("PR {label} is open")));
+                    Judgement::Ask {
+                        reason: format!("PR {label} is still open."),
+                        code: "pr_open",
+                    }
+                }
+                ReviewState::Closed => {
+                    evidence.push(Evidence::new(
+                        "vcs",
+                        format!("PR {label} was closed without merging"),
+                    ));
+                    Judgement::Ask {
+                        reason: format!("PR {label} was closed without merging, so the work may not have landed."),
+                        code: "pr_closed",
+                    }
+                }
+                ReviewState::Unknown(why) => {
+                    evidence.push(Evidence::new("vcs", format!("PR {label}: {why}")));
+                    Judgement::Ask {
+                        reason: format!("Could not read the state of PR {label} ({why})."),
+                        code: "pr_unknown",
+                    }
+                }
+                ReviewState::Merged => {
+                    evidence.push(Evidence::new("vcs", format!("PR {label} is merged")));
+                    merged_judgement(vcs, b, &label, head_sha, evidence)
+                }
+            }
+        }
+    }
+}
+
+fn merged_judgement(
+    vcs: &dyn SourceAdapter,
+    b: &LocalBranch,
+    label: &str,
+    head_sha: Option<String>,
+    evidence: &mut Vec<Evidence>,
+) -> Judgement {
+    if b.in_default {
+        return Judgement::Safe(format!(
+            "PR {label} is merged and the branch tip is contained in the default branch"
+        ));
+    }
+    let Some(head) = head_sha else {
+        return Judgement::Ask {
+            reason: format!("PR {label} is merged but the VCS did not report its head commit, so extra commits cannot be ruled out."),
+            code: "head_unknown",
+        };
+    };
+    evidence.push(Evidence::new("vcs", format!("PR {label} head was {head}")));
+    match vcs.commits_beyond(&b.tip, &head) {
+        Ok(Some(0)) => Judgement::Safe(format!(
+            "PR {label} is merged and the branch has no commits beyond the PR head ({})",
+            short_sha(&head)
+        )),
+        Ok(Some(n)) => {
+            evidence.push(Evidence::new(
+                "git",
+                format!("{n} commit(s) on the branch after the PR head"),
+            ));
+            Judgement::Ask {
+                reason: format!("PR {label} is merged, but the branch has {n} commit(s) after the PR head that were not part of it."),
+                code: "extra_commits",
+            }
+        }
+        Ok(None) => Judgement::Ask {
+            reason: format!("PR {label} is merged but its head commit {} is not in this repository, so extra commits cannot be ruled out. Run `git fetch` and re-run `ta cleanup`.", short_sha(&head)),
+            code: "head_missing",
+        },
+        Err(err) => Judgement::Ask {
+            reason: format!("Could not compare the branch with the PR head ({err}), so it is kept."),
+            code: "compare_failed",
+        },
+    }
+}
