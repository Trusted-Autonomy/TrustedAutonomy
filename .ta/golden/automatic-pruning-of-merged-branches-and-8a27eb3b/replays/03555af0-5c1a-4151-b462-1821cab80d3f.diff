+#[test]
+fn squash_merged_branch_is_deleted_and_logged_with_its_tip() {
+    let repo = Repo::new();
+    let tip = repo.branch("feature/done", 2);
+    repo.squash_merge("feature/done");
+    // A squash merge rewrites history: git's own merged test cannot see it landed.
+    assert!(git(&repo.root, &["branch", "--merged", "main"])
+        .find("feature/done")
+        .is_none());
+
+    let truth = Truth::new(&repo).pr("feature/done", ReviewState::Merged, Some(&tip));
+    let e = repo.engine(&truth, Settings::default());
+    let r = run(&e, &only_branches(false), None).unwrap();
+
+    assert!(
+        !branch_exists(&repo.root, "feature/done"),
+        "branch should be gone"
+    );
+    let f = finding(&r, "branch:feature/done");
+    assert_eq!(f.verdict, Verdict::AutoSafe);
+    assert!(
+        f.reason.contains("no commits beyond the PR head"),
+        "{}",
+        f.reason
+    );
+    let done = r
+        .done
+        .iter()
+        .find(|d| d.finding_id == f.id)
+        .expect("action logged");
+    assert!(done.summary.contains("feature/done") && done.summary.contains(&tip));
+    // The audit log is the cleanup log: it carries the name and the full tip.
+    let audit = std::fs::read_to_string(&e.paths.audit_log).unwrap();
+    assert!(
+        audit.contains(&tip) && audit.contains("feature/done"),
+        "{audit}"
+    );
+    // And the tip really is enough to bring it back.
+    git(&repo.root, &["branch", "restored", &tip]);
+    assert!(branch_exists(&repo.root, "restored"));
+    // The remote is untouched.
+    assert!(git(&repo.origin, &["branch", "--list", "feature/done"]).contains("feature/done"));
+}
