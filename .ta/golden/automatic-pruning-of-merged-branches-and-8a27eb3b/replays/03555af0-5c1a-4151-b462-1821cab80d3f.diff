+/// Remove a finished branch (and its clean worktree). The summary carries the branch
+/// name and full tip so the audit log alone is enough to restore it.
+fn prune_branch(
+    e: &Engine,
+    name: &str,
+    tip: &str,
+    worktree: Option<&Path>,
+) -> anyhow::Result<(String, u64)> {
+    let vcs = e.truth.vcs().ok_or_else(|| {
+        anyhow::anyhow!("cannot delete branch '{name}': no VCS adapter is configured")
+    })?;
+    let mut removed_wt = String::new();
+    if let Some(w) = worktree.filter(|w| w.exists()) {
+        // Look again right before acting: the person may have started work since the scan.
+        let dirty = vcs.worktree_dirty_files(w)?;
+        if !dirty.is_empty() {
+            anyhow::bail!(
+                "worktree {} now has {} uncommitted file(s); left it and branch '{name}' alone. Commit or discard them, then re-run `ta cleanup`.",
+                w.display(),
+                dirty.len()
+            );
+        }
+        vcs.remove_worktree(w)?;
+        removed_wt = format!(", removed worktree {}", w.display());
+    }
+    vcs.delete_local_branch(name, tip)?;
+    Ok((
+        format!("deleted local branch '{name}' (tip {tip}){removed_wt}; restore with `git branch {name} {tip}`"),
+        0,
+    ))
