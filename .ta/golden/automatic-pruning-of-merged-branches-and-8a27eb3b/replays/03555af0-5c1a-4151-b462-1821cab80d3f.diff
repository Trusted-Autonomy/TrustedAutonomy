+    fn delete_local_branch(&self, name: &str, expected_tip: &str) -> Result<()> {
+        let full = format!("refs/heads/{name}");
+        let now = self.git_cmd(&["rev-parse", "--verify", &full])?;
+        if now != expected_tip {
+            return Err(SubmitError::VcsError(format!(
+                "branch '{name}' moved from {expected_tip} to {now} since it was checked; not deleting. Re-run `ta cleanup`."
+            )));
+        }
+        if let Some(w) = self
+            .worktrees()?
+            .into_iter()
+            .find(|w| w.branch.as_deref() == Some(name))
+        {
+            return Err(SubmitError::VcsError(format!(
+                "branch '{name}' is checked out at {}; not deleting",
+                w.path.display()
+            )));
+        }
+        // Compare-and-delete: fails if the ref moved between the check and now.
+        self.git_cmd(&["update-ref", "-d", &full, expected_tip])?;
+        // Best effort: drop the branch's tracking config like `git branch -d` does.
+        let _ = self.git_cmd(&["config", "--remove-section", &format!("branch.{name}")]);
+        Ok(())
+    }
