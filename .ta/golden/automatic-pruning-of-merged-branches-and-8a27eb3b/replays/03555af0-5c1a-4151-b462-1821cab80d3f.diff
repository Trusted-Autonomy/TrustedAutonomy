+                    .map(|n| n.to_string())
+                    .unwrap_or_default(),
+                state: r["state"].as_str().unwrap_or("unknown").to_lowercase(),
+                head_sha: r["headRefOid"]
+                    .as_str()
+                    .filter(|s| !s.is_empty())
+                    .map(str::to_string),
