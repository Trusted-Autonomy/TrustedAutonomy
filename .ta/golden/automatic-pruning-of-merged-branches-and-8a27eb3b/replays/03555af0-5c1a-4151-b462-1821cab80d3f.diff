+#[test]
+fn dirty_worktree_is_asked_with_its_file_list_and_nothing_is_removed() {
+    let repo = Repo::new();
+    let tip = repo.branch("feature/busy", 1);
+    repo.squash_merge("feature/busy");
+    let wt = repo.worktree("feature/busy");
+    std::fs::write(wt.join("scratch-notes.txt"), "unsaved").unwrap();
+    std::fs::write(wt.join("feature_busy-0.txt"), "edited").unwrap();
+
+    let truth = Truth::new(&repo).pr("feature/busy", ReviewState::Merged, Some(&tip));
+    let e = repo.engine(&truth, Settings::default());
+    let r = run(&e, &only_branches(false), None).unwrap();
+
+    assert!(branch_exists(&repo.root, "feature/busy"));
+    assert!(
+        wt.join("scratch-notes.txt").exists(),
+        "worktree must be untouched"
+    );
+    let f = finding(&r, "branch:feature/busy");
+    assert_eq!(f.verdict, Verdict::Ask);
+    let listed: Vec<&str> = f.evidence.iter().map(|e| e.fact.as_str()).collect();
+    assert!(
+        listed.iter().any(|l| l.contains("scratch-notes.txt")),
+        "{listed:?}"
+    );
+    assert!(
+        listed.iter().any(|l| l.contains("feature_busy-0.txt")),
+        "{listed:?}"
+    );
+    // Deleting would discard the changes, so the only answer on offer is to keep it.
+    assert_eq!(
+        f.options.iter().map(|o| o.key.as_str()).collect::<Vec<_>>(),
+        ["keep"]
+    );
+    assert!(r.done.is_empty());
+}
