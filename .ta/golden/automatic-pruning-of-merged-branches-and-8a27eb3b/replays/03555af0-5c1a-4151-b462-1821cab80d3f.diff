+/// Run git in `dir` with a fixed identity and none of the caller's git environment.
+fn git(dir: &Path, args: &[&str]) -> String {
+    let out = Command::new("git")
+        .args([
+            "-c",
+            "user.name=Test",
+            "-c",
+            "user.email=test@example.com",
+            "-c",
+            "commit.gpgsign=false",
+            "-c",
+            "init.defaultBranch=main",
+        ])
+        .args(args)
+        .current_dir(dir)
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .env_remove("GIT_INDEX_FILE")
+        .env_remove("GIT_COMMON_DIR")
+        .env("GIT_CONFIG_NOSYSTEM", "1")
+        .output()
+        .expect("git must be installed to run these tests");
+    assert!(
+        out.status.success(),
+        "git {} failed in {}: {}",
+        args.join(" "),
+        dir.display(),
+        String::from_utf8_lossy(&out.stderr)
+    );
+    String::from_utf8_lossy(&out.stdout).trim().to_string()
+}
+
+fn branch_exists(dir: &Path, name: &str) -> bool {
+    Command::new("git")
+        .args(["rev-parse", "--verify", "--quiet"])
+        .arg(format!("refs/heads/{name}"))
+        .current_dir(dir)
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .output()
+        .map(|o| o.status.success())
+        .unwrap_or(false)
+}
+
+/// A work repository whose `origin` is a local bare repository.
+struct Repo {
+    _dir: tempfile::TempDir,
+    root: PathBuf,
+    origin: PathBuf,
+    scratch: PathBuf,
+}
+
+impl Repo {
+    fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let origin = dir.path().join("origin.git");
+        let root = dir.path().join("work");
+        let scratch = dir.path().join("trees");
+        for d in [&origin, &root, &scratch] {
+            std::fs::create_dir_all(d).unwrap();
+        }
+        git(&origin, &["init", "--bare", "-b", "main"]);
+        git(&root, &["init", "-b", "main"]);
+        let origin_url = origin.to_string_lossy().to_string();
+        git(&root, &["remote", "add", "origin", &origin_url]);
+        std::fs::write(root.join("README.md"), "base\n").unwrap();
+        git(&root, &["add", "."]);
+        git(&root, &["commit", "-m", "base"]);
+        git(&root, &["push", "-u", "origin", "main"]);
+        git(&root, &["remote", "set-head", "origin", "main"]);
+        Repo {
+            _dir: dir,
+            root,
+            origin,
+            scratch,
+        }
+    }
+
+    fn commit_file(&self, name: &str) {
+        std::fs::write(self.root.join(name), name).unwrap();
+        git(&self.root, &["add", name]);
+        git(&self.root, &["commit", "-m", name]);
+    }
+
+    /// Branch `name` off main with `n` commits, pushed, then back on main. Returns the tip.
+    fn branch(&self, name: &str, n: usize) -> String {
+        git(&self.root, &["checkout", "-b", name]);
+        for i in 0..n {
+            self.commit_file(&format!("{}-{i}.txt", name.replace('/', "_")));
+        }
+        git(&self.root, &["push", "origin", name]);
+        let tip = git(&self.root, &["rev-parse", "HEAD"]);
+        git(&self.root, &["checkout", "main"]);
+        tip
+    }
+
+    /// Land `name` on main as a single squash commit (the branch is NOT an ancestor afterwards).
+    fn squash_merge(&self, name: &str) {
+        git(&self.root, &["merge", "--squash", name]);
+        git(&self.root, &["commit", "-m", &format!("squash {name}")]);
+        git(&self.root, &["push", "origin", "main"]);
+    }
+
+    fn worktree(&self, branch: &str) -> PathBuf {
+        let path = self.scratch.join(branch.replace('/', "_"));
+        git(
+            &self.root,
+            &["worktree", "add", &path.to_string_lossy(), branch],
+        );
+        path
+    }
+
+    fn engine<'a>(&self, truth: &'a Truth, settings: Settings) -> Engine<'a> {
+        Engine {
+            paths: Paths::for_project(&self.root),
+            settings,
+            truth,
+            closer: &FileCloser,
+            assistant: None,
+        }
+    }
+}
+
+/// Real git for everything except PR lookups and the remote report.
+struct FakeVcs {
+    inner: GitAdapter,
+    remote_notes: Vec<RemoteBranchNote>,
+}
+
+impl SourceAdapter for FakeVcs {
+    fn prepare(&self, _: &CommitContext, _: &SubmitConfig) -> SubmitResult<()> {
+        Err(SubmitError::NotConfigured("test adapter".into()))
+    }
+    fn commit(&self, _: &CommitContext, _: &DraftPackage, _: &str) -> SubmitResult<CommitResult> {
+        Err(SubmitError::NotConfigured("test adapter".into()))
+    }
+    fn push(&self, _: &CommitContext) -> SubmitResult<PushResult> {
+        Err(SubmitError::NotConfigured("test adapter".into()))
+    }
+    fn open_review(&self, _: &CommitContext, _: &DraftPackage) -> SubmitResult<ReviewResult> {
+        Err(SubmitError::NotConfigured("test adapter".into()))
+    }
+    fn name(&self) -> &str {
+        "git-with-fake-prs"
+    }
+    fn list_local_branches(&self) -> SubmitResult<Vec<LocalBranch>> {
+        self.inner.list_local_branches()
+    }
+    fn commits_beyond(&self, tip: &str, base: &str) -> SubmitResult<Option<usize>> {
+        self.inner.commits_beyond(tip, base)
+    }
+    fn worktree_dirty_files(&self, path: &Path) -> SubmitResult<Vec<String>> {
+        self.inner.worktree_dirty_files(path)
+    }
+    fn delete_local_branch(&self, name: &str, tip: &str) -> SubmitResult<()> {
+        self.inner.delete_local_branch(name, tip)
+    }
+    fn remove_worktree(&self, path: &Path) -> SubmitResult<()> {
+        self.inner.remove_worktree(path)
+    }
+    fn closed_unmerged_remote_branches(&self) -> SubmitResult<Vec<RemoteBranchNote>> {
+        Ok(self.remote_notes.clone())
+    }
+}
+
+struct Truth {
+    vcs: FakeVcs,
+    prs: HashMap<String, BranchPrLookup>,
+}
+
+impl Truth {
+    fn new(repo: &Repo) -> Self {
+        Truth {
+            vcs: FakeVcs {
+                inner: GitAdapter::new(&repo.root),
+                remote_notes: Vec::new(),
+            },
+            prs: HashMap::new(),
+        }
+    }
+
+    fn pr(mut self, branch: &str, state: ReviewState, head: Option<&str>) -> Self {
+        self.prs.insert(
+            branch.to_string(),
+            BranchPrLookup::Pr {
+                review_ref: "42".into(),
+                state,
+                head_sha: head.map(str::to_string),
+            },
+        );
+        self
+    }
+}
+
+impl GroundTruth for Truth {
+    fn vcs(&self) -> Option<&dyn SourceAdapter> {
+        Some(&self.vcs)
+    }
+    fn branch_review(&self, branch: &str, _tip: &str) -> BranchPrLookup {
+        self.prs
+            .get(branch)
+            .cloned()
+            .unwrap_or(BranchPrLookup::NoPr)
+    }
+    fn review_state(&self, _: &str) -> ReviewState {
+        ReviewState::Unknown("not used by the branches group".into())
+    }
+    fn phase_done(&self, _: &str) -> bool {
+        false
+    }
+}
+
+fn only_branches(dry_run: bool) -> RunOptions {
+    RunOptions {
+        dry_run,
+        only: Some(vec![Category::Branches]),
+        auto_safe_only: true,
+        ..Default::default()
+    }
+}
+
+fn finding<'a>(r: &'a Report, id: &str) -> &'a Finding {
+    r.findings
+        .iter()
+        .find(|f| f.id == id)
+        .unwrap_or_else(|| panic!("no finding {id}; have {:?}", ids(r)))
+}
+
+fn ids(r: &Report) -> Vec<&str> {
+    r.findings.iter().map(|f| f.id.as_str()).collect()
+}
