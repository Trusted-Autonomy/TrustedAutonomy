+#[test]
+fn brand_new_branch_with_no_pr_is_a_question_not_a_deletion() {
+    let repo = Repo::new();
+    // Same commit as main: looks "merged" by ancestry, but may just have been created.
+    git(&repo.root, &["branch", "feature/fresh"]);
+    git(&repo.root, &["branch", "feature/lonely"]);
+    repo.commit_file("later.txt");
+    git(&repo.root, &["checkout", "-b", "feature/solo"]);
+    repo.commit_file("solo.txt");
+    git(&repo.root, &["checkout", "main"]);
+
+    let truth = Truth::new(&repo);
+    let e = repo.engine(&truth, Settings::default());
+    let r = run(&e, &only_branches(false), None).unwrap();
+
+    // `fresh` and `lonely` sit behind main now (ancestors), so they are finished work by
+    // ancestry. `solo` has its own unmerged commit and no PR.
+    assert!(!branch_exists(&repo.root, "feature/fresh"));
+    assert!(branch_exists(&repo.root, "feature/solo"));
+    let f = finding(&r, "branch:feature/solo");
+    assert_eq!(f.verdict, Verdict::Ask);
+    assert!(f.reason.contains("No PR"), "{}", f.reason);
+}
