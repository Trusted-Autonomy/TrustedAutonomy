+//! The `branches` group, against real git repositories in temp dirs with a local bare
+//! repository as `origin`. Only PR state is faked (through `GroundTruth::branch_review`);
+//! branches, worktrees and ancestry are real. Nothing here touches the project's own repo.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use ta_changeset::DraftPackage;
+use ta_goal::CommitContext;
+use ta_submit::adapter::{Result as SubmitResult, SubmitError};
+use ta_submit::{
+    CommitResult, GitAdapter, LocalBranch, PushResult, RemoteBranchNote, ReviewResult,
+    SourceAdapter, SubmitConfig,
+};
+
+use crate::act::FileCloser;
+use crate::*;
