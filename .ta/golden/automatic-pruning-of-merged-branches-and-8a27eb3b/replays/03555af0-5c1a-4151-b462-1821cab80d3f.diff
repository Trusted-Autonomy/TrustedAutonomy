+        // No --force: git itself refuses a worktree with changes or a lock.
+        let p = path.to_string_lossy();
+        self.git_cmd(&["worktree", "remove", &p]).map(|_| ())
+    }
+
+    fn closed_unmerged_remote_branches(&self) -> Result<Vec<crate::adapter::RemoteBranchNote>> {
+        if !self.has_gh_cli() {
+            return Ok(Vec::new());
+        }
+        let remote = self.sync_config.remote.clone();
+        let prefix = format!("refs/remotes/{remote}/");
+        let existing: std::collections::HashSet<String> = self
+            .git_cmd(&["for-each-ref", "--format=%(refname)", &prefix])?
+            .lines()
+            .filter_map(|l| l.strip_prefix(&prefix).map(str::to_string))
+            .collect();
+        let out = run_gh_bounded(
+            &self.gh_program,
+            &[
+                "pr",
+                "list",
+                "--state",
+                "all",
+                "--limit",
+                "200",
+                "--json",
+                "number,state,headRefName,isCrossRepository",
+            ],
+            &self.work_dir,
+            Duration::from_secs(30),
+        )
+        .ok_or_else(|| {
+            SubmitError::VcsError(
+                "`gh pr list` did not finish within 30s or could not start".into(),
+            )
+        })?;
+        if !out.status.success() {
+            return Err(SubmitError::VcsError(format!(
+                "`gh pr list` failed: {}",
+                String::from_utf8_lossy(&out.stderr).trim()
+            )));
+        }
+        let rows: Vec<serde_json::Value> = serde_json::from_slice(&out.stdout)
+            .map_err(|e| SubmitError::VcsError(format!("could not parse `gh pr list`: {e}")))?;
+        // The newest PR for a branch decides: a closed PR later superseded by an
+        // open or merged one is not a leftover.
+        let mut newest: std::collections::HashMap<String, (u64, String)> = Default::default();
+        for r in rows
+            .iter()
+            .filter(|r| r["isCrossRepository"].as_bool() != Some(true))
+        {
+            let (Some(head), Some(n)) = (r["headRefName"].as_str(), r["number"].as_u64()) else {
+                continue;
+            };
+            let state = r["state"].as_str().unwrap_or("").to_lowercase();
+            if newest.get(head).is_none_or(|(m, _)| n > *m) {
+                newest.insert(head.to_string(), (n, state));
+            }
+        }
+        let mut notes: Vec<_> = newest
+            .into_iter()
+            .filter(|(name, (_, state))| state == "closed" && existing.contains(name))
+            .map(|(name, (n, _))| crate::adapter::RemoteBranchNote {
+                name,
+                review_ref: n.to_string(),
+            })
+            .collect();
+        notes.sort_by(|a, b| a.name.cmp(&b.name));
+        Ok(notes)
+    }
+
+    }
