+
+/// One entry of `git worktree list --porcelain`.
+struct WorktreeEntry {
+    path: std::path::PathBuf,
+    /// Short branch name when a branch is checked out (None for detached HEAD).
+    branch: Option<String>,
+}
+
+impl GitAdapter {
+    /// Run git and report only whether it exited 0 (for `--is-ancestor` style
+    /// questions where a non-zero exit is an answer, not an error).
+    fn git_succeeds(&self, args: &[&str]) -> bool {
+        Command::new("git")
+            .args(["-c", "safe.directory=*"])
+            .args(args)
+            .current_dir(&self.work_dir)
+            .env_remove("GIT_DIR")
+            .env_remove("GIT_WORK_TREE")
+            .env_remove("GIT_INDEX_FILE")
+            .env_remove("GIT_COMMON_DIR")
+            .env_remove("GIT_CEILING_DIRECTORIES")
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .status()
+            .map(|s| s.success())
+            .unwrap_or(false)
+    }
+
+    /// All worktrees; the first entry is always the main working tree.
+    fn worktrees(&self) -> Result<Vec<WorktreeEntry>> {
+        let out = self.git_cmd(&["worktree", "list", "--porcelain"])?;
+        let mut entries: Vec<WorktreeEntry> = Vec::new();
+        for line in out.lines() {
+            if let Some(p) = line.strip_prefix("worktree ") {
+                entries.push(WorktreeEntry {
+                    path: std::path::PathBuf::from(p.trim()),
+                    branch: None,
+                });
+            } else if let Some(b) = line.strip_prefix("branch ") {
+                if let Some(e) = entries.last_mut() {
+                    e.branch = b.trim().strip_prefix("refs/heads/").map(str::to_string);
+                }
+            }
+        }
+        Ok(entries)
+    }
+
+    /// The default branch: what `<remote>/HEAD` points at, else `main`/`master`.
+    fn default_branch_name(&self) -> Option<String> {
+        let remote = &self.sync_config.remote;
+        let head_ref = format!("refs/remotes/{remote}/HEAD");
+        if let Ok(full) = self.git_cmd(&["symbolic-ref", "--short", &head_ref]) {
+            if let Some(name) = full.strip_prefix(&format!("{remote}/")) {
+                if !name.is_empty() {
+                    return Some(name.to_string());
+                }
+            }
+        }
+        ["main", "master"]
+            .into_iter()
+            .find(|c| {
+                self.git_succeeds(&[
+                    "rev-parse",
+                    "--verify",
+                    "--quiet",
+                    &format!("refs/heads/{c}"),
+                ])
+            })
+            .map(str::to_string)
+    }
+
+    fn same_path(a: &Path, b: &Path) -> bool {
+        match (a.canonicalize(), b.canonicalize()) {
+            (Ok(x), Ok(y)) => x == y,
+            _ => a == b,
+        }
