+    fn list_local_branches(&self) -> Result<Vec<crate::adapter::LocalBranch>> {
+        let refs = self.git_cmd(&[
+            "for-each-ref",
+            "--format=%(refname)%09%(objectname)",
+            "refs/heads",
+        ])?;
+        let worktrees = self.worktrees()?;
+        let toplevel = self.git_cmd(&["rev-parse", "--show-toplevel"])?;
+        let here = std::path::PathBuf::from(toplevel);
+        let default = self.default_branch_name();
+        let default_tip = default.as_ref().and_then(|d| {
+            self.git_cmd(&["rev-parse", &format!("refs/heads/{d}")])
+                .ok()
+        });
+        let remote = &self.sync_config.remote;
+        let mut out = Vec::new();
+        for line in refs.lines() {
+            let Some((full, tip)) = line.split_once('\t') else {
+                continue;
+            };
+            let Some(name) = full.strip_prefix("refs/heads/") else {
+                continue;
+            };
+            let tip = tip.trim().to_string();
+            let mut is_current = false;
+            let mut worktree = None;
+            for (i, w) in worktrees.iter().enumerate() {
+                if w.branch.as_deref() != Some(name) {
+                    continue;
+                }
+                if i == 0 || Self::same_path(&w.path, &here) {
+                    is_current = true;
+                } else {
+                    worktree = Some(w.path.clone());
+                }
+            }
+            let is_default = default.as_deref() == Some(name);
+            let in_default = default.as_ref().is_some_and(|d| {
+                self.git_succeeds(&[
+                    "merge-base",
+                    "--is-ancestor",
+                    &tip,
+                    &format!("refs/heads/{d}"),
+                ]) || self.git_succeeds(&[
+                    "merge-base",
+                    "--is-ancestor",
+                    &tip,
+                    &format!("refs/remotes/{remote}/{d}"),
+                ])
+            });
+            out.push(crate::adapter::LocalBranch {
+                name: name.to_string(),
+                at_default_tip: default_tip.as_deref() == Some(tip.as_str()),
+                tip,
+                is_current,
+                is_default,
+                worktree,
+                in_default,
+            });
+        }
+        Ok(out)
+    }
+
+    fn branch_review(&self, branch: &str, tip: &str) -> Result<crate::adapter::BranchReviewLookup> {
+        use crate::adapter::{BranchReview, BranchReviewLookup};
+        if !self.has_gh_cli() {
+            return Ok(BranchReviewLookup::Unsupported);
+        }
+        let out = run_gh_bounded(
+            &self.gh_program,
+            &[
+                "pr",
+                "list",
+                "--head",
+                branch,
+                "--state",
+                "all",
+                "--limit",
+                "30",
+                "--json",
+                "number,state,headRefOid",
+            ],
+            &self.work_dir,
+            Duration::from_secs(30),
+        )
+        .ok_or_else(|| {
+            SubmitError::VcsError(format!(
+                "`gh pr list --head {branch}` did not finish within 30s or could not start"
+            ))
+        })?;
+        if !out.status.success() {
+            return Err(SubmitError::VcsError(format!(
+                "`gh pr list --head {branch}` failed: {}",
+                String::from_utf8_lossy(&out.stderr).trim()
+            )));
+        }
+        let rows: Vec<serde_json::Value> = serde_json::from_slice(&out.stdout).map_err(|e| {
+            SubmitError::VcsError(format!("could not parse `gh pr list` output: {e}"))
+        })?;
+        let pick = rows
+            .iter()
+            .find(|r| r["headRefOid"].as_str() == Some(tip))
