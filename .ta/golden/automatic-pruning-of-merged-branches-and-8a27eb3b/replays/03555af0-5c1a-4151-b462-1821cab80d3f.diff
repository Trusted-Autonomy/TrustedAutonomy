+#[test]
+fn branch_with_commits_beyond_the_pr_head_is_asked() {
+    let repo = Repo::new();
+    let tip = repo.branch("feature/extra", 3);
+    let pr_head = git(&repo.root, &["rev-parse", &format!("{tip}~2")]);
+    repo.squash_merge("feature/extra");
+    let truth = Truth::new(&repo).pr("feature/extra", ReviewState::Merged, Some(&pr_head));
+    let e = repo.engine(&truth, Settings::default());
+    let r = run(&e, &only_branches(false), None).unwrap();
+
+    assert!(branch_exists(&repo.root, "feature/extra"));
+    let f = finding(&r, "branch:feature/extra");
+    assert_eq!(f.verdict, Verdict::Ask);
+    assert!(
+        f.reason.contains("2 commit(s) after the PR head"),
+        "{}",
+        f.reason
+    );
+    // A person may still choose to delete it; the offer names the recovery command.
+    assert!(f
+        .options
+        .iter()
+        .any(|o| o.key == "delete" && o.label.contains(&tip)));
+    assert_eq!(f.recommended.as_deref(), Some("keep"));
+}
