+//! The `branches` group against real repositories: a local bare repo is the origin, git does
+//! the branching, and only the PR state is faked (through `GroundTruth::branch_review`, the
+//! same seam the CLI fills from the VCS adapter).
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use ta_submit::{GitAdapter, SourceAdapter};
+
+use crate::act::FileCloser;
+use crate::*;
+
+fn git(dir: &Path, args: &[&str]) -> String {
+    let out = Command::new("git")
+        .args([
+            "-c",
+            "user.name=Test",
+            "-c",
+            "user.email=test@example.com",
+            "-c",
+            "commit.gpgsign=false",
+            "-c",
+            "init.defaultBranch=main",
+        ])
+        .args(args)
+        .current_dir(dir)
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .env_remove("GIT_INDEX_FILE")
+        .output()
+        .expect("git runs");
+    assert!(
+        out.status.success(),
+        "git {args:?} failed: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    String::from_utf8_lossy(&out.stdout).trim().to_string()
+}
+
+fn commit_file(dir: &Path, name: &str, body: &str) -> String {
+    std::fs::write(dir.join(name), body).unwrap();
+    git(dir, &["add", name]);
+    git(dir, &["commit", "-m", &format!("add {name}")]);
+    git(dir, &["rev-parse", "HEAD"])
+}
+
+struct Repo {
+    _dir: tempfile::TempDir,
+    root: PathBuf,
+    work: PathBuf,
+    scratch: PathBuf,
+}
+
+impl Repo {
+    fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().to_path_buf();
+        let origin = root.join("origin.git");
+        let work = root.join("work");
+        let scratch = root.join("scratch");
+        for d in [&origin, &work, &scratch] {
+            std::fs::create_dir_all(d).unwrap();
+        }
+        git(&origin, &["init", "--bare", "-b", "main"]);
+        git(&work, &["init", "-b", "main"]);
+        git(
+            &work,
+            &["remote", "add", "origin", &origin.to_string_lossy()],
+        );
+        commit_file(&work, "base.txt", "base\n");
+        git(&work, &["push", "-u", "origin", "main"]);
+        std::fs::create_dir_all(work.join(".ta")).unwrap();
+        Repo {
+            _dir: dir,
+            root,
+            work,
+            scratch,
+        }
+    }
+
+    /// A branch with one commit, pushed, with `main` checked out again. Returns its tip.
+    fn branch(&self, name: &str) -> String {
+        git(&self.work, &["checkout", "-b", name, "main"]);
+        let tip = commit_file(&self.work, &format!("{}.txt", name.replace('/', "_")), name);
+        git(&self.work, &["push", "origin", name]);
+        git(&self.work, &["checkout", "main"]);
+        tip
+    }
+
+    /// Land `name` on main the way GitHub's squash merge does: one new commit, new patch id.
+    fn squash_into_main(&self, name: &str) {
+        git(&self.work, &["merge", "--squash", name]);
+        git(&self.work, &["commit", "-m", &format!("squash {name}")]);
+        git(&self.work, &["push", "origin", "main"]);
+    }
+
+    fn exists(&self, branch: &str) -> bool {
+        Command::new("git")
+            .args([
+                "rev-parse",
+                "--verify",
+                "--quiet",
+                &format!("refs/heads/{branch}"),
+            ])
+            .current_dir(&self.work)
+            .env_remove("GIT_DIR")
+            .env_remove("GIT_WORK_TREE")
+            .env_remove("GIT_INDEX_FILE")
+            .stdout(std::process::Stdio::null())
+            .status()
+            .unwrap()
+            .success()
+    }
+}
+
+struct Truth {
+    adapter: GitAdapter,
+    reviews: HashMap<String, BranchReviewInfo>,
+}
+
+impl Truth {
+    fn new(repo: &Repo) -> Self {
+        Truth {
+            // A path that does not exist makes the adapter behave as without `gh`, so the
+            // remote-branch lookup stays hermetic.
+            adapter: GitAdapter::new(&repo.work).with_gh_program(repo.root.join("no-such-gh")),
+            reviews: HashMap::new(),
+        }
+    }
+
+    fn pr(mut self, branch: &str, state: ReviewState, head: Option<&str>) -> Self {
+        self.reviews.insert(
+            branch.to_string(),
+            BranchReviewInfo::Found {
+                review_id: "7".into(),
+                state,
+                head_sha: head.map(str::to_string),
+            },
+        );
+        self
+    }
+}
+
+impl GroundTruth for Truth {
+    fn review_state(&self, _r: &str) -> ReviewState {
+        ReviewState::Unknown("not used".into())
+    }
+    fn phase_done(&self, _p: &str) -> bool {
+        false
+    }
+    fn branch_adapter(&self) -> Option<&dyn SourceAdapter> {
+        Some(&self.adapter)
+    }
+    fn branch_review(&self, branch: &str) -> BranchReviewInfo {
+        self.reviews
+            .get(branch)
+            .cloned()
+            .unwrap_or(BranchReviewInfo::NoReview)
+    }
+}
+
+fn run_branches(repo: &Repo, truth: &Truth, dry_run: bool) -> Report {
+    let e = Engine {
+        paths: Paths::for_project(&repo.work),
+        settings: Settings::default(),
+        truth,
+        closer: &FileCloser,
+        assistant: None,
+    };
+    run(
+        &e,
+        &RunOptions {
+            dry_run,
+            only: Some(vec![Category::Branches]),
+            auto_safe_only: true,
+            ..Default::default()
+        },
+        None,
+    )
+    .unwrap()
+}
+
+fn finding<'a>(r: &'a Report, branch: &str) -> &'a Finding {
+    r.findings
+        .iter()
+        .find(|f| f.id == format!("branch:{branch}"))
+        .unwrap_or_else(|| panic!("no finding for {branch}: {:?}", r.findings))
+}
