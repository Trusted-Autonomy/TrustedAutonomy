+#[test]
+fn squash_merged_branch_is_deleted_and_logged_with_its_tip() {
+    let repo = Repo::new();
+    let tip = repo.branch("feature/squashed");
+    repo.squash_into_main("feature/squashed");
+
+    // The trap this group exists for: git itself calls the branch unmerged.
+    let unmerged = git(&repo.work, &["branch", "--no-merged", "main"]);
+    assert!(unmerged.contains("feature/squashed"), "{unmerged}");
+
+    let truth = Truth::new(&repo).pr("feature/squashed", ReviewState::Merged, Some(&tip));
+    let r = run_branches(&repo, &truth, false);
+
+    assert_eq!(finding(&r, "feature/squashed").verdict, Verdict::AutoSafe);
+    assert!(!repo.exists("feature/squashed"), "branch should be pruned");
+    assert!(repo.exists("main"));
+    let done = r
+        .done
+        .iter()
+        .map(|d| d.summary.as_str())
+        .collect::<String>();
+    assert!(
+        done.contains("feature/squashed") && done.contains(&tip),
+        "{done}"
+    );
+    // Recoverable from the log alone.
+    let log = std::fs::read_to_string(&Paths::for_project(&repo.work).audit_log).unwrap();
+    assert!(
+        log.contains("feature/squashed") && log.contains(&tip),
+        "{log}"
+    );
+    // The remote branch is never touched.
+    let remote = git(
+        &repo.work,
+        &["ls-remote", "--heads", "origin", "feature/squashed"],
+    );
+    assert!(remote.contains(&tip), "remote branch must stay: {remote}");
+}
