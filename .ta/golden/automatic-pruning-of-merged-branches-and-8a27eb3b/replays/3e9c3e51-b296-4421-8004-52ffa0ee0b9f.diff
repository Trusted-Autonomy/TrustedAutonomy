+++ b/crates/ta-cleanup/src/branches.rs
+//! The `branches` group: finished local branches and the worktrees that hold them.
+//!
+//! Ground truth is the PR state from the VCS adapter, never `git branch -d` or `git cherry`
+//! (a squash merge rewrites patch ids, so both call a finished branch unmerged). A branch is
+//! safe to delete only when its PR is merged and the branch has no commits beyond the PR head,
+//! or when its tip is already contained in the default branch. Everything else is a question.
+
+use ta_submit::{BranchSnapshot, LocalBranch, SourceAdapter};
+
+use crate::model::*;
+use crate::scan::mk;
+
+/// How many dirty files to name in a finding before summarising the rest.
+const MAX_FILES_SHOWN: usize = 10;
+
+enum Call {
+    Done(String),
+    Question(String),
+}
+
+fn sha12(s: &str) -> &str {
+    &s[..s.len().min(12)]
+}
+
+pub(crate) fn scan_branches(e: &Engine, out: &mut Vec<Finding>) {
+    let Some(a) = e.truth.branch_adapter() else {
+        return;
+    };
+    let snap = match a.branch_snapshot() {
+        Ok(Some(s)) => s,
+        Ok(None) => return,
+        Err(err) => {
+            tracing::warn!(error = %err, "cleanup: could not list local branches; the branches group was skipped");
+            return;
+        }
+    };
+    for b in &snap.branches {
+        if snap.default_branch.as_deref() == Some(b.name.as_str()) {
+            continue;
+        }
+        if b.is_current {
+            out.push(mk(
+                Kind::LocalBranch,
+                format!("branch:{}", b.name),
+                format!("local branch {}", b.name),
+                vec![Evidence::new("git", "this is the checked-out branch")],
+                Verdict::Skip,
+                "kept: the current branch is never touched",
+                Action::None,
+                &[("branch", b.name.clone()), ("current", "yes".into())],
+            ));
+            continue;
+        }
+        out.push(judge(e, a, &snap, b));
+    }
+
+    match a.closed_unmerged_remote_branches() {
+        Ok(list) => {
+            for (branch, review) in list {
+                let mut f = mk(
+                    Kind::RemoteBranch,
+                    format!("remote-branch:{branch}"),
+                    format!("remote branch origin/{branch}"),
+                    vec![Evidence::new(
+                        "pr",
+                        format!("PR #{review} was closed without merging"),
+                    )],
+                    Verdict::Skip,
+                    format!("finding only: PR #{review} was closed unmerged, so the host's delete-on-merge never removed it. Cleanup never deletes remote branches"),
+                    Action::None,
+                    &[("branch", branch.clone()), ("pr", review.clone())],
+                );
+                f.manual_command = Some(format!("git push origin --delete {branch}"));
+                out.push(f);
+            }
+        }
+        Err(err) => {
+            tracing::warn!(error = %err, "cleanup: could not list closed-unmerged PRs; remote branch findings were skipped");
+        }
+    }
+}
+
+fn judge(e: &Engine, a: &dyn SourceAdapter, snap: &BranchSnapshot, b: &LocalBranch) -> Finding {
+    let mut evidence = vec![Evidence::new("git", format!("tip {}", b.tip_sha))];
+    let call = decide(e, a, snap, b, &mut evidence);
+    let id = format!("branch:{}", b.name);
+    let title = format!("local branch {}", b.name);
+    let manual = match &b.worktree {
+        Some(w) => format!(
+            "git worktree remove {} && git update-ref -d refs/heads/{} {}",
+            w.display(),
+            b.name,
+            b.tip_sha
+        ),
+        None => format!("git update-ref -d refs/heads/{} {}", b.name, b.tip_sha),
+    };
+
+    match call {
+        Call::Done(reason) => {
+            // The branch is finished. A linked worktree only goes with it when it is clean.
+            if let Some(w) = &b.worktree {
+                match worktree_blocker(a, b, w, &mut evidence) {
+                    None => {}
+                    Some(why) => {
+                        return question(
+                            id,
+                            title,
+                            evidence,
+                            format!("{reason}, but {why}"),
+                            b,
+                            false,
+                            manual,
+                        );
+                    }
+                }
+            }
+            let mut f = mk(
+                Kind::LocalBranch,
+                id,
+                title,
+                evidence,
+                Verdict::AutoSafe,
+                reason.clone(),
+                Action::PruneBranch {
+                    branch: b.name.clone(),
+                    tip_sha: b.tip_sha.clone(),
+                    worktree: b.worktree.clone(),
+                },
+                &[
+                    ("branch", b.name.clone()),
+                    ("tip", b.tip_sha.clone()),
+                    ("call", "done".into()),
+                ],
+            );
+            f.manual_command = Some(manual);
+            f
+        }
+        Call::Question(reason) => {
+            let deletable = b.worktree.is_none();
+            question(id, title, evidence, reason, b, deletable, manual)
+        }
+    }
+}
+
+fn question(
+    id: String,
+    title: String,
+    evidence: Vec<Evidence>,
+    reason: String,
+    b: &LocalBranch,
+    offer_delete: bool,
+    manual: String,
+) -> Finding {
+    let mut f = mk(
+        Kind::LocalBranch,
