+/// Why the worktree at `w` must not go with its branch, or `None` when it is clean and removable.
+fn worktree_blocker(
+    a: &dyn SourceAdapter,
+    b: &LocalBranch,
+    w: &std::path::Path,
+    evidence: &mut Vec<Evidence>,
+) -> Option<String> {
+    if b.worktree_is_main {
+        evidence.push(Evidence::new(
+            "worktree",
+            format!("{} is the main worktree", w.display()),
+        ));
+        return Some(format!(
+            "it is checked out in the main worktree at {}. Switch that worktree to another branch first",
+            w.display()
+        ));
+    }
+    match a.worktree_dirty_files(w) {
+        Ok(files) if files.is_empty() => {
+            evidence.push(Evidence::new(
+                "worktree",
+                format!("{} is clean", w.display()),
+            ));
+            None
+        }
+        Ok(files) => {
+            let shown: Vec<&str> = files
+                .iter()
+                .take(MAX_FILES_SHOWN)
+                .map(String::as_str)
+                .collect();
+            let more = files.len().saturating_sub(MAX_FILES_SHOWN);
+            let list = if more > 0 {
+                format!("{} and {more} more", shown.join(", "))
+            } else {
+                shown.join(", ")
+            };
+            evidence.push(Evidence::new(
+                "worktree",
+                format!(
+                    "{} has {} uncommitted or untracked file(s): {list}",
+                    w.display(),
+                    files.len()
+                ),
+            ));
+            Some(format!(
+                "its worktree {} has {} uncommitted or untracked file(s): {list}. Commit, move or discard them, then re-run",
+                w.display(),
+                files.len()
+            ))
+        }
+        Err(err) => {
+            evidence.push(Evidence::new(
+                "worktree",
+                format!("{} could not be checked: {err}", w.display()),
+            ));
+            Some(format!(
+                "its worktree {} could not be checked for changes ({err})",
+                w.display()
+            ))
+        }
+    }
+}
