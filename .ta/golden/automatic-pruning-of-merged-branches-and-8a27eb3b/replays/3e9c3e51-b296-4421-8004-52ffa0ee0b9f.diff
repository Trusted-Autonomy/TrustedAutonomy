+/// Run a [`Action::PruneBranch`]. Re-checks that the branch is neither current nor the default
+/// right before deleting, and deletes only if the tip is still the one that was judged.
+pub(crate) fn prune(
+    e: &Engine,
+    branch: &str,
+    tip_sha: &str,
+    worktree: Option<&std::path::Path>,
+) -> anyhow::Result<(String, u64)> {
+    let a = e.truth.branch_adapter().ok_or_else(|| {
+        anyhow::anyhow!("no VCS adapter is available to delete branch '{branch}'. Run `git update-ref -d refs/heads/{branch} {tip_sha}` yourself")
+    })?;
+    if let Ok(Some(snap)) = a.branch_snapshot() {
+        let live = snap.branches.iter().find(|b| b.name == branch);
+        if live.is_some_and(|b| b.is_current) || snap.default_branch.as_deref() == Some(branch) {
+            anyhow::bail!(
+                "refusing to delete '{branch}': it is the current or default branch. Nothing was changed."
+            );
+        }
+    }
+    if let Some(w) = worktree {
+        a.remove_worktree(w).map_err(|err| {
+            anyhow::anyhow!(
+                "could not remove worktree {}: {err}. Branch '{branch}' (tip {tip_sha}) was kept.",
+                w.display()
+            )
+        })?;
+    }
+    a.delete_local_branch(branch, tip_sha).map_err(|err| {
+        anyhow::anyhow!(
+            "could not delete branch '{branch}' (expected tip {tip_sha}): {err}. It may have moved since the scan; re-run `ta cleanup --only branches`."
+        )
+    })?;
+    let wt = worktree
+        .map(|w| format!(" and removed worktree {}", w.display()))
+        .unwrap_or_default();
+    Ok((
+        format!(
+            "deleted local branch '{branch}' (tip {tip_sha}){wt}; recover with `git branch {branch} {tip_sha}`"
+        ),
+        0,
+    ))
+}
