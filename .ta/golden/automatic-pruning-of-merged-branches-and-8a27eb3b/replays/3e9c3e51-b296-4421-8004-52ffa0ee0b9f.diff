+fn decide(
+    e: &Engine,
+    a: &dyn SourceAdapter,
+    snap: &BranchSnapshot,
+    b: &LocalBranch,
+    evidence: &mut Vec<Evidence>,
+) -> Call {
+    // 1. Already contained in the default branch: nothing on it can be lost.
+    for tip in &snap.default_tips {
+        if matches!(a.is_ancestor(&b.tip_sha, tip), Ok(true)) {
+            let d = snap
+                .default_branch
+                .as_deref()
+                .unwrap_or("the default branch");
+            evidence.push(Evidence::new(
+                "git",
+                format!("tip is an ancestor of {d} ({})", sha12(tip)),
+            ));
+            return Call::Done(format!("its tip is already contained in {d}"));
+        }
+    }
+
+    // 2. The PR, from the VCS adapter.
+    match e.truth.branch_review(&b.name) {
+        BranchReviewInfo::NoReview => {
+            evidence.push(Evidence::new("pr", "none found for this branch"));
+            Call::Question("no PR exists for this branch and it has commits that are not on the default branch".into())
+        }
+        BranchReviewInfo::Unknown(why) => {
+            evidence.push(Evidence::new("pr", format!("unknown: {why}")));
+            Call::Question(format!("the PR state could not be read ({why})"))
+        }
+        BranchReviewInfo::Found {
+            review_id,
+            state,
+            head_sha,
+        } => match state {
+            ReviewState::Open => {
+                evidence.push(Evidence::new("pr", format!("#{review_id} is open")));
+                Call::Question(format!("PR #{review_id} is still open"))
+            }
+            ReviewState::Closed => {
+                evidence.push(Evidence::new(
+                    "pr",
+                    format!("#{review_id} was closed without merging"),
+                ));
+                Call::Question(format!("PR #{review_id} was closed without merging, so the work may be unwanted or unfinished"))
+            }
+            ReviewState::Unknown(why) => {
+                evidence.push(Evidence::new("pr", format!("#{review_id}: {why}")));
+                Call::Question(format!("PR #{review_id} has an unreadable state ({why})"))
+            }
+            ReviewState::Merged => {
+                let Some(head) = head_sha else {
+                    evidence.push(Evidence::new(
+                        "pr",
+                        format!("#{review_id} is merged; head commit not reported"),
+                    ));
+                    return Call::Question(format!(
+                        "PR #{review_id} is merged but the adapter did not report its head commit, so commits added after the merge cannot be ruled out"
+                    ));
+                };
+                match a.is_ancestor(&b.tip_sha, &head) {
+                    Ok(true) => {
+                        evidence.push(Evidence::new(
+                            "pr",
+                            format!(
+                                "#{review_id} is merged; branch tip is at or behind PR head {}",
+                                sha12(&head)
+                            ),
+                        ));
+                        Call::Done(format!(
+                            "PR #{review_id} is merged and the branch has no commits beyond the PR head"
+                        ))
+                    }
+                    Ok(false) => {
+                        evidence.push(Evidence::new(
+                            "pr",
+                            format!("#{review_id} is merged at {}, but the branch tip is not contained in it", sha12(&head)),
+                        ));
+                        Call::Question(format!(
+                            "PR #{review_id} is merged but the branch has commits beyond the PR head ({})",
+                            sha12(&head)
+                        ))
+                    }
+                    Err(err) => {
+                        evidence.push(Evidence::new(
+                            "pr",
+                            format!(
+                                "#{review_id} is merged; head {} cannot be compared: {err}",
+                                sha12(&head)
+                            ),
+                        ));
+                        Call::Question(format!(
+                            "PR #{review_id} is merged but its head commit {} is not available locally, so extra commits cannot be ruled out. Run `git fetch` and retry",
+                            sha12(&head)
+                        ))
+                    }
+                }
+            }
+        },
+    }
