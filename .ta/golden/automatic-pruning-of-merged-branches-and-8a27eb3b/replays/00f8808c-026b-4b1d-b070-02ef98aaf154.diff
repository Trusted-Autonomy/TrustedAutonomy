+            .args(args)
+            .env_remove("GIT_DIR")
+            .env_remove("GIT_WORK_TREE")
+            .env_remove("GIT_INDEX_FILE")
+            .env("GIT_AUTHOR_NAME", "t")
+            .env("GIT_AUTHOR_EMAIL", "t@example.com")
+            .env("GIT_COMMITTER_NAME", "t")
+            .env("GIT_COMMITTER_EMAIL", "t@example.com")
+            .env(
+                "GIT_CONFIG_GLOBAL",
+                if cfg!(windows) { "NUL" } else { "/dev/null" },
+            )
+            .output()
+            .unwrap();
+        assert!(
+            out.status.success(),
+            "git {args:?} failed: {}",
+            String::from_utf8_lossy(&out.stderr)
+        );
+        String::from_utf8_lossy(&out.stdout).trim().to_string()
+    }
+
+    fn commit(dir: &Path, file: &str, text: &str) -> String {
+        std::fs::write(dir.join(file), text).unwrap();
+        git(dir, &["add", file]);
+        git(dir, &["commit", "-q", "-m", &format!("add {file}")]);
+        git(dir, &["rev-parse", "HEAD"])
+    }
+
+    fn branch_exists(dir: &Path, name: &str) -> bool {
+        Command::new("git")
+            .arg("-C")
+            .arg(dir)
+            .env_remove("GIT_DIR")
+            .env_remove("GIT_WORK_TREE")
+            .args([
+                "rev-parse",
+                "--verify",
+                "--quiet",
+                &format!("refs/heads/{name}"),
+            ])
+            .output()
+            .unwrap()
+            .status
+            .success()
+    }
+
+    /// A project clone of a bare origin with `main` pushed.
+    struct Repo {
+        _tmp: tempfile::TempDir,
+        proj: PathBuf,
+        paths: Paths,
+    }
+
+    impl Repo {
+        fn new() -> Self {
+            let tmp = tempfile::tempdir().unwrap();
+            let origin = tmp.path().join("origin.git");
+            std::fs::create_dir_all(&origin).unwrap();
+            git(&origin, &["init", "-q", "--bare", "-b", "main"]);
+            let proj = tmp.path().join("proj");
+            git(
+                tmp.path(),
+                &["clone", "-q", origin.to_str().unwrap(), "proj"],
+            );
+            git(&proj, &["checkout", "-q", "-b", "main"]);
+            commit(&proj, "README.md", "hello\n");
+            git(&proj, &["push", "-q", "-u", "origin", "main"]);
+            let paths = Paths::for_project(&proj);
+            for d in [&paths.goals_dir, &paths.pr_packages_dir, &paths.staging_dir] {
+                std::fs::create_dir_all(d).unwrap();
+            }
+            std::fs::write(proj.join(".git/info/exclude"), ".ta/\n").unwrap();
+            Repo {
+                _tmp: tmp,
+                proj,
+                paths,
+            }
+        }
+
+        /// Branch `name` with one commit, back on `main`. Returns the commit (the PR head).
+        fn feature(&self, name: &str) -> String {
+            git(&self.proj, &["checkout", "-q", "-b", name]);
+            let head = commit(
+                &self.proj,
+                &format!("{}.txt", name.replace('/', "_")),
+                "work\n",
+            );
+            git(&self.proj, &["checkout", "-q", "main"]);
+            head
+        }
+
+        /// Squash-merge `name` into main and push, as the host does. The branch tip is then NOT
+        /// an ancestor of main, which is exactly what fools `git branch -d` and `git cherry`.
+        fn squash_merge(&self, name: &str) {
+            git(&self.proj, &["merge", "-q", "--squash", name]);
+            git(
+                &self.proj,
+                &["commit", "-q", "-m", &format!("squash {name}")],
+            );
+            git(&self.proj, &["push", "-q", "origin", "main"]);
+        }
+
+        fn record_pr(&self, branch: &str, review: &str, head: &str) {
+            let mut p = make_test_pkg(&review.repeat(8), 1);
+            p.status = DraftStatus::Applied {
+                applied_at: Utc::now(),
+                applied_via: Default::default(),
+            };
+            let mut v = vcs(review, "open");
+            v.branch = branch.to_string();
+            v.commit_sha = Some(head.to_string());
+            p.vcs_status = Some(v);
+            std::fs::write(
+                self.paths
+                    .pr_packages_dir
+                    .join(format!("{}.json", p.package_id)),
+                serde_json::to_string_pretty(&p).unwrap(),
+            )
+            .unwrap();
+        }
+
+        fn run(&self, truth: &Truth, settings: Settings) -> Report {
+            let engine = Engine {
+                paths: self.paths.clone(),
+                settings,
+                truth,
+                closer: &FileCloser,
+                assistant: None,
+            };
+            run(
+                &engine,
+                &RunOptions {
+                    auto_safe_only: true,
+                    only: Some(vec![Category::Branches]),
+                    ..Default::default()
+                },
+                None,
+            )
+            .unwrap()
+        }
+    }
+
+    fn truth(pairs: &[(&str, ReviewState)]) -> Truth {
+        Truth {
+            reviews: pairs
+                .iter()
+                .map(|(k, v)| (k.to_string(), v.clone()))
+                .collect(),
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn merged_squash_branch_is_deleted_and_logged_with_tip() {
+        let repo = Repo::new();
+        let head = repo.feature("feature/done");
+        repo.record_pr("feature/done", "5", &head);
+        repo.squash_merge("feature/done");
+        // Plain git agrees this looks unmerged: the whole reason PR state is the ground truth.
+        assert!(!Command::new("git")
+            .arg("-C")
+            .arg(&repo.proj)
+            .env_remove("GIT_DIR")
+            .env_remove("GIT_WORK_TREE")
+            .args(["merge-base", "--is-ancestor", &head, "main"])
+            .status()
+            .unwrap()
+            .success());
+
+        let r = repo.run(&truth(&[("5", ReviewState::Merged)]), Settings::default());
+
+        assert!(!branch_exists(&repo.proj, "feature/done"));
+        let done = r
+            .done
+            .iter()
+            .find(|d| d.finding_id == "branch:feature/done")
+            .unwrap();
+        assert!(done.summary.contains(&head), "{}", done.summary);
+        let log = std::fs::read_to_string(repo.paths.cleanup_dir().join("pruned-branches.jsonl"))
+            .unwrap();
+        assert!(log.contains(&head) && log.contains("feature/done"), "{log}");
+        // Recoverable from the logged tip.
+        git(&repo.proj, &["branch", "restored", &head]);
+    }
