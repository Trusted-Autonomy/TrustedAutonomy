+++ b/crates/ta-cleanup/src/branches.rs
+//! The `branches` group: finished local branches and the worktrees that hold them.
+//!
+//! Ground truth is the PR state from the VCS adapter (through [`GroundTruth::review_state`]),
+//! never `git branch -d` or `git cherry`: a squash merge rewrites patch ids, so a finished
+//! branch looks unmerged to both. A branch is safe to delete when its PR is merged and the
+//! branch has no commits beyond the PR head recorded on its draft, or when its tip is already an
+//! ancestor of the default branch. Everything else is a question, never an automatic deletion.
+//! Remote branches are never deleted (the host's "delete head branches on merge" does that);
+//! a remote branch whose PR was closed unmerged is only reported.
+
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+
+use chrono::Utc;
+use serde_json::json;
+
+use crate::model::*;
+use crate::scan::{dir_size, mk, review_ref, Scan};
+
+const REMOTE: &str = "origin";
+
+/// Run git in `dir`. `Ok(stdout)` on exit 0, `Err(stderr or exit description)` otherwise.
+fn git(dir: &Path, args: &[&str]) -> Result<String, String> {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(dir)
+        .args(args)
+        .env("GIT_TERMINAL_PROMPT", "0")
+        // An inherited repo override (hooks, wrappers) would aim git at the wrong repository.
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .env_remove("GIT_INDEX_FILE")
+        .stdin(Stdio::null())
+        .output()
+        .map_err(|e| format!("could not run git: {e}. Is git installed and on PATH?"))?;
+    if out.status.success() {
+        Ok(String::from_utf8_lossy(&out.stdout).trim_end().to_string())
+    } else {
+        let err = String::from_utf8_lossy(&out.stderr).trim().to_string();
+        Err(if err.is_empty() {
+            format!("git {} exited with {}", args.join(" "), out.status)
+        } else {
+            err
+        })
+    }
+}
+
+/// `git merge-base --is-ancestor a b`. Any error counts as "no": deleting needs a yes.
+fn is_ancestor(dir: &Path, a: &str, b: &str) -> bool {
+    git(dir, &["merge-base", "--is-ancestor", a, b]).is_ok()
+}
+
+fn rev_exists(dir: &Path, rev: &str) -> bool {
+    git(
+        dir,
+        &[
+            "rev-parse",
+            "--verify",
+            "--quiet",
+            &format!("{rev}^{{commit}}"),
+        ],
+    )
+    .is_ok()
+}
+
+fn default_branch(root: &Path) -> Option<String> {
+    if let Ok(r) = git(
+        root,
+        &[
+            "symbolic-ref",
+            "--quiet",
+            "--short",
+            &format!("refs/remotes/{REMOTE}/HEAD"),
+        ],
+    ) {
+        if let Some(n) = r.strip_prefix(&format!("{REMOTE}/")) {
+            return Some(n.to_string());
+        }
+    }
+    ["main", "master"]
+        .into_iter()
+        .find(|b| {
+            rev_exists(root, &format!("refs/heads/{b}"))
+                || rev_exists(root, &format!("refs/remotes/{REMOTE}/{b}"))
+        })
+        .map(str::to_string)
+}
+
+#[derive(Debug)]
+struct Worktree {
+    path: PathBuf,
+    branch: Option<String>,
+}
+
+/// All worktrees; the first entry is the main one (the project root).
+fn worktrees(root: &Path) -> Vec<Worktree> {
+    let Ok(text) = git(root, &["worktree", "list", "--porcelain"]) else {
+        return Vec::new();
+    };
+    let mut out: Vec<Worktree> = Vec::new();
+    for line in text.lines() {
+        if let Some(p) = line.strip_prefix("worktree ") {
+            out.push(Worktree {
+                path: PathBuf::from(p),
+                branch: None,
+            });
+        } else if let Some(b) = line.strip_prefix("branch refs/heads/") {
+            if let Some(w) = out.last_mut() {
+                w.branch = Some(b.to_string());
+            }
+        }
+    }
+    out
+}
+
+fn same_path(a: &Path, b: &Path) -> bool {
+    match (a.canonicalize(), b.canonicalize()) {
+        (Ok(x), Ok(y)) => x == y,
+        _ => a == b,
+    }
+}
+
+/// Uncommitted and untracked files in a worktree. `Err` when it cannot be read.
+fn dirty_files(path: &Path) -> Result<Vec<String>, String> {
+    git(path, &["status", "--porcelain", "-uall"])
+        .map(|t| t.lines().map(|l| l.trim_end().to_string()).collect())
+}
+
+struct PrInfo {
+    review_ref: String,
+    head: Option<String>,
+}
+
+/// The PR a branch was submitted as, from the newest draft that recorded one.
+fn pr_for(s: &Scan, branch: &str) -> Option<PrInfo> {
+    s.drafts
+        .iter()
+        .filter_map(|p| {
+            let v = p.vcs_status.as_ref().filter(|v| v.branch == branch)?;
+            Some((v.last_checked, review_ref(p)?, v.commit_sha.clone()))
+        })
+        .max_by_key(|(at, _, _)| *at)
+        .map(|(_, r, head)| PrInfo {
+            review_ref: r,
+            head: head.filter(|h| !h.trim().is_empty()),
+        })
+}
+
+fn short_sha(s: &str) -> &str {
+    &s[..s.len().min(10)]
+}
+
+pub(crate) fn branches(s: &Scan, out: &mut Vec<Finding>) {
+    let root = &s.e.paths.root;
+    if !root.join(".git").exists() {
+        return;
+    }
+    let Some(default) = default_branch(root) else {
+        return;
+    };
+    let wts = worktrees(root);
+    let main_branch = wts.first().and_then(|w| w.branch.clone());
+    let default_refs: Vec<String> = [
+        format!("refs/heads/{default}"),
+        format!("refs/remotes/{REMOTE}/{default}"),
+    ]
+    .into_iter()
+    .filter(|r| rev_exists(root, r))
+    .collect();
+
+    let Ok(listing) = git(
+        root,
+        &[
+            "for-each-ref",
+            "--format=%(refname:short)%09%(objectname)",
+            "refs/heads",
+        ],
+    ) else {
+        return;
+    };
+    for line in listing.lines() {
+        let Some((name, tip)) = line.split_once('\t') else {
+            continue;
+        };
+        let id = format!("branch:{name}");
+        let title = format!("Local branch '{name}'");
+        if name == default || main_branch.as_deref() == Some(name) {
+            let why = if name == default {
+                "the default branch is never pruned"
+            } else {
+                "it is the branch checked out in the project root (the current branch)"
+            };
+            out.push(mk(
+                Kind::Branch,
+                id,
+                title,
+                vec![Evidence::new("git", format!("tip {}", short_sha(tip)))],
+                Verdict::Skip,
+                format!("Kept: {why}."),
+                Action::None,
+                &[("tip", tip.to_string()), ("kept", why.to_string())],
+            ));
+            continue;
+        }
+
+        let mut ev = vec![Evidence::new("git", format!("tip {tip}"))];
+        let ancestor_of_default = default_refs.iter().any(|d| is_ancestor(root, tip, d));
+        ev.push(Evidence::new(
+            "git",
+            if ancestor_of_default {
+                format!("tip is an ancestor of '{default}'")
+            } else {
+                format!("tip is not an ancestor of '{default}'")
+            },
+        ));
+
+        let pr = pr_for(s, name);
+        let mut state_label = "no-pr".to_string();
+        let mut merged_clean = false;
+        let mut pr_note = String::from("no PR is recorded for this branch");
+        if let Some(pr) = &pr {
+            let st = s.probe(&pr.review_ref);
+            state_label = match &st {
+                ReviewState::Open => "open".into(),
+                ReviewState::Merged => "merged".into(),
+                ReviewState::Closed => "closed".into(),
+                ReviewState::Unknown(_) => "unknown".into(),
+            };
+            ev.push(Evidence::new(
+                "vcs",
+                match &st {
+                    ReviewState::Unknown(why) => {
+                        format!("PR {} state unknown: {why}", pr.review_ref)
+                    }
+                    other => format!("PR {} is {}", pr.review_ref, state_label_of(other)),
+                },
+            ));
+            pr_note = format!("its PR {} is {}", pr.review_ref, state_label);
+            if st == ReviewState::Merged {
+                match &pr.head {
+                    Some(h) if is_ancestor(root, tip, h) => {
+                        ev.push(Evidence::new(
+                            "git",
+                            format!("no commits beyond the PR head {}", short_sha(h)),
+                        ));
+                        merged_clean = true;
+                    }
+                    Some(h) => {
+                        ev.push(Evidence::new(
+                            "git",
+                            format!("branch has commits beyond the PR head {}", short_sha(h)),
+                        ));
+                        pr_note =
+                            format!("{pr_note}, but the branch has commits beyond the PR head");
+                    }
+                    None => {
+                        ev.push(Evidence::new("git", "the PR head commit was not recorded"));
+                        pr_note = format!("{pr_note}, but its head commit was not recorded");
+                    }
+                }
+            }
+        } else {
+            ev.push(Evidence::new(
+                "vcs",
+                "no draft recorded a PR for this branch",
+            ));
+        }
+
+        // A worktree holding the branch: it must be clean before anything is removed.
+        let linked = wts
+            .iter()
+            .skip(1)
+            .find(|w| w.branch.as_deref() == Some(name));
+        let mut worktree: Option<PathBuf> = None;
+        let mut dirty: Vec<String> = Vec::new();
+        let mut unreadable: Option<String> = None;
+        if let Some(w) = linked {
+            ev.push(Evidence::new(
+                "git",
+                format!("checked out in worktree {}", w.path.display()),
+            ));
+            if w.path.exists() {
+                match dirty_files(&w.path) {
+                    Ok(files) if files.is_empty() => worktree = Some(w.path.clone()),
+                    Ok(files) => {
+                        ev.push(Evidence::new(
+                            "git",
+                            format!(
+                                "worktree has uncommitted or untracked files: {}",
+                                files.join("; ")
+                            ),
+                        ));
+                        dirty = files;
+                    }
+                    Err(e) => {
+                        ev.push(Evidence::new(
+                            "git",
+                            format!("worktree status unreadable: {e}"),
+                        ));
+                        unreadable = Some(e);
+                    }
+                }
+            }
+        }
+
+        let done = ancestor_of_default || merged_clean;
+        let blocked = !dirty.is_empty() || unreadable.is_some();
+        let facts = [
+            ("tip", tip.to_string()),
+            ("pr", state_label.clone()),
+            ("done", done.to_string()),
+            ("dirty", dirty.join("\n")),
+        ];
+        let prune = Action::PruneBranch {
+            name: name.to_string(),
+            tip: tip.to_string(),
+            worktree: worktree.clone(),
+        };
+        let manual =
+            format!("git branch -D {name}   (tip {tip}; restore with: git branch {name} {tip})");
+
+        let mut f = if done && !blocked {
+            let why = if merged_clean {
+                format!("{pr_note} and the branch has no commits beyond the PR head")
+            } else {
+                format!("its tip is already part of '{default}'")
+            };
+            mk(
+                Kind::Branch,
+                id,
+                title,
+                ev,
+                Verdict::AutoSafe,
+                format!(
+                    "Finished: {why}. Deleting it loses nothing (tip {} is logged).",
+                    short_sha(tip)
+                ),
+                prune.clone(),
+                &facts,
+            )
+        } else {
+            let reason = if !dirty.is_empty() {
+                format!(
+                    "Its worktree has {} uncommitted or untracked file(s), so nothing is removed until you decide: {}.",
+                    dirty.len(),
+                    dirty.join("; ")
+                )
+            } else if let Some(e) = &unreadable {
+                format!("Its worktree could not be checked ({e}), so nothing is removed.")
+            } else if state_label == "no-pr" {
+                "No PR is recorded and the tip is not in the default branch, so it may hold unmerged work.".to_string()
+            } else {
+                format!("Not finished: {pr_note}, and the tip is not in '{default}'.")
+            };
+            let mut f = mk(
+                Kind::Branch,
+                id,
+                title,
+                ev,
+                Verdict::Ask,
+                reason,
+                Action::None,
+                &facts,
+            );
+            f.options = vec![AnswerOption {
+                key: "keep".into(),
+                label: "Keep the branch".into(),
+                action: Action::None,
+            }];
+            if !blocked {
+                f.options.push(AnswerOption {
+                    key: "delete".into(),
+                    label: format!(
+                        "Delete the branch (tip {} is logged for recovery)",
+                        short_sha(tip)
+                    ),
+                    action: prune,
+                });
+            }
+            f.recommended = Some("keep".into());
+            f
+        };
+        f.manual_command = Some(manual);
+        out.push(f);
+    }
+
+    remote_findings(s, root, &default, out);
+}
+
+fn state_label_of(s: &ReviewState) -> &'static str {
+    match s {
+        ReviewState::Open => "open",
+        ReviewState::Merged => "merged",
+        ReviewState::Closed => "closed",
+        ReviewState::Unknown(_) => "unknown",
+    }
+}
+
+/// Remote branches whose PR was closed without merging. Findings only: nothing remote is deleted.
+fn remote_findings(s: &Scan, root: &Path, default: &str, out: &mut Vec<Finding>) {
+    let prefix = format!("{REMOTE}/");
+    let Ok(listing) = git(
+        root,
+        &[
+            "for-each-ref",
+            "--format=%(refname:short)%09%(objectname)",
+            &format!("refs/remotes/{REMOTE}"),
+        ],
+    ) else {
+        return;
+    };
+    for line in listing.lines() {
+        let Some((full, tip)) = line.split_once('\t') else {
+            continue;
+        };
+        let Some(name) = full.strip_prefix(&prefix) else {
+            continue;
+        };
+        if name == "HEAD" || name == default {
+            continue;
+        }
+        let Some(pr) = pr_for(s, name) else {
+            continue;
+        };
+        if s.probe(&pr.review_ref) != ReviewState::Closed {
+            continue;
+        }
+        out.push(mk(
+            Kind::RemoteBranch,
+            format!("remote_branch:{name}"),
+            format!("Remote branch '{REMOTE}/{name}'"),
+            vec![
+                Evidence::new("git", format!("remote tip {tip}")),
+                Evidence::new("vcs", format!("PR {} was closed without merging", pr.review_ref)),
+            ],
+            Verdict::Skip,
+            "Reported only: its PR was closed unmerged. Remote branches are never deleted by cleanup.",
+            Action::None,
+            &[("tip", tip.to_string()), ("pr", "closed".to_string())],
+        ));
+        if let Some(f) = out.last_mut() {
+            f.manual_command = Some(format!("git push {REMOTE} --delete {name}"));
+        }
+    }
+}
+
+/// Delete a branch judged done, after re-checking that nothing changed since the scan.
+/// Returns a summary naming the branch and tip, and the bytes of any removed worktree.
+pub fn prune(
+    paths: &Paths,
+    name: &str,
+    tip: &str,
+    worktree: Option<&Path>,
+) -> anyhow::Result<(String, u64)> {
+    let root = &paths.root;
+    let now = git(
+        root,
+        &["rev-parse", "--verify", &format!("refs/heads/{name}")],
+    )
+    .map_err(|e| anyhow::anyhow!("branch '{name}' cannot be read: {e}"))?;
+    if now != tip {
+        anyhow::bail!(
+            "branch '{name}' moved from {} to {} since it was judged done; left alone. Re-run `ta cleanup`.",
+            short_sha(tip),
+            short_sha(&now)
+        );
+    }
+    let wts = worktrees(root);
+    if wts.first().and_then(|w| w.branch.as_deref()) == Some(name) {
+        anyhow::bail!("branch '{name}' is checked out in the project root; left alone.");
+    }
+    let mut bytes = 0;
+    if let Some(holder) = wts
+        .iter()
+        .skip(1)
+        .find(|w| w.branch.as_deref() == Some(name))
+    {
+        match worktree {
+            Some(expected) if same_path(expected, &holder.path) => {
+                let files = dirty_files(&holder.path).map_err(|e| {
+                    anyhow::anyhow!("worktree {} cannot be checked: {e}", holder.path.display())
+                })?;
+                if !files.is_empty() {
+                    anyhow::bail!(
+                        "worktree {} now has uncommitted or untracked files ({}); left alone.",
+                        holder.path.display(),
+                        files.join("; ")
+                    );
+                }
+                bytes = dir_size(&holder.path);
+                git(root, &["worktree", "remove", &holder.path.to_string_lossy()]).map_err(|e| {
+                    anyhow::anyhow!("could not remove worktree {}: {e}", holder.path.display())
+                })?;
+            }
+            _ => anyhow::bail!(
+                "branch '{name}' is checked out in worktree {}, which was not part of the decision; left alone.",
+                holder.path.display()
+            ),
+        }
+    }
+    let _ = git(root, &["worktree", "prune"]);
+    git(
+        root,
+        &["update-ref", "-d", &format!("refs/heads/{name}"), tip],
+    )
+    .map_err(|e| anyhow::anyhow!("could not delete branch '{name}': {e}"))?;
+    let _ = git(
+        root,
+        &["config", "--remove-section", &format!("branch.{name}")],
+    );
+    log_pruned(paths, name, tip, worktree);
+    Ok((
+        format!(
+            "deleted branch {name} (tip {tip}){}; restore with: git branch {name} {tip}",
+            worktree
+                .map(|w| format!(" and worktree {}", w.display()))
+                .unwrap_or_default()
+        ),
+        bytes,
+    ))
+}
+
+/// Append a recovery record to `.ta/cleanup/pruned-branches.jsonl`.
+fn log_pruned(paths: &Paths, name: &str, tip: &str, worktree: Option<&Path>) {
+    use std::io::Write;
+    let dir = paths.cleanup_dir();
+    let rec = json!({
+        "at": Utc::now().to_rfc3339(),
+        "branch": name,
+        "tip": tip,
+        "worktree": worktree.map(|w| w.display().to_string()),
+        "restore": format!("git branch {name} {tip}"),
+    });
+    let res = std::fs::create_dir_all(&dir).and_then(|_| {
+        let mut f = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(dir.join("pruned-branches.jsonl"))?;
+        writeln!(f, "{rec}")
+    });
+    if let Err(e) = res {
+        tracing::warn!(branch = name, tip, error = %e, "cleanup: could not write the pruned-branches log; the audit log still has the tip");
+    }
+}
