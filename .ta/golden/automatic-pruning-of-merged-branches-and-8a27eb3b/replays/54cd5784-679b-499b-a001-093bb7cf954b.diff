+struct Repo {
+    _dir: tempfile::TempDir,
+    origin: PathBuf,
+    work: PathBuf,
+    base: PathBuf,
+}
+
+impl Repo {
+    fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let base = dir.path().to_path_buf();
+        let origin = base.join("origin.git");
+        let work = base.join("work");
+        std::fs::create_dir_all(&origin).unwrap();
+        git(&origin, &["init", "--bare", "-b", "main"]);
+        git(&base, &["clone", origin.to_str().unwrap(), "work"]);
+        std::fs::write(work.join("README.md"), "hello\n").unwrap();
+        git(&work, &["add", "."]);
+        git(&work, &["commit", "-m", "initial"]);
+        git(&work, &["push", "-u", "origin", "main"]);
+        Repo {
+            _dir: dir,
+            origin,
+            work,
+            base,
+        }
+    }
+
+    /// A branch with one commit, then back on main. Returns the tip.
+    fn branch_with_commit(&self, name: &str, file: &str) -> String {
+        git(&self.work, &["checkout", "-b", name]);
+        std::fs::write(self.work.join(file), format!("{name}\n")).unwrap();
+        git(&self.work, &["add", "."]);
+        git(&self.work, &["commit", "-m", &format!("work on {name}")]);
+        let tip = git(&self.work, &["rev-parse", "HEAD"]);
+        git(&self.work, &["checkout", "main"]);
+        tip
+    }
+
+    /// Land `name` on main as a squash commit, so git itself sees it as unmerged.
+    fn squash_merge(&self, name: &str) {
+        git(&self.work, &["merge", "--squash", name]);
+        git(&self.work, &["commit", "-m", &format!("squash {name}")]);
+        git(&self.work, &["push", "origin", "main"]);
+    }
+
+    fn has_branch(&self, name: &str) -> bool {
+        git(&self.work, &["branch", "--list", name]).contains(name)
+    }
+
+    fn truth(&self, reviews: &[(&str, &str, Option<&str>)]) -> BTruth {
+        BTruth(FakeVcs {
+            inner: GitAdapter::new(&self.work),
+            reviews: reviews
+                .iter()
+                .enumerate()
+                .map(|(i, (b, state, head))| {
+                    (
+                        b.to_string(),
+                        BranchReview {
+                            review_ref: (i + 1).to_string(),
+                            state: state.to_string(),
+                            head_sha: head.map(str::to_string),
+                        },
+                    )
+                })
+                .collect(),
+            remote: Vec::new(),
+        })
+    }
+
+    fn engine<'a>(&self, truth: &'a BTruth, settings: Settings) -> Engine<'a> {
+        Engine {
+            paths: Paths::for_project(&self.work),
+            settings,
+            truth,
+            closer: &FileCloser,
+            assistant: None,
+        }
+    }
+}
+
+fn only_branches(dry_run: bool) -> RunOptions {
+    RunOptions {
+        dry_run,
+        auto_safe_only: true,
+        only: Some(vec![Category::Branches]),
+        ..Default::default()
+    }
+}
+
+fn finding<'a>(r: &'a Report, id: &str) -> &'a Finding {
+    r.findings.iter().find(|f| f.id == id).unwrap_or_else(|| {
+        panic!(
+            "no finding {id}: {:?}",
+            r.findings.iter().map(|f| &f.id).collect::<Vec<_>>()
+        )
+    })
+}
