+struct BTruth(FakeVcs);
+
+impl GroundTruth for BTruth {
+    fn review_state(&self, _: &str) -> ReviewState {
+        ReviewState::Unknown("not used".into())
+    }
+    fn phase_done(&self, _: &str) -> bool {
+        false
+    }
+    fn adapter(&self) -> Option<&dyn SourceAdapter> {
+        Some(&self.0)
+    }
