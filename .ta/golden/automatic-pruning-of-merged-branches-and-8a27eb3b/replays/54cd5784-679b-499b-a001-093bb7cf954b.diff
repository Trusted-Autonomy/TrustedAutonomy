+        let pick = prs
+            .iter()
+            .filter(|p| state_of(p) == "open")
+            .chain(prs.iter())
+            .max_by_key(|p| (state_of(p) == "open", p["number"].as_u64().unwrap_or(0)));
+        Ok(pick.map(|p| BranchReview {
+            review_ref: p["number"]
+                .as_u64()
+                .map(|n| n.to_string())
+                .unwrap_or_default(),
+            state: state_of(p),
+            head_sha: p["headRefOid"]
+                .as_str()
+                .filter(|s| !s.is_empty())
+                .map(str::to_string),
+        }))
+    }
