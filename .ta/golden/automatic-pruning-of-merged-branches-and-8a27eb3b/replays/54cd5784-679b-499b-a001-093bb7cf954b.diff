+                found.push(RemoteBranchReport {
+                    branch: branch.to_string(),
+                    review_ref: p["number"]
+                        .as_u64()
+                        .map(|n| n.to_string())
+                        .unwrap_or_default(),
+                });
+            }
+        }
+        Ok(found)
