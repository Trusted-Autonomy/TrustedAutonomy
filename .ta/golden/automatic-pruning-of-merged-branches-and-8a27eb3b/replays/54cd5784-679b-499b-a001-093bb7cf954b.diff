+//! The `branches` group: prune finished local branches and the worktrees they own.
+//!
+//! Ground truth is the PR state from the VCS adapter, never `git branch -d` or
+//! `git cherry` (a squash merge rewrites patch ids, so finished work looks unmerged).
+//! A branch is deleted without asking only when
+//!
+//! * its PR is merged and the branch has no commits beyond the PR head, or
+//! * its tip is an ancestor of the default branch,
+//!
+//! and it is not the current or default branch, and any worktree it is checked
+//! out in is clean. Everything else is a question or is left alone. Remote
+//! branches are never deleted; a closed-unmerged one is only reported.
+
+use std::path::{Path, PathBuf};
+
+use serde_json::json;
+use ta_submit::{SourceAdapter, WorktreeInfo};
+
+use crate::model::*;
+use crate::scan::{signature, Scan};
+use crate::state;
+
+/// First 8 characters of a commit id, for messages.
+fn short_sha(sha: &str) -> &str {
+    sha.get(..8).unwrap_or(sha)
+}
+
+/// Where deletions are recorded so a branch can be restored from its tip.
+pub fn deleted_log_path(p: &Paths) -> PathBuf {
+    p.cleanup_dir().join("branches-deleted.jsonl")
+}
+
+fn files_text(files: &[String]) -> String {
+    files.join(", ")
+}
+
+/// `Some(reason)` when the branch is provably finished.
+enum Proof {
+    Done(String),
+    Question(String),
+}
+
+/// Decide from the adapter whether `tip` of branch `name` is finished work.
+fn judge(a: &dyn SourceAdapter, name: &str, tip: &str, default: &str) -> (Proof, Vec<Evidence>) {
+    let mut ev = vec![Evidence::new("git", format!("tip {}", short_sha(tip)))];
+    // The local default branch may lag behind origin when the PR merged remotely.
+    for base in [default.to_string(), format!("origin/{default}")] {
+        if a.is_ancestor(tip, &base).unwrap_or(false) {
+            ev.push(Evidence::new(
+                "git",
+                format!("tip is an ancestor of {base}"),
+            ));
+            return (
+                Proof::Done(format!("its tip is already contained in {base}")),
+                ev,
+            );
+        }
+    }
+    let review = match a.branch_review(name) {
+        Ok(r) => r,
+        Err(e) => {
+            ev.push(Evidence::new("vcs", format!("PR lookup failed: {e}")));
+            return (
+                Proof::Question(format!(
+                    "the PR state could not be read ({e}), so merged-ness is unproven"
+                )),
+                ev,
+            );
+        }
+    };
+    let Some(r) = review else {
+        ev.push(Evidence::new("vcs", "no PR found for this branch"));
+        return (
+            Proof::Question(
+                "no PR is known for this branch and it is not in the default branch".into(),
+            ),
+            ev,
+        );
+    };
+    ev.push(Evidence::new(
+        "vcs",
+        format!("PR {} is {}", r.review_ref, r.state),
+    ));
+    match r.state.as_str() {
+        "merged" => {
+            let Some(head) = r.head_sha else {
+                return (
+                    Proof::Question(format!(
+                        "PR {} is merged but the VCS did not report its head commit, so extra commits cannot be ruled out",
+                        r.review_ref
+                    )),
+                    ev,
+                );
+            };
+            ev.push(Evidence::new(
+                "vcs",
+                format!("PR head {}", short_sha(&head)),
+            ));
+            match a.is_ancestor(tip, &head) {
+                Ok(true) => (
+                    Proof::Done(format!(
+                        "PR {} is merged and the branch has no commits beyond the PR head {}",
+                        r.review_ref,
+                        short_sha(&head)
+                    )),
+                    ev,
+                ),
+                Ok(false) => (
+                    Proof::Question(format!(
+                        "PR {} is merged but the branch has commits beyond the PR head {}",
+                        r.review_ref,
+                        short_sha(&head)
+                    )),
+                    ev,
+                ),
+                Err(e) => (
+                    Proof::Question(format!(
+                        "PR {} is merged but its head {} is not in this clone ({e}); fetch it and run again",
+                        r.review_ref,
+                        short_sha(&head)
+                    )),
+                    ev,
+                ),
+            }
+        }
+        "open" | "draft" => (
+            Proof::Question(format!("PR {} is still {}", r.review_ref, r.state)),
+            ev,
+        ),
+        "closed" => (
+            Proof::Question(format!(
+                "PR {} was closed without merging; the work may not be anywhere else",
+                r.review_ref
+            )),
+            ev,
+        ),
+        other => (
+            Proof::Question(format!("PR state '{other}' is not one cleanup understands")),
+            ev,
+        ),
+    }
+}
