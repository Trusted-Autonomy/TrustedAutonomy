+//! The `branches` group against real local git repositories (a bare repo as origin,
+//! a clone as the project). Only the PR state is faked, through the adapter trait.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use ta_changeset::DraftPackage;
+use ta_goal::CommitContext;
+use ta_submit::adapter::SubmitError;
+use ta_submit::config::SubmitConfig;
+use ta_submit::{
+    BranchReview, CommitResult, GitAdapter, LocalBranch, PushResult, RemoteBranchReport,
+    ReviewResult, SourceAdapter, WorktreeInfo,
+};
