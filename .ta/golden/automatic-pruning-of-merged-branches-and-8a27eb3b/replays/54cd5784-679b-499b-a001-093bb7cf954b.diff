+            .output()?;
+        if !out.status.success() {
+            return Err(SubmitError::VcsError(format!(
+                "gh pr list --head {branch} failed: {}",
+                String::from_utf8_lossy(&out.stderr).trim()
+            )));
+        }
+        let prs: Vec<serde_json::Value> = serde_json::from_slice(&out.stdout)
+            .map_err(|e| SubmitError::VcsError(format!("could not parse gh pr list: {e}")))?;
