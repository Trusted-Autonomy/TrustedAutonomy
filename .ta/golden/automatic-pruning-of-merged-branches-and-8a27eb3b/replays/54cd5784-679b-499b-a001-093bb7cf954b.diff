+pub(crate) fn branches(s: &Scan, out: &mut Vec<Finding>) {
+    let Some(a) = s.e.truth.adapter() else {
+        return;
+    };
+    let list = match a.list_local_branches() {
+        Ok(l) if !l.is_empty() => l,
+        Ok(_) => return,
+        Err(e) => {
+            tracing::warn!(error = %e, "cleanup: could not list branches; skipping the branches group");
+            return;
+        }
+    };
+    let Some(default) = a.default_branch() else {
+        tracing::warn!("cleanup: the default branch is unknown; skipping the branches group");
+        return;
+    };
+    let current = a.current_branch().ok();
+    // Without worktree facts a dirty checkout cannot be ruled out: do nothing.
+    let worktrees = match a.list_worktrees() {
+        Ok(w) => w,
+        Err(e) => {
+            tracing::warn!(error = %e, "cleanup: could not list worktrees; skipping the branches group");
+            return;
+        }
+    };
+
+    for b in list {
+        if b.name == default {
+            continue;
+        }
+        let id = format!("branch:{}", b.name);
+        let title = format!("branch {}", b.name);
+        let wt: Option<&WorktreeInfo> = worktrees
+            .iter()
+            .find(|w| w.branch.as_deref() == Some(b.name.as_str()));
+
+        if current.as_deref() == Some(b.name.as_str()) || wt.is_some_and(|w| w.is_primary) {
+            out.push(mk_branch(
+                id,
+                title,
+                vec![Evidence::new("git", "checked out in the main working tree")],
+                Verdict::Skip,
+                "this is the current branch; cleanup never touches it".into(),
+                Action::None,
+                &b.name,
+                &b.tip,
+                "current",
+            ));
+            continue;
+        }
+
+        let (proof, mut evidence) = judge(a, &b.name, &b.tip, &default);
+        let dirty: &[String] = wt.map(|w| w.dirty_files.as_slice()).unwrap_or(&[]);
+        if let Some(w) = wt {
+            evidence.push(Evidence::new(
+                "git",
+                format!("checked out in worktree {}", w.path.display()),
+            ));
+        }
+        if !dirty.is_empty() {
+            evidence.push(Evidence::new(
+                "git",
+                format!(
+                    "worktree has {} uncommitted or untracked file(s): {}",
+                    dirty.len(),
+                    files_text(dirty)
+                ),
+            ));
+        }
+        let manual = Some(format!("git branch -D {}  (tip {})", b.name, b.tip));
+        let delete = Action::DeleteBranch {
+            name: b.name.clone(),
+            tip: b.tip.clone(),
+            worktree: wt.map(|w| w.path.clone()),
+        };
+        let keep = AnswerOption {
+            key: "keep".into(),
+            label: "keep the branch and any worktree".into(),
+            action: Action::None,
+        };
+
+        let mut f = match proof {
+            Proof::Done(why) if dirty.is_empty() => {
+                let mut f = mk_branch(
+                    id,
+                    title,
+                    evidence,
+                    Verdict::AutoSafe,
+                    format!("finished: {why}"),
+                    delete,
+                    &b.name,
+                    &b.tip,
+                    "done",
+                );
+                f.manual_command = manual;
+                f
+            }
+            Proof::Done(why) => {
+                let mut f = mk_branch(
+                    id,
+                    title,
+                    evidence,
+                    Verdict::Ask,
+                    format!(
+                        "finished ({why}), but its worktree still has uncommitted or untracked files: {}",
+                        files_text(dirty)
+                    ),
+                    Action::None,
+                    &b.name,
+                    &b.tip,
+                    "dirty",
+                );
+                f.options = vec![keep];
+                f.recommended = Some("keep".into());
+                f.manual_command = Some(format!(
+                    "commit or discard the files in {}, then run `ta cleanup --only branches`",
+                    wt.map(|w| w.path.display().to_string()).unwrap_or_default()
+                ));
+                f
+            }
+            Proof::Question(why) => {
+                let mut f = mk_branch(
+                    id,
+                    title,
+                    evidence,
+                    Verdict::Ask,
+                    why,
+                    Action::None,
+                    &b.name,
+                    &b.tip,
+                    "question",
+                );
+                f.options = vec![keep];
+                // A dirty worktree is never deletable from here, even on request.
+                if dirty.is_empty() {
+                    f.options.push(AnswerOption {
+                        key: "delete".into(),
+                        label: format!(
+                            "delete the branch (tip {} is logged so it can be restored)",
+                            short_sha(&b.tip)
+                        ),
+                        action: delete,
+                    });
+                }
+                f.recommended = Some("keep".into());
+                f.manual_command = manual;
+                f
+            }
+        };
+        f.bytes = 0;
+        out.push(f);
+    }
+
+    match a.closed_unmerged_remote_branches() {
+        Ok(remote) => {
+            for r in remote {
+                let mut f = mk_branch(
+                    format!("remote_branch:{}", r.branch),
+                    format!("remote branch origin/{}", r.branch),
+                    vec![Evidence::new(
+                        "vcs",
+                        format!("PR {} was closed without merging", r.review_ref),
+                    )],
+                    Verdict::Skip,
+                    "PR closed unmerged and the remote branch still exists. Reported only: cleanup never deletes remote branches.".into(),
+                    Action::None,
+                    &r.branch,
+                    &r.review_ref,
+                    "remote",
+                );
+                f.kind = Kind::RemoteBranch;
+                f.manual_command = Some(format!("git push origin --delete {}", r.branch));
+                out.push(f);
+            }
+        }
+        Err(e) => {
+            tracing::warn!(error = %e, "cleanup: could not look up closed PRs for remote branches");
+        }
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn mk_branch(
+    id: String,
+    title: String,
+    evidence: Vec<Evidence>,
+    verdict: Verdict,
+    reason: String,
+    action: Action,
+    name: &str,
+    tip: &str,
+    class: &str,
+) -> Finding {
+    let facts = [
+        ("branch", name.to_string()),
+        ("tip", tip.to_string()),
+        ("class", class.to_string()),
+        (
+            "evidence",
+            evidence
+                .iter()
+                .map(|e| e.fact.clone())
+                .collect::<Vec<_>>()
+                .join("|"),
+        ),
+    ];
+    Finding {
+        kind: Kind::Branch,
+        id,
+        title,
+        evidence,
+        verdict,
+        reason,
+        action,
+        options: Vec::new(),
+        recommended: None,
+        signature: signature(Kind::Branch, &facts),
+        bytes: 0,
+        manual_command: None,
+        remembered: None,
+        suggestion: None,
+    }
+}
+
+/// Execute [`Action::DeleteBranch`]. Everything is re-checked first, because the
+/// scan may be minutes old (or a human may have answered a question much later).
+pub(crate) fn delete_branch(
+    e: &Engine,
+    name: &str,
+    tip: &str,
+    worktree: Option<&Path>,
+) -> anyhow::Result<(String, u64)> {
+    let a = e.truth.adapter().ok_or_else(|| {
+        anyhow::anyhow!("no VCS adapter is available to delete branch {name}; nothing was changed")
+    })?;
+    if a.current_branch().ok().as_deref() == Some(name) {
+        anyhow::bail!("branch {name} is now the current branch; not deleting it");
+    }
+    if a.default_branch().as_deref() == Some(name) {
+        anyhow::bail!("branch {name} is the default branch; not deleting it");
+    }
+    let now = a
+        .list_local_branches()?
+        .into_iter()
+        .find(|b| b.name == name);
+    match now {
+        None => return Ok((format!("branch {name} was already gone"), 0)),
+        Some(b) if b.tip != tip => anyhow::bail!(
+            "branch {name} moved from {} to {} since it was inspected; left alone. Run `ta cleanup --only branches` again.",
+            short_sha(tip),
+            short_sha(&b.tip)
+        ),
+        Some(_) => {}
+    }
+    // Re-check every worktree holding the branch, not just the one seen at scan time.
+    for w in a
+        .list_worktrees()?
+        .iter()
+        .filter(|w| w.branch.as_deref() == Some(name))
+    {
+        if w.is_primary {
+            anyhow::bail!(
+                "branch {name} is checked out in the main working tree {}; not deleting it",
+                w.path.display()
+            );
+        }
+        if !w.dirty_files.is_empty() {
+            anyhow::bail!(
+                "worktree {} has uncommitted or untracked files ({}); neither it nor branch {name} was removed. Commit or discard them first.",
+                w.path.display(),
+                files_text(&w.dirty_files)
+            );
+        }
+    }
+    let mut removed_wt = None;
+    if let Some(path) = worktree {
+        a.remove_worktree(path).map_err(|err| {
+            anyhow::anyhow!(
+                "could not remove worktree {}: {err}. Branch {name} was kept.",
+                path.display()
+            )
+        })?;
+        removed_wt = Some(path.display().to_string());
+    }
+    a.delete_local_branch(name, tip)?;
+    if let Err(err) = state::append_jsonl(
+        &deleted_log_path(&e.paths),
+        &json!({
+            "branch": name,
+            "tip": tip,
+            "worktree_removed": removed_wt,
+            "restore": format!("git branch {name} {tip}"),
+            "at": chrono::Utc::now().to_rfc3339(),
+        }),
+    ) {
+        tracing::warn!(branch = name, tip, error = %err, "cleanup: deleted the branch but could not write .ta/cleanup/branches-deleted.jsonl; the tip is in the audit log");
+    }
+    Ok((
+        format!(
+            "deleted local branch {name} (tip {tip}){}; restore with `git branch {name} {tip}`",
+            removed_wt
+                .map(|p| format!(" and removed worktree {p}"))
+                .unwrap_or_default()
+        ),
+        0,
+    ))
+}
