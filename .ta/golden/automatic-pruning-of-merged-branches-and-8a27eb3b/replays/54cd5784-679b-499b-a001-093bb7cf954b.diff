+#[test]
+fn merged_squash_branch_is_deleted_and_logged_with_its_tip() {
+    let repo = Repo::new();
+    let tip = repo.branch_with_commit("feature/a", "a.txt");
+    repo.squash_merge("feature/a");
+    // git alone cannot tell: the tip is not an ancestor of main after a squash.
+    assert!(!git(&repo.work, &["branch", "--merged", "main"]).contains("feature/a"));
+    let t = repo.truth(&[("feature/a", "merged", Some(&tip))]);
+    let e = repo.engine(&t, Settings::default());
+
+    let r = run(&e, &only_branches(false), None).unwrap();
+
+    assert!(!repo.has_branch("feature/a"), "{:?}", r.failed);
+    let done = r
+        .done
+        .iter()
+        .find(|d| d.finding_id == "branch:feature/a")
+        .unwrap();
+    assert!(done.summary.contains(&tip), "{}", done.summary);
+    assert_eq!(done.decided_by, Decider::Rule);
+    let log = std::fs::read_to_string(crate::branches::deleted_log_path(&e.paths)).unwrap();
+    assert!(log.contains("feature/a") && log.contains(&tip), "{log}");
+    assert!(repo.has_branch("main"));
+    // Recoverable from the logged tip.
+    git(&repo.work, &["branch", "restored", &tip]);
