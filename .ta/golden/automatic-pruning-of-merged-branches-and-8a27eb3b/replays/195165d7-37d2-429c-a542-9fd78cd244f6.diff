+#[test]
+fn merged_squash_branch_is_deleted_and_logged_with_its_tip() {
+    let mut repo = Repo::new();
+    let tip = repo.branch("feature/squashed");
+    repo.squash_merge("feature/squashed");
+    repo.review("feature/squashed", "merged", Some(&tip));
+    // The squash really did rewrite history: git's own check says "not merged".
+    assert_eq!(
+        git(&repo.work, &["branch", "--merged", "main"])
+            .lines()
+            .filter(|l| l.contains("squashed"))
+            .count(),
+        0
+    );
+
+    let r = repo.run(false);
+    assert_eq!(
+        finding(&r, "branch:feature/squashed").verdict,
+        Verdict::AutoSafe
+    );
+    assert!(!repo.branches().contains(&"feature/squashed".to_string()));
+    assert!(repo.branches().contains(&"main".to_string()));
+    let done = r
+        .done
+        .iter()
+        .find(|d| d.finding_id == "branch:feature/squashed")
+        .unwrap();
+    assert!(done.summary.contains(&tip), "summary: {}", done.summary);
+    assert_eq!(done.decided_by, Decider::Rule);
+    let log = std::fs::read_to_string(
+        Paths::for_project(&repo.work)
+            .cleanup_dir()
+            .join("branch-deletions.jsonl"),
+    )
+    .unwrap();
+    assert!(
+        log.contains(&tip) && log.contains("feature/squashed"),
+        "log: {log}"
+    );
+    // Recoverable from the logged SHA.
+    git(&repo.work, &["branch", "recovered", &tip]);
+}
