+struct Repo {
+    _dir: tempfile::TempDir,
+    origin: PathBuf,
+    work: PathBuf,
+    wts: PathBuf,
+    reviews: HashMap<String, BranchReview>,
+}
+
+fn commit_file(dir: &Path, name: &str, body: &str) -> String {
+    std::fs::write(dir.join(name), body).unwrap();
+    git(dir, &["add", name]);
+    git(dir, &["commit", "-m", &format!("add {name}")]);
+    git(dir, &["rev-parse", "HEAD"])
+}
+
+impl Repo {
+    fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let origin = dir.path().join("origin.git");
+        let work = dir.path().join("work");
+        let wts = dir.path().join("worktrees");
+        std::fs::create_dir_all(&origin).unwrap();
+        std::fs::create_dir_all(&work).unwrap();
+        std::fs::create_dir_all(&wts).unwrap();
+        git(&origin, &["init", "--bare", "--initial-branch=main"]);
+        git(&work, &["init", "--initial-branch=main"]);
+        git(
+            &work,
+            &["remote", "add", "origin", &origin.to_string_lossy()],
+        );
+        commit_file(&work, "README.md", "base\n");
+        git(&work, &["push", "-u", "origin", "main"]);
+        git(&work, &["remote", "set-head", "origin", "main"]);
+        Repo {
+            _dir: dir,
+            origin,
+            work,
+            wts,
+            reviews: HashMap::new(),
+        }
+    }
+
+    /// A branch off main with one commit. Returns its tip.
+    fn branch(&self, name: &str) -> String {
+        git(&self.work, &["checkout", "-b", name, "main"]);
+        let file = format!("{}.txt", name.replace('/', "-"));
+        let tip = commit_file(&self.work, &file, name);
+        git(&self.work, &["checkout", "main"]);
+        tip
+    }
+
+    /// Squash-merge `name` into main, the way the host does: main gets a new commit
+    /// and the branch tip is NOT an ancestor of main.
+    fn squash_merge(&self, name: &str) {
+        git(&self.work, &["merge", "--squash", name]);
+        git(&self.work, &["commit", "-m", &format!("squash {name}")]);
+        git(&self.work, &["push", "origin", "main"]);
+    }
+
+    fn review(&mut self, branch: &str, state: &str, head: Option<&str>) {
+        self.reviews.insert(
+            branch.to_string(),
+            BranchReview {
+                state: state.into(),
+                head_sha: head.map(str::to_string),
+                review_ref: Some("#7".into()),
+            },
+        );
+    }
+
+    fn worktree(&self, branch: &str) -> PathBuf {
+        let p = self.wts.join(branch);
+        git(
+            &self.work,
+            &["worktree", "add", &p.to_string_lossy(), branch],
+        );
+        p
+    }
+
+    fn branches(&self) -> Vec<String> {
+        git(
+            &self.work,
+            &["for-each-ref", "--format=%(refname:short)", "refs/heads"],
+        )
+        .lines()
+        .map(str::to_string)
+        .collect()
+    }
+
+    fn run(&self, dry_run: bool) -> Report {
+        let t = Truth(FakeHost {
+            git: GitAdapter::new(&self.work),
+            reviews: self.reviews.clone(),
+        });
+        let e = Engine {
+            paths: Paths::for_project(&self.work),
+            settings: Settings::default(),
+            truth: &t,
+            closer: &FileCloser,
+            assistant: None,
+        };
+        run(
+            &e,
+            &RunOptions {
+                dry_run,
+                only: Some(vec![Category::Branches]),
+                ..Default::default()
+            },
+            None,
+        )
+        .unwrap()
+    }
+}
+
+fn finding<'a>(r: &'a Report, id: &str) -> &'a Finding {
+    r.findings.iter().find(|f| f.id == id).unwrap_or_else(|| {
+        panic!(
+            "no finding {id}: {:?}",
+            r.findings.iter().map(|f| &f.id).collect::<Vec<_>>()
+        )
+    })
+}
