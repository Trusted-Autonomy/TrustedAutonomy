+++ b/crates/ta-cleanup/src/branches.rs
+//! The `branches` group: prune finished local branches and their worktrees.
+//!
+//! Ground truth is the PR state the VCS adapter reports for the branch, never
+//! `git branch -d` or `git cherry` (a squash merge rewrites patch ids, so a
+//! finished branch looks unmerged to both). A local branch is safe to delete when
+//!
+//! - its PR is merged and the branch has no commits beyond the PR head, or
+//! - its tip is already contained in the default branch.
+//!
+//! Everything else is kept: an open PR is left alone, and a branch with no PR,
+//! a closed PR or commits beyond the PR head becomes a question. The current
+//! branch, the default and protected branches, and a branch checked out in the
+//! main working tree are never touched. A linked worktree is removed together
+//! with its finished branch, but only when it has no uncommitted or untracked
+//! files; otherwise the file list goes to a human.
+//!
+//! Remote branches are never deleted (the host's delete-on-merge setting owns
+//! that). A remote branch whose PR was closed unmerged is reported only.
+
+use std::path::Path;
+
+use serde_json::json;
+use ta_submit::{BranchReview, LocalBranch, SourceAdapter};
+
+use crate::model::*;
+use crate::scan::mk;
+use crate::state;
+
+/// Most remote branches whose PR state is looked up in one run, so a repository
+/// with hundreds of stale remotes cannot turn one cleanup into hundreds of API calls.
+const MAX_REMOTE_LOOKUPS: usize = 30;
+
+/// How many dirty file names go into evidence before the rest are counted.
+const MAX_FILES_LISTED: usize = 20;
+
+fn short_sha(sha: &str) -> &str {
+    sha.get(..8).unwrap_or(sha)
+}
+
+pub fn scan_branches(e: &Engine, out: &mut Vec<Finding>) {
+    let Some(a) = e.truth.branch_adapter() else {
+        return;
+    };
+    let default = a.default_branch().ok().flatten();
+    let protected = a.protected_submit_targets();
+    match a.list_local_branches() {
+        Ok(list) => {
+            for b in &list {
+                out.push(judge_local(a, b, default.as_deref(), &protected));
+            }
+        }
+        Err(err) => {
+            tracing::warn!(error = %err, "cleanup: could not list local branches; branch pruning skipped");
+        }
+    }
+    remote_findings(a, default.as_deref(), &protected, out);
+}
+
+fn evidence_for(b: &LocalBranch) -> Vec<Evidence> {
+    let mut ev = vec![Evidence::new(
+        "git",
+        format!("branch {} at {}", b.name, b.tip),
+    )];
+    if let Some(wt) = &b.worktree {
+        ev.push(Evidence::new(
+            "git",
+            format!("checked out in worktree {}", wt.display()),
+        ));
+    }
+    ev
+}
+
+fn skip(b: &LocalBranch, mut ev: Vec<Evidence>, reason: impl Into<String>) -> Finding {
+    if ev.is_empty() {
+        ev = evidence_for(b);
+    }
+    mk(
+        Kind::LocalBranch,
+        format!("branch:{}", b.name),
+        format!("Branch {}", b.name),
+        ev,
+        Verdict::Skip,
+        reason,
+        Action::None,
+        &[("branch", b.name.clone()), ("tip", b.tip.clone())],
+    )
+}
+
+/// A question with a "keep" answer, and a "delete" answer when `deletable`.
+fn ask(
+    b: &LocalBranch,
+    ev: Vec<Evidence>,
+    reason: impl Into<String>,
+    deletable: bool,
+    facts: &[(&str, String)],
+) -> Finding {
+    let mut f = mk(
+        Kind::LocalBranch,
+        format!("branch:{}", b.name),
+        format!("Branch {}", b.name),
+        ev,
+        Verdict::Ask,
+        reason,
+        Action::None,
+        facts,
+    );
+    f.options.push(AnswerOption {
+        key: "keep".into(),
+        label: format!("Keep branch {}", b.name),
+        action: Action::None,
+    });
+    if deletable {
+        f.options.push(AnswerOption {
+            key: "delete".into(),
+            label: format!(
+                "Delete branch {} (recreate with: git branch {} {})",
+                b.name, b.name, b.tip
+            ),
+            action: Action::DeleteBranch {
+                branch: b.name.clone(),
+                tip: b.tip.clone(),
+                worktree: None,
+            },
+        });
+        f.manual_command = Some(format!("git branch -D {}   # tip {}", b.name, b.tip));
+    }
+    f.recommended = Some("keep".into());
+    f
+}
+
+fn judge_local(
+    a: &dyn SourceAdapter,
+    b: &LocalBranch,
+    default: Option<&str>,
+    protected: &[String],
+) -> Finding {
+    if b.is_current {
+        return skip(b, vec![], "current branch; cleanup never touches it");
+    }
+    if default == Some(b.name.as_str()) || protected.iter().any(|p| p == &b.name) {
+        return skip(b, vec![], "default or protected branch; never deleted");
+    }
+    if b.worktree_is_main {
+        return skip(
+            b,
+            vec![],
+            "checked out in the main working tree; never touched",
+        );
+    }
+
+    let mut ev = evidence_for(b);
+    let facts = |extra: &str| -> Vec<(&str, String)> {
+        vec![
+            ("branch", b.name.clone()),
+            ("tip", b.tip.clone()),
+            ("why", extra.to_string()),
+        ]
+    };
+
+    // Decide whether the branch is finished, and why.
+    let done_because: String = match a.merged_into_default(&b.tip) {
+        Ok(Some(true)) => {
+            ev.push(Evidence::new(
+                "git",
+                format!(
+                    "tip {} is already contained in {}",
+                    short_sha(&b.tip),
+                    default.unwrap_or("the default branch")
+                ),
+            ));
+            "tip is an ancestor of the default branch".to_string()
+        }
+        _ => match a.branch_review(&b.name) {
+            Ok(Some(r)) => match review_verdict(a, b, &r, &mut ev) {
+                ReviewVerdict::Done(why) => why,
+                ReviewVerdict::Keep(reason) => return skip(b, ev, reason),
+                ReviewVerdict::Question(reason, tag) => {
+                    // A branch held by a linked worktree is never offered for deletion.
+                    return ask(b, ev, reason, b.worktree.is_none(), &facts(&tag));
+                }
+            },
+            Ok(None) => {
+                return skip(
+                    b,
+                    ev,
+                    "the VCS adapter cannot report PR state for this branch (no hosting CLI or offline); kept",
+                )
+            }
+            Err(err) => {
+                return skip(
+                    b,
+                    ev,
+                    format!("PR lookup failed ({err}); kept. Re-run `ta cleanup` when the VCS is reachable"),
+                )
+            }
+        },
+    };
+
+    // Finished. A worktree goes with it, but only when it is clean.
+    let Some(wt) = &b.worktree else {
+        return finished(b, ev, done_because, None);
+    };
+    match a.worktree_dirty_files(wt) {
+        Ok(files) if files.is_empty() => finished(b, ev, done_because, Some(wt.clone())),
+        Ok(files) => {
+            let mut shown: Vec<String> = files.iter().take(MAX_FILES_LISTED).cloned().collect();
+            if files.len() > MAX_FILES_LISTED {
+                shown.push(format!("... and {} more", files.len() - MAX_FILES_LISTED));
+            }
+            ev.push(Evidence::new(
+                "git",
+                format!(
+                    "worktree {} has {} uncommitted or untracked file(s): {}",
+                    wt.display(),
+                    files.len(),
+                    shown.join(", ")
+                ),
+            ));
+            let mut f = ask(
+                b,
+                ev,
+                format!(
+                    "branch is finished ({done_because}) but its worktree {} has uncommitted or untracked files; commit, move or discard them, then re-run `ta cleanup`",
+                    wt.display()
+                ),
+                false,
+                &[
+                    ("branch", b.name.clone()),
+                    ("tip", b.tip.clone()),
+                    ("dirty", files.join("\n")),
+                ],
+            );
+            f.manual_command = Some(format!("git -C {} status", wt.display()));
+            f
+        }
+        Err(err) => ask(
+            b,
+            ev,
+            format!(
+                "branch is finished ({done_because}) but worktree {} could not be checked ({err}); kept",
+                wt.display()
+            ),
+            false,
+            &facts("worktree-unreadable"),
+        ),
+    }
+}
+
+fn finished(
+    b: &LocalBranch,
+    ev: Vec<Evidence>,
+    why: String,
+    worktree: Option<std::path::PathBuf>,
+) -> Finding {
+    let with_wt = worktree
+        .as_ref()
+        .map(|w| format!(" and remove clean worktree {}", w.display()))
+        .unwrap_or_default();
+    let mut f = mk(
+        Kind::LocalBranch,
+        format!("branch:{}", b.name),
+        format!("Branch {}", b.name),
+        ev,
+        Verdict::AutoSafe,
+        format!(
+            "finished ({why}); delete the local branch{with_wt}. Tip {} is logged so it can be recreated",
+            b.tip
+        ),
+        Action::DeleteBranch {
+            branch: b.name.clone(),
+            tip: b.tip.clone(),
+            worktree,
+        },
+        &[("branch", b.name.clone()), ("tip", b.tip.clone())],
+    );
+    f.manual_command = Some(format!("git branch -D {}   # tip {}", b.name, b.tip));
+    f
+}
+
+enum ReviewVerdict {
+    Done(String),
+    Keep(String),
+    /// Reason and a short tag folded into the signature.
+    Question(String, String),
+}
+
+fn review_verdict(
+    a: &dyn SourceAdapter,
+    b: &LocalBranch,
+    r: &BranchReview,
+    ev: &mut Vec<Evidence>,
+) -> ReviewVerdict {
+    let pr = r.review_ref.clone().unwrap_or_else(|| "no PR".into());
+    ev.push(Evidence::new(
+        "vcs",
+        format!("PR state for {}: {} ({pr})", b.name, r.state),
+    ));
+    match r.state.as_str() {
+        "merged" => {
+            let Some(head) = r.head_sha.as_deref() else {
+                return ReviewVerdict::Question(
+                    format!("PR {pr} is merged but the adapter did not report its head commit, so \"no commits beyond the PR head\" cannot be checked"),
+                    "merged-head-unknown".into(),
+                );
+            };
+            ev.push(Evidence::new("vcs", format!("PR head {head}")));
+            if head == b.tip {
+                return ReviewVerdict::Done(format!("PR {pr} merged and the tip is the PR head"));
+            }
+            match a.is_ancestor(&b.tip, head) {
+                Ok(Some(true)) => ReviewVerdict::Done(format!(
+                    "PR {pr} merged and the tip is contained in the PR head"
+                )),
+                Ok(Some(false)) => ReviewVerdict::Question(
+                    format!("PR {pr} is merged but the branch has commits beyond the PR head ({}); they exist nowhere else", short_sha(head)),
+                    "commits-beyond-head".into(),
+                ),
+                _ => ReviewVerdict::Question(
+                    format!("PR {pr} is merged but its head commit {} is not available locally, so \"no commits beyond the PR head\" cannot be checked; fetch and re-run", short_sha(head)),
+                    "head-not-local".into(),
+                ),
+            }
+        }
+        "open" | "draft" => ReviewVerdict::Keep(format!("PR {pr} is still open; kept")),
+        "closed" => ReviewVerdict::Question(
+            format!("PR {pr} was closed without merging; the work may be abandoned or may still be wanted"),
+            "closed-unmerged".into(),
+        ),
+        "none" => ReviewVerdict::Question(
+            "no PR exists for this branch and it is not in the default branch; it may be unpushed work".into(),
+            "no-pr".into(),
+        ),
+        other => ReviewVerdict::Keep(format!("unrecognised PR state '{other}'; kept")),
+    }
+}
+
+fn remote_findings(
+    a: &dyn SourceAdapter,
+    default: Option<&str>,
+    protected: &[String],
+    out: &mut Vec<Finding>,
+) {
+    let Ok(remotes) = a.list_remote_branches() else {
+        return;
+    };
+    let mut lookups = 0usize;
+    for rb in remotes {
+        if default == Some(rb.name.as_str()) || protected.iter().any(|p| p == &rb.name) {
+            continue;
+        }
+        if matches!(a.merged_into_default(&rb.tip), Ok(Some(true))) {
+            continue;
+        }
+        if lookups >= MAX_REMOTE_LOOKUPS {
+            tracing::info!(
+                limit = MAX_REMOTE_LOOKUPS,
+                "cleanup: remote branch PR lookups capped for this run; the rest are checked next time"
+            );
+            break;
+        }
+        lookups += 1;
+        let Ok(Some(r)) = a.branch_review(&rb.name) else {
+            continue;
+        };
+        if r.state != "closed" {
+            continue;
+        }
+        let full = format!("{}/{}", rb.remote, rb.name);
+        out.push(mk(
+            Kind::RemoteBranch,
+            format!("remote_branch:{full}"),
+            format!("Remote branch {full}"),
+            vec![
+                Evidence::new("git", format!("{full} at {}", rb.tip)),
+                Evidence::new(
+                    "vcs",
+                    format!(
+                        "PR {} was closed without merging",
+                        r.review_ref.as_deref().unwrap_or("?")
+                    ),
+                ),
+            ],
+            Verdict::Skip,
+            format!(
+                "report only: PR closed unmerged. Cleanup never deletes remote branches; if it is abandoned run `git push {} --delete {}`",
+                rb.remote, rb.name
+            ),
+            Action::None,
+            &[("remote_branch", full.clone()), ("tip", rb.tip.clone())],
+        ));
+    }
+}
+
+/// Execute `Action::DeleteBranch`: clean worktree first, then the branch, then log.
+pub fn delete_branch(
+    e: &Engine,
+    branch: &str,
+    tip: &str,
+    worktree: Option<&Path>,
+) -> anyhow::Result<(String, u64)> {
+    let a = e.truth.branch_adapter().ok_or_else(|| {
+        anyhow::anyhow!(
+            "no VCS adapter is available to delete branch '{branch}'. Delete it yourself: git branch -D {branch}   # tip {tip}"
+        )
+    })?;
+    if let Some(wt) = worktree {
+        let dirty = a.worktree_dirty_files(wt)?;
+        if !dirty.is_empty() {
+            anyhow::bail!(
+                "worktree {} now has {} uncommitted or untracked file(s) ({}); not removing it or branch '{branch}'",
+                wt.display(),
+                dirty.len(),
+                dirty.iter().take(5).cloned().collect::<Vec<_>>().join(", ")
+            );
+        }
+        a.remove_worktree(wt).map_err(|err| {
+            anyhow::anyhow!(
+                "could not remove worktree {}: {err}. Branch '{branch}' was kept.",
+                wt.display()
+            )
+        })?;
+    }
+    a.delete_local_branch(branch, tip)
+        .map_err(|err| anyhow::anyhow!("could not delete branch '{branch}' (tip {tip}): {err}"))?;
+    let recover = format!("git branch {branch} {tip}");
+    if let Err(err) = state::append_jsonl(
+        &e.paths.cleanup_dir().join("branch-deletions.jsonl"),
+        &json!({
+            "branch": branch,
+            "tip": tip,
+            "worktree": worktree.map(|w| w.display().to_string()),
+            "recover": recover,
+            "at": chrono::Utc::now().to_rfc3339(),
+        }),
+    ) {
+        tracing::warn!(branch, tip, error = %err, "cleanup: could not write branch-deletions.jsonl; the audit log still has the tip");
+    }
+    tracing::info!(branch, tip, "cleanup: deleted finished local branch");
+    let wt = worktree
+        .map(|w| format!(", removed worktree {}", w.display()))
+        .unwrap_or_default();
+    Ok((
+        format!("deleted local branch {branch} (tip {tip}){wt}; recover with: {recover}"),
+        0,
+    ))
+}
