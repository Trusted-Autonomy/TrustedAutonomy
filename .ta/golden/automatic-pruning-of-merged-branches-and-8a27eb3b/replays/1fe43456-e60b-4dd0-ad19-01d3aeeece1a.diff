+//! The `branches` group: local branches (and their linked worktrees) whose work is finished.
+//!
+//! Ground truth is the PR state the VCS adapter reports for the review a draft recorded
+//! (`vcs_status.review_id`), never `git branch -d` or `git cherry`: a squash merge rewrites
+//! patch ids, so a finished branch looks unmerged to both. A branch is safe to delete when
+//!
+//! - its PR is merged and the branch has no commits beyond the head recorded for that PR, or
+//! - its tip is an ancestor of the default branch.
+//!
+//! Everything else is kept or put to a person. The current branch, the default branch and any
+//! branch whose worktree has uncommitted or untracked files are never deleted by a rule.
+//! Remote branches are never deleted; a remote branch whose PR was closed unmerged is only
+//! reported.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use serde_json::json;
+
+use crate::model::*;
+use crate::scan::{mk, Scan};
+
+/// Names that are never pruned whatever the VCS says.
+const ALWAYS_KEEP: [&str; 2] = ["main", "master"];
+/// Files listed in a question before the list is cut off with a count.
+const MAX_LISTED_FILES: usize = 20;
+
+/// A git command that acts on the repository at `dir` and nothing else: inherited `GIT_DIR`,
+/// `GIT_WORK_TREE` or `GIT_INDEX_FILE` (set by some shells and hooks) would point it elsewhere.
+fn cmd(dir: &Path) -> Command {
+    let mut c = Command::new("git");
+    c.current_dir(dir)
+        .env("GIT_TERMINAL_PROMPT", "0")
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .env_remove("GIT_INDEX_FILE");
+    c
+}
+
+/// Run git in `dir`; stdout (trimmed) on success, `None` on any failure.
+fn git(dir: &Path, args: &[&str]) -> Option<String> {
+    let out = cmd(dir).args(args).output().ok()?;
+    out.status
+        .success()
+        .then(|| String::from_utf8_lossy(&out.stdout).trim().to_string())
+}
+
+/// Like [`git`] but keeps stderr, for actions whose failure the user must be able to read.
+fn git_checked(dir: &Path, args: &[&str]) -> anyhow::Result<String> {
+    let out = cmd(dir).args(args).output().map_err(|e| {
+        anyhow::anyhow!(
+            "could not run `git {}`: {e}. Is git installed?",
+            args.join(" ")
+        )
+    })?;
+    if out.status.success() {
+        Ok(String::from_utf8_lossy(&out.stdout).trim().to_string())
+    } else {
+        anyhow::bail!(
+            "`git {}` failed in {}: {}",
+            args.join(" "),
+            dir.display(),
+            String::from_utf8_lossy(&out.stderr).trim()
+        )
+    }
+}
+
+fn is_ancestor(dir: &Path, maybe_ancestor: &str, of: &str) -> bool {
+    cmd(dir)
+        .args(["merge-base", "--is-ancestor", maybe_ancestor, of])
+        .output()
+        .map(|o| o.status.success())
+        .unwrap_or(false)
+}
+
+fn same_path(a: &Path, b: &Path) -> bool {
+    match (std::fs::canonicalize(a), std::fs::canonicalize(b)) {
+        (Ok(x), Ok(y)) => x == y,
+        _ => a == b,
+    }
+}
+
+#[derive(Debug, Clone)]
+struct Worktree {
+    path: PathBuf,
+    branch: Option<String>,
+    locked: bool,
+}
+
+/// Linked worktrees plus the main one (first), parsed from `git worktree list --porcelain`.
+fn worktrees(root: &Path) -> Vec<Worktree> {
+    let Some(text) = git(root, &["worktree", "list", "--porcelain"]) else {
+        return Vec::new();
+    };
+    let mut out: Vec<Worktree> = Vec::new();
+    for line in text.lines() {
+        if let Some(p) = line.strip_prefix("worktree ") {
+            out.push(Worktree {
+                path: PathBuf::from(p),
+                branch: None,
+                locked: false,
+            });
+        } else if let Some(b) = line.strip_prefix("branch refs/heads/") {
+            if let Some(w) = out.last_mut() {
+                w.branch = Some(b.to_string());
+            }
+        } else if line == "locked" || line.starts_with("locked ") {
+            if let Some(w) = out.last_mut() {
+                w.locked = true;
+            }
+        }
+    }
+    out
+}
+
+/// Uncommitted and untracked files in a worktree (ignored files are not counted).
+fn dirty_files(dir: &Path) -> Vec<String> {
+    git(dir, &["status", "--porcelain", "--untracked-files=all"])
+        .map(|t| t.lines().map(|l| l.trim_end().to_string()).collect())
+        .unwrap_or_default()
+}
+
+/// Default branch name: what `origin/HEAD` points at, else `main`/`master` if one exists.
+fn default_branch(root: &Path) -> Option<String> {
+    if let Some(r) = git(
+        root,
+        &["symbolic-ref", "--short", "-q", "refs/remotes/origin/HEAD"],
+    ) {
+        if let Some(n) = r.strip_prefix("origin/") {
+            return Some(n.to_string());
+        }
+    }
+    ALWAYS_KEEP
+        .iter()
+        .find(|n| {
+            git(
+                root,
+                &["rev-parse", "--verify", "-q", &format!("refs/heads/{n}")],
+            )
+            .is_some()
+        })
+        .map(|n| n.to_string())
+}
+
+/// Draft records that tie a branch to a PR.
+struct PrLink {
+    review_ref: String,
+    head: Option<String>,
+}
+
+fn links_by_branch(s: &Scan) -> HashMap<String, Vec<PrLink>> {
+    let mut m: HashMap<String, Vec<PrLink>> = HashMap::new();
+    for pkg in &s.drafts {
+        let Some(v) = &pkg.vcs_status else { continue };
+        let Some(r) = crate::scan::review_ref(pkg) else {
+            continue;
+        };
+        m.entry(v.branch.clone()).or_default().push(PrLink {
+            review_ref: r,
+            head: v.commit_sha.clone(),
+        });
+    }
+    m
+}
+
+fn pr_label(r: &str) -> String {
+    if r.chars().all(|c| c.is_ascii_digit()) {
+        format!("PR #{r}")
+    } else {
+        r.to_string()
+    }
+}
+
+pub(crate) fn scan_branches(s: &Scan, out: &mut Vec<Finding>) {
+    if !s.e.settings.branches {
+        return;
+    }
+    let root = &s.e.paths.root;
+    // Only a repository rooted exactly here: never act on a parent repository.
+    let Some(top) = git(root, &["rev-parse", "--show-toplevel"]) else {
+        return;
+    };
+    if !same_path(Path::new(&top), root) {
+        return;
+    }
+    let Some(listing) = git(
+        root,
+        &[
+            "for-each-ref",
+            "--format=%(refname:short)\t%(objectname)",
+            "refs/heads",
+        ],
+    ) else {
+        return;
+    };
+    let default = default_branch(root);
+    let current = git(root, &["symbolic-ref", "--short", "-q", "HEAD"]);
+    let trees = worktrees(root);
+    // First entry is the main worktree; its branch can never be removed from under it.
+    let main_branch = trees.first().and_then(|w| w.branch.clone());
+    let links = links_by_branch(s);
+    let default_tips: Vec<String> = default
+        .iter()
+        .flat_map(|d| {
+            [
+                format!("refs/heads/{d}"),
+                format!("refs/remotes/origin/{d}"),
+            ]
+        })
+        .filter_map(|r| git(root, &["rev-parse", "--verify", "-q", &r]))
+        .collect();
+
+    for line in listing.lines() {
+        let Some((name, tip)) = line.split_once('\t') else {
+            continue;
+        };
+        if default.as_deref() == Some(name) || ALWAYS_KEEP.contains(&name) {
+            continue;
+        }
+        let id = format!("branch:{name}");
+        let title = format!("Branch {name} (tip {})", &tip[..tip.len().min(8)]);
+        let mut evidence = vec![Evidence::new("git", format!("{name} is at {tip}"))];
+
+        if current.as_deref() == Some(name) || main_branch.as_deref() == Some(name) {
+            evidence.push(Evidence::new("git", "checked out in the main working tree"));
+            out.push(mk(
+                Kind::Branch,
+                id,
+                title,
+                evidence,
+                Verdict::Skip,
+                "this is the branch checked out here; it is never deleted by cleanup",
+                Action::None,
+                &[("tip", tip.into()), ("why", "current".into())],
+            ));
+            continue;
+        }
+
+        // Where is it checked out, and is that place clean?
+        let wt = trees
+            .iter()
+            .skip(1)
+            .find(|w| w.branch.as_deref() == Some(name))
+            .cloned();
+        let dirty = wt
+            .as_ref()
+            .filter(|w| w.path.exists())
+            .map(|w| dirty_files(&w.path))
+            .unwrap_or_default();
+        if let Some(w) = &wt {
+            evidence.push(Evidence::new(
+                "git",
+                format!("checked out in worktree {}", w.path.display()),
+            ));
+        }
+
+        // What does the VCS say about the PRs this branch was submitted as?
+        let mut merged: Vec<String> = Vec::new();
+        let mut merged_heads: Vec<String> = Vec::new();
+        let mut open: Vec<String> = Vec::new();
+        let mut closed: Vec<String> = Vec::new();
+        let mut unknown: Vec<String> = Vec::new();
+        for l in links.get(name).map(Vec::as_slice).unwrap_or_default() {
+            let label = pr_label(&l.review_ref);
+            match s.probe(&l.review_ref) {
+                ReviewState::Merged => {
+                    evidence.push(Evidence::new("vcs", format!("{label} is merged")));
+                    merged.push(label);
+                    if let Some(h) = &l.head {
+                        merged_heads.push(h.clone());
+                    }
+                }
+                ReviewState::Open => {
+                    evidence.push(Evidence::new("vcs", format!("{label} is open")));
+                    open.push(label);
+                }
+                ReviewState::Closed => {
+                    evidence.push(Evidence::new("vcs", format!("{label} was closed unmerged")));
+                    closed.push(label);
+                }
+                ReviewState::Unknown(why) => {
+                    evidence.push(Evidence::new(
+                        "vcs",
+                        format!("{label} state unknown: {why}"),
+                    ));
+                    unknown.push(label);
+                }
+            }
+        }
+        let tip_in_default = default_tips.iter().any(|d| is_ancestor(root, tip, d));
+        if tip_in_default {
+            evidence.push(Evidence::new(
+                "git",
+                format!(
+                    "tip is an ancestor of {}",
+                    default.as_deref().unwrap_or("the default branch")
+                ),
+            ));
+        }
+        let at_default_tip = default_tips.iter().any(|d| d == tip);
+
+        enum Call {
+            Safe(String),
+            Keep(String),
+            Ask(String),
+        }
+        let call = if !open.is_empty() {
+            Call::Keep(format!(
+                "{} is still open, so the branch is in use and is kept",
+                open.join(", ")
+            ))
+        } else if tip_in_default && wt.is_some() && at_default_tip && merged.is_empty() {
+            Call::Keep(
+                "a branch sitting exactly on the default branch with a worktree looks like work that has not started; kept"
+                    .into(),
+            )
+        } else if tip_in_default {
+            Call::Safe("every commit on the branch is already in the default branch".into())
+        } else if !merged.is_empty() {
+            let no_extra = merged_heads.iter().any(|h| {
+                git(
+                    root,
+                    &["rev-parse", "--verify", "-q", &format!("{h}^{{commit}}")],
+                )
+                .is_some()
+                    && is_ancestor(root, tip, h)
+            });
+            if no_extra {
+                Call::Safe(format!(
+                    "{} is merged and the branch has no commits beyond the PR head",
+                    merged.join(", ")
+                ))
+            } else if merged_heads.is_empty() {
+                Call::Ask(
+                    format!(
+                        "{} is merged but no PR head commit was recorded, so I cannot tell whether the branch has newer commits",
+                        merged.join(", ")
+                    ),
+                )
+            } else {
+                Call::Ask(format!(
+                    "{} is merged but the branch has commits beyond the PR head",
+                    merged.join(", ")
+                ))
+            }
+        } else if !closed.is_empty() {
+            Call::Ask(format!(
+                "{} was closed without merging; the branch may hold work that never landed",
+                closed.join(", ")
+            ))
+        } else if !unknown.is_empty() {
+            Call::Keep(format!(
+                "the state of {} could not be read, so the branch is kept (check the VCS adapter or network and re-run)",
+                unknown.join(", ")
+            ))
+        } else {
+            Call::Ask(
+                "no PR is recorded for this branch and it is not merged into the default branch"
+                    .into(),
+            )
+        };
+
+        let facts = |why: &str| -> Vec<(&str, String)> {
+            vec![
+                ("tip", tip.to_string()),
+                ("why", why.to_string()),
+                ("dirty", dirty.len().to_string()),
+            ]
+        };
+        let manual = match &wt {
+            Some(w) => format!(
+                "git worktree remove \"{}\" && git branch -D {name}",
+                w.path.display()
+            ),
+            None => format!("git branch -D {name}"),
+        };
+        let prune = |reason: &str| Action::PruneBranch {
+            branch: name.to_string(),
+            tip: tip.to_string(),
+            worktree: wt.as_ref().map(|w| w.path.clone()),
+            reason: reason.to_string(),
+        };
+
+        match call {
+            Call::Keep(reason) => {
+                out.push(mk(
+                    Kind::Branch,
+                    id,
+                    title,
+                    evidence,
+                    Verdict::Skip,
+                    reason,
+                    Action::None,
+                    &facts("keep"),
+                ));
+            }
+            Call::Safe(reason) | Call::Ask(reason) if !dirty.is_empty() => {
+                let mut shown: Vec<String> = dirty.iter().take(MAX_LISTED_FILES).cloned().collect();
+                if dirty.len() > MAX_LISTED_FILES {
+                    shown.push(format!("... and {} more", dirty.len() - MAX_LISTED_FILES));
+                }
+                evidence.push(Evidence::new(
+                    "git",
+                    format!(
+                        "worktree has {} uncommitted or untracked file(s): {}",
+                        dirty.len(),
+                        shown.join("; ")
+                    ),
+                ));
+                let mut f = mk(
+                    Kind::Branch,
+                    id,
+                    title,
+                    evidence,
+                    Verdict::Ask,
+                    format!(
+                        "{reason}, but its worktree has uncommitted or untracked files, so nothing is removed"
+                    ),
+                    Action::None,
+                    &facts("dirty"),
+                );
+                f.options = vec![AnswerOption {
+                    key: "keep".into(),
+                    label: "keep the branch and worktree (commit, stash or discard the files yourself first)".into(),
+                    action: Action::None,
+                }];
+                f.recommended = Some("keep".into());
+                out.push(f);
+            }
+            Call::Safe(reason) => {
+                let mut f = mk(
+                    Kind::Branch,
+                    id,
+                    title,
+                    evidence,
+                    Verdict::AutoSafe,
+                    reason.clone(),
+                    prune(&reason),
+                    &facts("safe"),
+                );
+                f.manual_command = Some(manual);
+                out.push(f);
+            }
+            Call::Ask(reason) => {
+                let mut f = mk(
+                    Kind::Branch,
+                    id,
+                    title,
+                    evidence,
+                    Verdict::Ask,
+                    reason.clone(),
+                    Action::None,
+                    &facts("ask"),
+                );
+                f.options = vec![
+                    AnswerOption {
+                        key: "keep".into(),
+                        label: "keep the branch".into(),
+                        action: Action::None,
+                    },
+                    AnswerOption {
+                        key: "delete".into(),
+                        label: format!(
+                            "delete the branch (its tip {} is logged so it can be recreated)",
+                            short_sha(tip)
+                        ),
+                        action: prune(&format!("deleted on request: {reason}")),
+                    },
+                ];
+                f.recommended = Some("keep".into());
+                f.manual_command = Some(manual);
+                out.push(f);
+            }
+        }
+    }
+
+    remote_findings(s, &links, out);
+}
+
+fn short_sha(sha: &str) -> &str {
+    &sha[..sha.len().min(8)]
+}
+
+/// Remote branches whose PR was closed unmerged: reported, never deleted.
+fn remote_findings(s: &Scan, links: &HashMap<String, Vec<PrLink>>, out: &mut Vec<Finding>) {
+    let root = &s.e.paths.root;
+    let Some(listing) = git(
+        root,
+        &[
+            "for-each-ref",
+            "--format=%(refname:short)\t%(objectname)",
+            "refs/remotes/origin",
+        ],
+    ) else {
+        return;
+    };
+    for line in listing.lines() {
+        let Some((full, tip)) = line.split_once('\t') else {
+            continue;
+        };
+        let Some(name) = full.strip_prefix("origin/") else {
+            continue;
+        };
+        if name == "HEAD" || ALWAYS_KEEP.contains(&name) {
+            continue;
+        }
+        let Some(ls) = links.get(name) else { continue };
+        let states: Vec<(String, ReviewState)> = ls
+            .iter()
+            .map(|l| (pr_label(&l.review_ref), s.probe(&l.review_ref)))
+            .collect();
+        let closed: Vec<&str> = states
+            .iter()
+            .filter(|(_, st)| *st == ReviewState::Closed)
+            .map(|(l, _)| l.as_str())
+            .collect();
+        // Any merged or open PR on the same branch name means it is not abandoned.
+        let others = states
+            .iter()
+            .any(|(_, st)| matches!(st, ReviewState::Merged | ReviewState::Open));
+        if closed.is_empty() || others {
+            continue;
+        }
+        let mut f = mk(
+            Kind::RemoteBranch,
+            format!("remote-branch:{name}"),
+            format!("Remote branch origin/{name} (tip {})", short_sha(tip)),
+            vec![
+                Evidence::new("git", format!("origin/{name} is at {tip}")),
+                Evidence::new("vcs", format!("{} was closed unmerged", closed.join(", "))),
+            ],
+            Verdict::Ask,
+            "its PR was closed without merging. Cleanup never deletes remote branches; this is a report only",
+            Action::None,
+            &[("tip", tip.to_string())],
+        );
+        f.options = vec![AnswerOption {
+            key: "keep".into(),
+            label: "leave it (delete it yourself if the work is abandoned)".into(),
+            action: Action::None,
+        }];
+        f.recommended = Some("keep".into());
+        f.manual_command = Some(format!("git push origin --delete {name}"));
+        out.push(f);
+    }
+}
+
+/// Execute [`Action::PruneBranch`]: remove the worktree (never forced), then the branch, and
+/// log both with the tip SHA.
+pub(crate) fn prune(
+    root: &Path,
+    branch: &str,
+    tip: &str,
+    worktree: Option<&Path>,
+    reason: &str,
+    log_dir: &Path,
+) -> anyhow::Result<String> {
+    let reference = format!("refs/heads/{branch}");
+    let now = git(root, &["rev-parse", "--verify", "-q", &reference])
