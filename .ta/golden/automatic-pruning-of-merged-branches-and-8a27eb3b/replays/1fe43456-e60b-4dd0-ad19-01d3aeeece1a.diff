+    }
+    Ok(format!(
+        "deleted branch {branch} (tip {tip}){}; recover with `git branch {branch} {tip}`",
+        removed_wt
+            .map(|w| format!(", removed worktree {w}"))
+            .unwrap_or_default()
+    ))
+}
