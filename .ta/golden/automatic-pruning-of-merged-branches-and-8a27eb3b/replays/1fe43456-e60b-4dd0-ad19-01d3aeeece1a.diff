+//! The `branches` group, against real local repositories (project repo + bare origin) in
+//! temp dirs. PR state is faked through `GroundTruth`, the trait the engine already uses.
+
+use std::path::Path;
+use std::process::Command;
+
+use super::*;
+
+/// Run git with a fixed identity and no signing so the host's git config cannot interfere.
+fn git(dir: &Path, args: &[&str]) -> String {
+    let out = Command::new("git")
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .env_remove("GIT_INDEX_FILE")
+        .args(["-c", "user.name=Test", "-c", "user.email=test@example.com"])
+        .args(["-c", "commit.gpgsign=false", "-c", "core.autocrlf=false"])
+        .args(args)
+        .current_dir(dir)
+        .output()
+        .expect("git runs");
+    assert!(
+        out.status.success(),
+        "git {args:?} in {}: {}",
+        dir.display(),
+        String::from_utf8_lossy(&out.stderr)
+    );
+    String::from_utf8_lossy(&out.stdout).trim().to_string()
+}
+
+fn branch_exists(dir: &Path, name: &str) -> bool {
+    Command::new("git")
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .args(["rev-parse", "--verify", "-q", &format!("refs/heads/{name}")])
+        .current_dir(dir)
+        .output()
+        .unwrap()
+        .status
+        .success()
+}
+
+struct Repo {
+    fx: Fx,
+    origin: tempfile::TempDir,
+    scratch: tempfile::TempDir,
+}
+
+impl Repo {
+    fn new() -> Self {
+        let fx = Fx::new();
+        let origin = tempfile::tempdir().unwrap();
+        let scratch = tempfile::tempdir().unwrap();
+        git(origin.path(), &["init", "--bare", "-b", "main"]);
+        let root = fx.root().to_path_buf();
+        git(&root, &["init", "-b", "main"]);
+        std::fs::write(root.join("a.txt"), "base\n").unwrap();
+        // .ta/ holds cleanup's own state, never project content.
+        std::fs::write(root.join(".git/info/exclude"), ".ta/\n").unwrap();
+        git(&root, &["add", "a.txt"]);
+        git(&root, &["commit", "-m", "base"]);
+        git(
+            &root,
+            &["remote", "add", "origin", &origin.path().to_string_lossy()],
+        );
+        git(&root, &["push", "-u", "origin", "main"]);
+        git(&root, &["remote", "set-head", "origin", "main"]);
+        Repo {
+            fx,
+            origin,
+            scratch,
+        }
+    }
+
+    fn root(&self) -> &Path {
+        self.fx.root()
+    }
+
+    /// New branch with one commit; back on main afterwards. Returns the tip.
+    fn branch(&self, name: &str) -> String {
+        git(self.root(), &["checkout", "-b", name]);
+        let file = format!("{}.txt", name.replace('/', "_"));
+        std::fs::write(self.root().join(&file), "work\n").unwrap();
+        git(self.root(), &["add", &file]);
+        git(self.root(), &["commit", "-m", &format!("work on {name}")]);
+        let tip = git(self.root(), &["rev-parse", "HEAD"]);
+        git(self.root(), &["checkout", "main"]);
+        tip
+    }
+
+    /// Squash merge, as GitHub does: the branch tip never becomes an ancestor of main.
+    fn squash_merge(&self, name: &str) {
+        git(self.root(), &["merge", "--squash", name]);
+        git(self.root(), &["commit", "-m", &format!("squash {name}")]);
+        git(self.root(), &["push", "origin", "main"]);
+    }
+
+    /// Record a draft that submitted `branch` as PR `review`.
+    fn pr(&self, review: &str, branch: &str, head: Option<&str>) {
+        let mut g = self.fx.goal(GoalRunState::Applied, None, 10);
+        let mut p = self.fx.draft(&mut g, approved(), 10);
+        p.vcs_status = Some(VcsTrackingInfo {
+            branch: branch.into(),
+            review_url: None,
+            review_id: Some(review.into()),
+            review_state: Some("open".into()),
+            commit_sha: head.map(str::to_string),
+            last_checked: Utc::now(),
+        });
+        self.fx.save_draft(&p);
+    }
+
+    fn engine<'a>(&self, t: &'a Truth) -> Engine<'a> {
+        self.fx.engine(t, Settings::default())
+    }
+}
+
+fn only_branches() -> RunOptions {
+    RunOptions {
+        only: Some(vec![Category::Branches]),
+        ..RunOptions::default()
+    }
+}
+
+fn truth(review: &str, state: ReviewState) -> Truth {
+    let mut t = Truth::default();
+    t.reviews.insert(review.into(), state);
+    t
+}
+
+#[test]
+fn squash_merged_branch_is_deleted_and_logged_with_its_tip() {
+    let r = Repo::new();
+    let tip = r.branch("feature/x");
+    r.squash_merge("feature/x");
+    r.pr("7", "feature/x", Some(&tip));
+    let t = truth("7", ReviewState::Merged);
+
+    let report = run(&r.engine(&t), &only_branches(), None).unwrap();
+
+    let f = find(&report, "branch:feature/x");
+    assert_eq!(f.verdict, Verdict::AutoSafe);
+    assert!(
+        f.reason.contains("no commits beyond the PR head"),
+        "{}",
+        f.reason
+    );
+    assert!(!branch_exists(r.root(), "feature/x"));
+    // Name and tip SHA are in the cleanup log and in the result, so it can be recreated.
+    let log = std::fs::read_to_string(r.fx.paths.cleanup_dir().join("branches.jsonl")).unwrap();
+    assert!(log.contains("feature/x") && log.contains(&tip), "{log}");
+    assert!(
+        report.done[0].summary.contains(&tip),
+        "{}",
+        report.done[0].summary
+    );
+    // And the logged tip really does recover it.
+    git(r.root(), &["branch", "recovered", &tip]);
+    assert!(branch_exists(r.root(), "recovered"));
+}
+
+#[test]
+fn open_pr_branch_is_kept() {
+    let r = Repo::new();
+    let tip = r.branch("feature/open");
+    r.pr("8", "feature/open", Some(&tip));
+    let t = truth("8", ReviewState::Open);
+
+    let report = run(&r.engine(&t), &only_branches(), None).unwrap();
+
+    let f = find(&report, "branch:feature/open");
+    assert_eq!(f.verdict, Verdict::Skip);
+    assert!(f.reason.contains("still open"), "{}", f.reason);
+    assert!(branch_exists(r.root(), "feature/open"));
+    assert!(report.done.is_empty());
+}
+
+#[test]
+fn commits_beyond_the_pr_head_are_asked_never_deleted() {
+    let r = Repo::new();
+    let head = r.branch("feature/more");
+    r.squash_merge("feature/more");
+    r.pr("9", "feature/more", Some(&head));
+    // Work added after the PR head was recorded.
+    git(r.root(), &["checkout", "feature/more"]);
+    std::fs::write(r.root().join("late.txt"), "late\n").unwrap();
+    git(r.root(), &["add", "late.txt"]);
+    git(r.root(), &["commit", "-m", "late work"]);
+    git(r.root(), &["checkout", "main"]);
+    let t = truth("9", ReviewState::Merged);
+
+    let report = run(&r.engine(&t), &only_branches(), None).unwrap();
+
+    let f = find(&report, "branch:feature/more");
+    assert_eq!(f.verdict, Verdict::Ask);
+    assert!(f.reason.contains("beyond the PR head"), "{}", f.reason);
+    assert!(branch_exists(r.root(), "feature/more"));
+    assert!(report
+        .questions_open
+        .iter()
+        .any(|i| i == "branch:feature/more"));
+    assert!(report.done.is_empty());
+    // Asked, not forgotten: the question is queued for a person.
+    assert!(r.fx.paths.cleanup_dir().join("questions.jsonl").exists());
+}
+
+#[test]
+fn branch_with_no_pr_and_unmerged_work_is_asked() {
+    let r = Repo::new();
+    r.branch("scratch/idea");
+    let t = Truth::default();
+
+    let report = run(&r.engine(&t), &only_branches(), None).unwrap();
+
+    let f = find(&report, "branch:scratch/idea");
+    assert_eq!(f.verdict, Verdict::Ask);
+    assert!(f.reason.contains("no PR"), "{}", f.reason);
+    assert!(branch_exists(r.root(), "scratch/idea"));
+}
+
+#[test]
+fn dirty_worktree_is_asked_with_the_file_list() {
+    let r = Repo::new();
+    let tip = r.branch("feature/wt");
+    r.squash_merge("feature/wt");
+    r.pr("10", "feature/wt", Some(&tip));
+    let wt = r.scratch.path().join("wt");
+    git(
+        r.root(),
+        &["worktree", "add", &wt.to_string_lossy(), "feature/wt"],
+    );
+    std::fs::write(wt.join("notes.txt"), "unsaved\n").unwrap();
+    let t = truth("10", ReviewState::Merged);
+
+    let report = run(&r.engine(&t), &only_branches(), None).unwrap();
+
+    let f = find(&report, "branch:feature/wt");
+    assert_eq!(f.verdict, Verdict::Ask);
+    let listed = f.evidence.iter().any(|e| e.fact.contains("notes.txt"));
+    assert!(listed, "file list missing: {:?}", f.evidence);
+    assert!(
+        f.options.iter().all(|o| o.action == Action::None),
+        "a dirty worktree must offer no destructive option"
+    );
+    assert!(branch_exists(r.root(), "feature/wt"));
+    assert!(wt.join("notes.txt").exists());
+}
+
+#[test]
+fn clean_worktree_of_a_finished_branch_is_pruned_with_the_branch() {
+    let r = Repo::new();
+    let tip = r.branch("feature/clean");
+    r.squash_merge("feature/clean");
+    r.pr("11", "feature/clean", Some(&tip));
+    let wt = r.scratch.path().join("clean-wt");
+    git(
+        r.root(),
+        &["worktree", "add", &wt.to_string_lossy(), "feature/clean"],
