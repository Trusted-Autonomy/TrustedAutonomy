+/// Delete a branch and its worktree. Re-checks everything the scan decided on, because time
+/// has passed: the branch may have moved or the worktree may have been edited.
+pub fn prune_branch(
+    paths: &Paths,
+    branch: &str,
+    tip_sha: &str,
+    worktree: Option<&Path>,
+) -> anyhow::Result<(String, u64)> {
+    let root = &paths.root;
+    let refname = format!("refs/heads/{branch}");
+    let now_tip = match git(root, &["rev-parse", "--verify", "-q", &refname]) {
+        Ok(t) => t,
+        Err(_) => return Ok((format!("branch {branch} was already gone"), 0)),
+    };
+    if now_tip != tip_sha {
+        anyhow::bail!(
+            "branch {branch} moved from {} to {} since it was scanned; left alone. Run `ta cleanup --only branches` again.",
+            short_sha(tip_sha),
+            short_sha(&now_tip)
+        );
+    }
+    if git(root, &["symbolic-ref", "--short", "-q", "HEAD"])
+        .ok()
+        .as_deref()
+        == Some(branch)
+    {
+        anyhow::bail!(
+            "branch {branch} is checked out in {}; cleanup never deletes the current branch",
+            root.display()
+        );
+    }
+    let mut removed_wt = None;
+    if let Some(wt) = worktree {
+        if wt.exists() {
+            let dirty = dirty_files(wt)
+                .map_err(|e| anyhow::anyhow!("could not check worktree {}: {e}", wt.display()))?;
+            if !dirty.is_empty() {
+                anyhow::bail!(
+                    "worktree {} has uncommitted or untracked files ({}); left alone. Commit or discard them, then re-run `ta cleanup --only branches`.",
+                    wt.display(),
+                    file_list(&dirty)
+                );
+            }
+            git(root, &["worktree", "remove", &wt.to_string_lossy()]).map_err(|e| {
+                anyhow::anyhow!("`git worktree remove {}` failed: {e}. If the worktree is locked, run `git worktree unlock` first.", wt.display())
+            })?;
+        } else {
+            git(root, &["worktree", "prune"])
+                .map_err(|e| anyhow::anyhow!("`git worktree prune` failed: {e}"))?;
+        }
+        removed_wt = Some(wt.display().to_string());
+    }
+    // update-ref with the expected old value deletes only if nobody moved the branch meanwhile,
+    // and, unlike `git branch -d`, does not misread a squash-merged branch as unmerged.
+    git(root, &["update-ref", "-d", &refname, tip_sha])
+        .map_err(|e| anyhow::anyhow!("could not delete {refname} at {tip_sha}: {e}"))?;
+    let _ = git(
+        root,
+        &["config", "--remove-section", &format!("branch.{branch}")],
+    );
+
+    let log = json!({
+        "action": "prune_branch",
+        "branch": branch,
+        "tip_sha": tip_sha,
+        "worktree_removed": removed_wt,
+        "recover": format!("git branch {branch} {tip_sha}"),
+        "at": chrono::Utc::now().to_rfc3339(),
+    });
+    if let Err(e) = state::append_jsonl(&paths.cleanup_dir().join("branches.jsonl"), &log) {
+        tracing::warn!(branch, tip_sha, error = %e, "cleanup: could not write .ta/cleanup/branches.jsonl");
+    }
+    Ok((
+        format!(
+            "deleted local branch {branch} (tip {tip_sha}{}); recover with `git branch {branch} {tip_sha}`",
+            removed_wt.map(|w| format!(", removed worktree {w}")).unwrap_or_default()
+        ),
+        0,
+    ))
+}
