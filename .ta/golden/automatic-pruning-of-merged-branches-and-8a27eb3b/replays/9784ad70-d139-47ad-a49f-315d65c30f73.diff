+//! The `branches` group: finished local branches and the worktrees that hold them.
+//!
+//! Ground truth is the PR state from the VCS adapter (`GroundTruth::branch_review`) plus plain
+//! git facts about the commits. `git branch -d` and `git cherry` are not consulted: a squash
+//! merge rewrites patch ids, so they call every squash-merged branch unmerged.
+//!
+//! A local branch is deleted without asking only when
+//!   * its PR is merged and the branch has no commits beyond the PR head, or
+//!   * its tip is already inside the default branch (and it is not an untouched new branch).
+//!
+//! Everything else is a question. The current branch, the default branch and any branch whose
+//! worktree has uncommitted or untracked files are never deleted. Remote branches are never
+//! touched; those whose PR was closed unmerged are only reported.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use serde_json::json;
+
+use crate::model::*;
+use crate::scan::short_sha;
+use crate::state;
+
+/// A git command aimed at `dir`. `GIT_DIR`, `GIT_WORK_TREE` and `GIT_INDEX_FILE` are cleared:
+/// they override `-C` and would silently point cleanup at some other repository (TA sets them
+/// for agent sessions).
+pub(crate) fn git_cmd(dir: &Path) -> Command {
+    let mut c = Command::new("git");
+    c.arg("-C")
+        .arg(dir)
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .env_remove("GIT_INDEX_FILE");
+    c
+}
+
+/// Run git in `dir`. Returns trimmed stdout, or the stderr text on failure.
+fn git(dir: &Path, args: &[&str]) -> Result<String, String> {
+    let out = git_cmd(dir)
+        .args(args)
+        .output()
+        .map_err(|e| format!("could not run git: {e}"))?;
+    if out.status.success() {
+        Ok(String::from_utf8_lossy(&out.stdout).trim().to_string())
+    } else {
+        Err(String::from_utf8_lossy(&out.stderr).trim().to_string())
+    }
+}
