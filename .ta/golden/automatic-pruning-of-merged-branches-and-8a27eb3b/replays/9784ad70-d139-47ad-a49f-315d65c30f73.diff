+/// Once a PR is seen merged, remove the branch and worktree it leaves behind. Safe deletions
+/// only; anything uncertain stays for `ta cleanup`. A failure here never fails the watch.
+fn prune_after_merge(config: &GatewayConfig) {
+    match super::cleanup::prune_branches_now(config) {
+        Ok(Some(report)) => {
+            for d in &report.done {
+                println!("[cleanup] {}", d.summary);
+            }
+            for (id, err) in &report.failed {
+                eprintln!("[warn] cleanup of {id} failed: {err}");
+            }
+            if !report.questions_open.is_empty() {
+                println!(
+                    "[cleanup] {} branch(es) need a decision. Run `ta cleanup --only branches` to review them.",
+                    report.questions_open.len()
+                );
+            }
+        }
+        Ok(None) => {}
+        Err(e) => eprintln!(
+            "[warn] Branch cleanup after merge failed: {e}. Run `ta cleanup --only branches`."
+        ),
+    }
