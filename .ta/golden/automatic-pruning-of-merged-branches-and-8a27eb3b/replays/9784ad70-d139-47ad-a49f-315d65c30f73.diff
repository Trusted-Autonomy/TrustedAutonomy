+        let action = Action::PruneBranch {
+            branch: branch.to_string(),
+            tip_sha: tip.to_string(),
+            worktree: wt.map(|w| w.path.clone()),
+        };
+        let facts = [
+            ("branch", branch.to_string()),
+            ("tip", tip.to_string()),
+            ("review", describe(&review)),
+            (
+                "dirty",
+                dirty.as_ref().map(|d| d.join("|")).unwrap_or_default(),
+            ),
+        ];
+        let id = format!("branch:{branch}");
+        let title = format!("Local branch {branch}");
+        let manual = format!(
+            "git {}branch -D {branch}   (tip {tip}; recreate with `git branch {branch} {tip}`)",
+            wt.map(|w| format!("worktree remove \"{}\" && git ", w.path.display()))
+                .unwrap_or_default()
+        );
+        let mut f = match (&dirty, call) {
+            (Some(files), call) => {
+                let why = match call {
+                    Call::Done(r) => format!("branch looks finished ({r}) but its worktree has uncommitted or untracked files"),
+                    Call::Question { why, .. } => format!("{why}; its worktree also has uncommitted or untracked files"),
+                };
+                let mut f = crate::scan::mk(Kind::Branch, id, title, evidence, Verdict::Ask,
+                    format!("{why}: {}. Commit, move or discard them, then run `ta cleanup --only branches` again.", file_list(files)),
+                    Action::None, &facts);
+                f.options = vec![keep()];
+                f.recommended = Some("keep".into());
+                f
+            }
+            (None, Call::Done(why)) => crate::scan::mk(
+                Kind::Branch,
+                id,
+                title,
+                evidence,
+                Verdict::AutoSafe,
+                format!(
+                    "{why}; deleting the branch{} loses nothing",
+                    if wt.is_some() {
+                        " and its clean worktree"
+                    } else {
+                        ""
+                    }
+                ),
+                action,
+                &facts,
+            ),
+            (None, Call::Question { why, can_delete }) => {
+                let mut f = crate::scan::mk(
+                    Kind::Branch,
+                    id,
+                    title,
+                    evidence,
+                    Verdict::Ask,
+                    why,
+                    Action::None,
+                    &facts,
+                );
+                f.options = vec![keep()];
+                if can_delete {
+                    f.options.push(AnswerOption {
+                        key: "delete".into(),
+                        label: format!(
+                            "Delete the branch (tip {} is logged so it can be recreated)",
+                            short_sha(tip)
+                        ),
+                        action,
+                    });
+                }
+                f.recommended = Some("keep".into());
+                f
+            }
+        };
+        f.manual_command = Some(manual);
+        out.push(f);
+    }
+
+    remote_findings(e, default.as_deref(), out);
+}
+
+fn keep() -> AnswerOption {
+    AnswerOption {
+        key: "keep".into(),
+        label: "Keep the branch".into(),
+        action: Action::None,
+    }
+}
