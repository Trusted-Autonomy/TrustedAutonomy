+#[derive(Debug)]
+struct Worktree {
+    path: PathBuf,
+    branch: Option<String>,
+    locked: bool,
+}
+
+/// Linked worktrees (the primary one is left out) with the branch each has checked out.
+fn linked_worktrees(root: &Path) -> Vec<Worktree> {
+    let Ok(text) = git(root, &["worktree", "list", "--porcelain"]) else {
+        return Vec::new();
+    };
+    let mut all: Vec<Worktree> = Vec::new();
+    for line in text.lines() {
+        if let Some(p) = line.strip_prefix("worktree ") {
+            all.push(Worktree {
+                path: PathBuf::from(p),
+                branch: None,
+                locked: false,
+            });
+        } else if let Some(b) = line.strip_prefix("branch refs/heads/") {
+            if let Some(w) = all.last_mut() {
+                w.branch = Some(b.to_string());
+            }
+        } else if line == "locked" || line.starts_with("locked ") {
+            if let Some(w) = all.last_mut() {
+                w.locked = true;
+            }
+        }
+    }
+    // The first entry is the primary worktree, which is `root` itself.
+    all.into_iter().skip(1).collect()
+}
+
+/// The default branch name: what `origin/HEAD` points at, else `main`, `master` or `trunk`.
+fn default_branch(root: &Path) -> Option<String> {
+    if let Ok(r) = git(
+        root,
+        &["symbolic-ref", "--short", "-q", "refs/remotes/origin/HEAD"],
+    ) {
+        if let Some(b) = r.strip_prefix("origin/") {
+            return Some(b.to_string());
+        }
+    }
+    ["main", "master", "trunk"]
+        .into_iter()
+        .find(|b| {
+            git(
+                root,
+                &["rev-parse", "--verify", "-q", &format!("refs/heads/{b}")],
+            )
+            .is_ok()
+        })
+        .map(str::to_string)
+}
+
+/// Uncommitted and untracked files in a worktree, as `git status --porcelain` lines.
+fn dirty_files(dir: &Path) -> Result<Vec<String>, String> {
+    git(dir, &["status", "--porcelain", "--untracked-files=all"])
+        .map(|t| t.lines().map(str::to_string).collect())
+}
+
+fn file_list(files: &[String]) -> String {
+    const SHOWN: usize = 15;
+    let mut s = files
+        .iter()
+        .take(SHOWN)
+        .map(|f| f.trim().to_string())
+        .collect::<Vec<_>>()
+        .join(", ");
+    if files.len() > SHOWN {
+        s.push_str(&format!(" (and {} more)", files.len() - SHOWN));
+    }
+    s
+}
+
+enum Call {
+    /// Safe to delete; the string is the reason.
+    Done(String),
+    /// A person must decide; `can_delete` offers a "delete anyway" answer.
+    Question { why: String, can_delete: bool },
+}
+
+pub fn scan_branches(e: &Engine, out: &mut Vec<Finding>) {
+    if !e.settings.prune_branches {
+        return;
+    }
+    let root = &e.paths.root;
+    // Only when `root` is itself the top of a git checkout, never a project nested in some
+    // other repository: those branches and worktrees are not this project's.
+    match git(root, &["rev-parse", "--show-toplevel"]) {
+        Ok(top) if same_dir(Path::new(&top), root) => {}
+        _ => return,
+    }
+    let default = default_branch(root);
+    let current = git(root, &["symbolic-ref", "--short", "-q", "HEAD"]).ok();
+    let worktrees = linked_worktrees(root);
+
+    // Tips of the default branch, local and remote, for the ancestor test.
+    let default_refs: Vec<String> = default
+        .iter()
+        .flat_map(|d| {
+            [
+                format!("refs/heads/{d}"),
+                format!("refs/remotes/origin/{d}"),
+            ]
+        })
+        .filter(|r| git(root, &["rev-parse", "--verify", "-q", r]).is_ok())
+        .collect();
+    let default_tips: Vec<String> = default_refs
+        .iter()
+        .filter_map(|r| git(root, &["rev-parse", r]).ok())
+        .collect();
+
+    let Ok(listing) = git(
+        root,
+        &[
+            "for-each-ref",
+            "--format=%(refname)%09%(objectname)",
+            "refs/heads",
+        ],
+    ) else {
+        return;
+    };
+    for line in listing.lines() {
+        let Some((refname, tip)) = line.split_once('\t') else {
+            continue;
+        };
+        let Some(branch) = refname.strip_prefix("refs/heads/") else {
+            continue;
+        };
+        if default.as_deref() == Some(branch) || current.as_deref() == Some(branch) {
+            continue;
+        }
+        let wt = worktrees
+            .iter()
+            .find(|w| w.branch.as_deref() == Some(branch));
+        let review = e.truth.branch_review(branch);
+        let in_default = default_refs.iter().any(|d| is_ancestor(root, tip, d));
+        let same_as_default = default_tips.iter().any(|t| t == tip);
+
+        let mut evidence = vec![
+            Evidence::new("git", format!("tip {}", short_sha(tip))),
+            Evidence::new("vcs", describe(&review)),
+        ];
+        evidence.push(Evidence::new(
+            "git",
+            match (&default, in_default) {
+                (Some(d), true) => format!("tip is inside {d}"),
+                (Some(d), false) => format!("tip is not inside {d}"),
+                (None, _) => "no default branch found".to_string(),
+            },
+        ));
+
+        let mut call = judge(root, tip, &review, in_default, same_as_default);
+        let mut dirty: Option<Vec<String>> = None;
+        if let Some(w) = wt {
+            evidence.push(Evidence::new(
+                "git",
+                format!("checked out in worktree {}", w.path.display()),
+            ));
+            if w.locked {
+                call = Call::Question {
+                    why: format!("worktree {} is locked", w.path.display()),
+                    can_delete: false,
+                };
+            } else if w.path.exists() {
+                match dirty_files(&w.path) {
+                    Ok(f) if !f.is_empty() => dirty = Some(f),
+                    Ok(_) => {}
+                    Err(err) => {
+                        call = Call::Question {
+                            why: format!(
+                                "could not check worktree {} for uncommitted files: {err}",
+                                w.path.display()
+                            ),
+                            can_delete: false,
+                        }
+                    }
+                }
+            }
+        }
+        if let Some(files) = &dirty {
+            evidence.push(Evidence::new(
+                "git",
+                format!("uncommitted or untracked: {}", file_list(files)),
+            ));
+        }
