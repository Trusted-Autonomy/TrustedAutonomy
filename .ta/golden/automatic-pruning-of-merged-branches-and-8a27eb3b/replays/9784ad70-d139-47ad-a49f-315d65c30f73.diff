+fn describe(r: &BranchReview) -> String {
+    match r {
+        BranchReview::Open { id } => format!("PR {id} is open"),
+        BranchReview::Merged { id, head_sha } => match head_sha {
+            Some(h) => format!("PR {id} is merged (head {})", short_sha(h)),
+            None => format!("PR {id} is merged (head commit not reported)"),
+        },
+        BranchReview::ClosedUnmerged { id } => format!("PR {id} was closed without merging"),
+        BranchReview::NoReview => "no PR for this branch".to_string(),
+        BranchReview::Unknown(why) => format!("PR state unknown ({why})"),
+    }
+}
+
+fn judge(
+    root: &Path,
+    tip: &str,
+    review: &BranchReview,
+    in_default: bool,
+    same_as_default: bool,
+) -> Call {
+    match review {
+        BranchReview::Open { id } => Call::Question {
+            why: format!("PR {id} is still open"),
+            can_delete: false,
+        },
+        BranchReview::Merged { id, head_sha } => match head_sha {
+            Some(h) if h == tip => Call::Done(format!("PR {id} is merged and the branch is at the PR head")),
+            Some(h) if is_ancestor(root, tip, h) => {
+                Call::Done(format!("PR {id} is merged and the branch has no commits beyond the PR head"))
+            }
+            _ if in_default => Call::Done(format!("PR {id} is merged and the tip is inside the default branch")),
+            Some(h) => {
+                let beyond = git(root, &["rev-list", "--count", &format!("{h}..{tip}")])
+                    .map(|n| format!("{n} commit(s)"))
+                    .unwrap_or_else(|_| format!("commits not in the PR head {} (that commit is not in this clone)", short_sha(h)));
+                Call::Question {
+                    why: format!("PR {id} is merged but the branch has {beyond} beyond the PR head"),
+                    can_delete: true,
+                }
+            }
+            None => Call::Question {
+                why: format!("PR {id} is merged but the host did not report its head commit, and the tip is not inside the default branch"),
+                can_delete: true,
+            },
+        },
+        BranchReview::ClosedUnmerged { .. } | BranchReview::NoReview | BranchReview::Unknown(_) => {
+            if in_default && !same_as_default {
+                Call::Done("the tip is inside the default branch".into())
+            } else if in_default {
+                // Same commit as the default branch and no merged PR to say why: this may be a
+                // branch somebody just created, so it is not safe to call it finished.
+                Call::Question {
+                    why: "the branch points at the same commit as the default branch and no merged PR explains it; it may be new work that has no commits yet".into(),
+                    can_delete: true,
+                }
+            } else {
+                let why = match review {
+                    BranchReview::ClosedUnmerged { id } => format!("PR {id} was closed without merging and the branch has commits that are not in the default branch"),
+                    BranchReview::NoReview => "no PR exists and the branch has commits that are not in the default branch".to_string(),
+                    BranchReview::Unknown(w) => format!("PR state could not be read ({w}) and the branch has commits that are not in the default branch"),
+                    _ => unreachable!(),
+                };
+                Call::Question { why, can_delete: true }
+            }
+        }
+    }
+}
+
+/// Remote branches whose PR was closed without merging: reported, never deleted.
+fn remote_findings(e: &Engine, default: Option<&str>, out: &mut Vec<Finding>) {
+    let root = &e.paths.root;
+    let Ok(listing) = git(
+        root,
+        &["for-each-ref", "--format=%(refname)", "refs/remotes"],
+    ) else {
+        return;
+    };
+    for refname in listing.lines() {
+        let Some(rest) = refname.strip_prefix("refs/remotes/") else {
+            continue;
+        };
+        let Some((remote, branch)) = rest.split_once('/') else {
+            continue;
+        };
+        if branch == "HEAD" || default == Some(branch) {
+            continue;
+        }
+        if let BranchReview::ClosedUnmerged { id } = e.truth.branch_review(branch) {
+            out.push(crate::scan::mk(
+                Kind::RemoteBranch,
+                format!("remote-branch:{remote}/{branch}"),
+                format!("Remote branch {remote}/{branch}"),
+                vec![Evidence::new("vcs", format!("PR {id} was closed without merging"))],
+                Verdict::Skip,
+                format!("PR {id} was closed without merging. Remote branches are never deleted by cleanup; delete it on the host if the work is abandoned"),
+                Action::None,
+                &[("remote", remote.to_string()), ("branch", branch.to_string()), ("pr", id)],
+            ));
+        }
+    }
+}
