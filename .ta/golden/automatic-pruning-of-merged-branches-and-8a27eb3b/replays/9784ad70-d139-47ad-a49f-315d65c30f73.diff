+//! Tests for the `branches` group. A real local git repo with a bare repo as `origin`; only the
+//! PR host is faked, through `GroundTruth::branch_review`.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+use crate::act::FileCloser;
+use crate::*;
+
+#[derive(Default)]
+struct Truth {
+    branches: HashMap<String, BranchReview>,
+}
+
+impl GroundTruth for Truth {
+    fn review_state(&self, _r: &str) -> ReviewState {
+        ReviewState::Unknown("not used".into())
+    }
+    fn phase_done(&self, _p: &str) -> bool {
+        false
+    }
+    fn branch_review(&self, branch: &str) -> BranchReview {
+        self.branches
+            .get(branch)
+            .cloned()
+            .unwrap_or(BranchReview::NoReview)
+    }
+}
+
+fn git(dir: &Path, args: &[&str]) -> String {
+    let out = crate::branches::git_cmd(dir)
+        .args(["-c", "user.name=t", "-c", "user.email=t@example.com"])
+        .args([
+            "-c",
+            "commit.gpgsign=false",
+            "-c",
+            "init.defaultBranch=main",
+        ])
+        .args(args)
+        .output()
+        .expect("git runs");
+    assert!(
+        out.status.success(),
+        "git {args:?} failed: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    String::from_utf8_lossy(&out.stdout).trim().to_string()
+}
+
+struct Repo {
+    dir: tempfile::TempDir,
+    work: PathBuf,
+}
+
+impl Repo {
+    fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let origin = dir.path().join("origin.git");
+        let work = dir.path().join("work");
+        std::fs::create_dir_all(&origin).unwrap();
+        std::fs::create_dir_all(&work).unwrap();
+        git(&origin, &["init", "--bare", "-b", "main"]);
+        git(&work, &["init", "-b", "main"]);
+        git(
+            &work,
+            &["remote", "add", "origin", &origin.to_string_lossy()],
+        );
+        let r = Repo { dir, work };
+        r.commit("README.md", "hello", "initial");
+        git(&r.work, &["push", "-u", "origin", "main"]);
+        r
+    }
+
+    fn commit(&self, file: &str, body: &str, msg: &str) -> String {
+        std::fs::write(self.work.join(file), body).unwrap();
+        git(&self.work, &["add", "-A"]);
+        git(&self.work, &["commit", "-m", msg]);
+        git(&self.work, &["rev-parse", "HEAD"])
+    }
+
+    /// A branch with one commit, then back on main. Returns the tip.
+    fn feature(&self, name: &str) -> String {
+        git(&self.work, &["checkout", "-b", name]);
+        let tip = self.commit(&format!("{}.txt", name.replace('/', "_")), name, name);
+        git(&self.work, &["checkout", "main"]);
+        tip
+    }
+
+    /// Squash-merge `name` into main, the way a host does: branch history is not in main.
+    fn squash_merge(&self, name: &str) {
+        git(&self.work, &["merge", "--squash", name]);
+        git(&self.work, &["commit", "-m", &format!("squash {name}")]);
+    }
+
+    fn has_branch(&self, name: &str) -> bool {
+        crate::branches::git_cmd(&self.work)
+            .args(["rev-parse", "--verify", "-q", &format!("refs/heads/{name}")])
+            .output()
+            .unwrap()
+            .status
+            .success()
+    }
+
+    fn engine<'a>(&self, truth: &'a Truth) -> Engine<'a> {
+        Engine {
+            paths: Paths::for_project(&self.work),
+            settings: Settings::default(),
+            truth,
+            closer: &FileCloser,
+            assistant: None,
+        }
+    }
+}
+
+fn merged(id: &str, head: Option<&str>) -> BranchReview {
+    BranchReview::Merged {
+        id: id.into(),
+        head_sha: head.map(str::to_string),
+    }
+}
+
+fn opts(dry_run: bool) -> RunOptions {
+    RunOptions {
+        dry_run,
+        auto_safe_only: true,
+        only: Some(vec![Category::Branches]),
+        ..Default::default()
+    }
+}
+
+fn finding<'a>(r: &'a Report, branch: &str) -> &'a Finding {
+    r.findings
+        .iter()
+        .find(|f| f.id == format!("branch:{branch}"))
+        .unwrap_or_else(|| panic!("no finding for {branch}"))
+}
