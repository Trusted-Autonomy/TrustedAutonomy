+/// Choose the review that decides a branch's fate from `gh pr list --json
+/// number,state,headRefOid`: an open one wins, then the newest merged, then the
+/// newest closed.
+fn pick_branch_review(json: &str) -> Result<BranchReviewLookup> {
+    let v: serde_json::Value = serde_json::from_str(json)
+        .map_err(|e| SubmitError::VcsError(format!("Failed to parse gh pr list output: {e}")))?;
+    let prs = v.as_array().cloned().unwrap_or_default();
+    let rank = |state: &str| match state {
+        "open" | "draft" => 3,
+        "merged" => 2,
+        _ => 1,
+    };
+    let best = prs
+        .iter()
+        .filter_map(|p| {
+            let number = p.get("number")?.as_u64()?;
+            let state = p.get("state")?.as_str()?.to_lowercase();
+            let head = p
+                .get("headRefOid")
+                .and_then(|h| h.as_str())
+                .filter(|h| !h.is_empty())
+                .map(str::to_string);
+            Some((rank(&state), number, state, head))
+        })
+        .max_by_key(|(r, n, _, _)| (*r, *n));
+    Ok(match best {
+        None => BranchReviewLookup::NoReview,
+        Some((_, number, state, head_sha)) => BranchReviewLookup::Found(BranchReview {
+            review_id: number.to_string(),
+            state,
+            head_sha,
+        }),
+    })
