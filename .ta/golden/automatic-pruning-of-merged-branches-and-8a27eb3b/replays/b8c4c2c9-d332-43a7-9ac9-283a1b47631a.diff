+/// Prune finished branches and worktrees right after a PR was seen merging
+/// (`ta draft watch`, `ta draft merge`). Safe deletions only; anything doubtful is
+/// left for `ta cleanup`. Never fails the caller: the merge already succeeded.
+pub fn prune_branches_after_merge(config: &GatewayConfig) {
+    let wf = WorkflowConfig::load_or_default(&config.workspace_root.join(".ta/workflow.toml"));
+    if !wf.cleanup.branches {
+        println!("[branches] Pruning is off ([cleanup] branches = false); kept all branches.");
+        return;
+    }
+    match run_auto_safe(config, vec![Category::Branches]) {
+        Ok(r) => {
+            for d in &r.done {
+                println!("[branches] {}", d.summary);
+            }
+            for (id, err) in &r.failed {
+                eprintln!(
+                    "[warn] branch cleanup {id} failed: {err}. Run `ta cleanup --only branches`."
+                );
+            }
+            if !r.questions_open.is_empty() {
+                println!(
+                    "[branches] {} branch(es) need a decision. Run `ta cleanup --only branches`.",
+                    r.questions_open.len()
+                );
+            }
+        }
+        Err(e) => eprintln!(
+            "[warn] Branch cleanup after merge failed: {e}. Run `ta cleanup --only branches`."
+        ),
+    }
+}
