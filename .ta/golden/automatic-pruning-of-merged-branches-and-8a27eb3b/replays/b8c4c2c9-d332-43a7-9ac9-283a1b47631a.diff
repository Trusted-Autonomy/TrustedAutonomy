+//! The `branches` group: prune local branches and worktrees whose work has landed.
+//!
+//! Ground truth is the PR state from the VCS platform ([`GroundTruth::branch_review`]),
+//! never `git branch -d` or `git cherry`: a squash merge rewrites patch ids, so
+//! git alone calls a finished branch unmerged. A local branch is deleted without
+//! asking only when
+//!   * its PR is merged and the branch has no commits beyond the PR head, or
+//!   * its tip is an ancestor of the default branch (nothing on it is unique).
+//!
+//! The current branch, the default branch and any branch checked out in a
+//! worktree with uncommitted or untracked files are never deleted. An open PR,
+//! no PR, or commits beyond the PR head is a question for a person. Remote
+//! branches are never deleted: closed-unmerged ones are only reported.
+//!
+//! Git only. Local repository facts come from the `git` CLI (as in
+//! `ta_goal::start_state`); the PR facts come through the VCS adapter.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use crate::model::*;
+use crate::scan::{mk, short_sha, Scan};
+
+/// How many changed files a question lists before saying "and N more".
+const FILE_LIST_CAP: usize = 20;
+
+/// One entry of `git worktree list --porcelain`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Worktree {
+    pub path: PathBuf,
+    pub branch: Option<String>,
+    pub locked: bool,
+    pub prunable: bool,
+}
+
+/// The local repository, read and changed through the `git` CLI.
+pub struct Git {
+    root: PathBuf,
+}
+
+impl Git {
+    /// `None` unless `root` is itself the top level of a git work tree. A project
+    /// nested inside some other repository must never act on that outer one.
+    pub fn open(root: &Path) -> Option<Git> {
+        let g = Git {
+            root: root.to_path_buf(),
+        };
+        let top = g.run(root, &["rev-parse", "--show-toplevel"]).ok()?;
+        (same_path(Path::new(top.trim()), root)).then_some(g)
+    }
+
+    fn run(&self, dir: &Path, args: &[&str]) -> Result<String, String> {
+        let out = Command::new("git")
+            .arg("-C")
+            .arg(dir)
+            .args(args)
+            .env("GIT_OPTIONAL_LOCKS", "0")
+            // An inherited GIT_DIR / GIT_WORK_TREE would point git at another repository.
+            .env_remove("GIT_DIR")
+            .env_remove("GIT_WORK_TREE")
+            .env_remove("GIT_INDEX_FILE")
+            .output()
+            .map_err(|e| {
+                format!(
+                    "could not run `git {}` in {}: {e}. Install git or put it on PATH.",
+                    args.join(" "),
+                    dir.display()
+                )
+            })?;
+        if out.status.success() {
+            Ok(String::from_utf8_lossy(&out.stdout).to_string())
+        } else {
+            Err(format!(
+                "`git {}` in {} failed: {}",
+                args.join(" "),
+                dir.display(),
+                String::from_utf8_lossy(&out.stderr).trim()
+            ))
+        }
+    }
+
+    fn ok(&self, args: &[&str]) -> bool {
+        self.run(&self.root, args).is_ok()
+    }
+
+    /// `origin/HEAD` if set, else a local `main` or `master`.
+    pub fn default_branch(&self) -> Option<String> {
+        if let Ok(s) = self.run(
+            &self.root,
+            &["symbolic-ref", "--short", "refs/remotes/origin/HEAD"],
+        ) {
+            if let Some(name) = s.trim().strip_prefix("origin/") {
+                return Some(name.to_string());
+            }
+        }
+        ["main", "master"]
+            .into_iter()
+            .find(|b| {
+                self.ok(&[
+                    "show-ref",
+                    "--verify",
+                    "--quiet",
+                    &format!("refs/heads/{b}"),
+                ])
+            })
+            .map(str::to_string)
+    }
+
+    /// Branch checked out at the project root (`None` when detached).
+    pub fn current_branch(&self) -> Option<String> {
+        self.run(&self.root, &["symbolic-ref", "--short", "-q", "HEAD"])
+            .ok()
+            .map(|s| s.trim().to_string())
+            .filter(|s| !s.is_empty())
+    }
+
+    pub fn rev(&self, refname: &str) -> Option<String> {
+        self.run(&self.root, &["rev-parse", "--verify", "--quiet", refname])
+            .ok()
+            .map(|s| s.trim().to_string())
+            .filter(|s| !s.is_empty())
+    }
+
+    /// `(name, tip sha)` of every local branch.
+    pub fn local_branches(&self) -> Result<Vec<(String, String)>, String> {
+        let out = self.run(
+            &self.root,
+            &[
+                "for-each-ref",
+                "--format=%(refname:short)%09%(objectname)",
+                "refs/heads",
+            ],
+        )?;
+        Ok(split_pairs(&out))
+    }
+
+    /// `(branch name without remote, tip sha)` of every remote-tracking branch.
+    pub fn remote_branches(&self) -> Result<Vec<(String, String)>, String> {
+        let out = self.run(
+            &self.root,
+            &[
+                "for-each-ref",
+                "--format=%(refname:short)%09%(objectname)",
+                "refs/remotes",
+            ],
+        )?;
+        Ok(split_pairs(&out)
+            .into_iter()
+            .filter_map(|(r, sha)| {
+                let (_, name) = r.split_once('/')?;
+                (name != "HEAD").then(|| (name.to_string(), sha))
+            })
+            .collect())
+    }
+
+    pub fn is_ancestor(&self, a: &str, b: &str) -> bool {
+        self.ok(&["merge-base", "--is-ancestor", a, b])
+    }
+
+    /// Commits in `to` that are not in `from`: `(count, newest subjects)`.
+    pub fn commits_beyond(&self, from: &str, to: &str) -> (usize, Vec<String>) {
+        let range = format!("{from}..{to}");
+        let count = self
+            .run(&self.root, &["rev-list", "--count", &range])
+            .ok()
+            .and_then(|s| s.trim().parse().ok())
+            .unwrap_or(0);
+        let subjects = self
+            .run(&self.root, &["log", "--format=%h %s", "-n", "3", &range])
+            .map(|s| s.lines().map(str::to_string).collect())
+            .unwrap_or_default();
+        (count, subjects)
+    }
+
+    pub fn worktrees(&self) -> Result<Vec<Worktree>, String> {
+        let out = self.run(&self.root, &["worktree", "list", "--porcelain"])?;
+        Ok(parse_worktrees(&out))
+    }
+
+    /// Uncommitted and untracked files in the work tree at `dir`, as `git status` reports them.
+    pub fn dirty_files(&self, dir: &Path) -> Result<Vec<String>, String> {
+        let out = self.run(dir, &["status", "--porcelain", "-uall"])?;
+        Ok(out
+            .lines()
+            .filter(|l| !l.trim().is_empty())
+            .map(str::to_string)
+            .collect())
+    }
+
+    pub fn prune_worktrees(&self) -> Result<(), String> {
+        self.run(&self.root, &["worktree", "prune"]).map(|_| ())
+    }
+
+    /// Delete `branch` if its tip is still `sha`, removing `worktree` first.
+    /// Refuses the current branch, a moved branch and a worktree with local changes.
+    /// Returns the summary line that goes into the cleanup log.
+    pub fn delete_branch(
+        &self,
+        branch: &str,
+        sha: &str,
+        worktree: Option<&Path>,
+    ) -> Result<String, String> {
+        if self.current_branch().as_deref() == Some(branch) {
+            return Err(format!(
+                "branch '{branch}' is checked out at {}; cleanup never deletes the current branch.",
+                self.root.display()
+            ));
+        }
+        let tip = self
+            .rev(&format!("refs/heads/{branch}"))
+            .ok_or_else(|| format!("branch '{branch}' no longer exists"))?;
+        if tip != sha {
+            return Err(format!(
+                "branch '{branch}' moved from {} to {} since the scan; nothing was deleted. Run `ta cleanup` again.",
+                short_sha(sha),
+                short_sha(&tip)
+            ));
+        }
+        // Forget worktree records whose directory is gone, or git refuses the delete.
+        self.prune_worktrees()?;
+        let mut extra = String::new();
+        if let Some(wt) = worktree {
+            let wt_str = wt.to_string_lossy();
+            // No --force: git itself refuses when the worktree has local changes.
+            self.run(&self.root, &["worktree", "remove", &wt_str])
+                .map_err(|e| format!("{e}. The branch was kept."))?;
+            extra = format!(" and removed worktree {}", wt.display());
+        }
+        self.run(&self.root, &["branch", "-D", "--", branch])?;
+        Ok(format!(
+            "deleted branch {branch} (tip {sha}){extra}; recover with `git branch {branch} {sha}`"
+        ))
+    }
+}
+
+fn split_pairs(out: &str) -> Vec<(String, String)> {
+    out.lines()
+        .filter_map(|l| {
+            let (n, s) = l.split_once('\t')?;
+            Some((n.to_string(), s.trim().to_string()))
+        })
+        .collect()
+}
+
+pub fn parse_worktrees(porcelain: &str) -> Vec<Worktree> {
+    let mut out = Vec::new();
+    let mut cur: Option<Worktree> = None;
+    for line in porcelain.lines().chain(std::iter::once("")) {
+        if line.is_empty() {
+            out.extend(cur.take());
+        } else if let Some(p) = line.strip_prefix("worktree ") {
+            out.extend(cur.take());
+            cur = Some(Worktree {
+                path: PathBuf::from(p),
+                branch: None,
+                locked: false,
+                prunable: false,
+            });
+        } else if let Some(w) = cur.as_mut() {
+            if let Some(b) = line.strip_prefix("branch ") {
+                w.branch = b.strip_prefix("refs/heads/").map(str::to_string);
+            } else if line == "locked" || line.starts_with("locked ") {
+                w.locked = true;
+            } else if line == "prunable" || line.starts_with("prunable ") {
+                w.prunable = true;
+            }
+        }
+    }
+    out
+}
+
+/// Same directory, whatever the spelling (symlinks, `/var` vs `/private/var`, separators).
+fn same_path(a: &Path, b: &Path) -> bool {
+    match (a.canonicalize(), b.canonicalize()) {
+        (Ok(x), Ok(y)) => x == y,
+        _ => a == b,
+    }
+}
+
+fn keep_option() -> AnswerOption {
+    AnswerOption {
+        key: "keep".into(),
+        label: "Keep it".into(),
+        action: Action::None,
+    }
+}
+
+/// What the PR state and git history say about one branch.
+enum Verdicts {
+    /// Everything on the branch has landed; the string is the reason.
+    Landed(String),
+    /// A person has to decide; the string says why.
+    Question(String),
+}
+
+pub(crate) fn scan_branches(s: &Scan, out: &mut Vec<Finding>) {
+    let e = s.e;
+    let Some(git) = Git::open(&e.paths.root) else {
+        return;
+    };
+    let locals = match git.local_branches() {
+        Ok(l) => l,
+        Err(err) => {
+            tracing::warn!(error = %err, "cleanup: could not list branches");
+            return;
+        }
+    };
+    if locals.is_empty() {
+        return;
+    }
+    let Some(default) = git.default_branch() else {
+        out.push(mk(
+            Kind::Branch,
+            "branch:(default)".into(),
+            "Branch cleanup skipped".into(),
+            vec![Evidence::new("git", "no origin/HEAD, main or master found")],
+            Verdict::Skip,
+            "The default branch could not be determined, so no branch can be judged finished. Run `git remote set-head origin --auto` and retry.",
+            Action::None,
+            &[("why", "no-default".into())],
+        ));
+        return;
+    };
+    let default_tips: Vec<String> = [
+        git.rev(&format!("refs/heads/{default}")),
+        git.rev(&format!("refs/remotes/origin/{default}")),
+    ]
+    .into_iter()
+    .flatten()
+    .collect();
+    let current = git.current_branch();
+    let worktrees = git.worktrees().unwrap_or_else(|err| {
+        tracing::warn!(error = %err, "cleanup: could not list worktrees; assuming none");
+        Vec::new()
+    });
+
+    // Worktree records whose directory has vanished.
+    let gone: Vec<&Worktree> = worktrees.iter().filter(|w| w.prunable).collect();
+    if !gone.is_empty() {
+        let paths: Vec<String> = gone.iter().map(|w| w.path.display().to_string()).collect();
+        let mut f = mk(
+            Kind::Worktree,
+            "worktree:stale-records".into(),
+            format!(
+                "{} worktree record(s) point at deleted directories",
+                gone.len()
+            ),
+            paths
+                .iter()
+                .map(|p| Evidence::new("git", format!("{p} no longer exists")))
+                .collect(),
+            Verdict::AutoSafe,
+            "The directories are already gone; only git's bookkeeping is removed.",
+            Action::PruneWorktrees,
+            &[("paths", paths.join(","))],
+        );
+        f.manual_command = Some("git worktree prune".into());
+        out.push(f);
+    }
+
+    for (name, sha) in &locals {
+        if *name == default {
+            continue;
+        }
+        let wt = worktrees
+            .iter()
+            .enumerate()
+            .find(|(_, w)| w.branch.as_deref() == Some(name.as_str()) && !w.prunable);
+        let title = format!("Branch {name}");
+        let id = format!("branch:{name}");
+        let mut evidence = vec![Evidence::new("git", format!("tip {}", short_sha(sha)))];
+
+        // Never touched: the branch someone is on right now.
+        let at_root = current.as_deref() == Some(name.as_str())
+            || wt.is_some_and(|(_, w)| same_path(&w.path, &e.paths.root));
+        if at_root {
+            out.push(mk(
+                Kind::Branch,
+                id,
+                title,
+                evidence,
+                Verdict::Skip,
+                "This is the current branch; cleanup never touches it.",
+                Action::None,
+                &[("branch", name.clone()), ("why", "current".into())],
+            ));
+            continue;
+        }
+        if let Some((0, w)) = wt {
+            out.push(mk(
+                Kind::Branch,
+                id,
+                title,
+                evidence,
+                Verdict::Skip,
+                format!(
+                    "Checked out in the main worktree at {}; cleanup never touches it.",
+                    w.path.display()
+                ),
+                Action::None,
+                &[("branch", name.clone()), ("why", "main-worktree".into())],
+            ));
+            continue;
+        }
+
+        let review = e.truth.branch_review(name);
+        let in_default = |b: &Git| -> bool {
+            !default_tips.contains(sha) && default_tips.iter().any(|t| b.is_ancestor(sha, t))
+        };
+        let (open_pr, verdict) = match &review {
+            BranchReview::Review {
+                review_ref,
+                state,
+                head_sha,
+            } => {
+                let pr = format!("PR #{review_ref}");
+                match state {
+                    ReviewState::Open => {
+                        evidence.push(Evidence::new("vcs", format!("{pr} is open")));
+                        (
+                            true,
+                            Verdicts::Question(format!(
+                                "{pr} is still open; the work is not finished."
+                            )),
+                        )
+                    }
+                    ReviewState::Merged => {
+                        let head_text =
+                            head_sha.as_deref().map_or("head unknown".to_string(), |h| {
+                                format!("head {}", short_sha(h))
+                            });
+                        evidence.push(Evidence::new(
+                            "vcs",
+                            format!("{pr} is merged ({head_text})"),
+                        ));
+                        let verdict = match head_sha {
+                            Some(h) if sha == h || git.is_ancestor(sha, h) => Verdicts::Landed(
+                                format!("{pr} is merged and the branch has no commits beyond the PR head."),
+                            ),
+                            _ if in_default(&git) => Verdicts::Landed(format!(
+                                "{pr} is merged and the branch tip is already in {default}."
+                            )),
+                            Some(h) if git.rev(h).is_some() => {
+                                let (n, subjects) = git.commits_beyond(h, sha);
+                                for sub in &subjects {
+                                    evidence.push(Evidence::new("git", format!("beyond PR head: {sub}")));
+                                }
+                                Verdicts::Question(format!(
+                                    "{pr} is merged but the branch has {n} commit(s) beyond the PR head that never landed."
+                                ))
+                            }
+                            Some(h) => Verdicts::Question(format!(
+                                "{pr} is merged, but its head {} is not in this clone, so extra commits cannot be ruled out. Run `git fetch` and retry.",
+                                short_sha(h)
+                            )),
+                            None => Verdicts::Question(format!(
+                                "{pr} is merged, but the VCS did not report its head commit, so extra commits cannot be ruled out."
+                            )),
+                        };
+                        (false, verdict)
+                    }
+                    ReviewState::Closed => {
+                        evidence.push(Evidence::new(
+                            "vcs",
+                            format!("{pr} was closed without merging"),
+                        ));
+                        let verdict = if in_default(&git) {
+                            Verdicts::Landed(format!(
+                                "{pr} was closed, but every commit on the branch is already in {default}."
+                            ))
+                        } else {
+                            Verdicts::Question(format!(
+                                "{pr} was closed without merging; the branch may hold work that never landed."
+                            ))
+                        };
+                        (false, verdict)
+                    }
+                    ReviewState::Unknown(why) => {
+                        evidence.push(Evidence::new("vcs", format!("{pr} state unknown: {why}")));
+                        (false, history_only(&git, sha, &default, &default_tips, why))
+                    }
+                }
+            }
+            BranchReview::NoReview => {
+                evidence.push(Evidence::new("vcs", "no PR was opened from this branch"));
+                let v = if in_default(&git) {
+                    Verdicts::Landed(format!(
+                        "Every commit on the branch is already in {default}."
+                    ))
+                } else {
+                    let (n, _) = git.commits_beyond(&default, sha);
+                    Verdicts::Question(format!(
+                        "No PR exists and the branch has {n} commit(s) that are not in {default}."
+                    ))
+                };
+                (false, v)
+            }
+            BranchReview::Unknown(why) => {
+                evidence.push(Evidence::new("vcs", format!("PR state unknown: {why}")));
+                (false, history_only(&git, sha, &default, &default_tips, why))
+            }
+        };
+        // A worktree must be clean and unlocked before it may be removed with the branch.
+        let mut worktree_path: Option<PathBuf> = None;
+        let mut blocked: Option<String> = None;
+        if let Some((_, w)) = wt {
+            evidence.push(Evidence::new(
+                "git",
+                format!("checked out in worktree {}", w.path.display()),
+            ));
+            match git.dirty_files(&w.path) {
+                Ok(files) if files.is_empty() && !w.locked => worktree_path = Some(w.path.clone()),
+                Ok(files) if files.is_empty() => {
+                    blocked = Some(format!("The worktree {} is locked.", w.path.display()));
+                }
+                Ok(files) => {
+                    let total = files.len();
+                    for f in files.iter().take(FILE_LIST_CAP) {
+                        evidence.push(Evidence::new("worktree", f.clone()));
+                    }
+                    if total > FILE_LIST_CAP {
+                        evidence.push(Evidence::new(
+                            "worktree",
+                            format!("and {} more", total - FILE_LIST_CAP),
+                        ));
+                    }
+                    blocked = Some(format!(
+                        "The worktree {} has {total} uncommitted or untracked file(s) (listed above).",
+                        w.path.display()
+                    ));
+                }
+                Err(err) => {
+                    blocked = Some(format!(
+                        "The worktree {} could not be checked for local changes ({err}).",
+                        w.path.display()
+                    ));
+                }
+            }
+        }
+
+        let manual = |wt: &Option<PathBuf>| {
+            let rm = wt
+                .as_ref()
+                .map(|p| format!("git worktree remove \"{}\" && ", p.display()))
+                .unwrap_or_default();
+            format!("{rm}git branch -D \"{name}\"   # recover with: git branch \"{name}\" {sha}")
+        };
+        let facts = |why: &str| {
+            vec![
+                ("branch", name.clone()),
+                ("tip", sha.clone()),
+                ("why", why.to_string()),
+            ]
+        };
+        let delete = |wt: Option<PathBuf>| Action::DeleteBranch {
+            branch: name.clone(),
+            sha: sha.clone(),
+            worktree: wt,
+        };
+
+        let mut f = match (verdict, blocked) {
+            (Verdicts::Landed(reason), None) => {
+                let mut f = mk(
+                    Kind::Branch,
+                    id,
+                    title,
+                    evidence,
+                    Verdict::AutoSafe,
+                    reason,
+                    delete(worktree_path.clone()),
+                    &facts("landed"),
+                );
+                f.manual_command = Some(manual(&worktree_path));
+                f
+            }
+            (Verdicts::Landed(reason), Some(why)) => {
+                let mut f = mk(
+                    Kind::Branch,
+                    id,
+                    title,
+                    evidence,
+                    Verdict::Ask,
+                    format!("{reason} But it is kept: {why}"),
+                    Action::None,
+                    &facts("landed-blocked"),
+                );
+                f.options = vec![keep_option()];
+                f.recommended = Some("keep".into());
+                f
+            }
+            (Verdicts::Question(reason), blocked) => {
+                let mut f = mk(
+                    Kind::Branch,
+                    id,
+                    title,
+                    evidence,
+                    Verdict::Ask,
+                    match &blocked {
+                        Some(why) => format!("{reason} {why}"),
+                        None => reason,
+                    },
+                    Action::None,
+                    &facts(if open_pr { "open" } else { "unlanded" }),
+                );
+                f.options = vec![keep_option()];
+                if blocked.is_none() {
+                    f.options.push(AnswerOption {
+                        key: "delete".into(),
+                        label: format!(
+                            "Delete the branch (tip {} is logged so it can be restored)",
+                            short_sha(sha)
+                        ),
+                        action: delete(worktree_path.clone()),
+                    });
+                    f.manual_command = Some(manual(&worktree_path));
+                }
+                f.recommended = Some("keep".into());
+                f
+            }
+        };
+        f.bytes = 0;
+        out.push(f);
+    }
+
+    // Remote branches: findings only. The repo deletes merged heads itself.
+    match git.remote_branches() {
+        Ok(remotes) => {
+            let mut seen = std::collections::HashSet::new();
+            for (name, _) in remotes {
+                if name == default || !seen.insert(name.clone()) {
+                    continue;
+                }
+                if let BranchReview::Review {
+                    review_ref,
+                    state: ReviewState::Closed,
+                    ..
+                } = e.truth.branch_review(&name)
+                {
+                    out.push(mk(
+                        Kind::RemoteBranch,
+                        format!("remote_branch:{name}"),
+                        format!("Remote branch {name}"),
+                        vec![Evidence::new(
+                            "vcs",
+                            format!("PR #{review_ref} was closed without merging"),
+                        )],
+                        Verdict::Skip,
+                        "Its PR was closed unmerged. Cleanup never deletes remote branches; review it and delete it yourself if the work is abandoned.",
+                        Action::None,
+                        &[("branch", name.clone()), ("why", "remote-closed".into())],
+                    ));
+                }
+            }
+        }
+        Err(err) => {
+            tracing::warn!(error = %err, "cleanup: could not list remote branches");
+        }
+    }
+}
+
+/// No usable PR answer: git history can still prove the work is in the default branch.
+fn history_only(
+    git: &Git,
+    sha: &str,
+    default: &str,
+    default_tips: &[String],
+    why: &str,
+) -> Verdicts {
