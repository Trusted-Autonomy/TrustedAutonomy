+//! The `branches` group, against real git repositories in temp dirs: a bare
+//! repo as `origin`, a clone as the project, and PR state faked through
+//! `GroundTruth::branch_review`.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use crate::act::FileCloser;
+use crate::branches::{parse_worktrees, Git};
+use crate::*;
+
+#[derive(Default)]
+struct Truth {
+    reviews: HashMap<String, BranchReview>,
+}
+
+impl GroundTruth for Truth {
+    fn review_state(&self, _r: &str) -> ReviewState {
+        ReviewState::Unknown("not used".into())
+    }
+    fn phase_done(&self, _p: &str) -> bool {
+        false
+    }
+    fn branch_review(&self, branch: &str) -> BranchReview {
+        self.reviews
+            .get(branch)
+            .cloned()
+            .unwrap_or(BranchReview::NoReview)
+    }
+}
+
+fn merged(sha: &str) -> BranchReview {
+    BranchReview::Review {
+        review_ref: "7".into(),
+        state: ReviewState::Merged,
+        head_sha: Some(sha.into()),
+    }
+}
+
+fn with_state(state: ReviewState) -> BranchReview {
+    BranchReview::Review {
+        review_ref: "9".into(),
+        state,
+        head_sha: None,
+    }
+}
+
+fn git(dir: &Path, args: &[&str]) -> String {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(dir)
+        .args(args)
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .output()
+        .expect("git runs");
+    assert!(
+        out.status.success(),
+        "git {args:?} failed: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    String::from_utf8_lossy(&out.stdout).trim().to_string()
+}
+
+struct Repo {
+    dir: tempfile::TempDir,
+    work: PathBuf,
+}
+
+impl Repo {
+    /// `origin` (bare) and `work` (a clone on `main` with one pushed commit).
+    fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let origin = dir.path().join("origin.git");
+        let work = dir.path().join("work");
+        std::fs::create_dir_all(&origin).unwrap();
+        git(&origin, &["init", "--bare", "-b", "main"]);
+        git(
+            dir.path(),
+            &["clone", origin.to_str().unwrap(), work.to_str().unwrap()],
+        );
+        for (k, v) in [("user.email", "t@example.com"), ("user.name", "T")] {
+            git(&work, &["config", k, v]);
+        }
+        git(&work, &["checkout", "-B", "main"]);
+        let r = Repo { dir, work };
+        r.commit("README.md", "hello\n", "initial");
+        git(&r.work, &["push", "-u", "origin", "main"]);
+        git(&r.work, &["remote", "set-head", "origin", "main"]);
+        r
+    }
+
+    fn commit(&self, file: &str, body: &str, msg: &str) -> String {
+        self.commit_in(&self.work, file, body, msg)
+    }
+
+    fn commit_in(&self, dir: &Path, file: &str, body: &str, msg: &str) -> String {
+        std::fs::write(dir.join(file), body).unwrap();
+        git(dir, &["add", file]);
+        git(dir, &["commit", "-m", msg]);
+        git(dir, &["rev-parse", "HEAD"])
+    }
+
+    /// A branch with one commit, pushed, left checked out on `main`.
+    fn feature(&self, name: &str) -> String {
+        git(&self.work, &["checkout", "-b", name]);
+        let sha = self.commit(&format!("{}.txt", name.replace('/', "_")), "work\n", name);
+        git(&self.work, &["push", "origin", name]);
+        git(&self.work, &["checkout", "main"]);
+        sha
+    }
+
+    /// Land `file` on origin/main as one unrelated commit, as a squash merge would.
+    fn squash_into_main(&self, file: &str) {
+        self.commit(file, "squashed\n", "squash merge");
+        git(&self.work, &["push", "origin", "main"]);
+    }
+
+    fn branches(&self) -> Vec<String> {
+        git(
+            &self.work,
+            &["for-each-ref", "--format=%(refname:short)", "refs/heads"],
+        )
+        .lines()
+        .map(str::to_string)
+        .collect()
+    }
+
+    fn has(&self, branch: &str) -> bool {
+        self.branches().iter().any(|b| b == branch)
+    }
+}
+
+fn engine<'a>(repo: &Repo, truth: &'a Truth, settings: Settings) -> Engine<'a> {
+    Engine {
+        paths: Paths::for_project(&repo.work),
+        settings,
+        truth,
+        closer: &FileCloser,
+        assistant: None,
+    }
+}
+
+fn run_branches(repo: &Repo, truth: &Truth, auto_safe: bool, dry_run: bool) -> Report {
+    let e = engine(repo, truth, Settings::default());
+    run(
+        &e,
+        &RunOptions {
+            only: Some(vec![Category::Branches]),
+            auto_safe_only: auto_safe,
+            dry_run,
+            ..Default::default()
+        },
+        None,
+    )
+    .unwrap()
+}
+
+fn finding<'a>(r: &'a Report, branch: &str) -> &'a Finding {
+    r.findings
+        .iter()
+        .find(|f| f.id == format!("branch:{branch}"))
+        .unwrap_or_else(|| panic!("no finding for {branch}: {:?}", r.findings))
+}
+
+#[test]
+fn squash_merged_branch_is_deleted_and_logged_with_its_tip() {
+    let repo = Repo::new();
+    let tip = repo.feature("feat/a");
+    // A real project always has `.ta/`; the audit log lives in it.
+    std::fs::create_dir_all(repo.work.join(".ta")).unwrap();
+    // The squash commit shares no history with the branch, so `git branch -d`
+    // and ancestry checks would call it unmerged.
+    repo.squash_into_main("a.txt");
+    let mut truth = Truth::default();
+    truth.reviews.insert("feat/a".into(), merged(&tip));
+
+    let r = run_branches(&repo, &truth, true, false);
+
+    assert!(!repo.has("feat/a"), "merged branch should be gone");
+    assert!(repo.has("main"));
+    let done = r
+        .done
+        .iter()
+        .find(|d| d.finding_id == "branch:feat/a")
+        .unwrap();
+    assert!(
+        done.summary.contains("feat/a") && done.summary.contains(&tip),
+        "summary names branch and full tip: {}",
+        done.summary
+    );
+    let audit = std::fs::read_to_string(repo.work.join(".ta/audit.jsonl")).unwrap();
+    assert!(
+        audit.contains("feat/a") && audit.contains(&tip),
+        "cleanup log must hold branch and tip SHA: {audit}"
+    );
+    // Recoverable from the logged tip.
+    git(&repo.work, &["branch", "restored", &tip]);
+}
+
+#[test]
+fn open_pr_is_a_question_and_the_branch_is_kept() {
+    let repo = Repo::new();
+    repo.feature("feat/open");
+    let mut truth = Truth::default();
+    truth
+        .reviews
+        .insert("feat/open".into(), with_state(ReviewState::Open));
+
+    let r = run_branches(&repo, &truth, false, false);
+
+    let f = finding(&r, "feat/open");
+    assert_eq!(f.verdict, Verdict::Ask);
+    assert!(f.reason.contains("still open"), "{}", f.reason);
+    assert!(repo.has("feat/open"));
+    assert!(r.done.is_empty());
+    assert!(r.questions_open.contains(&"branch:feat/open".to_string()));
+}
