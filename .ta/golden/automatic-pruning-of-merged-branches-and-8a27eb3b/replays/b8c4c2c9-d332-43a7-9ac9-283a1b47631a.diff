+#[test]
+fn commits_beyond_the_pr_head_are_asked_about_not_deleted() {
+    let repo = Repo::new();
+    let pr_head = repo.feature("feat/more");
+    git(&repo.work, &["checkout", "feat/more"]);
+    repo.commit("late.txt", "after the PR\n", "late work");
+    git(&repo.work, &["checkout", "main"]);
+    repo.squash_into_main("more.txt");
+    let mut truth = Truth::default();
+    truth.reviews.insert("feat/more".into(), merged(&pr_head));
+
+    let r = run_branches(&repo, &truth, false, false);
+
+    let f = finding(&r, "feat/more");
+    assert_eq!(f.verdict, Verdict::Ask);
+    assert!(f.reason.contains("1 commit"), "{}", f.reason);
+    assert!(
+        f.evidence.iter().any(|e| e.fact.contains("late work")),
+        "the extra commit is listed: {:?}",
+        f.evidence
+    );
+    assert!(repo.has("feat/more"));
+}
