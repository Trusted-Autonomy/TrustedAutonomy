+#[test]
+fn dirty_worktree_is_asked_about_with_its_file_list() {
+    let repo = Repo::new();
+    let tip = repo.feature("feat/wt");
+    repo.squash_into_main("wt.txt");
+    let wt = repo.dir.path().join("wt");
+    git(
+        &repo.work,
+        &["worktree", "add", wt.to_str().unwrap(), "feat/wt"],
+    );
+    std::fs::write(wt.join("scratch.txt"), "not committed\n").unwrap();
+    let mut truth = Truth::default();
+    truth.reviews.insert("feat/wt".into(), merged(&tip));
+
+    let r = run_branches(&repo, &truth, true, false);
+
+    let f = finding(&r, "feat/wt");
+    assert_eq!(f.verdict, Verdict::Ask);
+    assert!(
+        f.evidence.iter().any(|e| e.fact.contains("scratch.txt")),
+        "file list in evidence: {:?}",
+        f.evidence
+    );
+    assert!(repo.has("feat/wt"), "dirty worktree keeps its branch");
+    assert!(wt.join("scratch.txt").exists(), "nothing was removed");
+    assert!(!f.options.iter().any(|o| o.key == "delete"));
+}
