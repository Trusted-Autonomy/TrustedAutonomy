+/// Map the adapter's answer onto the engine's. Merged and closed are final facts;
+/// anything unclear stays `Unknown` so it is asked about, never acted on.
+pub fn branch_review_from(
+    r: Result<ta_submit::BranchReviewLookup, ta_submit::adapter::SubmitError>,
+) -> BranchReview {
+    use ta_submit::BranchReviewLookup as L;
+    match r {
+        Ok(L::Unsupported) => {
+            BranchReview::Unknown("the VCS adapter cannot look up PRs by branch".into())
+        }
+        Ok(L::NoReview) => BranchReview::NoReview,
+        Ok(L::Found(b)) => BranchReview::Review {
+            review_ref: b.review_id,
+            state: match b.state.to_ascii_lowercase().as_str() {
+                "merged" => ReviewState::Merged,
+                "closed" => ReviewState::Closed,
+                "open" | "draft" => ReviewState::Open,
+                other => ReviewState::Unknown(format!("unrecognised review state '{other}'")),
+            },
+            head_sha: b.head_sha,
+        },
+        Err(e) => BranchReview::Unknown(format!("VCS lookup failed: {e}")),
+    }
+}
