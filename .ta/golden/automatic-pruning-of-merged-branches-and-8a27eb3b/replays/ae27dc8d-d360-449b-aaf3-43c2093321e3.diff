+    fn default_branch(&self) -> Result<Option<String>> {
+        // origin/HEAD is the authority when a remote exists; otherwise fall back to the
+        // conventional names, then to whatever the repository's init.defaultBranch implies.
+        if let Ok(r) = self.git_cmd(&["symbolic-ref", "--short", "refs/remotes/origin/HEAD"]) {
+            if let Some(name) = r.strip_prefix("origin/") {
+                return Ok(Some(name.to_string()));
+            }
+        }
+        for cand in ["main", "master", "trunk"] {
+            if self
+                .git_cmd(&[
+                    "rev-parse",
+                    "--verify",
+                    "--quiet",
+                    &format!("refs/heads/{cand}"),
+                ])
+                .is_ok()
+            {
+                return Ok(Some(cand.to_string()));
+            }
+        }
+        Ok(None)
+    }
+
+    fn local_branches(&self) -> Result<Vec<LocalBranch>> {
+        let refs = self.git_cmd(&[
+            "for-each-ref",
+            "--format=%(refname:short)%09%(objectname)",
+            "refs/heads",
+        ])?;
+        let current = self
+            .git_cmd(&["symbolic-ref", "--short", "-q", "HEAD"])
+            .ok()
+            .filter(|b| !b.is_empty());
+        let worktrees = self.git_cmd(&["worktree", "list", "--porcelain"])?;
+        // branch name -> (worktree path, is the main worktree)
+        let mut held: HashMap<String, (PathBuf, bool)> = HashMap::new();
+        let mut path: Option<PathBuf> = None;
+        let mut first = true;
+        for line in worktrees.lines().chain(std::iter::once("")) {
+            if let Some(p) = line.strip_prefix("worktree ") {
+                path = Some(PathBuf::from(p));
+            } else if let Some(b) = line.strip_prefix("branch refs/heads/") {
+                if let Some(p) = &path {
+                    held.insert(b.to_string(), (p.clone(), first));
+                }
+            } else if line.is_empty() && path.is_some() {
+                path = None;
+                first = false;
+            }
+        }
+        Ok(refs
+            .lines()
+            .filter_map(|l| l.split_once('\t'))
+            .map(|(name, sha)| {
+                let holder = held.get(name);
+                LocalBranch {
+                    name: name.to_string(),
+                    tip_sha: sha.to_string(),
+                    is_current: current.as_deref() == Some(name),
+                    worktree: holder.map(|(p, _)| p.clone()),
+                    worktree_is_main: holder.is_some_and(|(_, main)| *main),
+                }
+            })
+            .collect())
+    }
