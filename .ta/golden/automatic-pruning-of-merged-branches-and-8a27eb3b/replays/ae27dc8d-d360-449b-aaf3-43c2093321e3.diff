+
+/// Remove a finished branch's worktree, then the branch. The worktree goes first and is never
+/// forced, so uncommitted work stops the whole thing; the ref is deleted only while it still
+/// points at `tip_sha`. The name and sha are written to the cleanup log before the ref goes, so
+/// the branch can always be restored with `git branch <name> <sha>`.
+fn prune_branch(
+    e: &Engine,
+    branch: &str,
+    tip_sha: &str,
+    worktree: Option<&Path>,
+    reason: &str,
+) -> anyhow::Result<(String, u64)> {
+    // The scan may be old by now: ask again, so work added since is never lost.
+    if let Some(wt) = worktree {
+        let dirty = e.truth.worktree_dirty_files(wt)?;
+        if !dirty.is_empty() {
+            anyhow::bail!(
+                "worktree {} now has {} uncommitted or untracked file(s) ({}); branch '{branch}' was kept",
+                wt.display(),
+                dirty.len(),
+                dirty.join(", ")
+            );
+        }
+    }
+    crate::state::append_jsonl(
+        &e.paths.cleanup_dir().join("branches.jsonl"),
+        &serde_json::json!({
+            "branch": branch,
+            "tip_sha": tip_sha,
+            "worktree": worktree.map(|w| w.display().to_string()),
+            "reason": reason,
+            "restore": format!("git branch {branch} {tip_sha}"),
+            "at": Utc::now().to_rfc3339(),
+        }),
+    )?;
+    if let Some(wt) = worktree {
+        e.truth.remove_worktree(wt)?;
+    }
+    e.truth.delete_local_branch(branch, tip_sha)?;
+    Ok((
+        format!(
+            "deleted branch {branch} (tip {tip_sha}{}); restore with `git branch {branch} {tip_sha}`",
+            worktree
+                .map(|w| format!(", removed worktree {}", w.display()))
+                .unwrap_or_default()
+        ),
+        0,
+    ))
