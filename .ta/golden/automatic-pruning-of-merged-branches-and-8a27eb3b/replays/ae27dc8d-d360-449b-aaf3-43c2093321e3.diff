+        // caller never reads a missing tool as a fact.
+        if !self.has_gh_cli() {
+            return Err(SubmitError::VcsError(
+                "gh CLI not found; install GitHub CLI so PR state can be checked".to_string(),
+            ));
+        }
+        let out = run_gh_bounded(
+            &self.gh_program,
+            &[
+                "pr",
+                "list",
+                "--head",
+                branch,
+                "--state",
+                "all",
+                "--limit",
+                "30",
+                "--json",
+                "number,state,headRefOid,mergedAt",
+            ],
+            &self.work_dir,
+            Duration::from_secs(30),
+        );
+        let Some(out) = out.filter(|o| o.status.success()) else {
+            return Err(SubmitError::VcsError(format!(
+                "`gh pr list --head {branch}` failed or timed out; check `gh auth status`"
+            )));
+        };
+        let prs: Vec<serde_json::Value> = serde_json::from_slice(&out.stdout).map_err(|e| {
+            SubmitError::VcsError(format!("Failed to parse gh pr list output: {e}"))
+        })?;
+        let field =
+            |p: &serde_json::Value, k: &str| p.get(k).and_then(|v| v.as_str()).map(str::to_string);
+        let review = |p: &serde_json::Value, state: &str| BranchReview {
+            state: state.to_string(),
+            review_id: p
+                .get("number")
+                .and_then(|n| n.as_u64())
+                .map(|n| n.to_string())
+                .unwrap_or_default(),
+            head_sha: field(p, "headRefOid"),
+        };
+        let state_of = |p: &serde_json::Value| field(p, "state").unwrap_or_default().to_lowercase();
+        if let Some(p) = prs.iter().find(|p| state_of(p) == "open") {
