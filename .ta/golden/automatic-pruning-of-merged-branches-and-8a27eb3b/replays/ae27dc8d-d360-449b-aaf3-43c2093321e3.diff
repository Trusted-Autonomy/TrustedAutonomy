+//! The `branches` group against real git repositories (a local bare repo as origin) with PR
+//! state faked through the same ground-truth seam the engine uses in production.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use ta_submit::GitAdapter;
+
+use crate::act::FileCloser;
+use crate::vcs::AdapterBranches;
+use crate::*;
+
+fn git(dir: &Path, args: &[&str]) -> String {
+    let out = Command::new("git")
+        .args(["-c", "user.name=t", "-c", "user.email=t@example.com"])
+        .args([
+            "-c",
+            "commit.gpgsign=false",
+            "-c",
+            "init.defaultBranch=main",
+        ])
+        .args(args)
+        .current_dir(dir)
+        .env_remove("GIT_DIR")
+        .env_remove("GIT_WORK_TREE")
+        .output()
+        .unwrap();
+    assert!(
+        out.status.success(),
+        "git {args:?} failed: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    String::from_utf8_lossy(&out.stdout).trim().to_string()
+}
+
+/// Real git for everything local, a table for the PR platform.
+struct Truth {
+    adapter: GitAdapter,
+    prs: HashMap<String, BranchPr>,
+    closed_remote: Vec<RemoteBranchInfo>,
+}
+
+impl Truth {
+    fn b(&self) -> AdapterBranches<'_> {
+        AdapterBranches(&self.adapter)
+    }
+}
+
+impl GroundTruth for Truth {
+    fn review_state(&self, _r: &str) -> ReviewState {
+        ReviewState::Unknown("not used".into())
+    }
+    fn phase_done(&self, _p: &str) -> bool {
+        false
+    }
+    fn default_branch(&self) -> Option<String> {
+        self.b().default_branch()
+    }
+    fn local_branches(&self) -> anyhow::Result<Vec<BranchInfo>> {
+        self.b().local_branches()
+    }
+    fn branch_pr(&self, branch: &str) -> BranchPr {
+        self.prs.get(branch).cloned().unwrap_or(BranchPr::NoPr)
+    }
+    fn is_ancestor(&self, sha: &str, target: &str) -> Option<bool> {
+        self.b().is_ancestor(sha, target)
+    }
+    fn worktree_dirty_files(&self, path: &Path) -> anyhow::Result<Vec<String>> {
+        self.b().worktree_dirty_files(path)
+    }
+    fn delete_local_branch(&self, branch: &str, sha: &str) -> anyhow::Result<()> {
+        self.b().delete_local_branch(branch, sha)
+    }
+    fn remove_worktree(&self, path: &Path) -> anyhow::Result<()> {
+        self.b().remove_worktree(path)
+    }
+    fn closed_unmerged_remote_branches(&self) -> Vec<RemoteBranchInfo> {
+        self.closed_remote.clone()
+    }
+}
+
+struct Repo {
+    _dir: tempfile::TempDir,
+    repo: PathBuf,
+    wts: PathBuf,
+}
+
+impl Repo {
+    /// `origin.git` (bare) plus a clone with one commit on `main`, pushed.
+    fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let origin = dir.path().join("origin.git");
+        let repo = dir.path().join("repo");
+        let wts = dir.path().join("worktrees");
+        std::fs::create_dir_all(&origin).unwrap();
+        std::fs::create_dir_all(&wts).unwrap();
+        git(&origin, &["init", "--bare", "-b", "main"]);
+        git(dir.path(), &["clone", origin.to_str().unwrap(), "repo"]);
+        git(&repo, &["checkout", "-b", "main"]);
+        std::fs::write(repo.join("base.txt"), "base\n").unwrap();
+        git(&repo, &["add", "."]);
+        git(&repo, &["commit", "-m", "base"]);
+        git(&repo, &["push", "-u", "origin", "main"]);
+        git(&repo, &["remote", "set-head", "origin", "main"]);
+        Repo {
+            _dir: dir,
+            repo,
+            wts,
+        }
+    }
+
+    /// A branch off main with one commit. Returns its tip. Leaves `main` checked out.
+    fn branch(&self, name: &str) -> String {
+        git(&self.repo, &["checkout", "-b", name, "main"]);
+        let file = format!("{}.txt", name.replace('/', "_"));
+        std::fs::write(self.repo.join(&file), name).unwrap();
+        git(&self.repo, &["add", "."]);
+        git(&self.repo, &["commit", "-m", name]);
+        let tip = git(&self.repo, &["rev-parse", "HEAD"]);
+        git(&self.repo, &["checkout", "main"]);
+        tip
+    }
+
+    fn commit_on(&self, name: &str, file: &str) -> String {
+        git(&self.repo, &["checkout", name]);
+        std::fs::write(self.repo.join(file), "more").unwrap();
+        git(&self.repo, &["add", "."]);
+        git(&self.repo, &["commit", "-m", file]);
+        let tip = git(&self.repo, &["rev-parse", "HEAD"]);
+        git(&self.repo, &["checkout", "main"]);
+        tip
+    }
+
+    /// Land `name` on main the way a squash merge does: new commit, same content, new sha.
+    fn squash_into_main(&self, name: &str) {
+        git(&self.repo, &["merge", "--squash", name]);
+        git(&self.repo, &["commit", "-m", &format!("squash {name}")]);
+        git(&self.repo, &["push", "origin", "main"]);
+    }
+
+    fn worktree(&self, branch: &str) -> PathBuf {
+        let p = self.wts.join(branch.replace('/', "_"));
+        git(
+            &self.repo,
+            &["worktree", "add", p.to_str().unwrap(), branch],
+        );
+        p
+    }
+
+    fn exists(&self, branch: &str) -> bool {
+        !git(
+            &self.repo,
+            &["branch", "--list", branch, "--format=%(refname:short)"],
+        )
+        .is_empty()
+    }
+
+    fn truth(&self, prs: Vec<(&str, BranchPr)>) -> Truth {
+        Truth {
+            adapter: GitAdapter::new(&self.repo),
+            prs: prs.into_iter().map(|(b, p)| (b.to_string(), p)).collect(),
+            closed_remote: Vec::new(),
+        }
+    }
+
+    fn engine<'a>(&self, truth: &'a Truth, settings: Settings) -> Engine<'a> {
+        Engine {
+            paths: Paths::for_project(&self.repo),
+            settings,
+            truth,
+            closer: &FileCloser,
+            assistant: None,
+        }
+    }
+}
+
+fn merged(id: &str, head: &str) -> BranchPr {
+    BranchPr::Merged {
+        review_id: id.into(),
+        head_sha: Some(head.into()),
+    }
+}
+
+fn branches_only() -> RunOptions {
+    RunOptions {
+        only: Some(vec![Category::Branches]),
+        ..Default::default()
+    }
+}
+
+fn finding<'a>(r: &'a Report, branch: &str) -> &'a Finding {
+    let id = format!("branch:{branch}");
+    r.findings.iter().find(|f| f.id == id).unwrap_or_else(|| {
+        panic!(
+            "no finding {id}: {:?}",
+            r.findings.iter().map(|f| &f.id).collect::<Vec<_>>()
+        )
+    })
+}
+
+#[test]
+fn squash_merged_branch_is_deleted_and_logged_with_its_sha() {
+    let r = Repo::new();
+    let tip = r.branch("feature/squash");
+    r.squash_into_main("feature/squash");
+    // The premise: a squash merge leaves the tip outside main, so ancestry alone cannot see it.
+    assert!(!git(&r.repo, &["branch", "--merged", "main"]).contains("feature/squash"));
+    let t = r.truth(vec![("feature/squash", merged("12", &tip))]);
+    let e = r.engine(&t, Settings::default());
+
+    let report = run(&e, &branches_only(), None).unwrap();
+
+    assert_eq!(
+        finding(&report, "feature/squash").verdict,
+        Verdict::AutoSafe
+    );
+    assert!(!r.exists("feature/squash"));
+    assert_eq!(report.done.len(), 1);
+    assert!(
+        report.done[0].summary.contains(&tip),
+        "{}",
+        report.done[0].summary
+    );
+    let log = std::fs::read_to_string(r.repo.join(".ta/cleanup/branches.jsonl")).unwrap();
+    assert!(
+        log.contains("feature/squash") && log.contains(&tip),
+        "{log}"
+    );
+    assert!(
+        log.contains(&format!("git branch feature/squash {tip}")),
+        "{log}"
+    );
+    // Recoverable from the logged sha alone.
+    git(&r.repo, &["branch", "restored", &tip]);
+    assert!(r.exists("restored"));
+}
