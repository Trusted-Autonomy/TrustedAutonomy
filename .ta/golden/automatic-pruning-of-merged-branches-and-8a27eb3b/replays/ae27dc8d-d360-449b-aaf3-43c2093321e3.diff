+//! Bridges a [`SourceAdapter`] to the branch questions in [`GroundTruth`], so the CLI and the
+//! daemon answer them identically and no VCS command lives outside the adapter.
+
+use std::path::Path;
+
+use ta_submit::SourceAdapter;
+
+use crate::model::{BranchInfo, BranchPr, RemoteBranchInfo};
+
+pub struct AdapterBranches<'a>(pub &'a dyn SourceAdapter);
+
+impl AdapterBranches<'_> {
+    pub fn default_branch(&self) -> Option<String> {
+        self.0.default_branch().ok().flatten()
+    }
+
+    pub fn local_branches(&self) -> anyhow::Result<Vec<BranchInfo>> {
+        Ok(self
+            .0
+            .local_branches()
+            .map_err(|e| anyhow::anyhow!("could not list local branches: {e}"))?
+            .into_iter()
+            .map(|b| BranchInfo {
+                name: b.name,
+                tip_sha: b.tip_sha,
+                is_current: b.is_current,
+                worktree: b.worktree,
+                worktree_is_main: b.worktree_is_main,
+            })
+            .collect())
+    }
+
+    pub fn branch_pr(&self, branch: &str) -> BranchPr {
+        match self.0.branch_review(branch) {
+            Ok(Some(r)) => match r.state.as_str() {
+                "open" => BranchPr::Open {
+                    review_id: r.review_id,
+                },
+                "merged" => BranchPr::Merged {
+                    review_id: r.review_id,
+                    head_sha: r.head_sha,
+                },
+                "closed" => BranchPr::Closed {
+                    review_id: r.review_id,
+                },
+                other => BranchPr::Unknown(format!("unrecognised review state '{other}'")),
+            },
+            // An adapter that could look up reviews and found none. Adapters that cannot look
+            // them up return an error instead, so this is a fact, not a guess.
+            Ok(None) => BranchPr::NoPr,
+            Err(e) => BranchPr::Unknown(format!("VCS lookup failed: {e}")),
+        }
+    }
+
+    pub fn is_ancestor(&self, sha: &str, target: &str) -> Option<bool> {
+        self.0.is_ancestor(sha, target).ok().flatten()
+    }
+
+    pub fn worktree_dirty_files(&self, path: &Path) -> anyhow::Result<Vec<String>> {
+        self.0
+            .worktree_dirty_files(path)
+            .map_err(|e| anyhow::anyhow!("could not check {}: {e}", path.display()))
+    }
+
+    pub fn delete_local_branch(&self, branch: &str, sha: &str) -> anyhow::Result<()> {
+        self.0
+            .delete_local_branch(branch, sha)
+            .map_err(|e| anyhow::anyhow!("could not delete branch '{branch}': {e}"))
+    }
+
+    pub fn remove_worktree(&self, path: &Path) -> anyhow::Result<()> {
+        self.0
+            .remove_worktree(path)
+            .map_err(|e| anyhow::anyhow!("could not remove worktree {}: {e}", path.display()))
+    }
+
+    pub fn closed_unmerged_remote_branches(&self) -> Vec<RemoteBranchInfo> {
+        match self.0.closed_unmerged_remote_branches() {
+            Ok(v) => v
+                .into_iter()
+                .map(|b| RemoteBranchInfo {
+                    name: b.name,
+                    review_id: b.review_id,
+                })
+                .collect(),
+            Err(e) => {
+                tracing::warn!(error = %e, "cleanup: could not list remote branches with closed PRs");
+                Vec::new()
+            }
+        }
+    }
+}
