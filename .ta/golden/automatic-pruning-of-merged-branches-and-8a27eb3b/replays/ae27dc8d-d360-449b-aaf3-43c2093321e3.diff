+    fn is_ancestor(&self, sha: &str, target: &str) -> Result<Option<bool>> {
+        // A target that is not a known commit cannot answer; that is "unknown", not "no".
+        let mut known = false;
+        for cand in [target.to_string(), format!("origin/{target}")] {
+            if self
+                .git_cmd(&[
+                    "rev-parse",
+                    "--verify",
+                    "--quiet",
+                    &format!("{cand}^{{commit}}"),
+                ])
+                .is_err()
+            {
+                continue;
+            }
+            known = true;
+            let status = Command::new("git")
+                .args([
+                    "-c",
+                    "safe.directory=*",
+                    "merge-base",
+                    "--is-ancestor",
+                    sha,
+                    &cand,
+                ])
+                .current_dir(&self.work_dir)
+                .env_remove("GIT_DIR")
+                .env_remove("GIT_WORK_TREE")
+                .env_remove("GIT_INDEX_FILE")
+                .env_remove("GIT_COMMON_DIR")
+                .status()?;
+            if status.success() {
+                return Ok(Some(true));
+            }
+        }
+        Ok(known.then_some(false))
+    }
+
+    fn worktree_dirty_files(&self, path: &Path) -> Result<Vec<String>> {
