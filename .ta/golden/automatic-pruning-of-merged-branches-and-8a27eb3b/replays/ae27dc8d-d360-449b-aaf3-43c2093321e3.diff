+//! The `branches` group: finished local branches and their worktrees.
+//!
+//! Ground truth is the PR state from the VCS adapter plus commit ancestry. `git branch -d` and
+//! `git cherry` are deliberately not used: a squash merge rewrites patch ids, so both call a
+//! finished branch unmerged. Only two facts make a deletion automatic: the branch tip is
+//! already contained in the default branch, or the branch's PR is merged and the tip is the PR
+//! head (or an ancestor of it). Everything else is a question for a person, never a deletion.
+
+use super::{mk, Scan};
+use crate::model::*;
+
+fn short(sha: &str) -> &str {
+    sha.get(..9).unwrap_or(sha)
+}
+
+fn keep_option() -> AnswerOption {
+    AnswerOption {
+        key: "keep".into(),
+        label: "keep the branch as it is".into(),
+        action: Action::None,
+    }
+}
+
+pub(super) fn branches(s: &Scan, out: &mut Vec<Finding>) {
+    let truth = s.e.truth;
+    let root = &s.e.paths.root;
+
+    let local = match truth.local_branches() {
+        Ok(b) => b,
+        Err(e) => {
+            tracing::warn!(error = %e, "cleanup: could not list local branches; skipping the branches group");
+            return;
+        }
+    };
+    if local.is_empty() {
+        return;
+    }
+
+    // An apply creates its feature branch before the first commit lands on it, so for a short
+    // while a live branch looks exactly like a finished one. Wait the apply out.
+    let alive = |p: u32| truth.process_alive(p);
+    if let ta_lifecycle::ApplyLockState::Live { pid, draft_id } =
+        ta_lifecycle::apply_lock_state(root, &alive)
+    {
+        out.push(mk(
+            Kind::Branch,
+            "branch:apply-in-progress".into(),
+            "local branches".into(),
+            vec![Evidence::new(
+                "lock",
+                format!("held by running process {pid} applying draft {draft_id}"),
+            )],
+            Verdict::Skip,
+            "kept: a `ta draft apply` is in progress and may have just created a branch",
+            Action::None,
+            &[("lock", "live".into())],
+        ));
+        return;
+    }
+
+    let default = truth.default_branch();
+    let default_tip = default
+        .as_deref()
+        .and_then(|d| local.iter().find(|b| b.name == d))
+        .map(|b| b.tip_sha.clone());
+
+    for b in &local {
+        if default.as_deref() == Some(b.name.as_str()) {
+            continue;
+        }
+        if b.is_current || b.worktree_is_main {
+            out.push(mk(
+                Kind::Branch,
+                format!("branch:{}", b.name),
+                format!("branch {}", b.name),
+                vec![Evidence::new(
+                    "branch",
+                    format!(
+                        "{} at {}",
+                        if b.is_current {
+                            "checked out in this working directory"
+                        } else {
+                            "checked out in the main worktree"
+                        },
+                        short(&b.tip_sha)
+                    ),
+                )],
+                Verdict::Skip,
+                "kept: the branch in use is never touched",
+                Action::None,
+                &[("branch", b.name.clone()), ("tip", b.tip_sha.clone())],
+            ));
+            continue;
+        }
+        out.push(judge(s, b, default.as_deref(), default_tip.as_deref()));
+    }
+
+    for r in truth.closed_unmerged_remote_branches() {
+        out.push(mk(
+            Kind::RemoteBranch,
+            format!("remote_branch:{}", r.name),
+            format!("remote branch origin/{}", r.name),
+            vec![Evidence::new(
+                "vcs",
+                format!("PR #{} was closed without merging", r.review_id),
+            )],
+            Verdict::Skip,
+            "report only: remote branches are never deleted by cleanup (the host deletes merged \
+             branches itself). Review it and delete it on the host if the work is abandoned",
+            Action::None,
+            &[("remote", r.name.clone()), ("pr", r.review_id.clone())],
+        ));
+    }
+}
+
+fn judge(s: &Scan, b: &BranchInfo, default: Option<&str>, default_tip: Option<&str>) -> Finding {
+    let truth = s.e.truth;
+    let mut evidence = vec![Evidence::new(
+        "branch",
+        format!("tip {}", short(&b.tip_sha)),
+    )];
+    let mut facts: Vec<(&str, String)> =
+        vec![("branch", b.name.clone()), ("tip", b.tip_sha.clone())];
+
+    // Why this branch is safe to delete, or why it is a question.
+    let mut safe: Option<String> = None;
+    let mut question: String = String::new();
+
+    let in_default = default.and_then(|d| truth.is_ancestor(&b.tip_sha, d));
+    let same_as_default = default_tip == Some(b.tip_sha.as_str());
+    if in_default == Some(true) && !same_as_default {
+        let d = default.unwrap_or_default();
+        evidence.push(Evidence::new(
+            "git",
+            format!("tip {} is already contained in {d}", short(&b.tip_sha)),
+        ));
+        safe = Some(format!("its tip is already contained in {d}"));
+        facts.push(("in_default", "yes".into()));
+    } else {
+        let pr = truth.branch_pr(&b.name);
+        match &pr {
+            BranchPr::Merged {
+                review_id,
+                head_sha,
+            } => {
+                facts.push(("pr", format!("merged:{review_id}")));
+                let beyond = match head_sha {
+                    Some(h) if *h == b.tip_sha => Some(false),
+                    Some(h) => truth.is_ancestor(&b.tip_sha, h).map(|a| !a),
+                    None => None,
+                };
+                match beyond {
+                    Some(false) => {
+                        evidence.push(Evidence::new(
+                            "vcs",
+                            format!("PR #{review_id} is merged and the branch has no commits beyond its head"),
+                        ));
+                        safe = Some(format!(
+                            "PR #{review_id} is merged and the branch has no commits beyond the PR head"
+                        ));
+                    }
+                    Some(true) => {
+                        evidence.push(Evidence::new(
+                            "vcs",
+                            format!("PR #{review_id} is merged, but the branch has commits beyond the PR head"),
+                        ));
+                        question = format!(
+                            "PR #{review_id} is merged, but this branch has commits that were added after it. Those commits may not be in {}",
+                            default.unwrap_or("the default branch")
+                        );
+                    }
+                    None => {
+                        evidence.push(Evidence::new(
+                            "vcs",
+                            format!("PR #{review_id} is merged, but the PR head could not be compared with the branch tip"),
+                        ));
+                        question = format!(
+                            "PR #{review_id} is merged, but the PR head is unknown or not fetched, so extra commits cannot be ruled out. Run `git fetch` and retry"
+                        );
+                    }
+                }
+            }
+            BranchPr::Open { review_id } => {
+                facts.push(("pr", format!("open:{review_id}")));
+                evidence.push(Evidence::new(
+                    "vcs",
+                    format!("PR #{review_id} is still open"),
+                ));
+                question = format!("PR #{review_id} is still open, so the work is not finished");
+            }
+            BranchPr::Closed { review_id } => {
+                facts.push(("pr", format!("closed:{review_id}")));
+                evidence.push(Evidence::new(
+                    "vcs",
+                    format!("PR #{review_id} was closed without merging"),
+                ));
+                question = format!(
+                    "PR #{review_id} was closed without merging, so this branch may hold abandoned work or work that landed another way"
+                );
+            }
+            BranchPr::NoPr => {
+                facts.push(("pr", "none".into()));
+                evidence.push(Evidence::new("vcs", "no PR for this branch"));
+                question = if same_as_default {
+                    "no PR, and the branch has no commits of its own: it may have just been created"
+                        .into()
+                } else {
+                    "no PR and commits that are not in the default branch: it may hold unpublished work".into()
+                };
+            }
+            BranchPr::Unknown(why) => {
+                facts.push(("pr", "unknown".into()));
+                evidence.push(Evidence::new("vcs", format!("PR state unknown: {why}")));
+                question =
+                    format!("PR state could not be checked ({why}), so merged cannot be confirmed");
+            }
+        }
+        if in_default.is_none() && safe.is_none() && default.is_some() {
+            evidence.push(Evidence::new(
+                "git",
+                "could not compare the tip with the default branch",
+            ));
+        }
+    }
+
+    // A worktree holding the branch is pruned with it, but only when it is spotless.
+    let mut dirty: Option<Vec<String>> = None;
+    let mut worktree_err: Option<String> = None;
+    if let Some(wt) = &b.worktree {
+        match truth.worktree_dirty_files(wt) {
+            Ok(files) if files.is_empty() => {
+                evidence.push(Evidence::new(
+                    "worktree",
+                    format!("{}: clean", wt.display()),
+                ));
+            }
+            Ok(files) => {
+                evidence.push(Evidence::new(
+                    "worktree",
+                    format!(
+                        "{}: {} uncommitted or untracked file(s): {}",
+                        wt.display(),
+                        files.len(),
+                        files.join(", ")
+                    ),
+                ));
+                facts.push(("dirty", files.join(",")));
+                dirty = Some(files);
+            }
+            Err(e) => {
+                evidence.push(Evidence::new("worktree", format!("{}: {e}", wt.display())));
+                worktree_err = Some(e.to_string());
+            }
+        }
+    }
+
+    let prune = Action::PruneBranch {
+        branch: b.name.clone(),
+        tip_sha: b.tip_sha.clone(),
+        worktree: b.worktree.clone(),
+        reason: safe
+            .clone()
+            .unwrap_or_else(|| "approved by a person".into()),
+    };
+    let id = format!("branch:{}", b.name);
+    let title = match &b.worktree {
+        Some(wt) => format!("branch {} (worktree {})", b.name, wt.display()),
+        None => format!("branch {}", b.name),
+    };
+    let blocked = dirty.is_some() || worktree_err.is_some();
+    let delete_by_hand = format!(
+        "git branch -D {}   (tip {}; restore with `git branch {} {}`)",
+        b.name, b.tip_sha, b.name, b.tip_sha
+    );
+
+    if let (Some(why), false) = (&safe, blocked) {
+        let mut f = mk(
+            Kind::Branch,
+            id,
+            title,
+            evidence,
+            Verdict::AutoSafe,
+            format!("safe to delete: {why}"),
+            prune,
+            &facts,
+        );
+        f.manual_command = Some(delete_by_hand);
+        return f;
+    }
+
+    let (reason, mut options) = if let Some(files) = dirty {
+        (
+            format!(
+                "{} but its worktree has {} uncommitted or untracked file(s). Commit or discard them, then re-run",
+                safe.map(|w| format!("finished ({w})")).unwrap_or_else(|| question.clone()),
+                files.len()
+            ),
+            vec![keep_option()],
+        )
+    } else if let Some(why) = worktree_err {
+        (
+            format!("its worktree could not be checked for uncommitted work ({why}), so nothing was deleted"),
+            vec![keep_option()],
+        )
+    } else {
+        (
+            question,
+            vec![
+                keep_option(),
+                AnswerOption {
+                    key: "delete".into(),
+                    label: format!(
+                        "delete the local branch (tip {}; restorable with `git branch {} {}`)",
+                        short(&b.tip_sha),
+                        b.name,
+                        b.tip_sha
+                    ),
+                    action: prune,
+                },
+            ],
+        )
+    };
+    let mut f = mk(
+        Kind::Branch,
+        id,
+        title,
+        evidence,
+        Verdict::Ask,
+        reason,
+        Action::None,
+        &facts,
+    );
+    f.recommended = Some("keep".into());
+    f.options = std::mem::take(&mut options);
+    f.manual_command = Some(delete_by_hand);
+    f
+}
