+/// After a watched PR merges, prune the branches (and clean worktrees) that are now finished.
+/// Only the actions the rules mark safe run; anything uncertain is left for `ta cleanup`.
+/// Never fails the watch: the merge already happened.
+fn prune_finished_branches(config: &GatewayConfig, wf: &ta_submit::WorkflowConfig) {
+    if !wf.cleanup.prune_branches {
+        return;
+    }
+    match super::cleanup::run_auto_safe(config, vec![ta_cleanup::Category::Branches]) {
+        Ok(report) => {
+            if report.done.is_empty() {
+                println!("[cleanup] No finished branches to prune.");
+            }
+            for d in &report.done {
+                println!("[cleanup] {}", d.summary);
+            }
+            for (id, err) in &report.failed {
+                eprintln!("[warn] cleanup {id}: {err}");
+            }
+            if !report.questions_open.is_empty() {
+                println!(
+                    "[cleanup] {} branch(es) need a decision. Run `ta cleanup --only branches --dry-run` to see why.",
+                    report.questions_open.len()
+                );
+            }
+        }
+        Err(e) => eprintln!(
+            "[warn] Branch cleanup failed: {e}. Run `ta cleanup --only branches --dry-run` to see why."
+        ),
+    }
