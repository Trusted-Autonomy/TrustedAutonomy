+//! Export a cost report to Meridian (`ta cost report --meridian <file.jsonl>`).
+//!
+//! Meridian's generic JSONL loader reads `id`, `title`, `timestamp`,
+//! `tokens_input`, `tokens_output`, `source` and `phase`, and keeps every
+//! string-valued extra field as metadata. One record is written per session
+//! (transcripts) or goal (TA goals), built from the same filtered rows the
+//! report totals, so the export cannot disagree with the table.
+//!
+//! The write is atomic (temp file in the same directory, then rename) and
+//! idempotent by record `id`: records already in the file are kept, and a
+//! record with the same `id` is replaced rather than appended again.
+
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+
+use anyhow::Context;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+use crate::cost_report::{CostKind, CostRow, CostSourceKind};
+
+/// One Meridian record. Every metadata value is a string because Meridian's
+/// loader drops non-string extras.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct MeridianRecord {
+    pub id: String,
+    pub title: String,
+    /// RFC 3339, earliest turn of the session.
+    pub timestamp: String,
+    /// Uncached input tokens. Cache traffic is in the metadata below.
+    pub tokens_input: u64,
+    pub tokens_output: u64,
+    pub source: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub phase: Option<String>,
+    pub cost_usd: String,
+    /// "true" only when every turn's cost was reported by the runtime.
+    pub cost_exact: String,
+    pub model: String,
+    pub cache_read_tokens: String,
+    pub cache_write_tokens: String,
+    /// Largest prompt size of any turn, or "n/a" for goals (many turns).
+    pub context_peak: String,
+    /// "ta_goal" or "interactive".
+    pub workload: String,
+}
+
+/// Records built from rows, with what was left out and why.
+#[derive(Debug, Clone, PartialEq)]
+pub struct BuiltRecords {
+    pub records: Vec<MeridianRecord>,
+    /// Sessions with no timestamp on any turn. Meridian would stamp them with
+    /// the import time, which misplaces them in every window, so they are
+    /// skipped and counted instead.
+    pub skipped_no_timestamp: u64,
+}
+
+/// Group rows by (source, session) and build one record each, ordered by id.
+pub fn records_from_rows(rows: &[CostRow]) -> BuiltRecords {
+    let mut by_session: BTreeMap<(CostSourceKind, String), Vec<&CostRow>> = BTreeMap::new();
+    for r in rows {
+        by_session
+            .entry((r.source, r.session.clone()))
+            .or_default()
+            .push(r);
+    }
+    let mut records = Vec::new();
+    let mut skipped = 0;
+    for ((source, session), rs) in by_session {
+        let Some(ts) = rs.iter().filter_map(|r| r.ts).min() else {
+            skipped += 1;
+            continue;
+        };
+        let mut models: Vec<&str> = rs.iter().map(|r| r.model.as_str()).collect();
+        models.sort_unstable();
+        models.dedup();
+        let sum = |f: fn(&CostRow) -> u64| rs.iter().map(|r| f(r)).sum::<u64>();
+        let first = rs[0];
+        let title = match source {
+            CostSourceKind::Goals => first
+                .title
+                .clone()
+                .filter(|t| !t.trim().is_empty())
+                .unwrap_or_else(|| format!("TA goal {session}")),
+            _ => format!(
+                "{} session {} ({})",
+                source.as_str(),
+                session.chars().take(8).collect::<String>(),
+                first.project
+            ),
+        };
+        records.push(MeridianRecord {
+            id: format!("{}:{}", source.as_str(), session),
+            title,
+            timestamp: ts.to_rfc3339(),
+            tokens_input: sum(|r| r.usage.input),
+            tokens_output: sum(|r| r.usage.output),
+            source: source.as_str().to_string(),
+            phase: rs.iter().find_map(|r| r.phase.clone()),
+            cost_usd: format!("{:.6}", rs.iter().map(|r| r.usd).sum::<f64>()),
+            cost_exact: rs.iter().all(|r| r.kind == CostKind::Exact).to_string(),
+            model: models.join(","),
+            cache_read_tokens: sum(|r| r.usage.cache_read).to_string(),
+            cache_write_tokens: sum(|r| r.usage.cache_creation).to_string(),
+            context_peak: rs
+                .iter()
+                .filter_map(|r| r.context_tokens)
+                .max()
+                .map(|n| n.to_string())
+                .unwrap_or_else(|| "n/a".to_string()),
+            workload: if source == CostSourceKind::Goals {
+                "ta_goal"
+            } else {
+                "interactive"
+            }
+            .to_string(),
+        });
+    }
+    BuiltRecords {
+        records,
+        skipped_no_timestamp: skipped,
+    }
+}
+
+/// What a write did.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ExportOutcome {
+    pub path: PathBuf,
+    /// Records in the file after the write.
+    pub total: usize,
+    /// Ids that were not in the file before.
+    pub added: usize,
+    /// Ids that were already there and were replaced with fresh values.
+    pub replaced: usize,
+}
+
+/// Merge `records` into the JSONL file at `path` by `id` and write it
+/// atomically. Existing records with other ids are kept in their order; new ids
+/// are appended in the order given. A line of an existing file that cannot be
+/// parsed makes the call fail without touching the file, because rewriting
+/// would silently destroy it.
+pub fn write_jsonl(path: &Path, records: &[MeridianRecord]) -> anyhow::Result<ExportOutcome> {
+    let mut order: Vec<String> = Vec::new();
+    let mut lines: BTreeMap<String, String> = BTreeMap::new();
+    if path.exists() {
+        let text = std::fs::read_to_string(path).with_context(|| {
+            format!(
+                "could not read existing export {}. Check the file is readable, or choose a new \
+                 --meridian path",
+                path.display()
+            )
+        })?;
+        for (n, line) in text.lines().enumerate() {
+            if line.trim().is_empty() {
+                continue;
+            }
+            let v: Value = serde_json::from_str(line).with_context(|| {
+                format!(
+                    "{} line {} is not valid JSON, so the file was left unchanged. Fix or remove \
+                     that line, or choose a new --meridian path",
+                    path.display(),
+                    n + 1
+                )
+            })?;
+            let id = v.get("id").and_then(Value::as_str).with_context(|| {
+                format!(
+                    "{} line {} has no string `id`, so the file was left unchanged. Fix or remove \
+                     that line, or choose a new --meridian path",
+                    path.display(),
+                    n + 1
+                )
+            })?;
+            if lines.insert(id.to_string(), line.to_string()).is_none() {
+                order.push(id.to_string());
+            }
+        }
+    }
+    let (mut added, mut replaced) = (0, 0);
+    for r in records {
+        let line = serde_json::to_string(r).context("could not serialize a Meridian record")?;
+        if lines.insert(r.id.clone(), line).is_none() {
+            order.push(r.id.clone());
+            added += 1;
+        } else {
+            replaced += 1;
+        }
+    }
+    let mut body = String::new();
+    for id in &order {
+        body.push_str(&lines[id]);
+        body.push('\n');
+    }
+
+    let dir = match path.parent() {
+        Some(d) if !d.as_os_str().is_empty() => d.to_path_buf(),
+        _ => PathBuf::from("."),
+    };
+    std::fs::create_dir_all(&dir)
+        .with_context(|| format!("could not create directory {}", dir.display()))?;
+    let name = path
+        .file_name()
+        .map(|n| n.to_string_lossy().to_string())
+        .with_context(|| format!("{} is not a file path", path.display()))?;
+    let tmp = dir.join(format!(".{name}.tmp-{}", std::process::id()));
+    std::fs::write(&tmp, body)
+        .with_context(|| format!("could not write temp file {}", tmp.display()))?;
+    if let Err(e) = std::fs::rename(&tmp, path) {
+        let _ = std::fs::remove_file(&tmp);
+        return Err(e).with_context(|| {
+            format!(
+                "could not move {} into place as {}. The original file is unchanged",
+                tmp.display(),
+                path.display()
+            )
+        });
+    }
+    Ok(ExportOutcome {
+        path: path.to_path_buf(),
+        total: order.len(),
+        added,
+        replaced,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::token_cost::TokenUsage;
+    use chrono::{TimeZone, Utc};
+
+    fn row(session: &str, model: &str, out: u64, ctx: u64, kind: CostKind) -> CostRow {
+        CostRow {
+            source: CostSourceKind::Claude,
+            session: session.to_string(),
+            ts: Some(Utc.with_ymd_and_hms(2026, 10, 10, 1, 0, 0).unwrap()),
+            project: "proj".to_string(),
+            model: model.to_string(),
+            usage: TokenUsage {
+                input: 1,
+                output: out,
+                cache_read: ctx,
+                cache_creation: 10,
+            },
+            usd: 0.5,
+            kind,
+            context_tokens: Some(ctx + 11),
+            origin_class: None,
+            title: None,
+            phase: None,
+        }
+    }
+
+    #[test]
+    fn one_record_per_session_with_summed_tokens_and_string_metadata() {
+        let rows = vec![
+            row("s1", "m", 5, 100, CostKind::Exact),
+            row("s1", "m", 7, 300, CostKind::Estimated),
+            row("s2", "m", 1, 10, CostKind::Exact),
+        ];
+        let b = records_from_rows(&rows);
+        assert_eq!(b.records.len(), 2);
+        let r = &b.records[0];
+        assert_eq!(r.id, "claude_code:s1");
+        assert_eq!((r.tokens_input, r.tokens_output), (2, 12));
+        assert_eq!(r.cache_read_tokens, "400");
+        assert_eq!(r.cache_write_tokens, "20");
+        assert_eq!(r.context_peak, "311");
+        assert_eq!(r.cost_usd, "1.000000");
+        assert_eq!(r.cost_exact, "false"); // one turn was estimated
+        assert_eq!(r.workload, "interactive");
+        assert_eq!(b.records[1].cost_exact, "true");
+        // Every metadata value serializes as a JSON string (Meridian drops others).
+        let v: Value = serde_json::to_value(r).unwrap();
+        for k in [
+            "cost_usd",
+            "cost_exact",
+            "model",
+            "cache_read_tokens",
+            "cache_write_tokens",
+            "context_peak",
+            "workload",
+        ] {
+            assert!(v[k].is_string(), "{k} must be a string: {v}");
+        }
+        assert!(v["tokens_input"].is_u64() && v["timestamp"].is_string());
+    }
+
+    #[test]
+    fn goals_carry_title_phase_and_no_context_peak() {
+        let mut g = row("g1", "m", 5, 0, CostKind::Exact);
+        g.source = CostSourceKind::Goals;
+        g.context_tokens = None;
+        g.title = Some("Fix login".into());
+        g.phase = Some("v0.1".into());
+        let r = &records_from_rows(&[g]).records[0];
+        assert_eq!(r.id, "ta_goals:g1");
+        assert_eq!(r.title, "Fix login");
+        assert_eq!(r.phase.as_deref(), Some("v0.1"));
+        assert_eq!(r.context_peak, "n/a");
+        assert_eq!(r.workload, "ta_goal");
+    }
+
+    #[test]
+    fn sessions_without_a_timestamp_are_skipped_and_counted() {
+        let mut r = row("s1", "m", 1, 1, CostKind::Exact);
+        r.ts = None;
+        let b = records_from_rows(&[r]);
