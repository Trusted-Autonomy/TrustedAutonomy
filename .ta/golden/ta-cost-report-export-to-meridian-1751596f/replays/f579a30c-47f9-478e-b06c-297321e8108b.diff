+// ── Meridian export ─────────────────────────────────────────────────────────
+
+/// One Meridian generic-JSONL record: a session or a goal.
+///
+/// Meridian reads `id`, `title`, `timestamp`, `tokens_input`, `tokens_output`,
+/// `source` and `phase`, and keeps string-valued extras as metadata, so every
+/// extra here is a string.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct MeridianRecord {
+    /// `<source>:<session or goal id>`; the key the export is idempotent on.
+    pub id: String,
+    pub title: String,
+    pub timestamp: Option<String>,
+    /// Uncached input tokens. Cache traffic is in the metadata fields.
+    pub tokens_input: u64,
+    pub tokens_output: u64,
+    pub source: String,
+    /// Plan phase; transcripts and goal rows carry none, so this is empty.
+    pub phase: String,
+    pub cost_usd: String,
+    /// `"true"` when every turn's cost was reported by the runtime.
+    pub cost_exact: String,
+    pub model: String,
+    pub cache_read_tokens: String,
+    pub cache_write_tokens: String,
+    /// Largest prompt of any turn; `unknown` for goals (many turns, no peak).
+    pub context_peak: String,
+    /// `goal` for TA goals, `interactive` for Claude Code and OMP sessions.
+    pub workload: String,
+}
+
+/// Fold the report's rows into one record per session or goal, sorted by id.
+///
+/// Rows are already deduplicated by message id when scanned, so a session whose
+/// transcript repeated ids is counted once here.
+pub fn meridian_records(rows: &[CostRow]) -> Vec<MeridianRecord> {
+    struct Acc {
+        usage: TokenUsage,
+        usd: f64,
+        all_exact: bool,
+        first_ts: Option<DateTime<Utc>>,
+        peak: Option<u64>,
+        models: std::collections::BTreeSet<String>,
+        project: String,
+    }
+    let mut by_id: BTreeMap<(CostSourceKind, String), Acc> = BTreeMap::new();
+    for r in rows {
+        let a = by_id
+            .entry((r.source, r.session.clone()))
+            .or_insert_with(|| Acc {
+                usage: TokenUsage::default(),
+                usd: 0.0,
+                all_exact: true,
+                first_ts: None,
+                peak: None,
+                models: Default::default(),
+                project: r.project.clone(),
+            });
+        a.usage.input += r.usage.input;
+        a.usage.output += r.usage.output;
+        a.usage.cache_read += r.usage.cache_read;
+        a.usage.cache_creation += r.usage.cache_creation;
+        a.usd += r.usd;
+        a.all_exact &= r.kind == CostKind::Exact;
+        a.first_ts = match (a.first_ts, r.ts) {
+            (Some(x), Some(y)) => Some(x.min(y)),
+            (x, y) => x.or(y),
+        };
+        a.peak = a.peak.max(r.context_tokens);
+        a.models.insert(r.model.clone());
+    }
+    by_id
+        .into_iter()
+        .map(|((source, session), a)| {
+            let short: String = session.chars().take(8).collect();
+            MeridianRecord {
+                id: format!("{}:{}", source.as_str(), session),
+                title: format!("{} {} {}", a.project, source.as_str(), short),
+                timestamp: a.first_ts.map(|t| t.to_rfc3339()),
+                tokens_input: a.usage.input,
+                tokens_output: a.usage.output,
+                source: source.as_str().to_string(),
+                phase: String::new(),
+                cost_usd: format!("{:.6}", a.usd),
+                cost_exact: a.all_exact.to_string(),
+                model: a.models.into_iter().collect::<Vec<_>>().join(","),
+                cache_read_tokens: a.usage.cache_read.to_string(),
+                cache_write_tokens: a.usage.cache_creation.to_string(),
+                context_peak: a
+                    .peak
+                    .map_or_else(|| "unknown".to_string(), |p| p.to_string()),
+                workload: if source == CostSourceKind::Goals {
+                    "goal"
+                } else {
+                    "interactive"
+                }
+                .to_string(),
+            }
+        })
+        .collect()
+}
+
+/// Write `records` to `path` as JSONL, merging by `id` with what is already
+/// there (new values replace old ones, other records are kept), via a temp
+/// file and rename so a crash never leaves a half-written file. Returns the
+/// number of records in the file afterwards.
+pub fn write_meridian_jsonl(path: &Path, records: &[MeridianRecord]) -> Result<usize, String> {
+    let mut merged: BTreeMap<String, Value> = BTreeMap::new();
+    if path.exists() {
+        let text = std::fs::read_to_string(path).map_err(|e| {
+            format!(
+                "could not read existing export {}: {e}. Check permissions or choose another path",
+                path.display()
+            )
+        })?;
+        for (n, line) in text
+            .lines()
+            .enumerate()
+            .filter(|(_, l)| !l.trim().is_empty())
+        {
+            let v: Value = serde_json::from_str(line).map_err(|e| {
+                format!(
+                    "{} line {} is not valid JSON ({e}). Refusing to overwrite a file that is not a \
+                     previous export; move it aside or choose another path",
+                    path.display(),
+                    n + 1
+                )
+            })?;
+            let id = v
+                .get("id")
+                .and_then(Value::as_str)
+                .ok_or_else(|| {
+                    format!(
+                        "{} line {} has no string `id`. Refusing to overwrite a file that is not a \
+                         previous export; move it aside or choose another path",
+                        path.display(),
+                        n + 1
+                    )
+                })?
+                .to_string();
+            merged.insert(id, v);
+        }
+    }
+    for r in records {
+        let v = serde_json::to_value(r).map_err(|e| format!("could not encode {}: {e}", r.id))?;
+        merged.insert(r.id.clone(), v);
+    }
+    let mut out = String::new();
+    for v in merged.values() {
+        out.push_str(&v.to_string());
+        out.push('\n');
+    }
+    let parent = path.parent().filter(|p| !p.as_os_str().is_empty());
+    if let Some(dir) = parent {
+        std::fs::create_dir_all(dir)
+            .map_err(|e| format!("could not create {}: {e}", dir.display()))?;
+    }
+    let tmp = path.with_extension(format!("jsonl.tmp{}", std::process::id()));
+    std::fs::write(&tmp, out)
+        .map_err(|e| format!("could not write temp file {}: {e}", tmp.display()))?;
+    std::fs::rename(&tmp, path).map_err(|e| {
+        let _ = std::fs::remove_file(&tmp);
+        format!(
+            "could not move {} into place at {}: {e}",
+            tmp.display(),
+            path.display()
+        )
+    })?;
+    Ok(merged.len())
--- a/docs/USAGE.md
+++ b/docs/USAGE.md
+### Exporting the cost report to Meridian
+
+To analyse cost against your KPIs, write the same report to a file Meridian can read:
+
+```bash
+ta cost report --since 2026-10-01 --meridian ~/meridian/ta-cost.jsonl
+meridian analyze --source jsonl --path ~/meridian/ta-cost.jsonl
+```
+
+`--meridian <file.jsonl>` writes one record per session or goal (after the usual filters and de-duplication). Each record has `id` (`<source>:<session or goal id>`), `title`, `timestamp`, `tokens_input` (uncached), `tokens_output` and `source`, plus string metadata Meridian keeps as-is: `cost_usd`, `cost_exact` (`true` only when every turn's cost was reported by the runtime), `model`, `cache_read_tokens`, `cache_write_tokens`, `context_peak` (largest prompt of any turn, `unknown` for goals) and `workload` (`goal` or `interactive`).
+
+The write is atomic (temp file, then rename) and idempotent by `id`: running it again updates those records and leaves any others in the file alone. A file that is not a previous export (a line that is not JSON, or has no `id`) is refused and left untouched. The path, record count and the Meridian command are printed on stderr, so `--json` output stays clean.
+
