+/// Write the Meridian export and describe it: path, record count, how to read it.
+pub fn export_meridian(report: &CostReport, path: &Path) -> anyhow::Result<String> {
+    let records = meridian_records(&report.rows);
+    let total = write_meridian_jsonl(path, &records)
+        .map_err(anyhow::Error::msg)
+        .with_context(|| format!("--meridian export to {} failed", path.display()))?;
+    Ok(format!(
+        "Meridian export: wrote {} record(s) from this report to {} ({} in the file).\n\
+         Read it with: meridian analyze --source jsonl --path {}",
+        records.len(),
+        path.display(),
+        total,
+        path.display()
+    ))
+}
