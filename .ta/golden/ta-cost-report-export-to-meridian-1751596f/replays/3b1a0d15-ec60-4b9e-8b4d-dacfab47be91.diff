+//! Export a cost report to Meridian (`ta cost report --meridian <file.jsonl>`).
+//!
+//! Meridian's generic JSONL loader (`meridian-ingest`, `generic::load_jsonl`)
+//! reads `id`, `title`, `timestamp`, `tokens_input`, `tokens_output`, `source`
+//! and `phase`, and keeps only string-valued extras as metadata. One record is
+//! written per session (transcripts) or goal, so every metadata value here is a
+//! string, including the numbers.
+//!
+//! - `tokens_input` is the uncached input; cache traffic is carried separately
+//!   as `cache_read_tokens` and `cache_write_tokens`, because cache reads are
+//!   most of an interactive session's cost and would swamp the input count.
+//! - The record `id` is `<source>:<session>`, so a re-run replaces a record
+//!   instead of duplicating it. Lines already in the file that are not ours
+//!   (other ids, comments, blank lines) are kept as they were.
+//! - The write is atomic: a temp file in the same directory, then a rename.
+//!
+//! Rows arrive already deduplicated by `message.id`, so a session with repeated
+//! ids is exported once and with each message counted once.
+
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+
+use anyhow::Context;
+use chrono::{DateTime, Utc};
+use serde_json::{json, Map, Value};
+
+use crate::cost_report::{CostKind, CostRow, CostSourceKind};
+
+/// What an export wrote, for the confirmation the CLI prints.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ExportSummary {
+    pub path: PathBuf,
+    /// Records produced by this report (one per session or goal).
+    pub records: usize,
+    /// Of those, records that replaced an earlier record with the same id.
+    pub replaced: usize,
+    /// Lines already in the file that were left untouched.
+    pub kept_existing: usize,
+}
+
+impl ExportSummary {
+    /// The exact command that reads the file back.
+    pub fn meridian_command(&self) -> String {
+        let p = self.path.display().to_string();
+        let p = if p.contains(char::is_whitespace) {
+            format!("'{}'", p.replace('\'', "'\\''"))
+        } else {
+            p
+        };
+        format!("meridian analyze --source jsonl --path {p}")
+    }
+}
+
+fn session_title(first: &CostRow) -> String {
+    if let Some(t) = &first.title {
+        return t.clone();
+    }
+    let short: String = first.session.chars().take(8).collect();
+    match first.source {
+        CostSourceKind::Goals => format!("TA goal {short} ({})", first.project),
+        _ => format!(
+            "{} session {short} ({})",
+            first.source.as_str(),
+            first.project
+        ),
+    }
+}
+
+fn kind_label(kinds: &[CostKind]) -> &'static str {
+    let all = |k: CostKind| kinds.iter().all(|x| *x == k);
+    if all(CostKind::Exact) {
+        "exact"
+    } else if all(CostKind::Estimated) {
+        "estimated"
+    } else if all(CostKind::Unpriced) {
+        "unpriced"
+    } else {
+        "mixed"
+    }
+}
+
+/// One Meridian record per (source, session), ordered by id.
+pub fn meridian_records(rows: &[CostRow]) -> Vec<(String, Value)> {
+    let mut sessions: BTreeMap<String, Vec<&CostRow>> = BTreeMap::new();
+    for r in rows {
+        sessions
+            .entry(format!("{}:{}", r.source.as_str(), r.session))
+            .or_default()
+            .push(r);
+    }
+    sessions
+        .into_iter()
+        .map(|(id, rs)| {
+            let first = rs[0];
+            let ts: Option<DateTime<Utc>> = rs.iter().filter_map(|r| r.ts).min();
+            let sum =
+                |f: fn(&CostRow) -> u64| rs.iter().map(|r| f(r)).fold(0u64, u64::saturating_add);
+            let usd: f64 = rs.iter().map(|r| r.usd).sum();
+            let kinds: Vec<CostKind> = rs.iter().map(|r| r.kind).collect();
+            let kind = kind_label(&kinds);
+            // Distinct models in first-seen order.
+            let mut models: Vec<&str> = Vec::new();
+            for r in &rs {
+                let m = if r.model.is_empty() {
+                    "unknown"
+                } else {
+                    r.model.as_str()
+                };
+                if !models.contains(&m) {
+                    models.push(m);
+                }
+            }
+            let peak = rs.iter().filter_map(|r| r.context_tokens).max();
+            let mut rec = Map::new();
+            rec.insert("id".into(), json!(id));
+            rec.insert("title".into(), json!(session_title(first)));
+            if let Some(t) = ts {
+                rec.insert("timestamp".into(), json!(t.to_rfc3339()));
+            }
+            rec.insert("tokens_input".into(), json!(sum(|r| r.usage.input)));
+            rec.insert("tokens_output".into(), json!(sum(|r| r.usage.output)));
+            rec.insert("source".into(), json!(first.source.as_str()));
+            if let Some(p) = rs.iter().find_map(|r| r.phase.clone()) {
+                rec.insert("phase".into(), json!(p));
+            }
+            let mut meta = |k: &str, v: String| {
+                rec.insert(k.into(), Value::String(v));
+            };
+            meta("cost_usd", format!("{usd:.6}"));
+            meta("cost_exact", (kind == "exact").to_string());
+            meta("cost_kind", kind.to_string());
+            meta("model", models.join(","));
+            meta("cache_read_tokens", sum(|r| r.usage.cache_read).to_string());
+            meta(
+                "cache_write_tokens",
+                sum(|r| r.usage.cache_creation).to_string(),
+            );
+            meta(
+                "context_peak",
+                peak.map(|p| p.to_string()).unwrap_or_else(|| "n/a".into()),
+            );
+            meta(
+                "workload",
+                match first.source {
+                    CostSourceKind::Goals => "goal",
+                    _ => "interactive",
+                }
+                .into(),
+            );
+            meta("project", first.project.clone());
+            (id, Value::Object(rec))
+        })
+        .collect()
+}
+
+fn line_id(line: &str) -> Option<String> {
+    let t = line.trim();
+    if t.is_empty() || t.starts_with("//") {
+        return None;
+    }
+    serde_json::from_str::<Value>(t)
+        .ok()?
+        .get("id")?
+        .as_str()
+        .map(str::to_string)
+}
+
+/// Merge `rows` into the JSONL file at `path`, replacing records with the same
+/// id and keeping every other line. Atomic: temp file then rename.
+pub fn export_meridian(rows: &[CostRow], path: &Path) -> anyhow::Result<ExportSummary> {
+    let records = meridian_records(rows);
+    let existing = match std::fs::read_to_string(path) {
+        Ok(t) => t,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => String::new(),
+        Err(e) => {
+            return Err(anyhow::Error::new(e).context(format!(
+                "could not read the existing Meridian file {}. Check it is a readable file, or \
+                 pass a different --meridian path",
+                path.display()
+            )))
+        }
+    };
+    let mut new_by_id: BTreeMap<&str, &Value> =
+        records.iter().map(|(id, v)| (id.as_str(), v)).collect();
+    let mut out = String::new();
+    let (mut replaced, mut kept_existing) = (0usize, 0usize);
+    for line in existing.lines() {
+        match line_id(line).and_then(|id| new_by_id.remove_entry(id.as_str())) {
+            Some((_, v)) => {
+                out.push_str(&v.to_string());
+                replaced += 1;
+            }
+            None => {
+                if !line.trim().is_empty() {
+                    kept_existing += 1;
+                }
+                out.push_str(line);
+            }
+        }
+        out.push('\n');
+    }
+    // Ids not seen in the file, in id order. Records that replaced a line are
+    // already out of the map.
+    for v in new_by_id.values() {
+        out.push_str(&v.to_string());
+        out.push('\n');
+    }
+
+    if let Some(dir) = path.parent().filter(|d| !d.as_os_str().is_empty()) {
+        std::fs::create_dir_all(dir).with_context(|| {
+            format!(
+                "could not create {} for the Meridian export. Check the path is writable",
+                dir.display()
+            )
+        })?;
+    }
+    let mut tmp_name = path.file_name().unwrap_or_default().to_os_string();
+    tmp_name.push(format!(".tmp-{}", std::process::id()));
+    let tmp = path.with_file_name(tmp_name);
+    std::fs::write(&tmp, out).with_context(|| {
+        format!(
+            "could not write the temp file {} for the Meridian export. Check the directory is \
+             writable and has space",
+            tmp.display()
+        )
+    })?;
+    if let Err(e) = std::fs::rename(&tmp, path) {
+        let _ = std::fs::remove_file(&tmp);
+        return Err(anyhow::Error::new(e).context(format!(
+            "could not move {} into place as {}. The existing file was not changed",
+            tmp.display(),
+            path.display()
+        )));
+    }
+    Ok(ExportSummary {
+        path: path.to_path_buf(),
+        records: records.len(),
+        replaced,
+        kept_existing,
+    })
+}
+
+#[cfg(test)]
+mod tests {
