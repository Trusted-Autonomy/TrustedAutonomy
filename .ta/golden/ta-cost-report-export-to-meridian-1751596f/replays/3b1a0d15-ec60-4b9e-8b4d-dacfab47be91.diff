+    /// Mirrors `meridian_ingest::generic::load_jsonl`: `title` required, the
+    /// named fields typed, only string extras kept as metadata. Meridian is a
+    /// separate repository, so this is the fixture side of the round trip.
+    #[derive(serde::Deserialize)]
+    struct MeridianRecord {
+        id: Option<String>,
+        title: String,
+        timestamp: Option<String>,
+        tokens_input: Option<u64>,
+        tokens_output: Option<u64>,
+        source: Option<String>,
+        phase: Option<String>,
+        #[serde(flatten)]
+        extra: HashMap<String, Value>,
+    }
+
+    fn load(path: &Path) -> Vec<MeridianRecord> {
+        std::fs::read_to_string(path)
+            .unwrap()
+            .lines()
+            .filter(|l| !l.trim().is_empty() && !l.starts_with("//"))
+            .map(|l| serde_json::from_str(l).unwrap())
+            .collect()
+    }
+
+    fn meta<'a>(r: &'a MeridianRecord, k: &str) -> &'a str {
+        r.extra
+            .get(k)
+            .and_then(Value::as_str)
+            .unwrap_or_else(|| panic!("no string {k}"))
+    }
+
+    fn row(session: &str, usd: f64, kind: CostKind, ctx: Option<u64>) -> CostRow {
+        CostRow {
+            source: CostSourceKind::Claude,
+            session: session.into(),
+            ts: DateTime::parse_from_rfc3339("2026-10-10T01:00:00Z")
+                .ok()
+                .map(|d| d.with_timezone(&Utc)),
+            project: "proj".into(),
+            model: "claude-sonnet-5-5".into(),
+            usage: TokenUsage {
+                input: 10,
+                output: 20,
+                cache_read: 300,
+                cache_creation: 40,
+            },
+            usd,
+            kind,
+            context_tokens: ctx,
+            origin_class: None,
+            title: None,
+            phase: None,
+        }
+    }
+
