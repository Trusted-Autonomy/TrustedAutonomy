+        assert_eq!(meta(r, "cost_usd"), "2.000000");
+        assert_eq!(meta(r, "cost_exact"), "false");
+        assert_eq!(meta(r, "model"), "claude-sonnet-5-5");
+        assert_eq!(meta(r, "cache_read_tokens"), "600");
