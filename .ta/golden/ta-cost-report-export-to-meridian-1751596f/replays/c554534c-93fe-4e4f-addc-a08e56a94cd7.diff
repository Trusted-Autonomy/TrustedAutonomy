+// ── Meridian export ─────────────────────────────────────────────────────────
+
+/// One line of the JSONL file Meridian's generic loader reads: `id`, `title`,
+/// `timestamp`, `tokens_input`, `tokens_output`, `source` and `phase`, plus
+/// string-valued extras that Meridian keeps as metadata.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct MeridianRecord {
+    /// `<source>:<session or goal id>`; the idempotency key.
+    pub id: String,
+    pub title: String,
+    pub timestamp: Option<String>,
+    /// Uncached input tokens. Cache traffic is in the string metadata below.
+    pub tokens_input: u64,
+    pub tokens_output: u64,
+    pub source: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub phase: Option<String>,
+    pub cost_usd: String,
+    /// "true" only when every turn's cost was reported by the runtime.
+    pub cost_exact: String,
+    pub model: String,
+    pub cache_read_tokens: String,
+    pub cache_write_tokens: String,
+    /// Largest single-turn prompt size, or "n/a" for goals (many turns).
+    pub context_peak: String,
+    pub workload: String,
+}
+
+/// Collapse per-turn rows into one record per session or goal, sorted by id.
+/// A session that appears in several rows (repeated ids are already folded by
+/// the scan) is exported once.
+pub fn meridian_records(rows: &[CostRow]) -> Vec<MeridianRecord> {
+    let mut by_id: BTreeMap<String, Vec<&CostRow>> = BTreeMap::new();
+    for r in rows {
+        by_id
+            .entry(format!("{}:{}", r.source.as_str(), r.session))
+            .or_default()
+            .push(r);
+    }
+    by_id
+        .into_iter()
+        .map(|(id, rs)| {
+            let first = rs[0];
+            let mut usage = TokenUsage::default();
+            let mut usd = 0.0;
+            let mut per_model: BTreeMap<&str, u64> = BTreeMap::new();
+            for r in &rs {
+                usage.input = usage.input.saturating_add(r.usage.input);
+                usage.output = usage.output.saturating_add(r.usage.output);
+                usage.cache_read = usage.cache_read.saturating_add(r.usage.cache_read);
+                usage.cache_creation = usage.cache_creation.saturating_add(r.usage.cache_creation);
+                usd += r.usd;
+                let m = per_model.entry(r.model.as_str()).or_default();
+                *m = m.saturating_add(r.usage.total());
+            }
+            // The model that carried the most tokens; ties go to the name that sorts first.
+            let model = per_model
+                .iter()
+                .max_by(|a, b| a.1.cmp(b.1).then(b.0.cmp(a.0)))
+                .map(|(m, _)| m.to_string())
+                .unwrap_or_else(|| "unknown".to_string());
+            let ts = rs.iter().filter_map(|r| r.ts).min();
+            let peak = rs.iter().filter_map(|r| r.context_tokens).max();
+            let project = if first.project.is_empty() {
+                "unknown"
+            } else {
+                first.project.as_str()
+            };
+            MeridianRecord {
+                title: format!(
+                    "{} session {} ({project})",
+                    first.source.as_str(),
+                    first.session
+                ),
+                id,
+                timestamp: ts.map(|t| t.to_rfc3339()),
+                tokens_input: usage.input,
+                tokens_output: usage.output,
+                source: first.source.as_str().to_string(),
+                phase: None,
+                cost_usd: format!("{usd:.6}"),
+                cost_exact: rs.iter().all(|r| r.kind == CostKind::Exact).to_string(),
+                model,
+                cache_read_tokens: usage.cache_read.to_string(),
+                cache_write_tokens: usage.cache_creation.to_string(),
+                context_peak: peak.map_or_else(|| "n/a".to_string(), |p| p.to_string()),
+                workload: first
+                    .origin_class
+                    .clone()
+                    .unwrap_or_else(|| "interactive".to_string()),
+            }
+        })
+        .collect()
+}
+
+/// Outcome of [`write_meridian_jsonl`].
+#[derive(Debug, Clone, PartialEq)]
+pub struct MeridianWrite {
+    /// Records in the file after the write.
+    pub total: usize,
+    /// Records from this report that were not in the file before.
+    pub added: usize,
+    /// Records from this report that replaced an existing record of the same id.
+    pub updated: usize,
+}
+
+/// Merge `records` into the JSONL file at `path` by `id` and replace the file
+/// atomically (temp file in the same directory, then rename). Re-running with
+/// the same records leaves the file unchanged. Existing records with other ids
+/// are kept. A line in an existing file that is not valid JSON with an `id` is
+/// an error: the file is left untouched rather than silently dropped.
+pub fn write_meridian_jsonl(
+    path: &Path,
+    records: &[MeridianRecord],
+) -> Result<MeridianWrite, String> {
+    use std::io::Write;
+    let mut merged: BTreeMap<String, Value> = BTreeMap::new();
+    if path.exists() {
+        let text = std::fs::read_to_string(path).map_err(|e| {
+            format!(
+                "could not read existing {}: {e}. Check permissions or choose another --meridian path",
+                path.display()
+            )
+        })?;
+        for (i, line) in text
+            .lines()
+            .enumerate()
+            .filter(|(_, l)| !l.trim().is_empty())
+        {
+            let v: Value = serde_json::from_str(line).map_err(|e| {
+                format!(
+                    "{} line {} is not valid JSON ({e}). Fix or remove it, or choose another \
+                     --meridian path; nothing was written",
+                    path.display(),
+                    i + 1
+                )
+            })?;
+            let id = v.get("id").and_then(Value::as_str).ok_or_else(|| {
+                format!(
+                    "{} line {} has no string \"id\". Fix or remove it, or choose another \
+                     --meridian path; nothing was written",
+                    path.display(),
+                    i + 1
+                )
+            })?;
+            merged.insert(id.to_string(), v);
+        }
+    }
+    let (mut added, mut updated) = (0, 0);
+    for r in records {
+        let v = serde_json::to_value(r).map_err(|e| format!("could not encode {}: {e}", r.id))?;
+        if merged.insert(r.id.clone(), v).is_some() {
+            updated += 1;
+        } else {
+            added += 1;
+        }
+    }
+    let dir = match path.parent() {
+        Some(d) if !d.as_os_str().is_empty() => d.to_path_buf(),
+        _ => PathBuf::from("."),
+    };
+    std::fs::create_dir_all(&dir)
+        .map_err(|e| format!("could not create {}: {e}. Check permissions", dir.display()))?;
+    let mut tmp = tempfile::NamedTempFile::new_in(&dir).map_err(|e| {
+        format!(
+            "could not create a temp file in {}: {e}. Check permissions",
+            dir.display()
+        )
+    })?;
+    for v in merged.values() {
+        writeln!(tmp, "{v}").map_err(|e| format!("could not write {}: {e}", path.display()))?;
+    }
+    tmp.persist(path)
+        .map_err(|e| format!("could not move the temp file onto {}: {e}", path.display()))?;
+    Ok(MeridianWrite {
+        total: merged.len(),
+        added,
+        updated,
+    })
+}
