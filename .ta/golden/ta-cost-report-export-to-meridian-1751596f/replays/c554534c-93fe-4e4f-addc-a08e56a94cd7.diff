+/// Write the Meridian JSONL and return the confirmation text.
+pub fn export_meridian(report: &CostReport, path: &Path) -> anyhow::Result<String> {
+    let records = meridian_records(&report.rows);
+    let w = write_meridian_jsonl(path, &records).map_err(anyhow::Error::msg)?;
+    let shown = path
+        .canonicalize()
+        .unwrap_or_else(|_| path.to_path_buf())
+        .display()
+        .to_string();
+    tracing::info!(path = %shown, records = records.len(), added = w.added, "meridian export written");
+    Ok(format!(
+        "Meridian export: {shown}\n  {} record(s) from this report ({} new, {} updated); {} in the file.\n  \
+         Read it with: meridian analyze --source jsonl --path {shown}",
+        records.len(),
+        w.added,
+        w.updated,
+        w.total
+    ))
+}
